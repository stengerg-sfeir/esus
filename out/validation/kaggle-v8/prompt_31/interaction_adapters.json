{
  "interaction_adapters": [
    {
      "action_name": "create_account",
      "target_service": "AccountRepository",
      "target_method": "create",
      "input_fields": [
        {
          "field_name": "customer_id",
          "target_param": "customer_id",
          "transform": "LOOKUP_ID",
          "lookup_entity": "Customer",
          "required": true
        },
        {
          "field_name": "balance",
          "target_param": "balance",
          "transform": "DECIMAL_TO_CENTS",
          "lookup_entity": null,
          "required": true
        }
      ]
    },
    {
      "action_name": "list_customers",
      "target_service": "CustomerRepository",
      "target_method": "read_all",
      "input_fields": [
        {
          "field_name": "name",
          "target_param": "name",
          "transform": "DIRECT",
          "lookup_entity": null,
          "required": false
        },
        {
          "field_name": "email",
          "target_param": "email",
          "transform": "DIRECT",
          "lookup_entity": null,
          "required": false
        }
      ]
    }
  ]
}

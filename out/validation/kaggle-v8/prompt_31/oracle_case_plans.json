{
  "plans": [
    {
      "id": "deposit_increase_balance",
      "source": "Deposits increase the balance and withdrawals decrease it.",
      "when": {
        "action": "deposit",
        "args": [
          "account.id",
          "amount"
        ]
      },
      "setup_entities": [
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        },
        {
          "alias": "customer",
          "entity": "Customer",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "account.balance"
        ],
        "rows": {
          "Account": 1
        }
      },
      "status": "confirmed"
    },
    {
      "id": "withdrawal_negative_balance_rejection",
      "source": "A withdrawal must be rejected if it would make the balance negative.",
      "when": {
        "action": "withdraw",
        "args": [
          "account.id",
          "amount"
        ]
      },
      "setup_entities": [
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        },
        {
          "alias": "customer",
          "entity": "Customer",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "account.balance"
        ],
        "error": "withdrawal_rejected"
      },
      "status": "confirmed"
    }
  ]
}

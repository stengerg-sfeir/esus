              },
              {
                "name": "category",
                "type": "str"
              },
              {
                "name": "max_price",
                "type": "float"
              },
              {
                "name": "min_quantity",
                "type": "int"
              }
            ],
            "return_type": "list[Product]"
          },
          {
            "name": "search_products",
            "description": "Search products.",
            "params": [
              {
                "name": "name",
                "type": "str"
              },
              {
                "name": "category",
                "type": "str"
              },
              {
                "name": "max_price",
                "type": "str"
              },
              {
                "name": "min_quantity",
                "type": "str"
              }
            ],
            "return_type": "list[Product]",
            "raises": []
          }
        ]
      }
    ],
    "entity_mappings": [

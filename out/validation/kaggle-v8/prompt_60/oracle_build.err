```json
{
  "cases": [
    {
      "id": "cancel_pending_order_releases_stock",
      "source": "Cancelling an order releases the reserved stock.",
      "given": {
        "order": {"status": "pending", "customer_id": 1},
        "product": {"stock_quantity": 5}
      },
      "when": {
        "action": "cancel_order",
        "args": ["order.id"]
      },
      "then": {
        "state": {
          "order.status": "cancelled",
          "product.stock_quantity": 5  // Assumed: stock returns to original quantity after cancellation
        },
        "error": null,
        "rows": {"Order": 1}
      },
      "status": "assumed",
      "assumptions": [
        "Stock quantity reverts to its pre-order value after cancellation (not explicitly stated for pending orders)"
      ]
    },
    {
      "id": "confirm_pending_order_reserves_stock",
      "source": "Confirming an order reserves stock.",
      "given": {
        "order": {"status": "pending", "customer_id": 1},
        "product": {"stock_quantity": 5}
      },
      "when": {
        "action": "confirm_order",
        "args": ["order.id"]
      },
      "then": {
        "state": {
          "order.status": "confirmed",
          "product.stock_quantity": 0  // Assumed: stock is fully reserved
        },
        "error": null,
        "rows": {"Order": 1, "Product": 1}
      },
      "status": "assumed",
      "assumptions": [
        "Stock quantity is reduced to zero after full reservation (no partial reservation logic implied)"
      ]
    },
    {
      "id": "cancel_confirmed_order_releases_stock",
      "source": "Cancelling a confirmed order releases the reserved stock.",
      "given": {
        "order": {"status": "confirmed", "customer_id": 1},
        "product": {"stock_quantity": 0}  // Assumed: stock was reserved
      },
      "when": {
        "action": "cancel_order",
        "args": ["order.id"]
      },
      "then": {
        "state": {
          "order.status": "cancelled",
          "product.stock_quantity": 5  // Assumed: stock returns to original quantity
        },
        "error": null,
        "rows": {"Order": 1, "Product": 1}
      },
      "status": "assumed",
      "assumptions": [
        "Stock quantity returns to its pre-order value after cancellation (no partial restocking logic)"
      ]
    },
    {
      "id": "search_customer_orders",
      "source": "Customers should be able to search their orders.",
      "given": {
        "customer": {"id": 1}
      },
      "when": {
        "cli": ["orders", "list", "--customer_id=1"]
      },
      "then": {
        "state": {
          "rows": {"Order": 2}  // Assumed: At least 2 orders exist for customer 1
        },
        "error": null
      },
      "status": "ambiguous",

{
  "interaction_adapters": [
    {
      "action_name": "productadd",
      "target_service": "InvoiceLineRepository",
      "target_method": "create_with_product_and_quantity",
      "input_fields": [
        {
          "field_name": "invoice_id",
          "target_param": "invoice_id",
          "transform": "LOOKUP_ID",
          "lookup_entity": "Invoice",
          "required": true
        },
        {
          "field_name": "product_id",
          "target_param": "product_id",
          "transform": "LOOKUP_ID",
          "lookup_entity": "Product",
          "required": true
        },
        {
          "field_name": "quantity",
          "target_param": "quantity",
          "transform": "DIRECT",
          "lookup_entity": null,
          "required": true
        },
        {
          "field_name": "unit_price",
          "target_param": "unit_price",
          "transform": "DECIMAL_TO_CENTS",
          "lookup_entity": null,
          "required": true
        }
      ]
    }
  ]
}

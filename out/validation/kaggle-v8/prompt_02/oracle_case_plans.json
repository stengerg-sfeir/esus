{
  "plans": [
    {
      "id": "addition_support",
      "source": "It must support addition, subtraction, multiplication and division of two numbers.",
      "when": {
        "action": "add",
        "args": [
          "number1",
          "number2"
        ]
      },
      "setup_entities": [
        {
          "alias": "number1",
          "entity": "Number",
          "role": "input"
        },
        {
          "alias": "number2",
          "entity": "Number",
          "role": "input"
        }
      ],
      "expect": {
        "state": [
          "result"
        ],
        "rows": {
          "Operation": 1
        }
      },
      "status": "confirmed"
    },
    {

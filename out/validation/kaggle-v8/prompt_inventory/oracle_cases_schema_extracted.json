    {
      "id": "product_add_sku_unique_validation",
      "source": "product add --sku --name --category --price --stock [--stock]",
      "given": {
        "category": {
          "id": 1,
          "name": "Electronics",
          "description": "Electronic devices",
          "reorder_threshold": 10
        },
        "product": {
          "sku": "ELEC-001",
          "name": "Smartphone",
          "category_id": 1,
          "price_cents": 5000,
          "stock_qty": 5
        }
      },
      "when": {
        "action": "add_product",
        "args": [
          "sku",
          "name",
          "category_id",
          "price_cents",
          "stock_qty"
        ]
      },
      "then": {
        "state": {
          "product.sku": "ELEC-001",
          "product.name": "Smartphone",
          "product.category_id": 1,
          "product.price_cents": 5000,
          "product.stock_qty": 5
        },
        "error": "ProductNotFoundError",
        "rows": {
          "Product": 1
        }
      },
      "status": "assumed",
      "base_status": "assumed",
      "assumptions": [
        "The category exists with id 1 and name 'Electronics'",
        "The product with sku 'ELEC-001' does not already exist in the system",
        "The action adds a product with all provided fields and no validation on uniqueness beyond existence of category"
      ],
      "ambiguities": []
    },

{
  "cases": [
    {
      "id": "cancel_order",
      "source": "cancel_order",
      "given": {
        "order": {"status": "pending", "customer_id": 1},
        "product": {"stock_quantity": 5}
      },
      "when": {
        "action": "cancel_order",
        "args": ["order.id"]
      },
      "then": {
        "state": {
          "order.status": "cancelled",
          "product.stock_quantity": 7
        },
      "error": "",
      "rows": {
        "Order": 1
      },
      "status": "ambiguous",
      "assumptions": [
        "The 'cancel_order' action is not defined in the requirements; only product and category operations are described."
      ],
      "ambiguities": [
        "No requirement specifies a 'cancel_order' action or its effect on product stock quantities.",
        "The change in product.stock_quantity from 5 to 7 is not justified or defined in the requirements."
      ]
    },
    {
      "id": "add_product_with_valid_inputs",
      "source": "product add --sku --name --category --price --stock",
      "given": {
        "product": {
          "sku": "SKU123",
          "name": "Laptop",
          "category_id": 1,
          "price_cents": 10000,
          "stock_qty": 10
        }
      },
      "when": {
        "action": "product add",
        "args": [
          "--sku", "SKU123",
          "--name", "Laptop",
          "--category", "1",
          "--price", "10000",
          "--stock", "10"
        ]
      },
      "then": {
        "state": {
          "product.sku": "SKU123",
          "product.name": "Laptop",
          "product.category_id": 1,
          "product.price_cents": 10000,
          "product.stock_qty": 10
        },
        "error": "",
        "rows": {
          "Product": 1
        }
      },
      "status": "confirmed",
      "assumptions": []
    },
    {

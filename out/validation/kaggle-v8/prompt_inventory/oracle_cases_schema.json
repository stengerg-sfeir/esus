      "id": "product_add_sku_unique_validation",
      "source": "product add --sku --name --category --price --stock [--stock]",
      "given": {
        "category": {
          "id": 1,
          "name": "Electronics",
          "description": "Electronic devices",
          "reorder_threshold": 10
        },
        "product": {
          "sku": "ELEC-001",
          "name": "Smartphone",
          "category_id": 1,
          "price_cents": 5000,
          "stock_qty": 5
        }
      },
      "when": {
        "action": "add_product",
        "args": [
          "ELEC-001",
          "Smartphone",
          1,
          5000,
          5
        ]
      },
      "then": {
        "state": {
          "product.sku": "ELEC-001",
          "product.name": "Smartphone",
          "product.category_id": 1,
          "product.price_cents": 5000,
          "product.stock_qty": 5
        },
        "error": "ProductNotFoundError",
        "rows": {
          "Product": 1
        }
      },
      "status": "assumed",
      "base_status": "assumed",
      "assumptions": [
        "The category exists with id 1 and reorder_threshold 10",
        "The sku 'ELEC-001' is unique within the product model",
        "The product is added successfully and stored in the database"
      ],
      "ambiguities": []

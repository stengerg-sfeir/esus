{
  "service_contracts": [
    {
      "service_name": "OrderService",
      "methods": [
        {
          "name": "confirm_order",
          "description": "Transitions an order from pending to confirmed state. The order must be in pending state; if not, the operation fails.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "OrderStatusInvalidError",
            "OrderAlreadyConfirmedError"
          ]
        },
        {
          "name": "ship_order",
          "description": "Transitions an order from confirmed to shipped state. The order must be in confirmed state; if not, the operation fails.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "OrderStatusInvalidError",
            "OrderNotConfirmedError"
          ]
        },
        {
          "name": "cancel_order",
          "description": "Transitions an order from confirmed to cancelled state. The order must be in confirmed state; if not, the operation fails. A cancelled order cannot be shipped.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "OrderStatusInvalidError",
            "OrderNotConfirmedError"
          ]
        },

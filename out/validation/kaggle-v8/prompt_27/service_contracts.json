    {
      "service_name": "ReservationService",
      "methods": [
        {
          "name": "create_reservation",
          "description": "Creates a new reservation for a customer in a room, validating that the room and customer exist and that the reservation does not overlap with any existing reservation.",
          "params": [
            {
              "name": "customer_id",
              "type": "int"
            },
            {
              "name": "room_id",
              "type": "int"
            },
            {
              "name": "start_date",
              "type": "datetime"
            },
            {
              "name": "end_date",
              "type": "datetime"
            }
          ],
          "return_type": "models.Reservation",
          "raises": [
            "CustomerNotFoundError",
            "RoomNotFoundError",
            "OverlappingReservationError",
            "InvalidStartDateError",
            "InvalidEndDateError",
            "InvalidCustomerIdError",
            "InvalidRoomIdError"
          ]
        },
        {
          "name": "read_reservation_by_id",
          "description": "Reads one Reservation by its key.",
          "params": [
            {
              "name": "reservation_id",
              "type": "int"
            }
          ],
          "return_type": "Reservation | None",
          "raises": [
            "ReservationNotFoundError"
          ],
          "mechanical": true
        },
        {
          "name": "read_all_reservations",

      "id": "borrow_transaction_rollback",
      "source": "Borrowing and returning each perform all related writes in one SQLite transaction. If any write fails, roll back every write in that operation.",
      "given": {
        "book": {
          "title": "Brave New World",
          "isbn": "9780141439518",
          "author_id": 1,
          "published_year": 1932,
          "available_copies": 2
        },
        "member": {
          "id": 1,
          "name": "Bob Johnson",
          "email": "bob@example.com",
          "membership_date": "2023-01-01",
          "is_active": true
        }
      },
      "when": {
        "action": "library borrow",
        "args": [
          "member.id",
          "book.id"
        ]
      },
      "then": {
        "rows": {
          "Book": 1
        }
      },
      "status": "assumed",
      "base_status": "assumed",
      "assumptions": [

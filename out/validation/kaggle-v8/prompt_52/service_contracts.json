{
  "service_contracts": [
    {
      "service_name": "BorrowService",
      "methods": [
        {
          "name": "borrow_book",
          "description": "Borrows a book by a member. The book must be available and the member must exist. After borrowing, the book's available_status is updated to 'borrowed'.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "void",
          "raises": [
            "MemberNotFoundError",
            "BookNotFoundError",
            "BookAlreadyBorrowedError"
          ]
        },
        {
          "name": "return_book",
          "description": "Returns a borrowed book to the library. The book must be currently borrowed by the specified member. After return, the book's available_status is updated to 'available'.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "void",
          "raises": [
            "MemberNotFoundError",
            "BookNotFoundError",
            "BorrowRecordNotFoundError",
            "InvalidReturnDateError"
          ]
        }
      ]
    },

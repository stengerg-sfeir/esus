{
  "plans": [
    {
      "id": "create_event",
      "source": "People should be able to create events and register for them.",
      "when": {
        "action": "create_event",
        "args": [
          "event.name",
          "event.date",
          "event.max_participants"
        ]
      },
      "setup_entities": [
        {
          "alias": "event",
          "entity": "Event",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "event.status"
        ],
        "rows": {
          "Event": 1
        }
      },
      "status": "confirmed"
    },
    {
      "id": "register_for_event",
      "source": "People should be able to create events and register for them.",
      "when": {
        "action": "register_for_event",
        "args": [
          "event.id",
          "person.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "event",
          "entity": "Event",
          "role": "target"
        },
        {
          "alias": "person",
          "entity": "Person",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "event.status",
          "person.registration_status"
        ],
        "rows": {
          "Event": 1,
          "Person": 1
        }
      },
      "status": "confirmed"
    },
    {
      "id": "prevent_registration_when_full",
      "source": "The application should prevent registrations when an event is full.",
      "when": {
        "action": "register_for_event",
        "args": [
          "event.id",
          "person.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "event",
          "entity": "Event",
          "role": "target"
        },
        {
          "alias": "person",
          "entity": "Person",
          "role": "setup"
        }
      ],
      "expect": {
        "error": "registration_failed",
        "rows": {
          "Event": 1
        }
      },
      "status": "confirmed"
    }
  ]
}

{
  "plans": [
    {
      "id": "create_employee_valid",
      "source": "Create a Python 3.12 application for managing employees. An employee has a name, email address, age and salary. The email must be valid, age must be between 18 and 70, and salary must be positive. Provide CRUD operations using SQLite.",
      "when": {
        "action": "create_employee",
        "args": [
          "name",
          "email",
          "age",
          "salary"
        ]
      },
      "setup_entities": [
        {
          "alias": "employee",
          "entity": "Employee",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "employee.name",
          "employee.email",
          "employee.age",
          "employee.salary"
        ],
        "rows": {
          "Employee": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },
    {
      "id": "create_employee_invalid_email",
      "source": "An employee has a name, email address, age and salary. The email must be valid, age must be between 18 and 70, and salary must be positive.",

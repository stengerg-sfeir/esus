{
  "plans": [
    {
      "id": "create_customer_audit",
      "source": "Provide CRUD operations for customers. Every creation, update and deletion must also produce an audit record containing the operation, customer ID and timestamp.",
      "when": {
        "action": "create_customer",
        "args": [
          "customer.id",
          "customer.name",
          "customer.email"
        ]
      },
      "setup_entities": [
        {
          "alias": "customer",
          "entity": "Customer",
          "role": "target"
        },
        {
          "alias": "audit_record",
          "entity": "AuditRecord",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "customer.status",
          "audit_record.operation",
          "audit_record.customer_id",
          "audit_record.timestamp"
        ],
        "rows": {
          "Customer": 1,
          "AuditRecord": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },

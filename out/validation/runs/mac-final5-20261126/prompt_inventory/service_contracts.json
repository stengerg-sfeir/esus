          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "models.Product",
          "raises": [
            "ProductNotFoundError"
          ]
        },
        {
          "name": "list_products",
          "description": "Lists products filtered by optional category ID and whether to include only low-stock items.",
          "params": [
            {
              "name": "category_id",
              "type": "int"
            },
            {
              "name": "low_only",
              "type": "bool"
            }
          ],
          "return_type": "list[Product]",
          "raises": []
        },
        {
          "name": "restock",

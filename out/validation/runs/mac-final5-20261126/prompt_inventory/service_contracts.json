            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "qty",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "ProductNotFoundError"
          ]
        },
        {
          "name": "low_stock_report",
          "description": "Returns a list of products whose stock_qty is below their category's reorder_threshold.",

          "return_type": "list[Product]",
          "raises": []
        },
        {
          "name": "stock_value_by_category",
          "description": "Returns a dictionary mapping each category to the total value (price_cents * stock_qty) of all products in that category.",
          "params": [],
          "return_type": "dict[int: int]",
          "raises": []
        }

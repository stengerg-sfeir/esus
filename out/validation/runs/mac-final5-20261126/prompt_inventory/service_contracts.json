{
  "service_contracts": [
    {
      "service_name": "InventoryService",
      "methods": [
        {
          "name": "add_product",
          "description": "Adds a new product with validation that the category exists and the SKU is unique.",
          "params": [
            {
              "name": "sku",
              "type": "str"
            },
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "category_id",
              "type": "int"
            },
            {
              "name": "price_cents",
              "type": "int"
            },
            {
              "name": "stock_qty",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "CategoryNotFoundError"
          ]
        },
        {
          "name": "update_product",
          "description": "Updates a product's fields, with validation that the product exists and the category exists if provided.",
          "params": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "data",
              "type": "dict"
            }
          ],
          "return_type": "None",
          "raises": [
            "ProductNotFoundError",
            "CategoryNotFoundError"
          ]
        },
        {
          "name": "delete_product",
          "description": "Deletes a product by its ID, raising an error if the product does not exist.",
          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "ProductNotFoundError"
          ]
        },
        {
          "name": "get_product_by_id",

        "action": "delete_product",
        "args": [
          "id"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "product.id"
        ],
        "rows": {
          "Product": 0

{
  "plans": [
    {
      "id": "product_add_sku_unique_validation",
      "source": "product add --sku --name --category --price --stock [--stock]",
      "when": {
        "action": "add_product",
        "args": [
          "sku",
          "name",
          "category_id",
          "price_cents",
          "stock_qty"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        },
        {
          "alias": "category",
          "entity": "Category",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "product.sku",
          "product.name",
          "product.category_id",
          "product.price_cents",
          "product.stock_qty"
        ],
        "rows": {
          "Product": 1
        },
        "error": "ProductNotFoundError"
      },
      "status": "confirmed"
    },
    {
      "id": "product_list_with_category_filter",
      "source": "product list [--category] [--low-only]",
      "when": {
        "action": "list_products",
        "args": [
          "category_id",
          "low_only"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",

        },
        {
          "alias": "category",
          "entity": "Category",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "product.name",
          "product.sku",
          "product.category_id",
          "product.price_cents",
          "product.stock_qty"
        ],
        "rows": {
          "Product": 1
        }
      },
      "status": "confirmed"
    },
    {

{
  "service_contracts": [
    {
      "service_name": "WineInventoryService",
      "methods": [
        {
          "name": "assign_wine_to_location",
          "description": "Assigns a wine to a specific storage location. Ensures the wine name is unique and that the location has sufficient capacity.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            },
            {
              "name": "location_id",
              "type": "str"
            }
          ],
          "return_type": "bool",
          "raises": [
            "WineNotFoundError",
            "StorageLocationNotFoundError",
            "DuplicateWineNameError",
            "LocationOverCapacityException"
          ]
        },
        {
          "name": "update_wine_stock",
          "description": "Updates the stock quantity of a wine. Ensures the new stock level is non-negative and does not violate storage location capacity constraints.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            },
            {
              "name": "new_stock_quantity",
              "type": "int"
            }
          ],
          "return_type": "bool",
          "raises": [
            "WineNotFoundError",
            "NegativeStockError"
          ]
        },
        {
          "name": "validate_wine_pricing",
          "description": "Validates that a wine's selling price is strictly greater than its cost price.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            },
            {
              "name": "cost_price",
              "type": "float"
            },
            {
              "name": "selling_price",
              "type": "float"
            }
          ],
          "return_type": "bool",
          "raises": [
            "InvalidPricingException"
          ]
        },
        {
          "name": "check_storage_location_capacity",
          "description": "Checks whether adding a wine to a storage location would exceed its maximum bottle capacity.",
          "params": [
            {
              "name": "location_id",
              "type": "str"
            },
            {
              "name": "wine_id",
              "type": "int"
            }
          ],
          "return_type": "bool",
          "raises": [
            "LocationOverCapacityException"
          ]
        },
        {
          "name": "list_wines_by_type",
          "description": "Returns a list of wines filtered by wine type (red, white, rosé, sparkling).",
          "params": [
            {
              "name": "wine_type",
              "type": "str"
            }
          ],
          "return_type": "list",
          "raises": []
        },
        {
          "name": "get_storage_location_summary",
          "description": "Returns a summary of all storage locations, including total bottles assigned and remaining capacity.",
          "params": [],
          "return_type": "dict",
          "raises": []
        }
      ]
    },

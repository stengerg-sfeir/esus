{
  "plans": [
    {
      "id": "export_contacts",
      "source": "Export all contacts to CSV",
      "when": {
        "action": "export_contacts"
      },
      "setup_entities": [
        {
          "alias": "contact",
          "entity": "Contact",
          "role": "target"
        }
      ],
      "expect": {
        "rows": {
          "Contact": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },
    {
      "id": "import_contacts",
      "source": "Import contacts from CSV",
      "when": {
        "action": "import_contacts",
        "args": [
          "csv_file_path"
        ]
      },
      "setup_entities": [
        {
          "alias": "contact",
          "entity": "Contact",
          "role": "target"
        }
      ],
      "expect": {
        "rows": {
          "Contact": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },
    {
      "id": "import_invalid_row_rejected",
      "source": "Invalid rows during import must be rejected without corrupting existing data",
      "when": {
        "action": "import_contacts",
        "args": [
          "csv_file_path"
        ]
      },
      "setup_entities": [
        {
          "alias": "contact",
          "entity": "Contact",
          "role": "target"
        }
      ],
      "expect": {
        "error": "invalid_row",
        "rows": {
          "Contact": 0
        }
      },
      "status": "confirmed"
    }
  ]
}

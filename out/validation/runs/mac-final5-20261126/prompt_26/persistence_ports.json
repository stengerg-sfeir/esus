{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Book",
        "interface_name": "BookRepository",
        "methods": [
          {
            "name": "read_all",
            "description": "Lists every Book; optional fields narrow the result.",
            "params": [
              {
                "name": "title",
                "type": "str"
              },
              {
                "name": "isbn",
                "type": "str"
              },
              {
                "name": "available",
                "type": "bool"
              }
            ],
            "return_type": "list[Book]",
            "raises": []
          },
          {
            "name": "read_one",
            "description": "Reads one Book by its key.",
            "params": [
              {
                "name": "id",
                "type": "int"
              }
            ],
            "return_type": "models.Book",
            "raises": [
              "BookNotFoundError"
            ]
          }
        ]
      },
      {

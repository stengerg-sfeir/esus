{
  "plans": [
    {
      "id": "close_loan",
      "source": "Users must be able to create and close loans",
      "when": {
        "action": "close_loan",
        "args": [
          "loan.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "loan",
          "entity": "Loan",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "loan.status"
        ],
        "rows": {
          "Loan": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    }
  ]
}

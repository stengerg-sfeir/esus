{
  "service_contracts": [
    {
      "service_name": "LibraryService",
      "methods": [
        {
          "name": "borrow_book",
          "description": "Borrows a book by member and book ID, checks availability, creates a loan, and decrements available copies. All operations are performed in a single transaction.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "BookNotFoundError",
            "MemberNotFoundError",
            "InvalidBookIDError",
            "InvalidMemberIDError",
            "NegativeAvailableCopiesError",
            "AlreadyReturnedLoanError"
          ]
        },
        {
          "name": "return_book",
          "description": "Returns a loan by loan ID, sets return_date to today, updates status to 'returned', and increments the book's available copies. If the loan is already returned, raises AlreadyReturnedLoanError.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "LoanNotFoundError",
            "AlreadyReturnedLoanError"
          ]
        },
        {
          "name": "get_overdue_loans",
          "description": "Returns all active loans that are overdue (due_date < today and return_date is None). This is a read-only operation that computes overdue status based on current date.",
          "params": [],
          "return_type": "list[Loan]",
          "raises": []
        },
        {
          "name": "renew_membership",
          "description": "Toggles the active status of a member. If the member is active, sets is_active to False; if inactive, sets it to True. All operations are performed in a single transaction.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "MemberNotFoundError",
            "InvalidMemberIDError"
          ]
        },
        {
          "name": "search_books",
          "description": "Performs case-insensitive substring matching across book title, author name, and ISBN. Returns all books that match the query. An ISBN miss returns an empty list. Each book is returned once even if multiple fields match.",
          "params": [
            {
              "name": "query",
              "type": "str"
            }
          ],
          "return_type": "list[Book]",
          "raises": []
        }
      ]
    },

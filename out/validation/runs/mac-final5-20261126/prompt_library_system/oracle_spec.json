    {
      "kind": "method_contract",
      "source": "LibraryService.borrow_book",
      "chosen": {
        "effects": [
          {
            "target": "book.available_copies",
            "op": "decrement",
            "by": "1",
            "write": "BookRepository.update"
          }
        ],
        "creates": [
          {
            "class": "Loan",
            "call": "LoanRepository.create"
          }
        ],
        "preconditions": [
          {
            "check": "book exists",
            "error": "BookNotFoundError",
            "raise_when": "false"
          },
          {
            "check": "member exists",
            "error": "MemberNotFoundError",
            "raise_when": "false"
          }
        ],
        "order": [
          "preconditions",
          "LoanRepository.create",
          "BookRepository.update"
        ]
      },
      "provenance": "method_contracts.json"
    },

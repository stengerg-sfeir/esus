          "params": [
            {
              "name": "recipient",
              "type": "str"
            },
            {
              "name": "message",
              "type": "str"
            }
          ],
          "return_type": "None",
          "raises": []
        }
      ]
    },
    {
      "service_name": "OrderRepository",
      "methods": [

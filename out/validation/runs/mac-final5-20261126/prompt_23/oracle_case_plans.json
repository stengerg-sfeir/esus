{
  "plans": [
    {
      "id": "create_post_by_author",
      "source": "Authors can create posts.",
      "when": {
        "action": "create_post",
        "args": [
          "author.id",
          "post.title",
          "post.content"
        ]
      },
      "setup_entities": [
        {
          "alias": "author",
          "entity": "Author",
          "role": "target"
        },
        {
          "alias": "post",
          "entity": "Post",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "post.author_id",
          "post.title",
          "post.content"
        ],
        "rows": {
          "Post": 1
        }
      },
      "status": "confirmed"
    },
    {
      "id": "create_tag_association",
      "source": "A tag can be associated with multiple posts.",
      "when": {
        "action": "associate_tag_with_post",
        "args": [
          "tag.name",
          "post.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "tag",
          "entity": "Tag",
          "role": "target"
        },
        {
          "alias": "post",
          "entity": "Post",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "post.tags",
          "tag.posts"
        ],
        "rows": {
          "Post": 1,
          "Tag": 1
        }
      },
      "status": "confirmed"
    },

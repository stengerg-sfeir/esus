{
  "plans": [
    {
      "id": "list_orders_by_customer",
      "source": "allow users to list all orders belonging to a customer",
      "when": {
        "action": "list_orders",
        "args": [
          "customer.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "customer",
          "entity": "Customer",
          "role": "target"
        },
        {
          "alias": "order",
          "entity": "Order",
          "role": "related"
        }
      ],
      "expect": {
        "state": [
          "order.status",
          "order.date"
        ],
        "rows": {
          "Order": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },

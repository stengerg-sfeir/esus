              },
              {
                "name": "updated_at",
                "type": "datetime.datetime"
              }
            ],
            "return_type": "models.Book",
            "raises": []
          },
          {
            "name": "read_all",
            "description": "Lists every Book; optional fields narrow the result.",
            "params": [
              {
                "name": "title",
                "type": "str"
              },
              {
                "name": "author",
                "type": "str"
              },
              {
                "name": "created_at",
                "type": "datetime.datetime"
              },
              {
                "name": "updated_at",
                "type": "datetime.datetime"
              }
            ],
            "return_type": "list[Book]",
            "raises": []
          },
          {
            "name": "update",
            "description": "Updates an existing Book.",
            "params": [
              {
                "name": "id",
                "type": "int"
              },
              {
                "name": "title",
                "type": "str"
              },
              {
                "name": "author",
                "type": "str"
              },
              {
                "name": "created_at",
                "type": "datetime.datetime"
              },
              {
                "name": "updated_at",
                "type": "datetime.datetime"
              }
            ],
            "return_type": "models.Book",
            "raises": []
          },
          {
            "name": "delete",
            "description": "Deletes an existing Book.",
            "params": [
              {
                "name": "id",
                "type": "int"
              },
              {
                "name": "title",
                "type": "str"
              },
              {
                "name": "author",
                "type": "str"
              },
              {
                "name": "created_at",
                "type": "datetime.datetime"
              },
              {
                "name": "updated_at",
                "type": "datetime.datetime"
              }
            ],
            "return_type": "None",
            "raises": []
          },
          {
            "name": "read_one",
            "description": "Reads one Book by its key.",
            "params": [

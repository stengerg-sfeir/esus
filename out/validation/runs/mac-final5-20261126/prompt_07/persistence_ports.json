                "name": "id",
                "type": "int"
              }
            ],
            "return_type": "models.Book",
            "raises": []
          },
          {
            "name": "search_by_title",
            "description": "Search for books by a partial match of the title, returning a list of books that match the search term.",
            "params": [
              {
                "name": "title",
                "type": "str"
              }
            ],
            "return_type": "list[Book]"
          }
        ]
      }
    ],
    "entity_mappings": [

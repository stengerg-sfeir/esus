{
  "interaction_adapters": [
    {
      "action_name": "orderadd",
      "input_fields": [
        {
          "field_name": "customer_id",
          "lookup_entity": "Customer",
          "required": true,
          "status": "explicit",
          "target_param": "customer_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "order_date",
          "lookup_entity": null,
          "required": true,
          "status": "explicit",
          "target_param": "order_date",
          "transform": "ISO_DATE"
        }
      ],
      "target_method": "create",
      "target_service": "OrderRepository"
    },
    {
      "action_name": "orderitemadd",
      "input_fields": [
        {
          "field_name": "order_id",
          "lookup_entity": "Order",
          "required": false,
          "target_param": "order_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "product_id",
          "lookup_entity": "Product",
          "required": false,
          "target_param": "product_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "quantity",
          "lookup_entity": null,
          "required": false,
          "target_param": "quantity",
          "transform": "DIRECT"
        }
      ],
      "target_method": "create",
      "target_service": "OrderItemRepository"
    },
    {
      "action_name": "productupdate",
      "input_fields": [
        {
          "field_name": "id",
          "lookup_entity": "Product",
          "required": true,
          "target_param": "id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "name",
          "lookup_entity": null,
          "required": false,
          "target_param": "name",
          "transform": "DIRECT"
        },
        {
          "field_name": "stock_quantity",
          "lookup_entity": null,
          "required": false,
          "target_param": "stock_quantity",
          "transform": "DIRECT"
        }
      ],
      "target_method": "update",
      "target_service": "ProductRepository"
    }
  ]
}

{
  "service_contracts": [
    {
      "service_name": "BorrowService",
      "methods": [
        {
          "name": "return_book",
          "description": "Returns a borrowed book to the library. The book's borrow status is updated to available, and the return date is set. If the return date is earlier than the borrow date, an InvalidReturnDateError is raised. If the book was not borrowed, a BorrowRecordNotFoundError is raised.",
          "params": [
            {
              "name": "book_id",
              "type": "int"
            },
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "return_date",
              "type": "datetime"
            }
          ],
          "return_type": "void",
          "raises": [
            "BookNotFoundError",
            "MemberNotFoundError",
            "BorrowRecordNotFoundError",
            "InvalidReturnDateError"
          ]
        }
      ]
    },

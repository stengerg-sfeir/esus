{
  "plans": [
    {
      "id": "create_product",
      "source": "Create a Python 3.12 sales application. Products and sales must be persisted in SQLite. Provide CRUD operations for products and sales.",
      "when": {
        "action": "create_product",
        "args": [
          "product.name",
          "product.price"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        }
      ],
      "expect": {
        "rows": {
          "Product": 1
        },
        "state": [
          "product.name",
          "product.price"
        ]
      },
      "status": "confirmed"
    },
    {
      "id": "create_sale",
      "source": "Create a Python 3.12 sales application. Products and sales must be persisted in SQLite. Provide CRUD operations for products and sales.",
      "when": {
        "action": "create_sale",
        "args": [
          "sale.product_id",
          "sale.quantity",
          "sale.sale_date"
        ]
      },
      "setup_entities": [
        {
          "alias": "sale",
          "entity": "SalesRecord",
          "role": "target"
        },
        {
          "alias": "product",
          "entity": "Product",
          "role": "lookup"
        }
      ],
      "expect": {
        "rows": {
          "SalesRecord": 1
        },
        "state": [
          "sale.product_id",
          "sale.quantity",
          "sale.sale_date"
        ]
      },
      "status": "confirmed"
    },
    {
      "id": "update_product_price",
      "source": "Provide CRUD operations for products and sales.",
      "when": {
        "action": "update_product",
        "args": [
          "product.id",
          "product.price"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "product.price"
        ],
        "rows": {
          "Product": 1
        }
      },
      "status": "confirmed"
    },
    {
      "id": "delete_sale",
      "source": "Provide CRUD operations for products and sales.",
      "when": {
        "action": "delete_sale",
        "args": [
          "sale.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "sale",
          "entity": "SalesRecord",
          "role": "target"
        }
      ],
      "expect": {
        "rows": {
          "SalesRecord": 0
        },
        "state": [
          "sale.id"
        ]
      },
      "status": "confirmed"
    }
  ]
}

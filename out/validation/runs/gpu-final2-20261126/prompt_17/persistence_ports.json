{
  "persistence_ports": {
    "entity_mappings": [
      {
        "entity": "Product",
        "indexes": [
          "name"
        ],
        "primary_key": "id",
        "table": "products"
      }
    ],
    "repositories": [
      {
        "entity": "Product",
        "interface_name": "ProductRepository",
        "methods": [

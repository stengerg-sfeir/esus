            "params": [
              {
                "name": "name",
                "type": "str"
              },
              {
                "name": "category",
                "type": "str"
              },
              {
                "name": "price",
                "type": "int"
              },
              {
                "name": "quantity",
                "type": "int"
              }
            ],
            "raises": [],

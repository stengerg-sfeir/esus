              {
                "name": "category",
                "type": "str"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "description": "Filter products with price less than or equal to the specified maximum price; returns a list of products within the price limit.",
            "name": "filter_by_max_price",
            "params": [
              {
                "name": "max_price",
                "type": "float"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "description": "Filter products with quantity greater than or equal to the specified minimum quantity; returns a list of products meeting the quantity threshold.",
            "name": "filter_by_min_quantity",
            "params": [
              {
                "name": "min_quantity",
                "type": "int"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "description": "Combine multiple filters (name, category, max price, min quantity) to return products that satisfy all specified conditions simultaneously.",
            "name": "find_all_with_filters",
            "params": [
              {
                "name": "name",
                "type": "str"
              },
              {
                "name": "category",
                "type": "str"
              },
              {
                "name": "max_price",
                "type": "float"
              },
              {
                "name": "min_quantity",
                "type": "int"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "description": "Search products by name using partial matching; returns a list of products whose name contains the given string.",
            "name": "find_by_name",
            "params": [
              {
                "name": "name",
                "type": "str"
              }
            ],
            "return_type": "List[Product]"
          },
          {

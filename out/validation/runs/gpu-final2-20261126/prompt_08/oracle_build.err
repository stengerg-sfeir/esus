{
  "cases": [
    {
      "id": "create_product",
      "source": "Create a Python 3.12 inventory application. Products have a name, category, price and quantity. Provide CRUD operations.",
      "given": {
        "product": {
          "name": "Laptop",
          "category": "Electronics",
          "price": 999.99,
          "quantity": 10
        }
      },
      "when": {
        "action": "create_product",
        "args": [
          "name",
          "category",
          "price",
          "quantity"
        ]
      },
      "then": {
        "state": {
          "product.name": "Laptop",
          "product.category": "Electronics",
          "product.price": 999.99,
          "product.quantity": 10
        },
        "rows": {
          "Product": 1
        }
      },
      "status": "confirmed",
      "assumptions": [],
      "ambiguities": []
    },

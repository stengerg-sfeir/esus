  "decisions": [
    {
      "kind": "method_contract",
      "source": "OrderService.confirm_order",
      "chosen": {
        "effects": [
          {
            "target": "order.state",
            "op": "set",
            "value": "'confirmed'",
            "write": "OrderRepository.update"
          }
        ],
        "preconditions": [
          {
            "check": "order.state == 'pending'",
            "error": "OrderStateException",
            "raise_when": "false"
          }
        ]
      },
      "provenance": "method_contracts.json"
    },
    {
      "kind": "method_contract",
      "source": "OrderService.ship_order",
      "chosen": {
        "effects": [
          {
            "target": "order.state",
            "op": "set",
            "value": "'shipped'",
            "write": "OrderRepository.update"
          }
        ],
        "preconditions": [
          {
            "check": "order.state == 'confirmed'",
            "error": "OrderStateException",
            "raise_when": "false"
          }
        ]
      },
      "provenance": "method_contracts.json"
    },
    {
      "kind": "method_contract",
      "source": "OrderService.cancel_order",
      "chosen": {
        "effects": [
          {
            "target": "order.state",
            "op": "set",
            "value": "'cancelled'",
            "write": "OrderRepository.update"
          }
        ],
        "preconditions": [
          {
            "check": "order.state in ('pending', 'confirmed')",
            "error": "OrderStateException",
            "raise_when": "false"
          }
        ]
      },
      "provenance": "method_contracts.json"
    },

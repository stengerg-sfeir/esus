{
  "method_contracts": [
    {
      "holder": "OrderService",
      "method": "confirm_order",
      "decided_by": "user",
      "requirements_sha": "f1c572048902c0ff85e162e71635ffc995675ce87a0338ded3e30bfc085cfa54",
      "effects": [
        {
          "target": "order.state",
          "op": "set",
          "value": "'confirmed'",

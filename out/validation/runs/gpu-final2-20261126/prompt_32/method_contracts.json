        }
      ]
    },
    {
      "holder": "OrderService",
      "method": "ship_order",
      "decided_by": "user",
      "requirements_sha": "f1c572048902c0ff85e162e71635ffc995675ce87a0338ded3e30bfc085cfa54",
      "effects": [
        {
          "target": "order.state",
          "op": "set",
          "value": "'shipped'",
          "write": "OrderRepository.update"
        }
      ],
      "bindings": [
        {
          "name": "order",
          "repository": "OrderRepository",
          "method": "read_one",
          "args": [
            "order_id"
          ]
        }
      ],
      "preconditions": [
        {
          "check": "order.state == 'confirmed'",
          "error": "OrderStateException",
          "raise_when": "false"
        }
      ]
    },
    {
      "holder": "OrderService",
      "method": "cancel_order",
      "decided_by": "user",
      "requirements_sha": "f1c572048902c0ff85e162e71635ffc995675ce87a0338ded3e30bfc085cfa54",
      "effects": [
        {
          "target": "order.state",
          "op": "set",
          "value": "'cancelled'",
          "write": "OrderRepository.update"
        }
      ],
      "bindings": [
        {
          "name": "order",
          "repository": "OrderRepository",
          "method": "read_one",
          "args": [
            "order_id"
          ]
        }
      ],
      "preconditions": [
        {
          "check": "order.state in ('pending', 'confirmed')",
          "error": "OrderStateException",
          "raise_when": "false"
        }
      ]
    }
  ]

{
  "plans": [
    {
      "id": "confirm_pending_order",
      "source": "An order starts in the `pending` state and can become `confirmed`, `shipped` or `cancelled`.",
      "when": {
        "action": "confirm_order",
        "args": [
          "order.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "order",
          "entity": "Order",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "order.state"
        ],
        "rows": {
          "Order": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },

{
  "plans": [
    {
      "id": "add_book_action",
      "source": "Users should be able to add books",
      "when": {
        "action": "add_book",
        "args": [
          "book.title",
          "book.author"
        ]
      },
      "setup_entities": [
        {
          "alias": "book",
          "entity": "Book",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "book.title",
          "book.author"
        ],
        "rows": {
          "Book": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },
    {
      "id": "remember_between_executions_action",
      "source": "The application should remember the information between executions.",
      "when": {
        "action": "remember_information",
        "args": []
      },
      "setup_entities": [
        {
          "alias": "book",
          "entity": "Book",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "book.title",
          "book.author"
        ],
        "rows": {
          "Book": 1
        },
        "error": "omitted"
      },
      "status": "assumed"
    }
  ]
}

{
  "interaction_adapters": [
    {
      "action_name": "invoiceadd",
      "input_fields": [
        {
          "field_name": "customer_id",
          "lookup_entity": "Customer",
          "required": true,
          "status": "explicit",
          "target_param": "customer_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "issue_date",
          "lookup_entity": null,
          "required": true,
          "status": "explicit",
          "target_param": "issue_date",
          "transform": "ISO_DATE"
        },
        {
          "field_name": "total_amount",
          "lookup_entity": null,
          "required": true,
          "status": "deduced",
          "target_param": "total_amount",
          "transform": "DECIMAL_TO_CENTS"
        }
      ],
      "target_method": "create",
      "target_service": "InvoiceRepository"
    },
    {
      "action_name": "invoicelineadd",
      "input_fields": [
        {
          "field_name": "invoice_id",
          "lookup_entity": "Invoice",
          "required": false,
          "target_param": "invoice_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "product_id",
          "lookup_entity": "Product",
          "required": false,
          "target_param": "product_id",
          "transform": "LOOKUP_ID"
        },
        {
          "field_name": "quantity",
          "lookup_entity": null,
          "required": false,
          "target_param": "quantity",
          "transform": "DIRECT"
        }
      ],
      "target_method": "create",
      "target_service": "InvoiceLineRepository"
    }
  ]
}

    {
      "service_name": "OrderService",
      "methods": [
        {
          "name": "confirm_order",
          "description": "Reserves stock for products in the order and creates an invoice. Only allowed for pending orders. Throws InsufficientStockError if stock is insufficient.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "InsufficientStockError",
            "OrderAlreadyConfirmedError",
            "InvalidOrderStatusError",
            "OrderNotFoundError"
          ]
        },
        {
          "name": "cancel_order",
          "description": "Releases reserved stock for products in the order. Only allowed for confirmed orders. Throws OrderCannotBeCancelledError if order is not confirmed.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "OrderCannotBeCancelledError",
            "OrderNotFoundError",
            "InvalidOrderStatusError"
          ]
        },
        {
          "name": "ship_order",
          "description": "Marks an order as shipped. Only allowed for confirmed orders. Throws OrderCannotBeShippedError if order is not confirmed.",
          "params": [
            {
              "name": "order_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "OrderCannotBeShippedError",
            "OrderNotFoundError",
            "InvalidOrderStatusError"
          ]
        },

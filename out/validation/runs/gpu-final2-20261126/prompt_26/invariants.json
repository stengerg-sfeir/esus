{
  "invariants": [
    {
      "kind": "rule",
      "text": "A book can have at most one active loan at any time."
    },
    {
      "kind": "rule",
      "text": "A book is considered available if no active loan exists for it."
    },
    {
      "kind": "rule",
      "text": "A loan cannot be created if the book is already in an active loan."
    },
    {
      "kind": "rule",
      "text": "A loan must be associated with a book and a member."
    },
    {
      "kind": "rule",
      "text": "A loan's due date must be after the loan date."
    },
    {
      "kind": "rule",
      "text": "A member can have multiple loans, each involving a different book."
    },
    {
      "kind": "schema",
      "text": "Book.available must be a boolean"
    },
    {
      "kind": "schema",
      "text": "Book.available must not be null"
    },
    {
      "kind": "schema",
      "text": "Book.id must be an auto-incremented integer primary key with default value None"
    },
    {
      "kind": "schema",
      "text": "Book.isbn must be a string"
    },
    {
      "kind": "schema",
      "text": "Book.isbn must not be null"
    },
    {
      "kind": "schema",
      "text": "Book.title must be a string"
    },
    {
      "kind": "schema",
      "text": "Book.title must not be null"
    },
    {
      "kind": "rule",
      "text": "Closing a loan must result in the removal of the loan record and the book's availability status being updated."
    },
    {
      "kind": "schema",
      "text": "Loan.book_id must be an integer"
    },
    {
      "kind": "schema",
      "text": "Loan.book_id must not be null"
    },
    {
      "kind": "schema",
      "text": "Loan.book_id must reference an existing Book.id"
    },
    {
      "kind": "schema",
      "text": "Loan.closed must be a boolean"
    },
    {
      "kind": "schema",
      "text": "Loan.closed must not be null"
    },
    {
      "kind": "schema",
      "text": "Loan.due_date must be a datetime"
    },
    {
      "kind": "schema",
      "text": "Loan.due_date must not be null"
    },
    {
      "kind": "schema",
      "text": "Loan.id must be an auto-incremented integer primary key with default value None"
    },
    {
      "kind": "schema",
      "text": "Loan.loan_date must be a datetime"
    },
    {
      "kind": "schema",
      "text": "Loan.loan_date must not be null"
    },
    {
      "kind": "schema",
      "text": "Loan.member_id must be an integer"
    },
    {
      "kind": "schema",
      "text": "Loan.member_id must not be null"
    },
    {
      "kind": "schema",
      "text": "Loan.member_id must reference an existing Member.id"
    },
    {
      "kind": "schema",
      "text": "Member.email must be a string"
    },
    {
      "kind": "schema",
      "text": "Member.email must not be null"
    },
    {
      "kind": "schema",
      "text": "Member.id must be an auto-incremented integer primary key with default value None"
    },
    {
      "kind": "schema",
      "text": "Member.name must be a string"
    },
    {
      "kind": "schema",
      "text": "Member.name must not be null"
    },
    {
      "kind": "rule",
      "text": "When a loan is closed, the book becomes available again if it was previously loaned out."
    }
  ]
}

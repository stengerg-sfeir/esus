{
  "plans": [
    {
      "id": "expense_add_with_valid_params",
      "source": "expense add --amount --description --category [--expense-date] [--method] [--recurring]",
      "when": {
        "action": "add_expense",
        "args": [
          "amount",
          "description",
          "category",
          "expense-date",
          "method",
          "recurring"
        ]
      },
      "setup_entities": [
        {
          "alias": "category",
          "entity": "Category",
          "role": "target"
        },
        {
          "alias": "expense",
          "entity": "Expense",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "expense.amount_cents",
          "expense.description",
          "expense.expense_date",
          "expense.payment_method",
          "expense.is_recurring"
        ],
        "rows": {
          "Expense": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },

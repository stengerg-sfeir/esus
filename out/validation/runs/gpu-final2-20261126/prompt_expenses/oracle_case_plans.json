        "state": [
          "expense.amount_cents",
          "expense.description",
          "expense.expense_date",
          "expense.category_id",
          "expense.payment_method",
          "expense.is_recurring"
        ],
        "rows": {
          "Expense": "variable"
        },
        "error": "omitted"
      },
      "status": "confirmed"

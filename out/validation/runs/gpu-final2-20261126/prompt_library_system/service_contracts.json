{
  "service_contracts": [
    {
      "service_name": "LibraryService",
      "methods": [
        {
          "name": "borrow_book",
          "description": "Borrows a book for a member by checking availability, creating a loan, and decrementing available copies. All operations are performed in a single transaction.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "BookNotFoundError",
            "MemberNotFoundError",
            "InvalidBookCopiesError",
            "InvalidLoanStatusError",
            "InvalidBookIdError",
            "InvalidMemberIdError"
          ]
        },
        {
          "name": "return_book",
          "description": "Returns a loan by setting the return_date, updating the loan status to 'returned', and incrementing the book's available_copies. If the loan is already returned, raises AlreadyReturnedLoanError.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "AlreadyReturnedLoanError",
            "LoanNotFoundError",
            "InvalidLoanStatusError"
          ]
        },
        {
          "name": "get_overdue_loans",
          "description": "Returns all loans that are overdue, defined as loans where due_date is earlier than today and return_date is null.",
          "params": [],
          "return_type": "list[Loan]",
          "raises": []
        },
        {
          "name": "renew_membership",
          "description": "Toggles the active status of a member. If the member is active, sets is_active to False; if inactive, sets it to True.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            }
          ],
          "return_type": "None",
          "raises": [
            "MemberNotFoundError",
            "InvalidMemberIdError"
          ]
        },
        {
          "name": "search_books",
          "description": "Performs case-insensitive substring matching across book title, author name, and ISBN. Returns books that match the query. If no match is found, returns an empty list.",
          "params": [
            {
              "name": "query",
              "type": "str"
            }
          ],
          "return_type": "list[Book]",
          "raises": []
        }
      ]
    },

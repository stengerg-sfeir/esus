            "value1",
            "--content",
            "value1",
            "--author-id",
            "1"
          ],
          [
            "Post",
            "delete",
            "--post-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Post": {
            "title": "value1",
            "content": "value1",

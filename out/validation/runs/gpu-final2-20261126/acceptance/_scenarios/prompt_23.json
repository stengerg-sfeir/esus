{
  "scenarios": [
    {
      "name": "cli:Post add",
      "when": {
        "cli_variants": [
          [
            "Post",
            "add",
            "--title",
            "value1",
            "--content",
            "value1",
            "--author-id",
            "1"
          ]
        ],
        "seed_exclude": [
          "PostTag"
        ]
      },
      "expect": {
        "exit": 0
      }
    },

            "value1"
          ]
        ],
        "seed_overrides": {
          "User": {
            "password_hash": "value1"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:User update",
      "when": {
        "cli_variants": [
          [
            "User",
            "update",
            "--user-id",

{
  "plans": [
    {
      "id": "add_product_with_valid_category",
      "source": "product add --sku --name --category --price --stock [--stock]",
      "when": {
        "action": "add_product",
        "args": [
          "sku",
          "name",
          "category",
          "price_cents",
          "stock_qty"
        ]
      },
      "setup_entities": [
        {
          "alias": "category",
          "entity": "Category",
          "role": "target"
        },
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "product.sku",
          "product.name",
          "product.category_id",
          "product.price_cents",
          "product.stock_qty"
        ],
        "rows": {
          "Product": 1
        },
        "error": "omitted"
      },
      "status": "confirmed"
    },
    {

{
  "plans": [
    {
      "id": "cancel_order_1",
      "source": "A withdrawal must be rejected if it would make the balance negative.",
      "when": {
        "action": "withdraw",
        "args": [
          "account.id",
          "amount"
        ]
      },
      "setup_entities": [
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "account.balance"
        ],
        "error": "withdrawal_rejected"
      },
      "status": "confirmed"
    },
    {
      "id": "deposit_increase_balance",
      "source": "Deposits increase the balance",
      "when": {
        "action": "deposit",
        "args": [
          "account.id",
          "amount"
        ]
      },
      "setup_entities": [
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "account.balance"
        ],
        "rows": {
          "Account": 1
        }
      },
      "status": "assumed"
    },
    {
      "id": "withdrawal_decrease_balance",
      "source": "Withdrawals decrease it",
      "when": {
        "action": "withdraw",
        "args": [
          "account.id",
          "amount"
        ]
      },
      "setup_entities": [
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        }
      ],
      "expect": {
        "state": [
          "account.balance"
        ],
        "rows": {
          "Account": 1
        }
      },
      "status": "assumed"
    },
    {
      "id": "account_belongs_to_customer",
      "source": "An account belongs to a customer",
      "when": {
        "action": "create_account",
        "args": [
          "customer.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "customer",
          "entity": "Customer",
          "role": "setup"
        },
        {
          "alias": "account",
          "entity": "Account",
          "role": "target"
        }
      ],
      "expect": {
        "rows": {
          "Customer": 1,
          "Account": 1
        }
      },
      "status": "ambiguous"
    }
  ]
}

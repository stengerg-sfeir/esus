{
  "plans": [
    {
      "id": "create_product_with_nonexistent_category",
      "source": "Every product must belong to an existing category.",
      "when": {
        "action": "create_product",
        "args": [
          "product.name",
          "product.category_id"
        ]
      },
      "setup_entities": [
        {
          "alias": "product",
          "entity": "Product",
          "role": "target"
        },
        {
          "alias": "category",
          "entity": "Category",
          "role": "setup"
        }
      ],
      "expect": {
        "state": [
          "product.category_id"
        ],
        "error": "STATE_TRANSITION_GUARD"
      },
      "status": "confirmed"
    },
    {
      "id": "delete_category_with_products",
      "source": "A category cannot be deleted while products still belong to it.",
      "when": {
        "action": "delete_category",
        "args": [
          "category.id"
        ]
      },
      "setup_entities": [
        {
          "alias": "category",
          "entity": "Category",
          "role": "target"
        },
        {
          "alias": "product",
          "entity": "Product",
          "role": "setup"
        }
      ],
      "expect": {
        "error": "STATE_TRANSITION_GUARD"
      },
      "status": "confirmed"
    }
  ]
}

{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Book",
        "interface_name": "BookRepository",
        "methods": [
          {
            "name": "add_book",
            "description": "Adds a new book to the database.",
            "params": [
              {
                "name": "book",
                "type": "Book"
              }
            ],
            "return_type": "NoneType"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Book",
        "table": "books",
        "primary_key": "id",
        "indexes": [
          "isbn"
        ]
      }
    ]
  }
}
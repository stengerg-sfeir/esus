{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Category",
        "interface_name": "CategoryRepository",
        "methods": [
          {
            "name": "create",
            "description": "Creates a new category with the given name, description, and optional reorder_threshold.",
            "params": [],
            "return_type": "Category"
          }
        ]
      },
      {
        "entity": "Product",
        "interface_name": "ProductRepository",
        "methods": [
          {
            "name": "create",
            "description": "Creates a new product linked to the specified category.",
            "params": [],
            "return_type": "Product"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Category",
        "table": "categories",
        "primary_key": "id",
        "indexes": [
          "name"
        ]
      },
      {
        "entity": "Product",
        "table": "products",
        "primary_key": "id",
        "indexes": [
          "sku"
        ]
      }
    ]
  }
}

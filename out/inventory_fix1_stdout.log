--- START OF INTENTIONS STREAM ---
{"intentions":
  [
    "manage inventory categories with CRUD operations (add, list, update, delete)",
    "store and retrieve category metadata (name, description, reorder_threshold)",
    "manage inventory products with CRUD operations (add, list, update, delete)",
    "store and retrieve product metadata (sku, name, category_id, price_cents, stock_qty, low_active)",
    "validate product SKU uniqueness and category existence",
    "perform product category filtering and low-stock reporting",
    "aggregate stock value by category",
    "handle stock restocking operations",
    "validate low-stock thresholds against category reorder_thresholds",
    "provide a CLI interface for inventory management with nested command groups",
    "handle monetary values as cents (integer precision)",
    "implement custom exceptions for category/product not found errors",
    "enforce foreign key constraints between categories and products"
  ]
}
--- END OF INTENTIONS STREAM ---

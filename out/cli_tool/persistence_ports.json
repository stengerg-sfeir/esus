{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Expense",
        "interface_name": "ExpenseRepository",
        "methods": [
          {
            "name": "save",
            "description": "Persists an Expense entity",
            "params": [
              {
                "name": "expense",
                "type": "Expense"
              }
            ],
            "return_type": "Expense"
          },
          {
            "name": "findById",
            "description": "Retrieves an Expense by its ID",
            "params": [
              {
                "name": "id",
                "type": "UUID"
              }
            ],
            "return_type": "Expense"
          },
          {
            "name": "findAll",
            "description": "Retrieves all Expenses",
            "params": [
              {
                "name": "offset",
                "type": "int"
              },
              {
                "name": "limit",
                "type": "int"
              }
            ],
            "return_type": "List[Expense]"
          },
          {
            "name": "findByCategory",
            "description": "Retrieves Expenses by category",
            "params": [
              {
                "name": "category",
                "type": "String"
              }
            ],
            "return_type": "List[Expense]"
          },
          {
            "name": "calculateTotalByCategory",
            "description": "Calculates total expenses by category",
            "params": [
              {
                "name": "category",
                "type": "String"
              }
            ],
            "return_type": "Map[String, Double]"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Expense",
        "table": "expenses",
        "primary_key": "id",
        "indexes": [
          "id",
          "category_id",
          "date"
        ]
      }
    ]
  }
}
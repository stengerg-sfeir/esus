{
  "service_contracts": [
    {
      "service_name": "UserService",
      "methods": [
        {
          "name": "get_user_by_id",
          "description": "Retrieves a user by their unique identifier.",
          "params": [
            {
              "name": "user_id",
              "type": "int"
            }
          ],
          "return_type": "User"
        },
        {
          "name": "create_user",
          "description": "Creates a new user with the provided details.",
          "params": [
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "email",
              "type": "str"
            },
            {
              "name": "created_at",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "User"
        }
      ]
    },
    {
      "service_name": "PostService",
      "methods": [
        {
          "name": "get_post_by_id",
          "description": "Retrieves a post by its unique identifier.",
          "params": [
            {
              "name": "post_id",
              "type": "int"
            }
          ],
          "return_type": "Post"
        },
        {
          "name": "create_post",
          "description": "Creates a new post with the provided details.",
          "params": [
            {
              "name": "title",
              "type": "str"
            },
            {
              "name": "content",
              "type": "str"
            },
            {
              "name": "user_id",
              "type": "int"
            },
            {
              "name": "created_at",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "Post"
        }
      ]
    },
    {
      "service_name": "PostRepository",
      "methods": [
        {
          "name": "get_posts_by_user_id",
          "description": "Retrieves all posts associated with a specific user.",
          "params": [
            {
              "name": "user_id",
              "type": "int"
            }
          ],
          "return_type": "list[Post]"
        },
        {
          "name": "get_total_posts_by_user_id",
          "description": "Counts the total number of posts for a specific user.",
          "params": [
            {
              "name": "user_id",
              "type": "int"
            }
          ],
          "return_type": "int"
        }
      ]
    },
    {
      "service_name": "PostAnalytics",
      "methods": [
        {
          "name": "get_total_posts_by_category_and_month",
          "description": "Counts the total number of posts across a specific category and month.",
          "params": [
            {
              "name": "category",
              "type": "str"
            },
            {
              "name": "month",
              "type": "str"
            }
          ],
          "return_type": "int"
        }
      ]
    }
  ]
}

{
  "service_contracts": [
    {
      "service_name": "LibraryManagementSystem",
      "methods": [
        {
          "name": "initialize_database",
          "description": "Sets up the SQLite database schema for Book, Author, Member, and Loan tables with foreign key constraints.",
          "params": [
            {
              "name": "db_path",
              "type": "str"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "add_book",
          "description": "Adds a new book to the database with validation for ISBN uniqueness and available copies.",
          "params": [
            {
              "name": "title",
              "type": "str"
            },
            {
              "name": "isbn",
              "type": "str"
            },
            {
              "name": "author_id",
              "type": "int"
            },
            {
              "name": "published_year",
              "type": "int"
            },
            {
              "name": "available_copies",
              "type": "int"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "add_author",
          "description": "Adds a new author to the database with validation for name uniqueness.",
          "params": [
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "birth_year",
              "type": "int"
            },
            {
              "name": "biography",
              "type": "str"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "add_member",
          "description": "Adds a new member to the database with validation for email uniqueness.",
          "params": [
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "email",
              "type": "str"
            },
            {
              "name": "membership_date",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "borrow_book",
          "description": "Checks if a book is available and loans it to a member, decrementing available copies.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            },
            {
              "name": "loan_date",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "return_book",
          "description": "Returns a book by updating the loan record with a return date and status.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            },
            {
              "name": "return_date",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "get_overdue_loans",
          "description": "Retrieves all overdue loans based on the current date.",
          "params": [
            {
              "name": "current_date",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "renew_membership",
          "description": "Renews a member's membership by toggling their active status.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "is_active",
              "type": "bool"
            }
          ],
          "return_type": "bool"
        },
        {
          "name": "search_books",
          "description": "Searches books by title, author, or ISBN.",
          "params": [
            {
              "name": "query",
              "type": "str"
            },
            {
              "name": "author_id",
              "type": "int | None"
            },
            {
              "name": "isbn",
              "type": "str | None"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "list_books",
          "description": "Lists all books with optional filtering by author or availability.",
          "params": [
            {
              "name": "author_id",
              "type": "int | None"
            },
            {
              "name": "available_only",
              "type": "bool"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "list_members",
          "description": "Lists all members with optional filtering by active status.",
          "params": [
            {
              "name": "active_only",
              "type": "bool"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "get_member_loan_history",
          "description": "Retrieves all loans associated with a specific member.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "get_book_loan_history",
          "description": "Retrieves all loans associated with a specific book.",
          "params": [
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "list[dict]"
        },
        {
          "name": "get_active_loans",
          "description": "Retrieves all currently active loans.",
          "params": [
            {
              "name": "current_date",
              "type": "datetime.datetime"
            }
          ],
          "return_type": "list[dict]"
        }
      ]
    },

{
  "service_contracts": [
    {
      "service_name": "InventoryManagementSystem",
      "methods": [
        {
          "name": "add_product",
          "description": "Adds a new product to the inventory with validation checks for category existence and SKU uniqueness.",
          "params": [
            {
              "name": "sku",
              "type": "str"
            },
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "category_id",
              "type": "int"
            },
            {
              "name": "price_cents",
              "type": "int"
            },
            {
              "name": "stock_qty",
              "type": "int"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "update_product",
          "description": "Updates an existing product's fields with validation for product existence.",
          "params": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "data",
              "type": "dict[str, Union[int, str, bool]]"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "delete_product",
          "description": "Deletes a product by its ID after validation.",
          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "get_product_by_id",
          "description": "Retrieves a single product by its ID.",
          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "dict[str, Union[int, str, bool, int]]"
        },
        {
          "name": "list_products",
          "description": "Lists products filtered by optional category and low-stock status.",
          "params": [
            {
              "name": "category_id",
              "type": "Optional[int]"
            },
            {
              "name": "low_only",
              "type": "Optional[bool]"
            }
          ],
          "return_type": "List[dict[str, Union[int, str, bool, int]]]"
        },
        {
          "name": "restock",
          "description": "Increases the stock quantity of a product by a specified amount.",
          "params": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "qty",
              "type": "int"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "low_stock_report",
          "description": "Generates a report of products with stock below their category's reorder threshold.",
          "params": [
            {
              "name": "category_id",
              "type": "Optional[int]"
            }
          ],
          "return_type": "List[dict[str, Union[int, str, bool, int]]]"
        },
        {
          "name": "stock_value_by_category",
          "description": "Calculates the total stock value (price × stock) per category.",
          "params": [
            {
              "name": "category_id",
              "type": "Optional[int]"
            }
          ],
          "return_type": "Dict[int, int]"
        }
      ]
    },
    {
      "service_name": "CategoryRepository",

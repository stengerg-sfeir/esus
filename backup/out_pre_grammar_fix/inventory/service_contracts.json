          "params": [
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "description",
              "type": "Optional[str]"
            },
            {
              "name": "reorder_threshold",
              "type": "Optional[int]"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "update_category",
          "description": "Updates an existing category's fields with validation for category existence.",
          "params": [
            {
              "name": "id",
              "type": "int"
            },
            {
              "name": "data",
              "type": "dict[str, Union[str, Optional[int]]]"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "delete_category",
          "description": "Deletes a category by its ID after validation.",
          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "get_category_by_id",
          "description": "Retrieves a single category by its ID.",
          "params": [
            {
              "name": "id",
              "type": "int"
            }
          ],
          "return_type": "Optional[dict[str, Union[int, str, Optional[int]]]]"
        },
        {
          "name": "find_products_by_category",
          "description": "Finds all products belonging to a specified category.",
          "params": [
            {
              "name": "category_id",
              "type": "int"
            }
          ],
          "return_type": "List[dict[str, Union[int, str, bool, int]]]"
        }

{
  "service_contracts": [
    {
      "service_name": "WineRepository",
      "methods": [
        {
          "name": "create_wine",
          "description": "Creates a new wine entry with the provided details.",
          "params": [
            {
              "name": "wine_name",
              "type": "str"
            },
            {
              "name": "vintage_year",
              "type": "int"
            },
            {
              "name": "wine_type",
              "type": "str"
            },
            {
              "name": "country_of_origin",
              "type": "str"
            },
            {
              "name": "cost_price",
              "type": "float"
            },
            {
              "name": "selling_price",
              "type": "float"
            },
            {
              "name": "stock_quantity",
              "type": "int"
            }
          ],
          "return_type": "Wine",
          "raises": [
            "DuplicateWineNameError"
          ]
        },
        {
          "name": "read_all_wines",
          "description": "Reads all wines in the system.",
          "params": [],
          "return_type": "List[Wine]",
          "raises": []
        },
        {
          "name": "read_wine_by_id",
          "description": "Reads a specific wine by its unique identifier.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            }
          ],
          "return_type": "Wine",
          "raises": [
            "WineNotFoundError"
          ]
        },
        {
          "name": "update_wine",
          "description": "Updates an existing wine's details.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            },
            {
              "name": "wine_name",
              "type": "str"
            },
            {
              "name": "vintage_year",
              "type": "int"
            },
            {
              "name": "wine_type",
              "type": "str"
            },
            {
              "name": "country_of_origin",
              "type": "str"
            },
            {
              "name": "cost_price",
              "type": "float"
            },
            {
              "name": "selling_price",
              "type": "float"
            },
            {
              "name": "stock_quantity",
              "type": "int"
            }
          ],
          "return_type": "Wine",
          "raises": [
            "WineNotFoundError",
            "DuplicateWineNameError",
            "InvalidPricingException",
            "NegativeStockError"
          ]
        },
        {
          "name": "delete_wine",
          "description": "Deletes a wine entry from the system.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            }
          ],
          "return_type": "bool",
          "raises": [
            "WineNotFoundError"
          ]
        }
      ]
    },
    {
      "service_name": "StorageLocationRepository",
      "methods": [
        {
          "name": "create_location",
          "description": "Creates a new storage location.",
          "params": [
            {
              "name": "zone_name",
              "type": "str"
            },
            {
              "name": "row_number",
              "type": "int"
            },
            {
              "name": "shelf_number",
              "type": "int"
            },
            {
              "name": "max_bottle_capacity",
              "type": "int"
            }
          ],
          "return_type": "StorageLocation",
          "raises": [
            "NegativeCapacityError"
          ]
        },
        {
          "name": "read_all_locations",
          "description": "Reads all storage locations in the system.",
          "params": [],
          "return_type": "List[StorageLocation]",
          "raises": []
        },
        {
          "name": "read_location_by_id",
          "description": "Reads a specific storage location by its unique identifier.",
          "params": [
            {
              "name": "location_id",
              "type": "int"
            }
          ],
          "return_type": "StorageLocation",
          "raises": [
            "StorageLocationNotFoundError"
          ]
        },
        {
          "name": "update_location",
          "description": "Updates an existing storage location's details.",
          "params": [
            {
              "name": "location_id",
              "type": "int"
            },
            {
              "name": "zone_name",
              "type": "str"
            },
            {
              "name": "row_number",
              "type": "int"
            },
            {
              "name": "shelf_number",
              "type": "int"
            },
            {
              "name": "max_bottle_capacity",
              "type": "int"
            }
          ],
          "return_type": "StorageLocation",
          "raises": [
            "StorageLocationNotFoundError",
            "NegativeCapacityError"
          ]
        },
        {
          "name": "delete_location",
          "description": "Deletes a storage location from the system.",
          "params": [
            {
              "name": "location_id",
              "type": "int"
            }
          ],
          "return_type": "bool",
          "raises": [
            "StorageLocationNotFoundError"
          ]
        }
      ]
    },
    {
      "service_name": "WineLocationService",
      "methods": [
        {
          "name": "assign_wine_to_location",
          "description": "Assigns a wine to a specified storage location, ensuring the location's capacity is not exceeded.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            },
            {
              "name": "location_id",
              "type": "int"
            }
          ],
          "return_type": "Wine",
          "raises": [
            "WineNotFoundError",
            "StorageLocationNotFoundError",
            "LocationOverCapacityException"
          ]
        },
        {
          "name": "remove_wine_from_location",
          "description": "Removes a wine from its assigned storage location.",
          "params": [
            {
              "name": "wine_id",
              "type": "int"
            }
          ],
          "return_type": "Wine",
          "raises": [
            "WineNotFoundError"
          ]
        }
      ]
    }
  ]
}

#!/usr/bin/env python3
"""
Consistency checker for a completed extraction output directory.
Checks cross-references between:
  data_models -> persistence_ports (repositories + entity_mappings)
  data_models -> components (crud_services)
  persistence_ports -> service_contracts
  service_contracts -> interaction_adapters
  intentions (non-empty)
  invariants (non-empty, no duplicates)
"""

import json
import sys
from pathlib import Path


def load(out_dir, name):
    p = Path(out_dir) / f"{name}.json"
    if not p.exists():
        return None
    return json.loads(p.read_text(encoding="utf-8"))


def check(out_dir, prompt_name):
    errors = []
    warnings = []

    intentions   = load(out_dir, "intentions")
    data_models  = load(out_dir, "data_models")
    invariants   = load(out_dir, "invariants")
    components   = load(out_dir, "components")
    contracts    = load(out_dir, "service_contracts")
    adapters     = load(out_dir, "interaction_adapters")
    persistence  = load(out_dir, "persistence_ports")

    has_persistence = persistence is not None

    # ── Intentions ──────────────────────────────────────────────────────────
    if intentions is None:
        errors.append("MISSING: intentions.json")
    else:
        items = intentions.get("intentions", [])
        if not items:
            errors.append("intentions list is empty")

    # ── Data Models ─────────────────────────────────────────────────────────
    if data_models is None:
        errors.append("MISSING: data_models.json")
        model_names = set()
    else:
        models = data_models.get("data_models", [])
        model_names = {m.get("name") for m in models if m.get("name")}
        if not model_names:
            errors.append("data_models list is empty")
        # Check FK targets exist
        for m in models:
            for f in m.get("fields", []):
                fk = f.get("foreign_key")
                if fk and isinstance(fk, dict):
                    target = fk.get("target_entity")
                    if target and target not in model_names:
                        warnings.append(f"data_models: {m['name']}.{f['name']} FK targets unknown entity '{target}'")

    # ── Invariants ──────────────────────────────────────────────────────────
    if invariants is None:
        errors.append("MISSING: invariants.json")
    else:
        inv_list = invariants.get("invariants", [])
        if not inv_list:
            errors.append("invariants list is empty")
        dupes = {x for x in inv_list if inv_list.count(x) > 1}
        if dupes:
            warnings.append(f"invariants: {len(dupes)} duplicate entries found")

    # ── Components ──────────────────────────────────────────────────────────
    if components is None:
        errors.append("MISSING: components.json")
    else:
        crud = components.get("components", {}).get("crud_services", [])
        for item in crud:
            entity = item.get("entity", "")
            if entity.endswith("Repository") or entity.endswith("Service"):
                errors.append(f"components.crud_services: '{entity}' is a class name, not a domain entity")
            elif entity not in model_names and model_names:
                warnings.append(f"components.crud_services: '{entity}' not found in data_models")

    # ── Service Contracts ───────────────────────────────────────────────────
    if contracts is None:
        errors.append("MISSING: service_contracts.json")
        contract_services = set()
    else:
        sc_list = contracts.get("service_contracts", [])
        contract_services = {c.get("service_name") for c in sc_list if c.get("service_name")}
        if not sc_list:
            errors.append("service_contracts list is empty")
        for c in sc_list:
            for method in c.get("methods", []):
                if not method.get("name"):
                    errors.append(f"service_contracts: {c.get('service_name')} has a method with no name")

    # ── Persistence Ports ───────────────────────────────────────────────────
    if has_persistence:
        pp = persistence.get("persistence_ports", {})
        repos = pp.get("repositories", [])
        mappings = pp.get("entity_mappings", [])

        if not repos:
            errors.append("persistence_ports.repositories is empty")
        if not mappings:
            errors.append("persistence_ports.entity_mappings is empty")

        repo_entities = {r.get("entity") for r in repos if r.get("entity")}
        mapped_entities = {m.get("entity") for m in mappings if m.get("entity")}

        # Entity names must be bare domain names
        for e in repo_entities:
            if e and (e.endswith("Repository") or e.endswith("Service")):
                errors.append(f"persistence_ports: repository entity '{e}' is a class name, not a domain entity")

        # Every repo entity must have a mapping
        for e in repo_entities:
            if e not in mapped_entities:
                errors.append(f"persistence_ports: repository entity '{e}' has no entity_mapping")

        # Every repo entity should be a known data model
        for e in repo_entities:
            if e and e not in model_names and model_names:
                warnings.append(f"persistence_ports: repository entity '{e}' not found in data_models")

        # Every data model that appears in crud_services should have a repository
        if components:
            crud_entities = {i.get("entity") for i in components.get("components", {}).get("crud_services", [])}
            for e in crud_entities:
                if e and e not in repo_entities and has_persistence:
                    warnings.append(f"consistency: crud_services entity '{e}' has no matching repository in persistence_ports")

        # Repo method names must not be empty
        for r in repos:
            for method in r.get("methods", []):
                if not method.get("name"):
                    errors.append(f"persistence_ports: {r.get('interface_name')} has a method with no name")

    # ── Interaction Adapters ────────────────────────────────────────────────
    if adapters is not None:
        for adapter in adapters.get("interaction_adapters", []):
            target_svc = adapter.get("target_service")
            if target_svc and target_svc not in contract_services:
                warnings.append(f"interaction_adapters: '{adapter.get('action_name')}' targets unknown service '{target_svc}'")

    # ── Report ───────────────────────────────────────────────────────────────
    print(f"\n{'='*60}")
    print(f"  CONSISTENCY REPORT: {prompt_name}")
    print(f"{'='*60}")

    if not errors and not warnings:
        print("  ✅ All checks passed — fully consistent.")
    else:
        if errors:
            print(f"\n  ❌ ERRORS ({len(errors)}):")
            for e in errors:
                print(f"     • {e}")
        if warnings:
            print(f"\n  ⚠️  WARNINGS ({len(warnings)}):")
            for w in warnings:
                print(f"     • {w}")

    print(f"\n  Summary: {len(errors)} error(s), {len(warnings)} warning(s)")
    return len(errors), len(warnings)


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Cross-check consistency of extraction outputs.")
    parser.add_argument("--dirs", nargs="+", required=True,
                        help="One or more output directories to check (format: name:path)")
    args = parser.parse_args()

    total_errors = 0
    total_warnings = 0
    for entry in args.dirs:
        name, path = entry.split(":", 1)
        e, w = check(path, name)
        total_errors += e
        total_warnings += w

    print(f"\n{'='*60}")
    print(f"  GRAND TOTAL: {total_errors} error(s), {total_warnings} warning(s) across {len(args.dirs)} prompt(s)")
    print(f"{'='*60}\n")
    sys.exit(0 if total_errors == 0 else 1)


if __name__ == "__main__":
    main()

{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Wine",
        "interface_name": "WineRepository",
        "methods": [
          {
            "name": "save",
            "description": "Persists a new wine entry or updates existing one.",
            "params": [
              {
                "name": "wine",
                "type": "Wine"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "find_by_id",
            "description": "Retrieves a wine by its unique identifier.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              }
            ],
            "return_type": "Wine"
          },
          {
            "name": "find_by_name",
            "description": "Retrieves a wine by its name (case-insensitive).",
            "params": [
              {
                "name": "wine_name",
                "type": "str"
              }
            ],
            "return_type": "Wine"
          },
          {
            "name": "find_all",
            "description": "Retrieves all wines in the system.",
            "params": [
              {
                "name": "none",
                "type": "None"
              }
            ],
            "return_type": "List[Wine]"
          },
          {
            "name": "update_stock",
            "description": "Updates the stock quantity of a wine.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              },
              {
                "name": "quantity",
                "type": "int"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "assign_to_location",
            "description": "Assigns a wine to a storage location.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              },
              {
                "name": "location_id",
                "type": "str"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "remove_from_location",
            "description": "Removes a wine from its storage location.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              }
            ],
            "return_type": "bool"
          }
        ]
      },
      {
        "entity": "StorageLocation",
        "interface_name": "StorageLocationRepository",
        "methods": [
          {
            "name": "save",
            "description": "Persists a new storage location or updates existing one.",
            "params": [
              {
                "name": "location",
                "type": "StorageLocation"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "find_by_id",
            "description": "Retrieves a storage location by its unique identifier.",
            "params": [
              {
                "name": "location_id",
                "type": "str"
              }
            ],
            "return_type": "StorageLocation"
          },
          {
            "name": "find_by_zone",
            "description": "Retrieves all locations in a specific zone.",
            "params": [
              {
                "name": "zone_name",
                "type": "str"
              }
            ],
            "return_type": "List[StorageLocation]"
          },
          {
            "name": "find_all",
            "description": "Retrieves all storage locations.",
            "params": [
              {
                "name": "none",
                "type": "None"
              }
            ],
            "return_type": "List[StorageLocation]"
          },
          {
            "name": "check_capacity",
            "description": "Checks if a location can accommodate additional bottles.",
            "params": [
              {
                "name": "location_id",
                "type": "str"
              },
              {
                "name": "additional_bottles",
                "type": "int"
              }
            ],
            "return_type": "bool"
          }
        ]
      },
      {
        "entity": "WineLocationAssociation",
        "interface_name": "WineLocationAssociationRepository",
        "methods": [
          {
            "name": "save_association",
            "description": "Creates a new association between a wine and its storage location.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              },
              {
                "name": "location_id",
                "type": "str"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "remove_association",
            "description": "Removes an existing association between a wine and its location.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              }
            ],
            "return_type": "bool"
          },
          {
            "name": "get_associated_locations",
            "description": "Retrieves all storage locations associated with a wine.",
            "params": [
              {
                "name": "wine_id",
                "type": "str"
              }
            ],
            "return_type": "List[StorageLocation]"
          },
          {
            "name": "get_associated_wines",
            "description": "Retrieves all wines associated with a specific storage location.",
            "params": [
              {
                "name": "location_id",
                "type": "str"
              }
            ],
            "return_type": "List[Wine]"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Wine",
        "table": "wines",
        "primary_key": "wine_id",
        "indexes": [
          "wine_name"
        ]
      },
      {
        "entity": "StorageLocation",
        "table": "storage_locations",
        "primary_key": "location_id",
        "indexes": [
          "zone_name",
          "row_number",
          "shelf_number"
        ]
      },
      {
        "entity": "WineLocationAssociation",
        "table": "wine_location_associations",
        "primary_key": "wine_id_location_id_composite",
        "indexes": [
          "wine_id",
          "location_id"
        ]
      }
    ]
  }
}

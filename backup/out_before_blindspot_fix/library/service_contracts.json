{
  "service_contracts": [
    {
      "service_name": "BookRepository",
      "methods": [
        {
          "name": "add_book",
          "description": "Adds a new book to the library system with the provided details.",
          "params": [
            {
              "name": "book",
              "type": "Book"
            }
          ],
          "return_type": "Book"
        },
        {
          "name": "get_book_by_id",
          "description": "Retrieves a book by its unique ID.",
          "params": [
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "Book | None"
        },
        {
          "name": "get_books_by_isbn",
          "description": "Retrieves a book by its ISBN (unique).",
          "params": [
            {
              "name": "isbn",
              "type": "str"
            }
          ],
          "return_type": "Book | None"
        },
        {
          "name": "get_books_by_title",
          "description": "Retrieves books matching the given title (partial match).",
          "params": [
            {
              "name": "title",
              "type": "str"
            }
          ],
          "return_type": "List[Book]"
        },
        {
          "name": "get_books_by_author_id",
          "description": "Retrieves books by a specific author ID.",
          "params": [
            {
              "name": "author_id",
              "type": "int"
            }
          ],
          "return_type": "List[Book]"
        },
        {
          "name": "get_books_by_published_year",
          "description": "Retrieves books published in a specific year.",
          "params": [
            {
              "name": "published_year",
              "type": "int"
            }
          ],
          "return_type": "List[Book]"
        },
        {
          "name": "update_book_available_copies",
          "description": "Updates the available copies count for a book.",
          "params": [
            {
              "name": "book_id",
              "type": "int"
            },
            {
              "name": "new_available_copies",
              "type": "int"
            }
          ],
          "return_type": "Book | None"
        },
        {
          "name": "get_books_with_available_copies",
          "description": "Retrieves books that have available copies (greater than zero).",
          "params": [
            {
              "name": "available_copies_threshold",
              "type": "int"
            }
          ],
          "return_type": "List[Book]"
        }
      ]
    },
    {
      "service_name": "AuthorRepository",
      "methods": [
        {
          "name": "add_author",
          "description": "Adds a new author to the library system.",
          "params": [
            {
              "name": "author",
              "type": "Author"
            }
          ],
          "return_type": "Author"
        },
        {
          "name": "get_author_by_id",
          "description": "Retrieves an author by their unique ID.",
          "params": [
            {
              "name": "author_id",
              "type": "int"
            }
          ],
          "return_type": "Author | None"
        },
        {
          "name": "get_authors_by_name",
          "description": "Retrieves authors matching the given name (partial match).",
          "params": [
            {
              "name": "name",
              "type": "str"
            }
          ],
          "return_type": "List[Author]"
        },
        {
          "name": "get_authors_with_books",
          "description": "Retrieves authors who have at least one book in the system.",
          "params": [
            {
              "name": "book_ids",
              "type": "List[int]"
            }
          ],
          "return_type": "List[Author]"
        }
      ]
    },
    {
      "service_name": "MemberRepository",
      "methods": [
        {
          "name": "add_member",
          "description": "Adds a new member to the library system.",
          "params": [
            {
              "name": "member",
              "type": "Member"
            }
          ],
          "return_type": "Member"
        },
        {
          "name": "get_member_by_id",
          "description": "Retrieves a member by their unique ID.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            }
          ],
          "return_type": "Member | None"
        },
        {
          "name": "get_members_by_name",
          "description": "Retrieves members matching the given name (partial match).",
          "params": [
            {
              "name": "name",
              "type": "str"
            }
          ],
          "return_type": "List[Member]"
        },
        {
          "name": "get_members_by_email",
          "description": "Retrieves members by their unique email.",
          "params": [
            {
              "name": "email",
              "type": "str"
            }
          ],
          "return_type": "Member | None"
        },
        {
          "name": "get_active_members",
          "description": "Retrieves all active members.",
          "params": [
            {
              "name": "is_active",
              "type": "bool"
            }
          ],
          "return_type": "List[Member]"
        },
        {
          "name": "get_inactive_members",
          "description": "Retrieves all inactive members.",
          "params": [
            {
              "name": "is_active",
              "type": "bool"
            }
          ],
          "return_type": "List[Member]"
        }
      ]
    },
    {
      "service_name": "LoanRepository",
      "methods": [
        {
          "name": "add_loan",
          "description": "Adds a new loan record to the library system.",
          "params": [
            {
              "name": "loan",
              "type": "Loan"
            }
          ],
          "return_type": "Loan"
        },
        {
          "name": "get_loan_by_id",
          "description": "Retrieves a loan by its unique ID.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            }
          ],
          "return_type": "Loan | None"
        },
        {
          "name": "get_active_loans",
          "description": "Retrieves all active loans.",
          "params": [
            {
              "name": "status",
              "type": "str"
            }
          ],
          "return_type": "List[Loan]"
        },
        {
          "name": "get_overdue_loans",
          "description": "Retrieves all overdue loans.",
          "params": [
            {
              "name": "due_date",
              "type": "datetime.date"
            }
          ],
          "return_type": "List[Loan]"
        },
        {
          "name": "get_loans_by_member_id",
          "description": "Retrieves all loans by a specific member ID.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            }
          ],
          "return_type": "List[Loan]"
        },
        {
          "name": "get_loans_by_book_id",
          "description": "Retrieves all loans by a specific book ID.",
          "params": [
            {
              "name": "book_id",
              "type": "int"
            }
          ],
          "return_type": "List[Loan]"
        },
        {
          "name": "update_loan_return_date",
          "description": "Updates the return date for a loan.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            },
            {
              "name": "return_date",
              "type": "datetime.date | None"
            }
          ],
          "return_type": "Loan | None"
        },
        {
          "name": "update_loan_status",
          "description": "Updates the status of a loan.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            },
            {
              "name": "status",
              "type": "str"
            }
          ],
          "return_type": "Loan | None"
        }
      ]
    },
    {
      "service_name": "LibraryService",
      "methods": [
        {
          "name": "borrow_book",
          "description": "Checks if a book is available and creates a loan record if valid.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "book_id",
              "type": "int"
            },
            {
              "name": "loan_date",
              "type": "datetime.date"
            }
          ],
          "return_type": "Loan | None"
        },
        {
          "name": "return_book",
          "description": "Updates the return date and status of a loan.",
          "params": [
            {
              "name": "loan_id",
              "type": "int"
            },
            {
              "name": "return_date",
              "type": "datetime.date"
            }
          ],
          "return_type": "Loan | None"
        },
        {
          "name": "get_overdue_loans",
          "description": "Returns all overdue loans based on the current date.",
          "params": [
            {
              "name": "current_date",
              "type": "datetime.date"
            }
          ],
          "return_type": "List[Loan]"
        },
        {
          "name": "renew_membership",
          "description": "Toggles the active status of a member.",
          "params": [
            {
              "name": "member_id",
              "type": "int"
            },
            {
              "name": "is_active",
              "type": "bool"
            }
          ],
          "return_type": "Member | None"
        },
        {
          "name": "search_books",
          "description": "Searches books by title, author, or ISBN.",
          "params": [
            {
              "name": "query",
              "type": "str"
            }
          ],
          "return_type": "List[Book]"
        }
      ]
    }
  ]
}

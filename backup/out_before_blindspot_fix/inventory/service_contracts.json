            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "description",
              "type": "str"
            },
            {
              "name": "reorder_threshold",
              "type": "Optional[int]"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "get_category_by_id",
          "description": "Retrieves a category by its ID.",
          "params": [
            {
              "name": "category_id",
              "type": "int"
            }
          ],
          "return_type": "Category"
        },
        {
          "name": "get_category_by_name",
          "description": "Retrieves a category by its name (case-insensitive).",
          "params": [
            {
              "name": "name",
              "type": "str"
            }
          ],
          "return_type": "Category"
        },
        {
          "name": "get_all_categories",
          "description": "Retrieves all categories from the database.",
          "params": [],
          "return_type": "List[Category]"
        },
        {
          "name": "get_products_by_category",
          "description": "Retrieves all products belonging to a specific category.",
          "params": [
            {
              "name": "category_id",
              "type": "int"
            }
          ],
          "return_type": "List[Product]"
        }
      ]
    },

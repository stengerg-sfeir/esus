              "type": "int"
            },
            {
              "name": "price_cents",
              "type": "int"
            },
            {
              "name": "stock_qty",
              "type": "int"
            },
            {
              "name": "low_active",
              "type": "bool"
            }
          ],
          "return_type": "None"
        },
        {
          "name": "get_product_by_id",

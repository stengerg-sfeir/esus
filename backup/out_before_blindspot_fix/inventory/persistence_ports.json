{
  "persistence_ports": {
    "repositories": [
      {
        "entity": "Category",
        "interface_name": "CategoryRepository",
        "methods": [
          {
            "name": "add_category",
            "description": "Adds a new category to the database with validation for unique name and optional reorder_threshold.",
            "params": [
              {
                "name": "name",
                "type": "str"
              },
              {
                "name": "description",
                "type": "str"
              },
              {
                "name": "reorder_threshold",
                "type": "Optional[int]"
              }
            ],
            "return_type": "None"
          },
          {
            "name": "get_category_by_id",
            "description": "Retrieves a category by its ID.",
            "params": [
              {
                "name": "category_id",
                "type": "int"
              }
            ],
            "return_type": "Category"
          },
          {
            "name": "get_category_by_name",
            "description": "Retrieves a category by its name (case-insensitive).",
            "params": [
              {
                "name": "name",
                "type": "str"
              }
            ],
            "return_type": "Category"
          },
          {
            "name": "get_all_categories",
            "description": "Retrieves all categories from the database.",
            "params": [],
            "return_type": "List[Category]"
          },
          {
            "name": "get_products_by_category",
            "description": "Retrieves all products belonging to a specific category.",
            "params": [
              {
                "name": "category_id",
                "type": "int"
              }
            ],
            "return_type": "List[Product]"
          }
        ]
      },
      {
        "entity": "Product",
        "interface_name": "ProductRepository",
        "methods": [
          {
            "name": "add_product",
            "description": "Adds a new product to the database with validation for unique SKU and category existence.",
            "params": [
              {
                "name": "sku",
                "type": "str"
              },
              {
                "name": "name",
                "type": "str"
              },
              {
                "name": "category_id",
                "type": "int"
              },
              {
                "name": "price_cents",
                "type": "int"
              },
              {
                "name": "stock_qty",
                "type": "int"
              },
              {
                "name": "low_active",
                "type": "bool"
              }
            ],
            "return_type": "None"
          },
          {
            "name": "get_product_by_id",
            "description": "Retrieves a product by its ID.",
            "params": [
              {
                "name": "product_id",
                "type": "int"
              }
            ],
            "return_type": "Product"
          },
          {
            "name": "get_product_by_sku",
            "description": "Retrieves a product by its SKU (case-sensitive).",
            "params": [
              {
                "name": "sku",
                "type": "str"
              }
            ],
            "return_type": "Product"
          },
          {
            "name": "get_products_by_category",
            "description": "Retrieves all products belonging to a specific category.",
            "params": [
              {
                "name": "category_id",
                "type": "int"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "name": "get_low_stock_products",
            "description": "Retrieves products whose stock_qty is below their category's reorder_threshold.",
            "params": [],
            "return_type": "List[Product]"
          },
          {
            "name": "get_total_stock_value_by_category",
            "description": "Calculates the total stock value (price_cents * stock_qty) per category.",
            "params": [],
            "return_type": "Dict[int, int]"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Category",
        "table": "categories",
        "primary_key": "id",
        "indexes": [
          "name"
        ]
      },
      {
        "entity": "Product",
        "table": "products",
        "primary_key": "id",
        "indexes": [
          "sku"
        ]
      }
    ]
  }
}

{
  "invariants": [
    "category.id is auto-incremented primary key",
    "category.name is unique",
    "category.monthly_budget is nullable (can be None)",
    "category.icon is nullable (can be None)",
    "expense.id is auto-incremented primary key",
    "expense.amount_cents is non-negative integer",
    "expense.expense_date is ISO date string",
    "expense.category_id is foreign key referencing category.id",
    "expense.payment_method is one of ['cash', 'card', 'transfer']",
    "expense.is_recurring is boolean",
    "budget.id is auto-incremented primary key",
    "budget.category_id is foreign key referencing category.id",
    "budget.month is 'YYYY-MM' string (e.g., '2024-01')",
    "budget.amount_limit_cents is non-negative integer",
    "budget.category_id and budget.month are unique across the entire budget table"
  ]
}

                "name": "name",
                "type": "str"
              },
              {
                "name": "category_id",
                "type": "int"
              },
              {
                "name": "price_cents",
                "type": "int"
              },
              {
                "name": "stock_qty",
                "type": "int"
              },
              {
                "name": "low_active",
                "type": "Optional[bool]"
              }
            ],
            "return_type": "Product"
          },
          {
            "name": "read_product_by_id",
            "description": "Reads a product by its ID.",
            "params": [
              {
                "name": "id",
                "type": "int"
              }
            ],
            "return_type": "Product"
          },
          {
            "name": "read_products_by_category",

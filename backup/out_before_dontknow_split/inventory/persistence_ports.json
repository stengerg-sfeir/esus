            "params": [
              {
                "name": "category_id",
                "type": "int"
              }
            ],
            "return_type": "List[Product]"
          },
          {
            "name": "update_product",
            "description": "Updates an existing product by its ID with the provided fields.",
            "params": [
              {
                "name": "id",
                "type": "int"
              },
              {
                "name": "sku",
                "type": "Optional[str]"
              },
              {
                "name": "name",
                "type": "Optional[str]"
              },
              {
                "name": "category_id",
                "type": "Optional[int]"
              },
              {
                "name": "price_cents",
                "type": "Optional[int]"
              },
              {
                "name": "stock_qty",
                "type": "Optional[int]"
              },
              {
                "name": "low_active",
                "type": "Optional[bool]"
              }
            ],
            "return_type": "Product"
          },
          {
            "name": "delete_product",
            "description": "Deletes a product by its ID.",
            "params": [

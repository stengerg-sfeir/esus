              }
            ],
            "return_type": "bool"
          },
          {
            "name": "get_low_stock_products",
            "description": "Retrieves products whose stock_qty is below their category's reorder_threshold.",
            "params": [],
            "return_type": "List[Product]"
          },
          {
            "name": "get_total_stock_value_by_category",
            "description": "Calculates the total stock value (price_cents * stock_qty) per category.",
            "params": [],
            "return_type": "Dict[int, int]"
          }
        ]
      }
    ],
    "entity_mappings": [
      {
        "entity": "Category",

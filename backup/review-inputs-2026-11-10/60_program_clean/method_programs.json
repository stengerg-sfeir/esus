{
  "programs": [
    {
      "holder": "OrderService",
      "method": "confirm_order",
      "steps": [
        {
          "op": "read",
          "repo": "OrderRepository",
          "method": "read_one",
          "args": [
            "order_id"
          ],
          "as": "order",
          "error": "OrderNotFoundError"
        },
        {
          "op": "check",
          "condition": "order.status in ('confirmed', 'shipped')",
          "error": "OrderAlreadyConfirmedError"
        },
        {
          "op": "assign",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "query",
          "repo": "OrderItemRepository",
          "method": "get_order_items_by_order_id",
          "args": [
            "order_id"
          ],
          "as": "items"
        },
        {
          "op": "for_each",
          "collection": "items",
          "as": "item",
          "steps": [
            {
              "op": "read",
              "repo": "ProductRepository",
              "method": "read_one",
              "args": [
                "item.product_id"
              ],
              "as": "product",
              "error": "ProductNotFoundError"
            },
            {
              "op": "check",
              "condition": "product.stock_quantity < item.quantity",
              "error": "InsufficientStockError"
            },
            {
              "op": "update",
              "repo": "ProductRepository",
              "method": "update",
              "args": [
                "product.product_id"
              ],
              "fields": {
                "stock_quantity": "product.stock_quantity - item.quantity"
              }
            },
            {
              "op": "add",
              "name": "total",
              "expr": "product.price * item.quantity"
            }
          ]
        },
        {
          "op": "create",
          "repo": "InvoiceRepository",
          "method": "create",
          "fields": {
            "order_id": "order_id",
            "total_amount": "total",
            "generated_at": "datetime.datetime.now()"
          }
        },
        {
          "op": "update",
          "repo": "OrderRepository",
          "method": "update",
          "args": [
            "order_id"
          ],
          "fields": {
            "status": "'confirmed'"
          }
        }
      ],
      "decided_by": "assistant"
    },
    {
      "holder": "OrderService",
      "method": "cancel_order",
      "steps": [
        {
          "op": "read",
          "repo": "OrderRepository",
          "method": "read_one",
          "args": [
            "order_id"
          ],
          "as": "order",
          "error": "OrderNotFoundError"
        },
        {
          "op": "check",
          "condition": "order.status != 'confirmed'",
          "error": "OrderCannotBeCancelledError"
        },
        {
          "op": "query",
          "repo": "OrderItemRepository",
          "method": "get_order_items_by_order_id",
          "args": [
            "order_id"
          ],
          "as": "items"
        },
        {
          "op": "for_each",
          "collection": "items",
          "as": "item",
          "steps": [
            {
              "op": "read",
              "repo": "ProductRepository",
              "method": "read_one",
              "args": [
                "item.product_id"
              ],
              "as": "product",
              "error": "ProductNotFoundError"
            },
            {
              "op": "update",
              "repo": "ProductRepository",
              "method": "update",
              "args": [
                "product.product_id"
              ],
              "fields": {
                "stock_quantity": "product.stock_quantity + item.quantity"
              }
            }
          ]
        },
        {
          "op": "update",
          "repo": "OrderRepository",
          "method": "update",
          "args": [
            "order_id"
          ],
          "fields": {
            "status": "'cancelled'"
          }
        }
      ],
      "decided_by": "assistant"
    },
    {
      "holder": "OrderService",
      "method": "ship_order",
      "steps": [
        {
          "op": "read",
          "repo": "OrderRepository",
          "method": "read_one",
          "args": [
            "order_id"
          ],
          "as": "order",
          "error": "OrderNotFoundError"
        },
        {
          "op": "check",
          "condition": "order.status != 'confirmed'",
          "error": "OrderCannotBeShippedError"
        },
        {
          "op": "update",
          "repo": "OrderRepository",
          "method": "update",
          "args": [
            "order_id"
          ],
          "fields": {
            "status": "'shipped'"
          }
        }
      ],
      "decided_by": "assistant"
    }
  ],
  "schema": "method_programs/1",
  "requirements_sha": "009bd41c9b1bbcbf35e2a0ad999fde416e3655fdaf079841b11cac78d84edd9f"
}

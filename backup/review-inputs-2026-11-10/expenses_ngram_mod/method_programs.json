    {
      "holder": "ExpenseRepository",
      "method": "get_top_spending_categories",
      "steps": [
        {
          "op": "select",
          "as": "expenses"
        },
        {
          "op": "select",
          "entity": "Category",
          "as": "categories"
        },
        {
          "op": "assign",
          "name": "names",
          "expr": "{row.get('id'): row.get('name') for row in categories}"
        },
        {
          "op": "assign",
          "name": "totals",
          "expr": "{}"
        },
        {
          "op": "for_each",
          "collection": "expenses",
          "as": "expense",
          "steps": [
            {
              "op": "assign",
              "name": "when",
              "expr": "str(expense.get('expense_date') or '')[:10]"
            },
            {
              "op": "if",
              "condition": "(start_date is None or when >= str(start_date)[:10]) and (end_date is None or when <= str(end_date)[:10])",
              "steps": [
                {
                  "op": "assign",
                  "name": "category_id",
                  "expr": "expense.get('category_id')"
                },
                {
                  "op": "if",
                  "condition": "category_id is not None",
                  "steps": [
                    {
                      "op": "set",
                      "name": "totals",
                      "key": "category_id",
                      "value": "totals.get(category_id, 0) + (expense.get('amount_cents') or 0)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "op": "assign",
          "name": "ranked",
          "expr": "sorted(totals.items(), key=lambda item: item[1], reverse=True)[:5]"
        },
        {
          "op": "return",
          "expr": "[(category_id, names.get(category_id, str(category_id)), total) for category_id, total in ranked]"
        }
      ],
      "decided_by": "assistant"
    },
    {
      "holder": "ExpenseService",
      "method": "get_monthly_report",
      "steps": [
        {
          "op": "query",
          "repo": "ExpenseRepository",
          "method": "get_monthly_spending_by_category",
          "args": [
            "month"
          ],
          "as": "category_spending"
        },
        {
          "op": "assign",
          "name": "total_spent",
          "expr": "sum(category_spending.values())"
        },
        {
          "op": "query",
          "repo": "BudgetRepository",
          "method": "find_budgets_by_month",
          "args": [
            "month"
          ],
          "as": "budgets"
        },
        {
          "op": "assign",
          "name": "budget_status",
          "expr": "{}"
        },
        {
          "op": "for_each",
          "collection": "budgets",
          "as": "budget",
          "steps": [
            {
              "op": "assign",
              "name": "category_id",
              "expr": "budget.category_id"
            },
            {
              "op": "if",
              "condition": "category_id is not None",
              "steps": [
                {
                  "op": "assign",
                  "name": "spent",
                  "expr": "category_spending.get(category_id, 0)"
                },
                {
                  "op": "assign",
                  "name": "limit",
                  "expr": "budget.amount_limit_cents or 0"
                },
                {
                  "op": "set",
                  "name": "budget_status",
                  "key": "category_id",
                  "value": "'exceeded' if limit and spent > limit else ('warning' if limit and spent >= limit * 0.9 else 'on_track')"
                }
              ]
            }
          ]
        },
        {
          "op": "return",
          "expr": "{'total_spent': total_spent, 'category_spending': category_spending, 'budget_status': budget_status}"
        }
      ],
      "decided_by": "assistant"
    },
    {
      "holder": "ExpenseService",
      "method": "get_yearly_summary",
      "steps": [
        {
          "op": "query",
          "repo": "ExpenseRepository",

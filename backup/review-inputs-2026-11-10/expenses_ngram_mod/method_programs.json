        },
        {
          "op": "assign",
          "name": "category_totals",
          "expr": "{}"
        },
        {
          "op": "for_each",
          "collection": "expenses",
          "as": "expense",
          "steps": [
            {
              "op": "if",
              "condition": "year is None or str(expense.expense_date or '')[:4] == str(year)",
              "steps": [
                {
                  "op": "assign",
                  "name": "category_id",
                  "expr": "expense.category_id"
                },
                {
                  "op": "if",
                  "condition": "category_id is not None",
                  "steps": [
                    {
                      "op": "set",
                      "name": "category_totals",

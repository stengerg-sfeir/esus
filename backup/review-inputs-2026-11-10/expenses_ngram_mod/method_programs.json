                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "op": "assign",
          "name": "ranked",
          "expr": "sorted(category_totals.items(), key=lambda item: item[1], reverse=True)[:5]"
        },
        {
          "op": "return",
          "expr": "{'monthly_totals': monthly_totals, 'top_spending_categories': [[category_id, total] for category_id, total in ranked], 'average_monthly_spend': average_monthly_spend}"
        }
      ],
      "decided_by": "assistant"
    },
    {
      "holder": "ExpenseService",
      "method": "detect_recurring",
      "steps": [
        {
          "op": "query",
          "repo": "ExpenseRepository",
          "method": "read_all",
          "args": [],
          "as": "records"
        },
        {
          "op": "assign",
          "name": "groups",
          "expr": "{}"
        },
        {
          "op": "for_each",
          "collection": "records",
          "as": "record",
          "steps": [
            {
              "op": "assign",
              "name": "key",
              "expr": "(record.amount_cents, record.category_id)"
            },
            {
              "op": "if",
              "condition": "key in groups",
              "steps": [
                {
                  "op": "append",
                  "name": "groups[key]",
                  "expr": "record"
                }
              ],
              "else": [
                {
                  "op": "set",
                  "name": "groups",
                  "key": "key",
                  "value": "[record]"
                }
              ]
            }
          ]
        },
        {
          "op": "assign",
          "name": "result",
          "expr": "[]"
        },
        {
          "op": "for_each",
          "collection": "groups.values()",
          "as": "group",
          "steps": [
            {
              "op": "assign",
              "name": "months",
              "expr": "{}"
            },
            {
              "op": "for_each",
              "collection": "group",
              "as": "record",
              "steps": [
                {
                  "op": "assign",
                  "name": "month",
                  "expr": "str(record.expense_date)[:7]"
                },
                {
                  "op": "set",
                  "name": "months",
                  "key": "month",
                  "value": "True"
                }
              ]
            },
            {
              "op": "if",
              "condition": "len(months) > 1",
              "steps": [
                {
                  "op": "for_each",
                  "collection": "group",
                  "as": "record",
                  "steps": [
                    {
                      "op": "update",
                      "repo": "ExpenseRepository",
                      "method": "update",
                      "args": [
                        "record.id"
                      ],
                      "fields": {
                        "is_recurring": "True"
                      },
                      "as": "updated"
                    },
                    {
                      "op": "append",
                      "name": "result",
                      "expr": "updated"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "op": "return",
          "expr": "result"
        }
      ],
      "decided_by": "assistant"
    },

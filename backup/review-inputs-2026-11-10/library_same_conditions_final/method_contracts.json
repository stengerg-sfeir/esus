{
  "method_contracts": [
    {
      "holder": "LibraryService",
      "method": "borrow_book",
      "decided_by": "user",
      "effects": [
        {
          "target": "book.available_copies",
          "op": "decrement",
          "by": "1",
          "write": "BookRepository.update"
        }
      ],
      "creates": [
        {
          "class": "Loan",
          "call": "LoanRepository.create"
        }
      ],
      "reads": [],
      "derives": [],
      "preconditions": [
        {
          "check": "book exists",
          "error": "BookNotFoundError",
          "raise_when": "false"
        },
        {
          "check": "member exists",
          "error": "MemberNotFoundError",
          "raise_when": "false"
        },
        {
          "check": "getattr(book, 'available_copies', 1) < 1",
          "error": "NegativeAvailableCopiesError",
          "raise_when": "true"
        }
      ],
      "order": [
        "preconditions",
        "LoanRepository.create",
        "BookRepository.update"
      ],
      "forbid": [],

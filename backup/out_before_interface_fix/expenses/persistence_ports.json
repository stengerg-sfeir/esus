          },
          {
            "name": "get_by_name",
            "description": "Retrieves a category by its name. Returns None if not found.",
            "params": [
              {
                "name": "name",
                "type": "str"
              }
            ],
            "return_type": "Optional[Category]"
          },
          {
            "name": "get_expenses_for_category",
            "description": "Retrieves all expenses associated with a category by its ID. Returns a list of expenses.",
            "params": [
              {
                "name": "category_id",
                "type": "int"
              }
            ],
            "return_type": "List[Expense]"
          }
        ]
      },

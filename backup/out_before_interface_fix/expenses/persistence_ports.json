            "name": "check_budget_exceeded",
            "description": "Checks if the total expenses for a category in a month exceed the budget limit. Returns True if exceeded, False otherwise.",
            "params": [
              {
                "name": "category_id",
                "type": "int"
              },
              {
                "name": "month",
                "type": "str"
              }
            ],
            "return_type": "bool"
          }
        ]
      }

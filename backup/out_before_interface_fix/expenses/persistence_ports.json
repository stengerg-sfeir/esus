                "name": "month",
                "type": "str"
              }
            ],
            "return_type": "List[Expense]"
          },
          {
            "name": "aggregate_expenses_by_category",
            "description": "Aggregates expenses by category for a given date range. Returns a dictionary mapping category IDs to total amounts spent.",
            "params": [
              {

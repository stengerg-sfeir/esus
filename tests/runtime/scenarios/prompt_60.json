{
  "scenarios": [
    {
      "name": "ship_confirmed_order",
      "setup": [
        {
          "entity": "Customer",
          "as": "customer",
          "values": {
            "name": "Ada",
            "email": "ada@example.test"
          }
        },
        {
          "entity": "Order",
          "as": "order",
          "values": {
            "customer_id": {
              "ref": "customer.customer_id"
            },
            "status": "confirmed"
          }
        }
      ],
      "when": {
        "service": "OrderService",
        "method": "ship_order",
        "args": [
          {
            "ref": "order.order_id"
          }
        ]
      },
      "expect": {
        "fields": {
          "order.status": "shipped"
        }
      }
    },
    {
      "name": "confirm_order_reserves_stock_and_creates_invoice",
      "setup": [
        {
          "entity": "Category",
          "as": "category",
          "values": {
            "name": "General"
          }
        },
        {
          "entity": "Customer",
          "as": "customer",
          "values": {
            "name": "Ada",
            "email": "ada@example.test"
          }
        },
        {
          "entity": "Product",
          "as": "product",
          "values": {
            "name": "Widget",
            "category_id": {
              "ref": "category.category_id"
            },
            "price": 10,
            "stock_quantity": 5
          }
        },
        {
          "entity": "Order",
          "as": "order",
          "values": {
            "customer_id": {
              "ref": "customer.customer_id"
            },
            "status": "pending"
          }
        },
        {
          "entity": "OrderItem",
          "as": "item",
          "values": {
            "order_id": {
              "ref": "order.order_id"
            },
            "product_id": {
              "ref": "product.product_id"
            },
            "quantity": 2
          }
        }
      ],
      "when": {
        "service": "OrderService",
        "method": "confirm_order",
        "args": [
          {
            "ref": "order.order_id"
          }
        ]
      },
      "expect": {
        "fields": {
          "order.status": "confirmed",
          "product.stock_quantity": 3
        },
        "rows": {
          "Invoice": 1
        }
      }
    },
    {
      "name": "cancel_confirmed_order_restores_stock",
      "setup": [
        {
          "entity": "Category",
          "as": "category",
          "values": {
            "name": "General"
          }
        },
        {
          "entity": "Customer",
          "as": "customer",
          "values": {
            "name": "Ada",
            "email": "ada@example.test"
          }
        },
        {
          "entity": "Product",
          "as": "product",
          "values": {
            "name": "Widget",
            "category_id": {
              "ref": "category.category_id"
            },
            "price": 10,
            "stock_quantity": 5
          }
        },
        {
          "entity": "Order",
          "as": "order",
          "values": {
            "customer_id": {
              "ref": "customer.customer_id"
            },
            "status": "confirmed"
          }
        },
        {
          "entity": "OrderItem",
          "as": "item",
          "values": {
            "order_id": {
              "ref": "order.order_id"
            },
            "product_id": {
              "ref": "product.product_id"
            },
            "quantity": 2
          }
        }
      ],
      "when": {
        "service": "OrderService",
        "method": "cancel_order",
        "args": [
          {
            "ref": "order.order_id"
          }
        ]
      },
      "expect": {
        "fields": {
          "order.status": "cancelled",
          "product.stock_quantity": 7
        }
      }
    },
    {
      "name": "cli:Order cancel",
      "when": {
        "cli_variants": [
          [
            "Order",
            "cancel",
            "--order-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Order": {
            "status": "confirmed"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:Order ship",
      "when": {
        "cli_variants": [
          [
            "Order",
            "ship",
            "--order-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Order": {
            "status": "confirmed"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:Order add",

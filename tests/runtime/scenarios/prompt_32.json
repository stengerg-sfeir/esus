{
  "scenarios": [
    {
      "name": "confirm pending order",
      "setup": [
        {
          "entity": "Order",
          "as": "order",
          "values": {
            "state": "pending"
          }
        }
      ],
      "when": {
        "service": "OrderService",
        "method": "confirm_order",
        "args": [
          {
            "ref": "order.id"
          }
        ]
      },
      "expect": {
        "fields": {
          "order.state": "confirmed"
        }
      }
    },
    {
      "name": "cli:Order confirm",
      "when": {
        "cli_variants": [
          [
            "Order",
            "confirm",
            "--order-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Order": {
            "state": "pending"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:Order ship",
      "when": {
        "cli_variants": [
          [
            "Order",
            "ship",
            "--order-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Order": {
            "state": "confirmed"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:Order cancel",
      "when": {
        "cli_variants": [
          [
            "Order",
            "cancel",
            "--order-id",
            "1"
          ]
        ],
        "seed_overrides": {
          "Order": {
            "state": "confirmed"
          }
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "name": "cli:Order update",
      "when": {
        "cli_variants": [
          [
            "Order",
            "update",
            "--order-id",
            "1",
            "--state",
            "value1"
          ]
        ]
      },
      "expect": {
        "exit": 0
      }
    }
  ]
}

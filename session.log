            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/report.py, lines 1-197\n1: \"\"\"Findings, severity levels and report rendering.\"\"\"\n2: \n3: from dataclasses import dataclass, field\n4: \n5: ERROR = \"error\"\n6: WARNING = \"warning\"\n7: \n8: # A note is an observation the checker cannot call a defect: an empty\n9: # intentions or invariants list is a correct extraction when the requirements\n10: # state none, and the checker has no access to the requirements to tell the\n11: # difference. Notes are reported but never counted, so \"0 errors, 0 warnings\"\n12: # stays an accurate statement about a clean run.\n13: NOTE = \"note\"\n14: \n15: SEVERITY_ORDER = (ERROR, WARNING, NOTE)\n16: SEVERITY_HEADERS = {ERROR: \"❌ ERRORS\", WARNING: \"⚠️  WARNINGS\", NOTE: \"NOTES\"}\n17: \n18: MAX_SUBJECTS = 8\n19: GRAND_TOTAL_RULES = 10\n20: \n21: RULE_TITLES = {\n22:     \"missing_directory\": \"Output directory does not exist\",\n23:     \"missing_document\": \"Document is missing\",\n24:     \"malformed_document\": \"Document is not valid JSON\",\n25:     \"unexpected_shape\": \"Document has an unexpected shape\",\n26:     \"invalid_value\": \"Value has the wrong type or content\",\n27:     \"invalid_identifier\": \"Name is empty\",\n28:     \"placeholder_value\": \"Placeholder left by the extractor\",\n29:     \"empty_section\": \"Section is empty\",\n30:     \"duplicate_entry\": \"Duplicate entry\",\n31:     \"unknown_reference\": \"Reference points at something that does not exist\",\n32:     \"name_variant\": \"Reference spells a name differently from its definition\",\n33:     \"class_name_entity\": \"Entity field holds a class name\",\n34:     \"no_mapping\": \"Repository entity has no entity mapping\",\n35:     \"no_repository\": \"CRUD entity has no repository\",\n36:     \"missing_primary_key\": \"Model declares no primary key\",\n37:     \"nullable_primary_key\": \"Primary key is marked nullable\",\n38:     \"non_unique_primary_key\": \"Primary key is marked non-unique\",\n39:     \"primary_key_mismatch\": \"Mapping primary key is not a field of the entity\",\n40:     \"unsupported_value\": \"Value is outside the allowed set\",\n41:     \"unresolved_adapter_target\": \"Adapter target services cannot be resolved\",\n42:     \"inconsistent_adapter\": \"Adapter transform and lookup entity disagree\",\n43:     \"inconsistent_interface\": \"One repository declared differently in two documents\",\n44:     \"inconsistent_facade\": \"The facade declares a parser and an argument list that disagree\",\n45:     \"missing_parameters\": \"Method promises arguments but declares none\",\n46:     \"inconsistent_invariant\": \"Invariant contradicts the field it names\",\n47:     \"unmet_crud_operation\": \"Claimed operation has no implementing method\",\n48:     \"low_confidence\": \"Classification confidence is below the floor\",\n49:     \"narrow_margin\": \"The top two answers were too close to call — the verdict may differ between runs\",\n50:     \"corrected_claim\": \"An impossible pattern was claimed and a possible one recorded instead\",\n51:     \"missing_pattern\": \"No pattern covers this requirement — a vocabulary gap\",\n52:     \"unused_error\": \"A declared error type that no method raises\",\n53:     \"contradictory_raise\": \"A method that creates a record claims it can fail to find one\",\n54:     \"misplaced_field\": \"An adapter field mapped to a parameter that is not its own\",\n55:     \"mismatched_transform\": \"A transform that does not fit the field it is applied to\",\n56:     \"missing_command\": \"A command the requirements name that the surface does not declare\",\n57:     \"unbacked_command\": \"A command the surface declares that no service method implements\",\n58:     \"unreachable_error\": \"A not-found error no method raises, while its reader exists\",\n59:     \"duplicate_error_subject\": \"Two error types name the same missing record\",\n60: }\n61: \n62: \n63: @dataclass(frozen=True)\n64: class Finding:\n65:     \"\"\"A single consistency problem, identified by its rule.\"\"\"\n66: \n67:     severity: str\n68:     rule: str\n69:     message: str\n70: \n71:     def render(self):\n72:         return f\"[{self.rule}] {self.message}\"\n73: \n74: \n75: @dataclass\n76: class Report:\n77:     \"\"\"Collects the findings for one output directory.\"\"\"\n78: \n79:     prompt_name: str\n80:     findings: list = field(default_factory=list)\n81:     _seen: set = field(default_factory=set, repr=False)\n82: \n83:     def add(self, severity, rule, message):\n84:         key = (severity, rule, message)\n85:         if key in self._seen:\n86:             return\n87:         self._seen.add(key)\n88:         self.findings.append(Finding(*key))\n89: \n90:     def error(self, rule, message):\n91:         self.add(ERROR, rule, message)\n92: \n93:     def warning(self, rule, message):\n94:         self.add(WARNING, rule, message)\n95: \n96:     def note(self, rule, message):\n97:         self.add(NOTE, rule, message)\n98: \n99:     @property\n100:     def sorted_findings(self):\n101:         return sorted(\n102:             self.findings,\n103:             key=lambda finding: (\n104:                 SEVERITY_ORDER.index(finding.severity),\n105:                 finding.rule,\n106:                 finding.message,\n107:             ),\n108:         )\n109: \n110:     def of_severity(self, severity):\n111:         return [f for f in self.sorted_findings if f.severity == severity]\n112: \n113:     @property\n114:     def errors(self):\n115:         return self.of_severity(ERROR)\n116: \n117:     @property\n118:     def warnings(self):\n119:         return self.of_severity(WARNING)\n120: \n121:     @property\n122:     def notes(self):\n123:         return self.of_severity(NOTE)\n124: \n125:     @property\n126:     def counts(self):\n127:         \"\"\"Errors and warnings only — a note is not a defect.\"\"\"\n128:         return len(self.errors), len(self.warnings)\n129: \n130: \n131: def render_report(report, show_all=False):\n132:     \"\"\"Render one directory's report block.\"\"\"\n133:     lines = [\"\", \"=\" * 60, f\"  CONSISTENCY REPORT: {report.prompt_name}\", \"=\" * 60]\n134: \n135:     if not report.findings:\n136:         lines.append(\"  ✅ All checks passed — fully consistent.\")\n137:     else:\n138:         for severity in SEVERITY_ORDER:\n139:             findings = report.of_severity(severity)\n140:             if not findings:\n141:                 continue\n142:             lines.append(\"\")\n143:             lines.append(f\"  {SEVERITY_HEADERS[severity]} ({len(findings)}):\")\n144:             shown = findings if show_all else findings[:MAX_SUBJECTS]\n145:             lines.extend(f\"     • {finding.render()}\" for finding in shown)\n146:             hidden = len(findings) - len(shown)\n147:             if hidden:\n148:                 lines.append(f\"     … and {hidden} more (--all-findings to list them)\")\n149: \n150:     errors, warnings = report.counts\n151:     summary = f\"\\n  Summary: {errors} error(s), {warnings} warning(s)\"\n152:     if report.notes:\n153:         summary += f\", {len(report.notes)} note(s)\"\n154:     lines.append(summary)\n155:     return \"\\n\".join(lines)\n156: \n157: \n158: def with_suggestions(message, suggestions):\n159:     \"\"\"Append a \"did you mean\" hint to a finding message when one is available.\"\"\"\n160:     if not suggestions:\n161:         return message\n162:     return f\"{message} (did you mean: {', '.join(suggestions)}?)\"\n163: \n164: \n165: def render_grand_total(reports):\n166:     \"\"\"Render the cross-directory tally, including the noisiest rules.\"\"\"\n167:     total_errors = sum(report.counts[0] for report in reports)\n168:     total_warnings = sum(report.counts[1] for report in reports)\n169:     total_notes = sum(len(report.notes) for report in reports)\n170: \n171:     header = f\"  GRAND TOTAL: {total_errors} error(s), {total_warnings} warning(s)\"\n172:     if total_notes:\n173:         header += f\", {total_notes} note(s)\"\n174:     lines = [\n175:         \"\",\n176:         \"=\" * 60,\n177:         f\"{header} across {len(reports)} prompt(s)\",\n178:         \"=\" * 60,\n179:     ]\n180: \n181:     tally = {}\n182:     for report in reports:\n183:         for finding in report.findings:\n184:             key = (finding.severity, finding.rule)\n185:             tally[key] = tally.get(key, 0) + 1\n186: \n187:     if tally:\n188:         lines.append(\"\")\n189:         lines.append(\"  By rule:\")\n190:         ranked = sorted(tally.items(), key=lambda item: (-item[1], item[0]))\n191:         for (severity, rule), count in ranked[:GRAND_TOTAL_RULES]:\n192:             lines.append(f\"     {count:>4}  [{severity}] {rule} — {RULE_TITLES.get(rule, rule)}\")\n193:         if len(ranked) > GRAND_TOTAL_RULES:\n194:             lines.append(f\"     … and {len(ranked) - GRAND_TOTAL_RULES} more rule(s)\")\n195: \n196:     lines.append(\"\")\n197:     return \"\\n\".join(lines)"
              }
            ],

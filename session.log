              "command": "cd /Users/gillesstenger/Documents/esus && python3 -c \"\nimport json, glob\nfrom kernel.consistency.naming import normalize\nfor f in sorted(glob.glob('out/*/components.json')):\n    try:\n        cmds = json.load(open(f))['components']['facade']['invocation']['commands']\n    except Exception as e:\n        print(f, 'ERR', e); continue\n    tops = {normalize(c['name']) for c in cmds if isinstance(c, dict)}\n    dups = []\n    for c in cmds:\n        for s in (c.get('subcommands') or []):\n            if isinstance(s, dict) and normalize(s.get('name') or '') in tops:\n                dups.append((c['name'], s['name']))\n    print(f.split('/')[1], '->', dups if dups else 'none')\n\""

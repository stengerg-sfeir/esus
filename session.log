                "type": "text",
                "text": "Read file /home/gstenger/Documents/esus/extract_arch.py, lines 1-557\n1: #!/usr/bin/env python3\n2: \"\"\"Extract a software architecture from requirements, one step at a time.\n3: \n4: Reads the requirements on stdin (or --requirements PATH) and writes one\n5: `<step>.json` per document into the output directory, plus `run.log`. Each\n6: step is handed the names its predecessors produced — in its prompt as an\n7: authoritative list, and in its GBNF grammar as the only strings it can\n8: write — so the documents agree by construction rather than by repair.\n9: \n10: With --chat, the run continues after writing: the probe judges the output,\n11: and the tie and alias reviews ask about whatever needs a human, right here —\n12: one entry point for the attended pipeline.\n13: \n14: Usage:\n15:     python3.12 extract_arch.py --model MODEL.gguf --output out/library \\\\\n16:         < prompts/prompt_library_system.txt\n17:     python3.12 extract_arch.py --model MODEL.gguf --output out/library \\\\\n18:         --requirements prompts/prompt_library_system.txt --chat\n19: \"\"\"\n20: \n21: import argparse\n22: import os\n23: import sys\n24: from pathlib import Path\n25: \n26: from kernel.extraction import pipeline as pipeline_module\n27: from kernel.extraction import runner, writer\n28: from kernel.extraction.aliases import apply_aliases, apply_model_fields, load_aliases\n29: from kernel.extraction.decisions import apply_decisions, load_decisions\n30: from review_surface import apply_surface_decisions, load_surface_decisions\n31: \n32: \n33: def build_parser():\n34:     parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n35:     parser.add_argument(\"--model\", required=True, help=\"Path to the GGUF model\")\n36:     parser.add_argument(\n37:         \"--output\",\n38:         required=True,\n39:         help=\"Directory to write the step documents and run.log into\",\n40:     )\n41:     parser.add_argument(\n42:         \"--context\",\n43:         type=int,\n44:         default=8192,\n45:         help=\"Context size in tokens (default 8192)\",\n46:     )\n47:     parser.add_argument(\n48:         \"--check\",\n49:         action=\"store_true\",\n50:         help=\"Run the consistency checker over the output once the run finishes\",\n51:     )\n52:     parser.add_argument(\n53:         \"--requirements\",\n54:         default=None,\n55:         metavar=\"PATH\",\n56:         help=\"Read requirements from PATH instead of stdin (required for \"\n57:              \"--chat, so stdin stays free for answers)\",\n58:     )\n59:     parser.add_argument(\n60:         \"--chat\",\n61:         action=\"store_true\",\n62:         help=\"After writing, loop: probe, review what needs a human, resume \"\n63:              \"the earliest step that can heal the rest — keeping a strictly \"\n64:              \"better state or rolling back — until clean, stuck, or 3 rounds\",\n65:     )\n66:     parser.add_argument(\n67:         \"--quiet\",\n68:         action=\"store_true\",\n69:         help=\"Print only the step plan (name: description), one result line \"\n70:              \"per step, questions, and the final SUMMARY — full detail stays \"\n71:              \"in run.log\",\n72:     )\n73:     parser.add_argument(\n74:         \"--from-step\",\n75:         default=None,\n76:         choices=(\n77:             pipeline_module.INTENTIONS,\n78:             pipeline_module.DATA_MODELS,\n79:             pipeline_module.ERRORS,\n80:             pipeline_module.INVARIANTS,\n81:             pipeline_module.COMPONENTS,\n82:             pipeline_module.SERVICE_CONTRACTS,\n83:             pipeline_module.PATTERN_MATCHES,\n84:             pipeline_module.INTERACTION_ADAPTERS,\n85:             pipeline_module.PERSISTENCE_PORTS,\n86:         ),\n87:         help=\"Resume at one step, chaining from the archived documents instead \"\n88:              \"of rerunning the whole pipeline (requirements are read from the \"\n89:              \"output directory's requirements.txt, not stdin)\",\n90:     )\n91:     return parser\n92: \n93: \n94: def resolve_requirements(args):\n95:     \"\"\"The requirements text from --requirements or stdin, or None when empty.\"\"\"\n96:     if args.requirements is not None:\n97:         try:\n98:             text = Path(args.requirements).read_text(encoding=\"utf-8\").strip()\n99:         except OSError as error:\n100:             print(f\"error: cannot read {args.requirements}: {error}\", file=sys.stderr)\n101:             return None\n102:         if not text:\n103:             print(f\"error: {args.requirements} is empty\", file=sys.stderr)\n104:             return None\n105:         return text\n106:     text = sys.stdin.read().strip()\n107:     if not text:\n108:         print(\"error: no requirements were provided on stdin\", file=sys.stderr)\n109:         return None\n110:     return text\n111: \n112: \n113: # The pipeline plan a --quiet run prints up front: step name and what it\n114: # produces. Keys match `pipeline_module` document names; `errors_repair` is a\n115: # deterministic fix, not a model call, and prints as such.\n116: STEP_PLAN = (\n117:     (\"intentions\", \"the program's own phrases from the requirements\"),\n118:     (\"data_models\", \"entities and their fields\"),\n119:     (\"errors\", \"application error types\"),\n120:     (\"invariants\", \"rules the program must always hold\"),\n121:     (\"components\", \"CLI surface and CRUD services\"),\n122:     (\"service_contracts\", \"service methods with params and raises\"),\n123:     (\"errors_repair\", \"deterministic error-registry fix (no model call)\"),\n124:     (\"pattern_matches\", \"pattern classification of invariants and methods\"),\n125:     (\"interaction_adapters\", \"CLI input to service-method mapping\"),\n126:     (\"persistence_ports\", \"repository interfaces for the entities\"),\n127: )\n128: \n129: # A per-step generation result, as `StepResult.describe` writes it:\n130: # `[components] 2310 tokens in 76.3s (30.3 tok/s)`, plus the run totals line\n131: # `[run] 11 steps, 18409 generated tokens in 621.2s` — and only that `[run]`\n132: # line, never the requirements/temperature preamble.\n133: STEP_RESULT = __import__(\"re\").compile(r\"^\\[.+\\] \\d+ tokens in .*tok/s\")\n134: RUN_TOTALS = __import__(\"re\").compile(r\"^\\[run\\] \\d+ steps, \\d+ generated tokens in \")\n135: \n136: \n137: def print_step_plan(out_fn=print, start=None):\n138:     \"\"\"The steps, one `name: description` line each — the quiet header.\n139: \n140:     A resume (`--from-step`) continues a plan already shown by its parent\n141:     run, so it prints nothing: without this every chat-loop round repeats\n142:     the same ten lines.\n143:     \"\"\"\n144:     if start is not None:\n145:         return\n146:     out_fn(\"steps:\")\n147:     for name, description in STEP_PLAN:\n148:         out_fn(f\"  {name}: {description}\")\n149: \n150: \n151: def print_quiet_results(log, out_fn=print):\n152:     \"\"\"One result line per generation plus the totals; detail stays in run.log.\"\"\"\n153:     for line in log.lines:\n154:         if STEP_RESULT.match(line) or RUN_TOTALS.match(line):\n155:             out_fn(line)\n156: \n157: \n158: def chat_flow(output_dir, out_fn=print, tie_runner=None, alias_runner=None,\n159:               surface_runner=None, slot_runner=None):\n160:     \"\"\"Probe, ask, re-probe: the attended tail of an extraction run.\n161: \n162:     Runs the probe over `output_dir`; when ties need a human, runs the tie\n163:     review, surface duplicates get the surface review, field pairs the alias\n164:     review, and pattern slots the slot review. Structural blockers\n165:     (missing commands, uncovered fields, unknown model fields) are reported,\n166:     never asked — no answer the user can type fixes those; a rerun or a code\n167:     fix does. Returns the remaining blockers (a list — the loop judges\n168:     them without re-probing). `*_runner` override the reviews\n169:     (output_dir -> (asked, answered)) for tests.\n170:     \"\"\"\n171:     import probe_readiness\n172:     import review_aliases\n173:     import review_slots\n174:     import review_surface\n175:     import review_ties\n176: \n177:     name = os.path.basename(str(output_dir).rstrip(os.sep))\n178:     blockers, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n179:     questions = probe_readiness.open_questions(str(output_dir))\n180:     if questions:\n181:         out_fn(f\"{questions} tie(s) need a human — starting the tie review\")\n182:         (tie_runner or review_ties.run_review)(str(output_dir))\n183:     duplicates, _ = review_surface.collect_duplicates(str(output_dir))\n184:     if duplicates:\n185:         out_fn(f\"{len(duplicates)} duplicated surface node(s) need a human — \"\n186:                f\"starting the surface review\")\n187:         (surface_runner or review_surface.run_review)(str(output_dir))\n188:     pairs, _ = review_aliases.collect_questions(str(output_dir))\n189:     if pairs:\n190:         out_fn(f\"{len(pairs)} field mapping(s) need a human — starting the alias review\")\n191:         (alias_runner or review_aliases.run_review)(str(output_dir))\n192:     slot_questions, _ = review_slots.collect_slots(str(output_dir))\n193:     if slot_questions:\n194:         out_fn(f\"{len(slot_questions)} pattern slot(s) need a human — \"\n195:                f\"starting the slot review\")\n196:         (slot_runner or review_slots.run_review)(str(output_dir))\n197:     final, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n198:     out_fn(f\"chat: {len(final)} blocker(s) remain\")\n199:     for finding in final:\n200:         out_fn(f\"  - [{finding.rule}] {finding.message}\")\n201:     return final\n202: \n203: \n204: def main():\n205:     args = build_parser().parse_args()\n206:     return run(args)\n207: \n208: \n209: def run(args):\n210:     \"\"\"One extraction round (initial
 label, text, tokens, seconds, finish_reason, budget=None):\n140:         self.label = label\n141:         self.text = text\n142:         self.tokens = tokens\n143:         self.seconds = seconds\n144:         self.finish_reason = finish_reason\n145:         self.budget = budget\n146: \n147:     @property\n148:     def truncated(self):\n149:         \"\"\"True when the model ran out of budget rather than finishing.\"\"\"\n150:         return self.finish_reason == TRUNCATED\n151: \n152:     def describe(self):\n153:         speed = self.tokens / self.seconds if self.seconds else 0.0\n154:         # The ceiling is named on a truncation, because the ceiling is the\n155:         # diagnosis: it is what the retry has to raise.\n156:         note = f\" TRUNCATED at the {self.budget}-token ceiling\" if self.truncated else \"\"\n157:         return (\n158:             f\"[{self.label}] {self.tokens} tokens in {self.seconds:.1f}s \"\n159:             f\"({speed:.1f} tok/s){note}\"\n160:         )\n161: \n162: \n163: def token_count(llm, text):\n164:     \"\"\"Tokens consumed by `text` as a prompt.\"\"\"\n165:     return len(llm.tokenize(text.encode(\"utf-8\")))\n166: \n167: \n168: def available_tokens(llm, prompt):\n169:     \"\"\"How many tokens the context can still hold as a response to `prompt`.\n170: \n171:     This is the real ceiling: the room the prompt left behind. `MAX_NEW_TOKENS`\n172:     is only a guard against filling the whole context on the first attempt.\n173:     \"\"\"\n174:     if llm is None or not prompt or llm.n_ctx() <= 0:\n175:         return MAX_NEW_TOKENS\n176:     return max(MIN_BUDGET, llm.n_ctx() - token_count(llm, prompt) - CONTEXT_RESERVE)\n177: \n178: \n179: def generation_budget(llm, prompt, max_new_tokens=None):\n180:     \"\"\"The response ceiling: the one asked for, clamped to the room available.\n181: \n182:     The retry after a truncation passes `max_new_tokens=available_tokens(...)`,\n183:     which is how a step that hit `MAX_NEW_TOKENS` gets the rest of the context\n184:     on the second attempt instead of the same ceiling that cut it off.\n185:     \"\"\"\n186:     ceiling = MAX_NEW_TOKENS if max_new_tokens is None else max_new_tokens\n187:     return max(MIN_BUDGET, min(ceiling, available_tokens(llm, prompt)))\n188: \n189: \n190: def generate(llm, prompt, grammar_text, label, temperature=0.0, max_new_tokens=None, seed=None):\n191:     \"\"\"Generate one document under `grammar_text`, honouring the context budget.\n192: \n193:     The call is **not** streamed. Streaming yields one chunk per token and\n194:     rebuilds a response dict for each, which is pure Python overhead on top of\n195:     the sampler that already runs per token — it buys nothing here, because the\n196:     document is only ever parsed once the whole step has finished. A single\n197:     non-streaming call returns the same text in one dict, and its `usage` gives\n198:     the exact completion-token count instead of the one-per-chunk estimate the\n199:     stream forced.\n200: \n201:     The caller is responsible for having validated `grammar_text` first: this\n202:     function assumes it is well formed and would otherwise fail on the first\n203:     token rather than up front.\n204: \n205:     `max_new_tokens` overrides the first-attempt ceiling of `MAX_NEW_TOKENS`,\n206:     still clamped to the room the prompt left in the context. The retry after a\n207:     truncation uses it to ask for that whole room.\n208: \n209:     The grammar is required, not optional. An experiment with no GBNF mask at\n210:     all (§9.31) settled it: the raw model fences its JSON, appends prose and\n211:     code, renames the document's own keys and loses whole steps, so the mask is\n212:     what makes the output machine-readable at all — not a vocabulary guard on\n213:     top of otherwise-good JSON. There is deliberately no switch to turn it off.\n214:     \"\"\"\n[Output truncated. Continue reading with offset: 215]"

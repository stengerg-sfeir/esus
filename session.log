            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_chat_loop.py, lines 1-266\n1: \"\"\"The chat loop terminates well: clean, stuck, crashed, or out of rounds.\n2: \n3: Each test pins one exit with the model and the probe mocked — the loop's\n4: contract is about orchestration (findings, snapshot, rerun, compare), never\n5: about generation itself: it keeps a strictly better state or rolls back,\n6: and it always terminates. Snapshots use real temp dirs throughout.\n7: \"\"\"\n8: \n9: import sys\n10: import tempfile\n11: import unittest\n12: from pathlib import Path\n13: from unittest import mock\n14: \n15: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n16: \n17: import extract_arch  # noqa: E402\n18: from kernel.consistency.report import Finding  # noqa: E402\n19: \n20: \n21: def finding(rule):\n22:     return Finding(\"warning\", rule, f\"rule {rule} fired\")\n23: \n24: \n25: class ResumeStepForTests(unittest.TestCase):\n26:     def test_earliest_healable_step_wins(self):\n27:         step = extract_arch.resume_step_for(\n28:             [finding(\"uncovered_field\"), finding(\"missing_flag\")])\n29:         self.assertEqual(step, \"components\")\n30: \n31:     def test_contracts_outranks_adapters(self):\n32:         step = extract_arch.resume_step_for(\n33:             [finding(\"unknown_model_field\"), finding(\"unmet_crud_operation\")])\n34:         self.assertEqual(step, \"service_contracts\")\n35: \n36:     def test_structural_rules_have_no_step(self):\n37:         self.assertIsNone(extract_arch.resume_step_for([finding(\"invalid_value\")]))\n38:         self.assertIsNone(extract_arch.resume_step_for([finding(\"placeholder_value\")]))\n39: \n40:     def test_no_findings_means_no_step(self):\n41:         self.assertIsNone(extract_arch.resume_step_for([]))\n42: \n43: \n44: class SnapshotTests(unittest.TestCase):\n45:     def test_snapshot_and_rollback_restore_bytes(self):\n46:         with tempfile.TemporaryDirectory() as directory:\n47:             target = Path(directory) / \"out\"\n48:             target.mkdir()\n49:             (target / \"a.json\").write_text(\"before\", encoding=\"utf-8\")\n50:             snapshot = extract_arch.snapshot_output(str(target))\n51:             (target / \"a.json\").write_text(\"after\", encoding=\"utf-8\")\n52:             (target / \"b.json\").write_text(\"new\", encoding=\"utf-8\")\n53:             extract_arch.restore_snapshot(snapshot, str(target))\n54:             self.assertEqual((target / \"a.json\").read_text(encoding=\"utf-8\"), \"before\")\n55:             self.assertFalse((target / \"b.json\").exists())\n56:             self.assertTrue(Path(snapshot).is_dir(), \"snapshot stays as evidence\")\n57: \n58: \n59: class ChatLoopTests(unittest.TestCase):\n60:     def loop(self, **stubs):\n61:         \"\"\"Run the loop with scripted flows (findings per round) and checks.\"\"\"\n62:         directory = tempfile.mkdtemp()\n63:         calls = {\"rerun\": []}\n64:         params = {\"max_rounds\": 3, \"flows\": [[]], \"checks\": [],\n65:                   \"crash\": False, **stubs}\n66:         flows = [list(items) for items in params[\"flows\"]]\n67:         checks = [list(items) for items in params[\"checks\"]]\n68: \n69:         def fake_flow(path, out_fn=None, tie_runner=None, alias_runner=None):\n70:             return flows.pop(0)\n71: \n72:         def fake_check(name, path):\n73:             return checks.pop(0), [], None\n74: \n75:         crashes_left = [params[\"crash\"] if isinstance(params[\"crash\"], int)\n76:                         else (1 if params[\"crash\"] else 0)]\n77: \n78:         def fake_rerun(start):\n79:             calls[\"rerun\"].append(start)\n80:             if crashes_left[0] > 0:\n81:                 crashes_left[0] -= 1\n82:                 raise RuntimeError(\"llama_decode returned -3\")\n83:             Path(directory, \"marker.txt\").write_text(\"rerun touched this\",\n84:                                                      encoding=\"utf-8\")\n85: \n86:         with mock.patch.object(extract_arch, \"chat_flow\", side_effect=fake_flow), \\\n87:              mock.patch(\"probe_readiness.check_prompt\", side_effect=fake_check):\n88:             for filename, content in dict(params.get(\"writes\", {})).items():\n89:                 Path(directory, filename).write_text(content, encoding=\"utf-8\")\n90:             remaining = extract_arch.chat_loop(\n91:                 directory, fake_rerun, out_fn=lambda _: None,\n92:                 max_rounds=params[\"max_rounds\"])\n93:         return remaining, calls, directory\n94: \n95:     def snapshot_of(self, directory):\n96:         return Path(directory).parent / f\".chat_snapshot_{Path(directory).name}\"\n97: \n98:     def test_clean_first_round_asks_nothing_reruns_nothing(self):\n99:         remaining, calls, directory = self.loop(flows=[[]])\n100:         self.assertEqual(remaining, 0)\n101:         self.assertEqual(calls[\"rerun\"], [])\n102:         self.assertFalse(self.snapshot_of(directory).exists())\n103: \n104:     def test_improvement_keeps_the_new_state(self):\n105:         remaining, calls, directory = self.loop(\n106:             flows=[[finding(\"uncovered_field\")], []],\n107:             checks=[[]],\n108:             writes={\"marker.txt\": \"before\"})\n109:         self.assertEqual(remaining, 0)\n110:         self.assertEqual(calls[\"rerun\"], [\"interaction_adapters\"])\n111:         self.assertFalse(self.snapshot_of(directory).exists())\n112: \n113:     def test_regression_rolls_back_and_keeps_evidence(self):\n114:         remaining, calls, directory = self.loop(\n115:             flows=[[finding(\"uncovered_field\"), finding(\"missing_flag\")]],\n116:             checks=[[finding(\"uncovered_field\")] * 3],\n117:             writes={\"marker.txt\": \"before\"})\n118:         self.assertEqual(remaining, 2)\n119:         self.assertEqual((Path(directory) / \"marker.txt\").read_text(encoding=\"utf
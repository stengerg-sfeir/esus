                "text": "Read file /Users/gillesstenger/Documents/esus/review_aliases.py, lines 240-356\n240:         + (f\", which must be a {get('entity')}\" if get(\"entity\") else \"\"),\n241:     ]\n242:     for problem in get(\"problem\") or []:\n243:         lines.append(f\"  Problem: {problem}\")\n244:     supplied = get(\"supplied\") or []\n245:     if supplied:\n246:         lines.append(\"  The value arrives via \" + \", \".join(\n247:             f\"flag '{flag}' on '{leaf}'\" for leaf, flag in supplied) + \".\")\n248:     elif get(\"leaves\"):\n249:         lines.append(\"  No bound flag supplies it; flags on \"\n250:                      + \", \".join(f\"'{leaf}'\" for leaf in get(\"leaves\") or [])\n251:                      + \": \" + (\", \".join(f\"'{flag}'\" for flag in get(\"leaf_flags\") or [])\n252:                                 or \"none declared\") + \".\")\n253:     else:\n254:         lines.append(\"  No command reaches this action.\")\n255:     lines.append(f\"  {get('question') or 'What does this value map to?'}\")\n256:     spellings = get(\"spellings\") or {}\n257:     for number, suggestion in enumerate(get(\"suggestions\") or [], start=1):\n258:         shown = spellings.get(suggestion, suggestion)\n259:         lines.append(f\"  {number}) {suggestion}\" + (f\" (as flag '{shown}')\" if shown != suggestion else \"\"))\n260:     if not (get(\"suggestions\") or []) and get(\"entity\"):\n261:         lines.append(f\"  (type the {get('entity')} field it fills, or skip)\")\n262:     elif not (get(\"suggestions\") or []):\n263:         lines.append(\"  (type a flag name, or skip — without a declared flag it stays blocked)\")\n264:     lines.append(f\"  Answering renames the adapter field only; \"\n265:                  f\"parameter '{get('target')}' is untouched.\")\n266:     return lines\n267: \n268: \n269: def ask(question, input_fn=input):\n270:     \"\"\"Pose one pair; return the asserted flag, or None on skip/invalid.\"\"\"\n271:     suggestions = question[\"suggestions\"]\n272:     try:\n273:         answer = input_fn(\"choose a number, type a flag name, or skip: \").strip()\n274:     except (EOFError, KeyboardInterrupt):\n275:         return None\n276:     if answer.lower() in (\"skip\", \"s\", \"\"):\n277:         return None\n278:     if answer.isdigit():\n279:         index = int(answer) - 1\n280:         if 0 <= index < len(suggestions):\n281:             return suggestions[index]\n282:         return None\n283:     cleaned = answer.lstrip(\"-\")\n284:     return cleaned or None\n285: \n286: \n287: def run_review(output_dir, input_fn=input, out_fn=print):\n288:     \"\"\"Ask every open pair; return (asked, answered).\"\"\"\n289:     questions, context = collect_questions(output_dir)\n290:     if not questions:\n291:         out_fn(\"no open field mappings — nothing to decide\")\n292:         return 0, 0\n293:     aliases = load_aliases(output_dir)\n294:     answered = 0\n295:     for number, question in enumerate(questions, start=1):\n296:         for line in describe_question(number, len(questions), question):\n297:             out_fn(line)\n298:         flag = ask(question, input_fn)\n299:         if not flag:\n300:             out_fn(\"skipped — left open\")\n301:             continue\n302:         if flag == question[\"field\"]:\n303:             # Answering the name it already has renames nothing: record\n304:             # nothing, ask nothing again later — the pair stays open.\n305:             out_fn(\"that changes nothing — skipped, left open\")\n306:             continue\n307:         record = {\n308:             \"action\": question[\"action\"],\n309:             \"field\": question[\"field\"],\n310:             \"flag\": flag,\n311:             \"decided_by\": \"user\",\n312:         }\n313:         if context[\"prompt_sha\"] is not None:\n314:             record[\"requirements_sha\"] = context[\"prompt_sha\"]\n315:         aliases.append(record)\n316:         answered += 1\n317:     save_aliases(output_dir, aliases)\n318:     matches_path = os.path.join(output_dir, \"interaction_adapters.json\")\n319:     try:\n320:         with open(matches_path, encoding=\"utf-8\") as handle:\n321:             payload = json.load(handle)\n322:     except (OSError, ValueError) as error:\n323:         out_fn(f\"error: cannot read {matches_path}: {error}\")\n324:         return len(questions), answered\n325:     payload[\"interaction_adapters\"] = apply_aliases(\n326:         payload.get(\"interaction_adapters\"), aliases)\n327:     with open(matches_path, \"w\", encoding=\"utf-8\") as handle:\n328:         json.dump(payload, handle, indent=2, ensure_ascii=False)\n329:         handle.write(\"\\n\")\n330:     out_fn(f\"answered {answered} of {len(questions)}; mappings in field_aliases.json\")\n331:     return len(questions), answered\n332: \n333: \n334: def main(argv=None):\n335:     args = list(sys.argv[1:] if argv is None else argv)\n336:     list_only = \"--list\" in args\n337:     args = [a for a in args if a != \"--list\"]\n338:     if len(args) != 1:\n339:         print(__doc__.splitlines()[0], file=sys.stderr)\n340:         print(\"usage: python review_aliases.py OUT_DIR [--list]\", file=sys.stderr)\n341:         return 2\n342:     if list_only:\n343:         questions, _ = collect_questions(args[0])\n344:         if not questions:\n345:             print(\"no open field mappings — nothing to decide\")\n346:             return 0\n347:         for number, question in enumerate(questions, start=1):\n348:             for line in describe_question(number, len(questions), question):\n349:                 print(line)\n350:         return 0\n351:     asked, _ = run_review(args[0])\n352:     return 0\n353: \n354: \n355: if __name__ == \"__main__\":\n356:     sys.exit(main())"

ion):\n    \"\"\"The lines presenting one tie: text, source, and both sides.\"\"\"'''\nassert old in t\nnew = '''def suggest_model_fields(model_fields, entity, field):\n    \"\"\"Target-entity model fields containing the name, sorted, deterministic.\n\n    Offered only when no leaf flag resembles the field: answering one of\n    these renames the value into a real model field, which is what\n    unblocks construction.\n    \"\"\"\n    from kernel.consistency.naming import normalize\n\n    wanted = normalize(field or \"\")\n    names = model_fields.get(entity or \"\", []) if isinstance(model_fields, dict) else []\n    matches = sorted({n for n in names if n and wanted\n                      and (normalize(n) in wanted or wanted in normalize(n))})\n    return matches\n\n\ndef describe_question(index, total, question):\n    \"\"\"The lines presenting one tie: text, source, and both sides.\"\"\"'''\nt = t.replace(old, new, 1)\n\nold = '''    for number, suggestion in enumerate(question[\"suggestions\"], start=1):\n        lines.append(f\"{number}) {suggestion}\")\n    return lines'''\nassert old in t\nnew = '''    for number, suggestion in enumerate(question[\"suggestions\"], start=1):\n        lines.append(f\"{number}) {suggestion}\")\n    if not question[\"suggestions\"] and question[\"entity\"]:\n        lines.append(f\"(no flag resembles '{question['field']}': type the \"\n                     f\"{question['entity']} field it fills, or skip)\")\n    return lines'''\nt = t.replace(old, new, 1)\n\nold = '''    if answer.lower() in (\"skip\", \"s\", \"\"):\n        return None'''\nassert old in t\nnew = '''    if answer.lower() in (\"skip\", \"s\", \"\"):\n        return None\n    if entry_says_nothing := False:\n        return None'''\nt = t.replace(old, new, 1)\np.write_text(t)\nprint('wired (ask guard next)')\nPYEOF\necho \"--- now fixing the ask guard properly\""

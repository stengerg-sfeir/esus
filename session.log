80:             continue\n181:         if isinstance(values, (list, tuple)):\n182:             return [str(value) for value in values]\n183:     return []\n184: \n185: \n186: def _date_fields(ctx, entity, exclude=None):\n187:     rows = []\n188:     for class_name, field_name, field_type, field in _fields(ctx):\n189:         if class_name != entity or field_name == exclude:\n190:             continue\n191:         if field_type in DATE_TYPES or (\n192:                 field_type in (\"str\", \"string\")\n193:                 and any(hint in normalize(field_name)\n194:                         for hint in DATE_NAME_HINTS)):\n195:             rows.append((class_name, field_name))\n196:     return rows\n197: \n198: \n199: def _value_choices(ctx, entity, field_name):\n200:     \"\"\"`[(label, value)]` for a set effect, from facts, not a name guess.\"\"\"\n201:     fields = [(cls, name, ftype, field)\n202:               for cls, name, ftype, field in _fields(ctx)\n203:               if cls == entity and name == field_name]\n204:     field_type = fields[0][2] if fields else \"\"\n205:     choices = []\n206:     if field_type in DATE_TYPES or any(hint in normalize(field_name)\n207:                                       for hint in DATE_NAME_HINTS):\n208:         choices.append((\"now\", \"now\"))\n209:         for cls, other in _date_fields(ctx, entity, exclude=field_name):\n210:             choices.append((f\"{cls.lower()}.{other}\", f\"{cls.lower()}.{other}\"))\n211:     elif field_type in BOOL_TYPES:\n212:         choices += [(f\"not {field_name}\", f\"not {field_name}\"),\n213:                     (\"True\", True), (\"False\", False)]\n214:     else:\n215:         for value in _invariant_values(ctx, entity, field_name):\n216:             choices.append((value, value))\n217:     return choices\n218: \n219: \n220: def _effect_questions(ctx, index, effect, params):\n221:     target = effect[\"target\"]\n222:     variable, field_name = target.split(\".\", 1)\n223:     entity = next((name for name in ctx.get(\"entity_names\") or []\n224:                    if name.lower() == variable), variable.capitalize())\n225:     choices = []\n226:     prompt = \"\"\n227:     if effect[\"op\"] in (\"increment\", \"decrement\"):\n228:         prompt = (f\"By how much should `{target}` \"\n229:                   f\"{effect['op']}?\")\n230:         choices = [(\"1\", \"1\")]\n231:         choices += [(name, name) for name in params]\n232:     else:\n233:         prompt = f\"What value should `{target}` be set to?\"\n234:         choices = _value_choices(ctx, entity, field_name)\n235:         choices += [(name, name) for name in params]\n236:     # Deduplicate while preserving order.\n237:     seen, unique = set(), []\n238:     for label, value in choices:\n239:         key = (label, repr(value))\n240:         if key not in seen:\n241:             seen.add(key)\n242:             unique.append((label, value))\n243:     if not unique:\n244:         return {\n245:             \"id\": f\"effect:{index}\", \"kind\": \"text\", \"required\": True,\n246:             \"prompt\": prompt,\n247:             \"apply\": \"value\" if effect[\"op\"] == \"set\" else \"by\",\n248:         }\n249:     return {\n250:         \"id\": f\"effect:{index}\", \"kind\": \"choice\", \"required\": True,\n251:         \"prompt\": prompt, \"choices\": unique,\n252:         \"apply\": \"value\" if effect[\"op\"] == \"set\" else \"by\",\n253:     }\n254: \n255: \n256: def _obvious_preconditions(ctx, raises, fields, method):\n257:     \"\"\"Preconditions the declared errors imply, plus the open ones.\n258: \n259:     `NotFound` means the named entity exists; `InsufficientCopies` means the\n260:     copies field is positive; `InvalidStockQty` means a `qty` parameter is\n261:     positive. Everything else is an open human question because its name\n262:     does not settle the condition.\n263:     \"\"\"\n264:     obvious, open_errors = [], []\n265:     params = set(_params(method))\n266:     for error in raises or []:\n267:         name = str(error).rsplit(\".\", 1)[-1]\n268:         match = re.match(r\"(\\w+?)NotFoundError$\", name)\n269:         if match:\n270:             entity = match.group(1)\n271:             obvious.append({\"check\": f\"{entity.lower()} exists\",\n272:                             \"error\": name})\n273:             continue\n274:         if \"InsufficientCopies\" in name:\n275:             copies = [row for row in fields\n276:                       if \"copies\" in normalize(row[1])\n277:                       or \"stock\" in normalize(row[1])\n278:                       or \"quantity\" in normalize(row[1])]\n279:             if copies:\n280:                 entity, field_name = copies[0][0], copies[0][1]\n281:                 obvious.append({\n282:                     \"check\": f\"{entity.lower()}.{field_name} > 0\",\n283:                     \"error\": name,\n284:                 })\n285:                 continue\n286:         if \"InvalidStockQty\" in name and \"qty\" in params:\n287:             obvious.append({\"check\": \"qty > 0\", \"error\": name})\n288:             continue\n289:         open_errors.append(name)\n290:     return obvious, open_errors\n291: \n292: \n293: def _propose(ctx, holder, method, role, requirement):\n294:     \"\"\"One proposal from the method's description/requirement, or None.\"\"\"\n295:     description = method.get(\"description\") or \"\"\n296:     text = \" \".join(part for part in (description, requirement) if part)\n297:     fields = _fields(ctx)\n298:     params = _params(method)\n299:     effects, creates = [], []\n300:     seen_effects, seen_creates = set(), set()\n301: \n302:     def add_effect(entity, field_name, op, write):\n303:         key = (f\"{entity.lower()}.{field_name}\", op)\n304:         if key in seen_effects:\n305:             return\n306:         seen_effects.add(key)\n307:         item = {\"target\": f\"{entity.lower()}.{field_name}\", \"op\": op}\n308:        
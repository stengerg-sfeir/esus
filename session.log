              "content": "\"\"\"Apply the three proposed hand fixes to a copy of the run-4 tree and\nre-smoke: search must find authors without crashing, borrow must return\nthe created loan, return must persist the loan, guard double returns and\nadd exactly one copy back.\"\"\"\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\n\nSRC = \"/tmp/esus_llm_check2/library4\"\nDST = \"/tmp/esus_llm_check2/library4_fixed\"\nshutil.rmtree(DST, ignore_errors=True)\nshutil.copytree(SRC, DST)\nfor name in os.listdir(DST):\n    if name.endswith(\".db\"):\n        os.remove(os.path.join(DST, name))\nshutil.rmtree(os.path.join(DST, \"__pycache__\"), ignore_errors=True)\n\nSEARCH = '''    def search_books_by_title_author_isbn(self, query: str = None) -> List[models.Book]:\n        \"\"\"Searches books by title, ISBN or author name.\"\"\"\n        needle = (query or \"\").lower()\n        authors = {author.get(\"id\"): (author.get(\"name\") or \"\").lower()\n                   for author in self._store.all(\"Author\")}\n        found = []\n        for record in self._store.all(self.ENTITY):\n            text = f\"{record.get('title') or ''} {record.get('isbn') or ''}\"\n            if needle in text.lower() or needle in authors.get(record.get(\"author_id\"), \"\"):\n                found.append(models.Book(**record))\n        return found'''\n\nRETURN = '''    def return_book(self, loan_id: int = None) -> models.Loan:\n        \"\"\"Marks the loan returned and puts the copy back on the shelf.\"\"\"\n        loan = self._repos['LoanRepository'].read_one_loan(loan_id)\n        if loan.return_date is not None:\n            raise errors.InvalidReturnDateError(\"Book already returned\")\n        book = self._repos['BookRepository'].read_one_book(loan.book_id)\n        loan.return_date = datetime.datetime.now()\n        loan.status = \"returned\"\n        updated_loan = self._repos['LoanRepository'].update_loan(loan_id, loan)\n        book.available_copies = (book.available_copies or 0) + 1\n        self._repos['BookRepository'].update_book(book.id, book)\n        return updated_loan'''\n\nBORROW = '''    def borrow_book(self, member_id: int = None, book_id: int = None) -> models.Loan:\n        \"\"\"Checks a copy is on the shelf, creates the loan, takes the copy.\"\"\"\n        member = self._repos['MemberRepository'].read_one_member(member_id)\n        book = self._repos['BookRepository'].read_one_book(book_id)\n        if (book.available_copies or 0) <= 0:\n            raise errors.InsufficientCopiesError(\"No available copies of this book\")\n        loan = models.Loan(\n            book_id=book.id,\n            member_id=member.id,\n            loan_date=datetime.datetime.now(),\n            due_date=datetime.datetime.now() + datetime.timedelta(days=14),  # loan period: not stated by the prompt\n            status=\"active\",\n        )\n        created = self._repos['LoanRepository'].create_loan(loan)\n        book.available_copies = (book.available_copies or 0) - 1\n        self._repos['BookRepository'].update_book(book.id, book)\n        return created'''\n\n\ndef replace_method(text, name, block):\n    start = text.index(f\"    def {name}(\")\n    rest = text[start:]\n    stop = re.search(r\"\\n(?=    def |class |\\Z)\", rest)\n    end = start + (stop.start() if stop else len(rest))\n    return text[:start] + block + text[end:]\n\n\nrepos_path = os.path.join(DST, \"repositories.py\")\nwith open(repos_path, encoding=\"utf-8\") as handle:\n    text = handle.read()\nwith open(repos_path, \"w\", encoding=\"utf-8\") as handle:\n    handle.write(replace_method(text, \"search_books_by_title_author_isbn\",\n                                SEARCH))\n\nservices_path = os.path.join(DST, \"services.py\")\nwith open(services_path, encoding=\"utf-8\") as handle:\n    text = handle.read()\ntext = replace_method(text, \"return_book\", RETURN)\ntext = replace_method(text, \"borrow_book\", BORROW)\nwith open(services_path, \"w\", encoding=\"utf-8\") as handle:\n    handle.write(text)\nmodule = shutil.which(\"python3.12\") or \"python3\"\nsubprocess.run([module, \"-c\", \"import py_compile; py_compile.compile(r'%s', doraise=True); py_compile.compile(r'%s', doraise=True)\" % (repos_path, services_path)], check=True)\nprint(\"patched and compiling\")\n\nSEED = '''\nimport sys\nsys.path.insert(0, \".\")\nimport store as store_mod\ns = store_mod.Store(\"lab.db\")\ns.add(\"Author\", \"id\", {\"name\": \"Ursula Le Guin\", \"birth_year\": 1929})\ns.add(\"Book\", \"id\", {\"title\": \"A Wizard of Earthsea\", \"isbn\": \"978-0\",\n                     \"author_id\": 1, \"published_year\": 1968,\n                     \"available_copies\": 1})\ns.add(\"Book\", \"id\", {\"title\": \"The Dispossessed\", \"isbn\": \"978-1\",\n                     \"author_id\": 1, \"published_year\": 1974,\n                     \"available_copies\": 1})\ns.add(\"Member\", \"id\", {\"name\": \"Ada\", \"email\": \"ada@example.com\",\n                       \"membership_date\": \"2026-01-15\", \"is_active\": True})\ns.close()\nprint(\"seeded\")\n'''\n\nREAD = '''\nimport sqlite3\ndb = sqlite3.connect(\"lab.db\")\nfor entity in (\"Loan\", \"Book\"):\n    for key, doc in db.execute(\n            \"SELECT key, doc FROM records WHERE entity = ? ORDER BY key\",\n            (entity,)):\n        print(f\"{entity} {key}: {doc}\")\n'''\n\n\ndef run(cmd):\n    print(\"\\n$\", \" \".join(cmd))\n    proc = subprocess.run(cmd, cwd=DST, capture_output=True, text=True)\n    output = (proc.stdout + proc.stderr).strip()\n    print(output if output else \"(no output)\")\n    print(\"exit:\", proc.returncode)\n\n\nC = [module, \"cli.py\", \"--db\", \"lab.db\"]\n\nrun([module, \"-c\", SEED])\nrun(C + [\"book\", \"search\", \"-query\", \"earthsea\"])\nrun(C + [\"book\", \"search\", \"-query\", \"dispossessed\"])\nrun(C + [\"book\", \"search\", \"-query\", \"le guin\"])\nrun(C + [\"borrow\", \"--member-id\", \"1\", \"--book-id\", \"1\"])\nrun(C + [\"borrow\", \"--member-id\", \"1\", \"--book-id\", \"1\"])\nrun(C + [\"return\", \"--loan-id\", \"1\"])\nrun([module, \"-c\", READ])\nrun(C + [\"return\", \"--loan-id\", \"1\"])\nrun(C + [\"overdue\"])\nrun(C + [\"member\", \"history\", \"--member-id\", \"1\"])\n",
              "path": "/tmp/esus_llm_check2/drive_library4_fixed.py"

              "content": "\"\"\"Show the fence structure of each Qwen raw answer and compile its blocks.\n\nThe prompt ends inside an open ```python fence, so the *first* fence line in\na completion closes it.  Parse with that starting state and list what the\nmodel actually fenced, then compile each fenced block as a body.\n\"\"\"\nimport json\nimport re\nimport textwrap\n\nPATH = \"/tmp/opencode/qwen4b_llm_stub_answers.json\"\nrows = json.load(open(PATH, encoding=\"utf-8\"))\n\n\ndef regions(text):\n    \"\"\"[(opened_by_answer, info, lines)] with state starting inside a fence.\"\"\"\n    out = []\n    inside = True\n    info = \"prompt\"\n    current = []\n    for line in text.splitlines():\n        match = re.match(r\"^\\s*```([A-Za-z0-9_+.-]*)\\s*$\", line)\n        if match:\n            out.append((info != \"prompt\", info, current))\n            inside = not inside\n            if inside:\n                info = match.group(1) or \"\"\n                current = []\n            continue\n        if inside:\n            current.append(line)\n    if inside:\n        out.append((info != \"prompt\", info, current))\n    return out\n\n\ndef compiles(lines):\n    \"\"\"(ok, error) for a fenced block as one method body.\"\"\"\n    text = textwrap.dedent(\"\\n\".join(lines)).strip(\"\\n\")\n    if not text.strip():\n        return False, \"empty\"\n    source = (\"def _wrapped(self, *args, **kwargs):\\n\"\n              + \"\\n\".join((\"    \" + line if line.strip() else \"\")\n                          for line in text.splitlines()))\n    try:\n        compile(source, \"<block>\", \"exec\")\n        return True, \"\"\n    except SyntaxError as error:\n        return False, f\"{error.msg} (line {error.lineno})\"\n\n\nlines_out = []\nfor row in rows:\n    lines_out.append(\"=\" * 78)\n    lines_out.append(f\"LABEL: {row['label']}\")\n    for key in (\"first_answer\", \"answer\"):\n        raw = row.get(key)\n        if raw is None:\n            continue\n        lines_out.append(f\"--- {key}: {len(raw)} chars, \"\n                         f\"{len(raw.splitlines())} lines\")\n        tail = raw.splitlines()[-10:]\n        lines_out.append(\"    tail:\")\n        for line in tail:\n            lines_out.append(f\"      | {line}\")\n        blocks = regions(raw)\n        for index, (by_answer, info, block) in enumerate(blocks):\n            text = \"\\n\".join(block).strip(\"\\n\")\n            first = next((line for line in block if line.strip()), \"\")\n            ok, error = compiles(block) if text.strip() else (False, \"empty\")\n            kind = \"ANSWER\" if by_answer else \"prompt\"\n            lines_out.append(\n                f\"    block {index}: opened by {kind}\"\n                f\" (info={info!r}), {len(block)} lines, \"\n                f\"{'compiles' if ok else 'does not compile: ' + error}\")\n            lines_out.append(f\"      first: {first[:100]}\")\n            if not by_answer and text.strip():\n                lines_out.append(\"      [continuation before the first fence]\")\n        # candidate: first non-empty answer-opened block that compiles,\n        # else the first compiling answer-opened block,\n        # else the first non-empty prompt region\n        candidates = [(by, info, block) for by, info, block in blocks\n                      if by and \"\\n\".join(block).strip()]\n        pick = None\n        for by, info, block in candidates:\n            if compiles(block)[0]:\n                pick = (by, info, block)\n                break\n        if pick is None and candidates:\n            pick = candidates[0]\n        if pick is None:\n            prompts = [(by, info, block) for by, info, block in blocks\n                       if not by and \"\\n\".join(block).strip()]\n            pick = prompts[0] if prompts else None\n        if pick is not None:\n            body = textwrap.dedent(\"\\n\".join(pick[2])).strip(\"\\n\")\n            lines_out.append(\"    PICK (dedented):\")\n            
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/pipeline.py, lines 1-412\n1: \"\"\"The extraction steps, run in order and chained.\n2: \n3: Each step receives the names its predecessors actually produced, both in the\n4: prompt (as an authoritative list) and in its grammar (as the only writable\n5: strings). Steps whose predecessor produced nothing usable fall back to the\n6: unconstrained grammar and say so in the log, so a degraded run is visible\n7: rather than silent.\n8: \"\"\"\n9: \n10: import json\n11: import sys\n12: \n13: from kernel.extraction import (\n14:     classification,\n15:     dedupe,\n16:     grammar_builders,\n17:     grammar_check,\n18:     grammar_open,\n19:     grammar_persistence,\n20:     interfaces,\n21:     prompts,\n22:     repairs,\n23:     return_types,\n24:     runner,\n25:     vocabulary,\n26: )\n27: \n28: # A second attempt at a higher temperature, used only when a step returns\n29: # something JSON rejects.\n30: RETRY_TEMPERATURE = 0.35\n31: \n32: # Document keys, which are also the top-level JSON keys the checker reads.\n33: INTENTIONS = \"intentions\"\n34: DATA_MODELS = \"data_models\"\n35: ERRORS = \"errors\"\n36: INVARIANTS = \"invariants\"\n37: COMPONENTS = \"components\"\n38: SERVICE_CONTRACTS = \"service_contracts\"\n39: PATTERN_MATCHES = \"pattern_matches\"\n40: INTERACTION_ADAPTERS = \"interaction_adapters\"\n41: PERSISTENCE_PORTS = \"persistence_ports\"\n42: \n43: \n44: class Pipeline:\n45:     \"\"\"Runs steps A–H over one set of requirements.\"\"\"\n46: \n47:     def __init__(self, llm, classifier=None, log=None, classifier_factory=None):\n48:         self.llm = llm\n49:         # The classifier is a second `Llama` instance whose context is built with\n50:         # `logits_all=True`, which step F's `logprobs` needs and every other step\n51:         # would only pay for. It is therefore loaded on first use rather than at\n52:         # startup — a program with no domain classifies nothing, and should not\n53:         # load a second model to find that out. `classifier_factory` is that\n54:         # deferred loader (see `extract_archi.py`); `classifier` stays accepted\n55:         # for an already-built instance and in tests.\n56:         self.classifier = classifier\n57:         self.classifier_factory = classifier_factory\n58:         self.log = log\n59:         self.documents = {}\n60:         self.results = []\n61: \n62:     def run(self, requirements):\n63:         # Kept so the post-contract error repair can consult the requirements — the\n64:         # only authority on whether a declared-but-unraised error belongs.\n65:         self.requirements = requirements\n66:         self._step_intentions(requirements)\n67:         self._step_data_models(requirements)\n68:         self._step_errors(requirements)\n69:         self._step_invariants(requirements)\n70:         self._step_components(requirements)\n71:         self._step_contracts(requirements)\n72:         self._repair_errors()\n73:         self._step_patterns()\n74:         self._step_adapters(requirements)\n75:         self._step_persistence(requirements)\n76:         return self.documents\n77: \n78:     def _generate(self, key, prompt, grammar_text, temperature=0.1):\n79:         \"\"\"Validate the grammar, generate, and store the document under `key`.\n80: \n81:         One unusable document used to cost the whole run: library's missing\n82:         components.json and every downstream warning came from a single\n83:         malformed step. A grammar-constrained step fails only when the model\n84:         writes something the grammar permits but JSON rejects, so one retry at a\n85:         higher temperature recovers it cheaply.\n86:         \"\"\"\n87:         grammar_check.assert_valid(grammar_text, label=f\"step {key}\")\n88: \n89:         body = None\n90:         # The ceiling the retry runs under. It starts as None, meaning the\n91:         # first-attempt ceiling of `MAX_NEW_TOKENS`.\n92:         retry_budget = None\n93:         for attempt, attempt_temperature in enumerate((temperature, RETRY_TEMPERATURE)):\n94:             result = runner.generate(\n95:                 self.llm, prompt, grammar_text, key,\n96:                 temperature=attempt_temperature,\n97:                 max_new_tokens=retry_budget,\n98:             )\n99:             self.results.append(result)\n100:             self.log.write(result.describe())\n101: \n102:             body = _parse_document(result.text, key)\n103:             # A truncated document is retried even when it parsed. It can parse and\n104:             # still be incomplete — the ceiling can fall exactly on a valid list\n105:             # boundary — and accepting that silently is the one outcome this must\n106:             # not produce, because a short document is indistinguishable from a\n107:             # complete one downstream. Only an untruncated, parseable document ends\n108:             # the loop.\n109:             if body is not None and not result.truncated:\n110:                 break\n111:             if attempt == 0:\n112:                 if result.truncated:\n113:                     # Retrying a truncation under the ceiling that caused it can\n114:                     # only truncate again — that is what happened to expenses'\n115:                     # adapters, which hit `MAX_NEW_TOKENS` twice while the context\n116:                     # still held room for thousands more tokens. So the retry gets\n117:                     # the whole room the prompt left behind.\n118:                     retry_budget = runner.available_tokens(self.llm, prompt)\n119:                     if retry_budget <= (result.budget or 0):\n120:                         self.log.write(\n121:                             f\"[!] step {key}: the context has no room left to raise the \"\n122:                             f\"{result.budget}-token ceiling — retrying at the same ceiling\"\n123:                         )\n124:                     reason = (\n125:                         f\"hit the {result.budget}-token ceiling — its document may be \"\n126:                         f\"incomplete, retrying with a {retry_budget}-token ceiling\"\n127:                     )\n128:                 else:\n129:                     reason = \"produced unusable JSON\"\n130:                 self.log.write(f\"[!] step {key} {reason} — retrying once\")\n131: \n132:         if body is not None and result.truncated:\n133:             self.log.write(\n134:                 f\"[!] step {key} is still truncated after the retry — \"\n135:                 f\"the document written is incomplete\"\n136:             )\n137: \n138:         if body is None:\n139:             self.log.write(f\"[!] step {key} produced unusable JSON — dependent steps degrade\")\n140:             return None\n141: \n142:         # A repeated name cannot be prevented by the grammar (distinctness over\n143:         # free text is not a regular property) and must not be prevented by a\n144:         # length cap either, which would truncate a legitimate long list. So the\n145:         # exact repeat is removed here, keeping the first occurrence untouched.\n146:         body, removed = dedupe.deduplicate(key, body)\n147:         if removed:\n148:             self.log.write(f\"[ok] step {key}: removed {removed} exactly repeated name(s)\")\n149: \n150:         self.documents[key] = body\n151:         return body\n152: \n153:     def _entities(self):\n154:         return vocabulary.entities_from(self.documents.get(DATA_MODELS))\n155: \n156:     def _services(self):\n157:         return vocabulary.services_from(self.documents.get(SERVICE_CONTRACTS))\n158: \n159:     def _step_intentions(self, requirements):\n160:         self._generate(\n161:             INTENTIONS,\n162:             prompts.intentions(requirements),\n163:             grammar_open.phrase_list(INTENTIONS),\n164:         )\n165: \n166:     def _step_data_models(self, requirements):\n167:         \"\"\"Step B: the one step nothing constrains, so it is shown A's phrases.\n168: \n169:         Every other step's grammar is generated from the names an earlier step\n170:         produced, so it *cannot* invent one. A emits prose, which cannot become a\n171:         vocabulary — so B ran on the raw requirements with an open grammar, and\n172:         for a program that models nothing it filled the required shape from\n173:         priors (cli_tool got `users, products, orders, order_items`).\n174: \n175:         Showing it A's phrases is grounding rather than constraint: it supplies\n176:         the program's own words and leaves no vacuum for priors to fill. It is\n177:         deliberately the **only** thing added here — the empty answer is already\n178:         permitted by both the prompt and the grammar, and cli_tool took neither,\n179:         so more permission cannot be the fix. See `prompts.intentions_block`.\n180:         \"\"\"\n181:         grounding = prompts.intentions_block(self.documents.get(INTENTIONS))\n182:         if grounding is None:\n183:             self.log.write(\n184:                 \"[!] step data_models: step A produced no usable phrases — running ungrounded\"\n185:             )\n186:         self._generate(\n187:             DATA_MODELS,\n188:             prompts.data_models(requirements, grounding),\n189:             grammar_open.data_models(),\n190:         )\n191: \n192:     def _step_errors(self, requirements):\n193:         \"\"\"Step E': the application error types, before the services that raise them.\n194: \n195:         Placed after step B so a type named for an entity is spelled with that\n196:         entity's own name, and before step E because a contract method names the\n197:         errors it may raise — the registry has to exist first for the reference to\n198:         mean anything. This is the one thing the requirements name that had\n199:         nowhere to go: inventory asks for 
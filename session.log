                "text": "Read file /home/gstenger/Documents/esus/kernel/extraction/runner.py, lines 1-260\n1: \"\"\"Model loading and one-step generation.\n2: \n3: This is the only module in the package that imports llama_cpp.\n4: \n5: Two things it does that the previous extractor did not: it computes the token\n6: budget from the space actually left in the context instead of hardcoding 4096,\n7: and it reads `finish_reason` so a truncated step is reported rather than saved\n8: as if it were complete.\n9: \"\"\"\n10: \n11: import sys\n12: import time\n13: \n14: from llama_cpp import Llama, LlamaGrammar\n15: \n16: try:  # the fd-level redirect the wrapper itself uses for backend init\n17:     from llama_cpp._utils import suppress_stdout_stderr\n18: except ImportError:  # pragma: no cover - very old bindings lack the helper\n19:     import contextlib\n20: \n21:     def suppress_stdout_stderr(disable=True):\n22:         return contextlib.nullcontext()\n23: \n24: try:  # llama-cpp-python < 0.2.x has no GPU offload probe\n25:     from llama_cpp import llama_supports_gpu_offload\n26: except ImportError:\n27:     llama_supports_gpu_offload = None\n28: \n29: GPU_LAYERS_ALL = -1\n30: GPU_LAYERS_NONE = 0\n31: \n32: # Thread counts are a CPU-backend tuning knob: llama.cpp picks the physical core\n33: # count itself when they are omitted, which beats a fixed number on both a small\n34: # laptop and a large workstation. They are therefore set only off macOS, where\n35: # the CPU backend does the work and an explicit count keeps it predictable —\n36: # on macOS Metal does the work and the setting is mostly moot.\n37: CPU_THREADS = 8\n38: \n39: # Novel-token ceiling for the *first* attempt at a step. The context is 8192 and\n40: # the prompts are a few hundred tokens, so this is rarely the binding\n41: # constraint; the room left in the context is. It exists to stop an\n42: # unconstrained generation from filling the whole context, and it is deliberately\n43: # not the last word: a step that hits it is retried with the full room left in\n44: # the context instead, because a ceiling that truncated an attempt cannot also be\n45: # the ceiling the retry runs under — see `generation_budget` and the retry in\n46: # `pipeline._generate`.\n47: MAX_NEW_TOKENS = 3584\n48: # The floor a budget is never allowed to fall below, so even a long prompt\n49: # leaves room for the shortest possible document.\n50: MIN_BUDGET = 16\n51: CONTEXT_RESERVE = 64\n52: \n53: # Flash attention, measured rather than assumed. This stack (Metal, Ministral-3\n54: # 3B Q4_K_M) renders decode 22.1 -> 25.3 tok/s and a whole document 24.8 -> 28.0\n55: # tok/s (+13-15%) with it on, and the effect on the output was measured too,\n56: # because the setting is commonly believed to cost quality:\n57: #\n58: #   - 118 real classification items across five prompts: **118/118 identical\n59: #     verdicts**, confidence drifting by a median of 0.0004 (max 0.0034);\n60: #   - one whole document generated at temperature 0: **byte-identical**, 7694\n61: #     characters either way;\n62: #   - the runner-up ordering differed on 2 of 118 items, which can move a\n63: #     `narrow_margin` note but never a verdict.\n64: #\n65: # `n_batch`/`n_ubatch` were measured in the same pass and are deliberately left\n66: # at their defaults: they changed nothing (prompts are ~1 100 tokens, so the\n67: # default 512 already chunks them and prefill is fixed-cost dominated, 4.2 s\n68: # flat across 512-4096). Raise `n_batch` only if a prompt ever exceeds 512\n69: # tokens by enough for the chunking to matter.\n70: FLASH_ATTENTION = True\n71: \n72: TRUNCATED = \"length\"\n73: \n74: \n75: def resolve_gpu_layers():\n76:     \"\"\"Offload every layer on Metal, otherwise stay on CPU.\"\"\"\n77:     if sys.platform != \"darwin\":\n78:         return GPU_LAYERS_NONE\n79:     if llama_supports_gpu_offload is None or not llama_supports_gpu_offload():\n80:         return GPU_LAYERS_NONE\n81:     return GPU_LAYERS_ALL\n82: \n83: \n84: def threading_parameters():\n85:     \"\"\"Explicit thread counts, or no keys at all to let llama.cpp choose.\n86: \n87:     Returning an empty dict — rather than keys set to None — matters, because\n88:     llama-cpp-python forwards these straight through to llama.cpp, which is\n89:     not expecting a None thread count.\n90:     \"\"\"\n91:     if sys.platform == \"darwin\":\n92:         return {}\n93:     return {\"n_threads\": CPU_THREADS, \"n_threads_batch\": CPU_THREADS}\n94: \n95: \n96: def load_model(model_path, context_size=8192, logits_all=False, quiet=False):\n97:     \"\"\"Load the GGUF model with the settings every step shares.\"\"\"\n98:     started = time.time()\n99:     if quiet:\n100:         # `verbose=False` silences the wrapper's own logs, but two things\n101:         # write to the fds straight from the C layer, bypassing that flag:\n102:         # the offload probe (`resolve_gpu_layers` initialises the Metal\n103:         # backend — device discovery and shader compile banners) and the\n104:         # model load itself. Both are redirected to devnull for the\n105:         # construction only — generation itself is silent, and any failure\n106:         # still raises as an exception.\n107:         with suppress_stdout_stderr(disable=False):\n108:             llm = _construct(model_path, context_size, logits_all)\n109:     else:\n110:         device = \"CPU\" if resolve_gpu_layers() == GPU_LAYERS_NONE else \"Metal\"\n111:         threads = threading_parameters().get(\"n_threads\", \"auto\")\n112:         print(\n113:             f\"[model] {model_path} on {device}, n_ctx={context_size}, \"\n114:             f\"n_threads={threads}, logits_all={logits_all}, \"\n115:             f\"flash_attn={FLASH_ATTENTION}\",\n116:             file=sys.stderr,\n117:         )\n118:         llm = _construct(model_path, context_size, logits_all)\n119:         print(f\"[model] loaded in {time.time() - started:.1f}s\", file=sys.stderr)\n120:     return llm\n121: \n122: \n123: def _construct(model_path, context_size, logits_all):\n124:     \"\"\"Build the `Llama` instance; callers handle noise and announcements.\"\"\"\n125:     return Llama(\n126:         model_path=model_path,\n127:         n_ctx=context_size,\n128:         **threading_parameters(),\n129:         n_gpu_layers=resolve_gpu_layers(),\n130:         flash_attn=FLASH_ATTENTION,\n131:         logits_all=logits_all,\n132:         verbose=False,\n133:     )\n134: \n135: \n136: class StepResult:\n137:     \"\"\"The outcome of one constrained generation.\"\"\"\n138: \n139:     def __init__(self, label, text, tokens, seconds, finish_reason, budget=None):\n140:         self.label = label\n141:         self.text = text\n142:         self.tokens = tokens\n143:         self.seconds = seconds\n144:         self.finish_reason = finish_reason\n145:         self.budget = budget\n146: \n147:     @property\n148:     def truncated(self):\n149:         \"\"\"True when the model ran out of budget rather than finishing.\"\"\"\n150:         return self.finish_reason == TRUNCATED\n151: \n152:     def describe(self):\n153:         speed = self.tokens / self.seconds if self.seconds else 0.0\n154:         # The ceiling is named on a truncation, because the ceiling is the\n155:         # diagnosis: it is what the retry has to raise.\n156:         note = f\" TRUNCATED at the {self.budget}-token ceiling\" if self.truncated else \"\"\n157:         return (\n158:             f\"[{self.label}] {self.tokens} tokens in {self.seconds:.1f}s \"\n159:             f\"({speed:.1f} tok/s){note}\"\n160:         )\n161: \n162: \n163: def token_count(llm, text):\n164:     \"\"\"Tokens consumed by `text` as a prompt.\"\"\"\n165:     return len(llm.tokenize(text.encode(\"utf-8\")))\n166: \n167: \n168: def available_tokens(llm, prompt):\n169:     \"\"\"How many tokens the context can still hold as a response to `prompt`.\n170: \n171:     This is the real ceiling: the room the prompt left behind. `MAX_NEW_TOKENS`\n172:     is only a guard against filling the whole context on the first attempt.\n173:     \"\"\"\n174:     if llm is None or not prompt or llm.n_ctx() <= 0:\n175:         return MAX_NEW_TOKENS\n176:     return max(MIN_BUDGET, llm.n_ctx() - token_count(llm, prompt) - CONTEXT_RESERVE)\n177: \n178: \n179: def generation_budget(llm, prompt, max_new_tokens=None):\n180:     \"\"\"The response ceiling: the one asked for, clamped to the room available.\n181: \n182:     The retry after a truncation passes `max_new_tokens=available_tokens(...)`,\n183:     which is how a step that hit `MAX_NEW_TOKENS` gets the rest of the context\n184:     on the second attempt instead of the same ceiling that cut it off.\n185:     \"\"\"\n186:     ceiling = MAX_NEW_TOKENS if max_new_tokens is None else max_new_tokens\n187:     return max(MIN_BUDGET, min(ceiling, available_tokens(llm, prompt)))\n188: \n189: \n190: def generate(llm, prompt, grammar_text, label, temperature=0.0, max_new_tokens=None, seed=None):\n191:     \"\"\"Generate one document under `grammar_text`, honouring the context budget.\n192: \n193:     The call is **not** streamed. Streaming yields one chunk per token and\n194:     rebuilds a response dict for each, which is pure Python overhead on top of\n195:     the sampler that already runs per token — it buys nothing here, because the\n196:     document is only ever parsed once the whole step has finished. A single\n197:     non-streaming call returns the same text in one dict, and its `usage` gives\n198:     the exact completion-token count instead of the one-per-chunk estimate the\n199:     stream forced.\n200: \n201:     The caller is responsible for having validated `grammar_text` first: this\n202:     function assumes it is well formed and would otherwise fail on the first\n203:     token rather than up front.\n204: \n205:     `max_new_tokens` overrides the first-attempt ceiling of `MAX_NEW_TOKENS`,\n206:     still clamped to the room the prompt left in the context. The retry after a\n207:     truncation uses it to ask for that whole room.\n208: \n209:     The grammar is required, not optional. An experiment with no GBNF mask at\n210:     all (§9.31) settled it: the raw model fences its JSON, appends prose and\n211:     code, renames the document's own keys and loses whole steps, so the mask is\n212:     what makes the output machine-readable at all — not a vocabulary guard on\n213:     top of otherwise-good JSON. There is deliberately no switch to turn it off.\n214:     \"\"\"\n215:     grammar = LlamaGrammar.from_string(grammar_text)\n216:     return _generate_impl(llm, prompt, grammar, label, temperature,\n217:                           max_new_tokens, seed)\n218: \n219: \n220: def generate_free(llm, prompt, label, temperature=0.0, max_new_tokens=None, seed=None):\n221:     \"\"\"Generate free text (no grammar mask), returning a `StepResult`.\n222: \n223:     The one unmasked call in the project: the generator's degenerate fallback,\n224:     where the documents are clean but empty (no models, services or commands)\n225:     and the requirements describe a whole tiny program. A mask would only be\n226:     able to say \"any text\", so none is used — and the output is verified by\n227:     running it, the only check that means anything there.\n228:     \"\"\"\n229:     return _generate_impl(llm, prompt, None, label, temperature,\n230:                           max_new_tokens, seed)\n231: \n232: \n233: def _generate_impl(llm, prompt, grammar, label, temperature, max_new_tokens, seed):\n234:     \"\"\"One non-streaming call (see `generate` for why), timed and counted.\"\"\"\n235:     llm.reset()\n236: \n237:     budget = generation_budget(llm, prompt, max_new_tokens)\n238: \n239:     started = time.time()\n240:     call = dict(prompt=prompt, max_tokens=budget, temperature=temperature)\n241:     if grammar is not None:\n242:         call[\"grammar\"] = grammar\n243:     if seed is not None:\n244:         call[\"seed\"] = seed\n245:     response = llm(**call)\n246: \n247:     choice = (response.get(\"choices\") or [{}])[0]\n248:     text = choice.get(\"text\") or \"\"\n249:     finish_reason = choice.get(\"finish_reason\")\n250:     usage = response.get(\"usage\") or {}\n251:     tokens = usage.get(\"completion_tokens\")\n252:     if not isinstance(tokens, int):\n253:         # A backend without a usage block: measure the text directly rather than\n254:         # reporting zero, so the speed line and the truncation diagnosis stay\n255:         # meaningful.\n256:         tokens = token_count(llm, text)\n257: \n258:     return StepResult(\n259:         label, text, tokens, time.time() - started, finish_reason, budget\n260:     )"

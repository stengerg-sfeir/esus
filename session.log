              "content": "\"\"\"Run the Qwen dump's extracted blocks through the real guard, offline.\n\n`out/library/generated` is the same mechanical module text the Qwen run\nstarted from (stubs not filled), so its `info` and API facts are the ones\nthe live prompts carried.  The raw answers are parsed with the prompt's\nfence still open; every candidate block is cleaned and put through\n`_body_refusal`, `_body_complaints` and the splice compile.\n\"\"\"\nimport json\nimport re\nimport sys\n\nsys.path.insert(0, \"/home/gstenger/Documents/esus\")\nimport generator  # noqa: E402\n\nOUT = \"/home/gstenger/Documents/esus/out/library/generated\"\nFILES = {name: open(f\"{OUT}/{name}\", encoding=\"utf-8\").read()\n         for name in (\"repositories.py\", \"services.py\", \"models.py\",\n                      \"errors.py\", \"store.py\")}\nSPANS = {}\nfor name in (\"repositories.py\", \"services.py\"):\n    for _start, _end, info in generator.find_stub_spans(FILES[name]):\n        info = dict(info, file=name)\n        SPANS[f\"{info['cls']}.{generator._stub_method(info)}\"] = info\nprint(\"stubs found:\", sorted(SPANS))\n\nSTORE_NAMES = {m.group(1) for m in\n               re.finditer(r\"^    def (\\w+)\", FILES[\"store.py\"], re.M)}\nMODEL_NAMES = generator._class_names(FILES[\"models.py\"])\nERROR_NAMES = generator._class_names(FILES[\"errors.py\"])\nFENCE = re.compile(r\"^\\s*```([A-Za-z0-9_+.-]*)\\s*$\")\n\n\ndef regions(text):\n    out = []\n    inside = True\n    info = \"prompt\"\n    current = []\n    for line in text.splitlines():\n        match = FENCE.match(line)\n        if match:\n            if inside:\n                out.append((info != \"prompt\", info, current))\n                current = []\n                info = \"prompt\"\n            else:\n                info = match.group(1) or \"\"\n            inside = not inside\n            continue\n        if inside:\n            current.append(line)\n    if inside:\n        out.append((info != \"prompt\", info, current))\n    return out\n\n\ndef clean_block(block):\n    \"\"\"Dedent one fenced block and drop an echoed def/docstring like _clean_body.\"\"\"\n    lines = [line.rstrip() for line in block]\n    while lines and not lines[0].strip():\n        lines.pop(0)\n    while lines and not lines[-1].strip():\n        lines.pop()\n    if lines and re.match(r\"^\\s*def \\w+\", lines[0]):\n        lines.pop(0)\n    while lines and not lines[0].strip():\n        lines.pop(0)\n    if lines:\n        opener = re.match(r'^\\s*[rubf]{0,2}(\"\"\"|\\'\\'\\')', lines[0])\n        if opener:\n            closing = opener.group(1)\n            tail = lines.pop(0)[opener.end():]\n            while closing not in tail and lines:\n                tail = lines.pop(0)\n    indents = [len(line) - len(line.lstrip(\" \")) for line in lines\n               if line.strip()]\n    if not indents:\n        return []\n    trim = min(indents)\n    return [line[trim:] if line.strip() else \"\" for line in lines]\n\n\ndef compile_body(body, info, text, label):\n    candidate = generator._spliced_candidate(\n        text, *generator.find_stub_spans(text)[0][:2], info, body,\n        \"Qwen3-4B-Instruct-2507-Q4_K_M.gguf\") if False else None\n    # Re-find the span by label, then splice.\n    span = next((found for found in generator.find_stub_spans(text)\n                 if f\"{found[2]['cls']}.{generator._stub_method(found[2])}\"\n                 == label), None)\n    if span is None:\n        return False, \"span gone\"\n    start, end, found_info = span\n    candidate = generator._spliced_candidate(\n        text, start, end, found_info, body,\n        \"Qwen3-4B-Instruct-2507-Q4_K_M.gguf\")\n    try:\n        compile(candidate, info[\"file\"], \"exec\")\n        return True, \"\"\n    except SyntaxError as error:\n        return False, f\"{error.msg} (line {error.lineno})\"\n\n\nrows = json.load(open(\"/tmp/opencode/qwen4b_llm_stub_answers.json\",\n                      encoding=\"utf-8\"
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/matcher.py, lines 1-120\n1: import json\n2: import re\n3: from pathlib import Path\n4: \n5: KERNEL_DIR = Path(__file__).parent\n6: \n7: def load_patterns():\n8:     repo_file = KERNEL_DIR / \"repo_patterns\" / \"patterns.json\"\n9:     service_file = KERNEL_DIR / \"service_patterns\" / \"patterns.json\"\n10:     \n11:     with open(repo_file, \"r\", encoding=\"utf-8\") as f:\n12:         repo_patterns = json.load(f)\n13:     with open(service_file, \"r\", encoding=\"utf-8\") as f:\n14:         service_patterns = json.load(f)\n15:         \n16:     return repo_patterns, service_patterns\n17: \n18: def match_text_to_patterns(text: str, patterns: list) -> list:\n19:     \"\"\"Matches freeform intentions or invariant text against catalog patterns via keyword overlap.\"\"\"\n20:     matched = []\n21:     text_lower = text.lower()\n22:     \n23:     for pat in patterns:\n24:         score = 0\n25:         matched_kws = []\n26:         for kw in pat.get(\"match_keywords\", []):\n27:             if re.search(r'\\b' + re.escape(kw.lower()) + r'\\b', text_lower):\n28:                 score += 1\n29:                 matched_kws.append(kw)\n30:         if score > 0:\n31:             matched.append({\n32:                 \"pattern_id\": pat[\"pattern_id\"],\n33:                 \"score\": score,\n34:                 \"matched_keywords\": matched_kws,\n35:                 \"pattern\": pat\n36:             })\n37:             \n38:     # Sort by relevance\n39:     matched.sort(key=lambda x: x[\"score\"], reverse=True)\n40:     return matched\n41: \n42: def match_architecture(prefix: str):\n43:     \"\"\"Matches all extracted architecture files for a given prefix against kernel patterns.\"\"\"\n44:     repo_patterns, service_patterns = load_patterns()\n45:     \n46:     intentions_file = Path(f\"{prefix}_intentions.json\")\n47:     invariants_file = Path(f\"{prefix}_invariants.json\")\n48:     contracts_file = Path(f\"{prefix}_service_contracts.json\")\n49:     \n50:     intentions = []\n51:     invariants = []\n52:     contracts = []\n53:     \n54:     if intentions_file.exists():\n55:         with open(intentions_file, \"r\", encoding=\"utf-8\") as f:\n56:             intentions = json.load(f).get(\"intentions\", [])\n57:     if invariants_file.exists():\n58:         with open(invariants_file, \"r\", encoding=\"utf-8\") as f:\n59:             invariants = json.load(f).get(\"invariants\", [])\n60:     if contracts_file.exists():\n61:         with open(contracts_file, \"r\", encoding=\"utf-8\") as f:\n62:             contracts = json.load(f).get(\"service_contracts\", [])\n63:         \n64:     results = {\n65:         \"matched_repo_operations\": [],\n66:         \"matched_service_guards\": []\n67:     }\n68:     \n69:     # Match Intentions -> Repository Patterns\n70:     for intent in intentions:\n71:         repo_matches = match_text_to_patterns(intent, repo_patterns)\n72:         if repo_matches:\n73:             results[\"matched_repo_operations\"].append({\n74:                 \"source\": \"intention\",\n75:                 \"text\": intent,\n76:                 \"matches\": [m[\"pattern_id\"] for m in repo_matches]\n77:             })\n78:             \n79:     # Match Invariants -> Service Patterns\n80:     for inv in invariants:\n81:         svc_matches = match_text_to_patterns(inv, service_patterns)\n82:         if svc_matches:\n83:             results[\"matched_service_guards\"].append({\n84:                 \"source\": \"invariant\",\n85:                 \"text\": inv,\n86:                 \"matches\": [m[\"pattern_id\"] for m in svc_matches]\n87:             })\n88: \n89:     # Match Service Contracts (Methods & Descriptions)\n90:     for contract in contracts:\n91:         s_name = contract.get(\"service_name\", \"\")\n92:         for method in contract.get(\"methods\", []):\n93:             m_text = f\"{method.get('name', '')} {method.get('description', '')}\"\n94:             \n95:             repo_matches = match_text_to_patterns(m_text, repo_patterns)\n96:             if repo_matches:\n97:                 results[\"matched_repo_operations\"].append({\n98:                     \"source\": f\"contract:{s_name}.{method.get('name')}\",\n99:                     \"text\": m_text,\n100:                     \"matches\": [m[\"pattern_id\"] for m in repo_matches]\n101:                 })\n102:                 \n103:             svc_matches = match_text_to_patterns(m_text, service_patterns)\n104:             if svc_matches:\n105:                 results[\"matched_service_guards\"].append({\n106:                     \"source\": f\"contract:{s_name}.{method.get('name')}\",\n107:                     \"text\": m_text,\n108:                     \"matches\": [m[\"pattern_id\"] for m in svc_matches]\n109:                 })\n110:             \n111:     return results\n112: \n113: if __name__ == \"__main__\":\n114:     import sys\n115:     if len(sys.argv) >= 2:\n116:         prefix = sys.argv[1]\n117:         res = match_architecture(prefix)\n118:         print(json.dumps(res, indent=2))\n119:     else:\n120:         print(\"Usage: python3 matcher.py <prefix_e.g._out_expenses>\")"

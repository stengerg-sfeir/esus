any the documents so the checker can later compare\n321:     # the recorded surface against what was actually asked for.\n322:     log.write(f\"[write] {writer.write_requirements(output_dir, requirements)}\")\n323: \n324:     tokens = sum(result.tokens for result in pipeline.results)\n325:     seconds = sum(result.seconds for result in pipeline.results)\n326:     log.write(\n327:         f\"[run] {len(pipeline.results)} steps, {tokens} generated tokens in {seconds:.1f}s\"\n328:     )\n329:     log.flush()\n330:     if getattr(args, \"quiet\", False):\n331:         print_quiet_results(log)\n332: \n333:     if args.check:\n334:         status = check_output(output_dir, quiet=getattr(args, \"quiet\", False))\n335:     else:\n336:         status = 0\n337:     if args.chat:\n338:         remaining = chat_loop(\n339:             output_dir,\n340:             lambda start: resume_in_subprocess(args, output_dir, start),\n341:             out_fn=print,\n342:         )\n343:         return 1 if remaining or status else 0\n344:     return status\n345: \n346: \n347: # --------------------------------------------------------------------------\n348: # chat loop: probe, review, resume — keeping better, rolling back worse\n349: # --------------------------------------------------------------------------\n350: \n351: ROUND_LIMIT = 3\n352: \n353: # Resume attempts per round: both crashes seen so far landed in classifier\n354: # decode (llama_decode -3, transient Metal state) and succeeded on the next\n355: # run, so a crashed resume is retried rather than aborting the session.\n356: # Retries run as fresh child processes (see resume_in_subprocess): reloading\n357: # beside a crashed decode fails with pressure errors, so in-process retry\n358: # would poison its own well.\n359: RESUME_ATTEMPTS = 2\n360: \n361: # Findings a rerun can heal, mapped to the earliest step that owns them. A\n362: # rule absent here (malformed documents, placeholders, duplicate names) is\n363: # not a coverage miss but a structural defect: no round of generation fixes\n364: # it, so the loop stops and reports instead of burning model calls.\n365: RULE_STEPS = {\n366:     \"missing_command\": pipeline_module.COMPONENTS,\n367:     \"missing_flag\": pipeline_module.COMPONENTS,\n368:     \"unbacked_command\": pipeline_module.COMPONENTS,\n369:     \"non_unique_primary_key\": pipeline_module.DATA_MODELS,\n370:     \"unmet_crud_operation\": pipeline_module.SERVICE_CONTRACTS,\n371:     \"uncovered_field\": pipeline_module.INTERACTION_ADAPTERS,\n372:     \"unknown_model_field\": pipeline_module.INTERACTION_ADAPTERS,\n373: }\n374: STEP_ORDER = (\n375:     pipeline_module.DATA_MODELS,\n376:     pipeline_module.COMPONENTS,\n377:     pipeline_module.SERVICE_CONTRACTS,\n378:     pipeline_module.INTERACTION_ADAPTERS,\n379: )\n380: \n381: \n382: def resume_in_subprocess(args, output_dir, start):\n383:     \"\"\"One resume round in a child process; raise on failure.\n384: \n385:     Model runs are isolated per attempt on purpose: a crashed decode can\n386:     leave Metal state unusable, and reloading beside the wreckage fails\n387:     with pressure errors (`Failed to load model`) that look like missing\n388:     files. The child inherits stdio, so its run.log lines stream live, and\n389:     anything it leaves behind dies with it — the loop's snapshot decides\n390:     what survives, never a half-written directory.\n391:     \"\"\"\n392:     import subprocess\n393: \n394:     script = Path(__file__).resolve().parent / \"extract_arch.py\"\n395:     cmd = [sys.executable, str(script),\n396:            \"--model\", args.model, \"--output\", str(output_dir),\n397:            \"--context\", str(args.context), \"--from-step\", start]\n398:     if getattr(args, \"quiet\", False):\n399:         cmd.append(\"--quiet\")\n400:     completed = subprocess.run(cmd)\n401:     if completed.returncode != 0:\n402:         raise RuntimeError(f\"resume exited {completed.returncode}\")\n403: \n404: \n405: def resume_step_for(blockers):\n406:     \"\"\"The earliest pipeline step that can heal one of these findings, or None.\"\"\"\n407:     steps = {RULE_STEPS[finding.rule] for finding in blockers if finding.rule in RULE_STEPS}\n408:     if not steps:\n409:         return None\n410:     return min(steps, key=STEP_ORDER.index)\n411: \n412: \n413: def snapshot_output(output_dir):\n414:     \"\"\"Copy the output dir aside for rollback; return the snapshot path.\"\"\"\n415:     output_dir = Path(output_dir)\n416:     snapshot = output_dir.parent / f\".chat_snapshot_{output_dir.name}\"\n417:     import shutil\n418: \n419:     if snapshot.is_dir():\n420:         shutil.rmtree(snapshot)\n421:     shutil.copytree(output_dir, snapshot)\n422:     return snapshot\n423: \n424: \n425: def restore_snapshot(snapshot, output_dir):\n426:     \"\"\"Roll back to the snapshot, keeping the snapshot itself as evidence.\"\"\"\n427:     import shutil\n428: \n429:     shutil.rmtree(output_dir)\n430:     shutil.copytree(snapshot, output_dir)\n431: \n432: \n433: def report_verdict(output_dir, out_fn=print):\n434:     \"\"\"One explicit tail: GENERATABLE yes/no, with the reasons, or the blocker list.\n435: \n436:     The pipeline log narrates repairs and retries; this is the only line that\n437:     answers the question the run was for. Blockers (with rules) come from the\n438:     probe; open ties come from the probe's question list. Both print even when\n439:     empty, so `GENERATABLE: YES` is never the absence of a message.\n440:     Returns the blocker count.\n441:     \"\"\"\n442:     import probe_readiness\n443: \n444:     name = os.path.basename(str(output_dir).rstrip(os.sep))\n445:     blockers, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n446:     questions = probe_readiness.open_questions(str(output_dir))\n447:     out_fn(\"==== SUMMARY ====\")\n448:     out_fn(f\"blockers: {len(blockers)}, open tie(s): {questions}\")\n449:     if not blockers and not questions:\n450:         out_fn(\"GENERATABLE: YES — `generator.py` can run on this output\")\n451:     else:\n452:         out_fn(\"GENERATABLE: NO — `generator.py` will refuse this output\")\n453:         for finding in blockers:\n454:             out_fn(f\"  - [{finding.rule}] {finding.message}\")\n455:         if questions:\n456:             out_fn(f\"  - {questions} tie(s) still need a human answer \"\n457:                    f\"(`review_ties.py`)\")\n458:     return len(blockers)\n459: \n460: \n461: def chat_loop(output_dir, rerun, out_fn=print, max_rounds=ROUND_LIMIT,\n462:               tie_runner=None, alias_runner=None, surface_runner=None,\n463:               slot_runner=None):\n464:     \"\"\"Probe, review, resume — until clean, stuck, or out of rounds.\n465: \n466:     `rerun(start)` performs one model round from `start` (raising on crash).\n467:     Each round keeps a strictly better state or rolls back to the snapshot:\n468:     the loop can never leave the documents worse than it found them, and it\n469:     always terminates — 0 blockers, nothing rerunnable, a crash, a\n470:     non-improving round, or `max_rounds`. Returns remaining blockers.\n471:     \"\"\"\n472:     import probe_readiness\n473: \n474:     name = os.path.basename(str(output_dir).rstrip(os.sep))\n475:     current = None\n476:     for _ in range(max(1, max_rounds)):\n477:         blockers = chat_flow(output_dir, out_fn=out_fn,\n478:                              tie_runner=tie_runner, alias_runner=alias_runner,\n479:                              surface_runner=surface_runner,\n480:                              slot_runner=slot_runner)\n481:         if not blockers:\n482:             report_verdict(output_dir, out_fn=out_fn)\n483:             return 0\n484:         step = resume_step_for(blockers)\n485:         if step is None:\n486:             out_fn(\"chat: remaining blockers need more than a rerun \"\n487:                    \"(see rules above) — stopping\")\n488:             report_verdict(output_dir, out_fn=out_fn)\n489:             return len(blockers)\n490:         snapshot = snapshot_output(output_dir)\n491:         before = len(blockers)\n492:         try:\n493:             attempt_resume(rerun, step, out_fn)\n494:         except Exception as error:\n495:             restore_snapshot(snapshot, output_dir)\n496:             out_fn(f\"chat: resume crashed twice ({error}) — rolled back to {before} blocker(s); \"\n497:                    f\"pre-round state kept at {snapshot}\")\n498:             report_verdict(output_dir, out_fn=out_fn)\n499:             return before\n500:         after, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n501:         current = after\n502:         if len(after) < before:\n503:             out_fn(f\"chat: round improved {before}->{len(after)} — continuing\")\n504:             _drop_snapshot(snapshot)\n505:             continue\n506:         restore_snapshot(snapshot, output_dir)\n507:         out_fn(f\"chat: round did not improve ({before}->{len(after)}) — \"\n508:                f\"rolled back, keeping {before} blocker(s); pre-round state kept at {snapshot}\")\n509:         report_verdict(output_dir, out_fn=out_fn)\n510:         return before\n511:     out_fn(f\"chat: {max_rounds} rounds done — stopping\")\n512:     report_verdict(output_dir, out_fn=out_fn)\n513:     return len(current) if current is not None else 0\n514: \n515: \n516: def attempt_resume(rerun, step, out_fn=print, attempts=RESUME_ATTEMPTS):\n517:     \"\"\"Run one resume round, retrying a crashed attempt.\n518: \n519:     Raises the last error when every attempt crashes, so the caller rolls\n520:     back to the snapshot instead of continuing on a half-written directory.\n521:     \"\"\"\n522:     error = None\n523:     for attempt in range(1, max(1, attempts) + 1):\n524:         try:\n525:             rerun(step)\n526:             return\n527:         except Exception as exc:\n528:             error = exc\n529:             if attempt < max(1, attempts):\n530:                 out_fn(f\"chat: resume crashed ({error}) — retrying the resume \"\n531:                        f\"({attempt + 1}/{max(1, attempts)})\")\n532:     raise error\n533: \n534: \n535: def _drop_snapshot(snapshot):\n536:     import shutil\n537: \n538:     shutil.rmtree(snapshot, ignore_errors=True)\n539: \n540: \n541: def check_output(output_dir, quiet=False):\n542:     \"\"\"Run the consistency checker over a finished run.\"\"\"\n543:     from kernel.consistency import check_directory, render_report\n544: \n545:     report = check_directory(str(output_dir), output_dir.name)\n546:     if not quiet:\n547:         print(render_report(report, show_all=True))\n548:     errors, warnings = report.counts\n549:     summary = f\"consistency: {errors} error(s), {warnings} warning(s)\"\n550:     if report.notes:\n551:         summary += f\", {len(report.notes)} note(s)\"\n552:     print(summary)\n553:     return 1 if errors else 0\n554: \n555: \n556: if __name__ == \"__main__\":\n557:     sys.exit(main())"

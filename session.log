(path):\n    tree = ast.parse(open(path, encoding=\"utf-8\").read())\n    for node in tree.body:\n        if isinstance(node, ast.Assign) and any(\n                isinstance(t, ast.Name) and t.id == \"answers\"\n                for t in node.targets):\n            return ast.literal_eval(node.value)\n    raise SystemExit(f\"no answers list in {path}\")\n\n\ndef module_names(text):\n    names = set()\n    for node in ast.parse(text).body:\n        if isinstance(node, ast.Import):\n            for alias in node.names:\n                names.add(alias.asname or alias.name.split(\".\")[0])\n        elif isinstance(node, ast.ImportFrom):\n            for alias in node.names:\n                names.add(alias.asname or alias.name)\n        elif isinstance(node, (ast.ClassDef, ast.FunctionDef)):\n            names.add(node.name)\n        elif isinstance(node, (ast.Assign, ast.AnnAssign)):\n            targets = node.targets if isinstance(node, ast.Assign) \\\n                else [node.target]\n            for target in targets:\n                if isinstance(target, ast.Name):\n                    names.add(target.id)\n    return names\n\n\ndef model_fields(models_text):\n    fields = {}\n    for entry in generator._model_fields(models_text):\n        name, _, inside = entry.partition(\"(\")\n        names = []\n        for piece in [p.strip() for p in inside.rstrip(\")\").split(\",\")]:\n            if piece:\n                names.append(piece.split(\":\")[0].strip())\n        fields[name.strip()] = names\n    return fields\n\n\ndef stub_signature(module_text, method):\n    match = re.search(\n        rf\"^    def {re.escape(method)}\\(([^)]*)\\)\"\n        r\"(?:\\s*->\\s*([^:]+))?:\\s*$\", module_text, re.M)\n    if not match:\n        raise SystemExit(f\"signature not found: {method}\")\n    params = []\n    for piece in match.group(1).split(\",\"):\n        piece = piece.strip()\n        if not piece or piece.startswith(\"*\"):\n            continue\n        name = piece.split(\":\")[0].split(\"=\")[0].strip()\n        if name and name != \"self\":\n            params.append(name)\n    return params, (match.group(2) or \"\").strip()\n\n\ndef return_types(text):\n    found = {}\n    for match in re.finditer(\n            r\"def (\\w+)\\([^)]*\\)\\s*->\\s*([^:]+):\", text or \"\"):\n        found.setdefault(match.group(1), match.group(2).strip())\n    return found\n\n\ndef first_model(annotation):\n    match = re.search(r\"models\\.(\\w+)\", annotation or \"\")\n    return match.group(1) if match else None\n\n\ndef complaints(body, params, declared_ret, module_text, references_text,\n               fields):\n    text = \"\\n\".join(body)\n    found = []\n    if VIEW_INDEX.search(text):\n        found.append(\"indexes a dict view (`dict.keys()[i]` is not \"\n                     \"subscriptable); wrap with `list(...)` or iterate\")\n    source = \"def _wrapped(self%s):\\n\" % (\n        \",\".join([\" \" + p for p in params])) + \"\\n\".join(\n        (\"    \" + line if line.strip() else \"\") for line in body)\n    try:\n        tree = ast.parse(source)\n    except SyntaxError as error:\n        return [f\"body does not parse: {error}\"]\n    loads = {node.id for node in ast.walk(tree)\n             if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load)}\n    stores = {node.id for node in ast.walk(tree)\n              if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store)}\n    known = (set(params) | module_names(module_text) | BUILTINS\n             | BODY_IMPORTS | stores | {\"self\"})\n    unknown = sorted(loads - known)\n    if unknown:\n        found.append(\"unknown name(s) %s: nothing in the module binds them\"\n                     % \", \".join(f\"`{n}`\" for n in unknown))\n    for param in params:\n        if param not in loads:\n            found.append(f\"parameter `{param}` is never used in the body\")\n    typed = {}\n    for node in ast.walk(tree):\n        if (isinstance(node, ast.Assign) and len(node.targets) == 1\n                and isinstance(node.targets[0], ast.Name)\n                and isinstance(node.value, ast.Call)):\n            func = node.value.func\n            if (isinstance(func, ast.Attribute)\n                    and isinstance(func.value, ast.Name)\n                    and func.value.id == \"models\"\n                    and func.attr in fields):\n                typed[node.targets[0].id] = func.attr\n    seen = set()\n    for node in ast.walk(tree):\n        if (isinstance(node, ast.Attribute)\n                and isinstance(node.value, ast.Name)):\n            cls = typed.get(node.value.id)\n            if cls and node.attr not in fields[cls] \\\n                    and (node.value.id, node.attr) not in seen:\n                seen.add((node.value.id, node.attr))\n                found.append(\n                    f\"`{node.value.id}.{node.attr}`: {cls} has no field \"\n                    f\"`{node.attr}` (fields: {', '.join(fields[cls])})\")\n    load_line, store_line = {}, {}\n    for node in ast.walk(tree):\n        if not isinstance(node, ast.Name):\n            continue\n        if isinstance(node.ctx, ast.Load):\n            load_line[node.id] = min(load_line.get(node.id, 10 ** 9),\n                                     node.lineno)\n        elif isinstance(node.ctx, ast.Store):\n            store_line[node.id] = min(store_line.get(node.id, 10 ** 9),\n                                      node.lineno)\n    for name in sorted(load_line):\n        if name in params or name in BUILTINS or name in stores \\\n                or name in BODY_IMPORTS or name in module_names(module_text):\n            continue\n        if load_line[name] < store_line.get(name, 10 ** 9):\n            found.append(\n                f\"`{name}` is read (line {load_line[name]}) before it is \"\n                f\"assigned (line {store_line[name]}) — possible \"\n                \"use-before-assignment\")\n    declared = first_model(declared_ret)\n    if declared:\n        fixed = return_types(references_text)\n        fixed.update(return_types(module_text))\n        for node in ast.walk(tree):\n            if not isinstance(node, ast.Return) \\\n                    or not isinstance(node.value, ast.Name):\n                continue\n            name = node.value.id\n            for assign in [n for n in ast.walk(tree)\n                           if isinstance(n, ast.Assign)\n                           and len(n.targets) == 1\n                           and isinstance(n.targets[0], ast.Name)\n                           and n.targets[0].id == name]:\n                value = assign.value\n                if not isinstance(value, ast.Call):\n                    continue\n                func = value.func\n                method = func.attr if isinstance(func, ast.Attribute) else None\n                actual = first_model(fixed.get(method, \"\"))\n                if actual and actual != declared:\n                    found.append(\n                        f\"returns `{name}` from `{method}(...)` \"\n                        f\"({actual}) but is declared `-> models.{declared}`\")\n                    break\n    return found\n\n\ndef main():\n    for program, spec in TARGETS.items():\n        answers = harness_answers(spec[\"harness\"])\n        base = spec[\"dir\"]\n        modules = {}\n        for name in (\"repositories.py\", \"services.py\", \"models.py\"):\n            with open(os.path.join(base, name), encoding=\"utf-8\") as handle:\n                modules[name] = handle.read()\n        fields = model_fields(modules[\"models.py\"])\n        print(f\"=== {program}: models = \"\n              + \"; \".join(f\"{k}({len(v)})\" for k, v in fields.items()))\n        for answer, (filename, cls, method) in zip(answers, spec[\"labels\"]):\n            module_text = modules[filename]\n            references = modules[\"repositories.py\"]\n            body = generator._clean_body(answer)\n            params, declared = stub_signature(module_text, method)\n            found = complaints(body, params, declared, module_text,\n                               references, fields)\n            print(f\"\\n--- {cls}.{method}\")\n            if found:\n                for item in found:\n                    print(f\"  ! {item}\")\n            else:\n                print(\"  clean\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
            },

              "content": "\"\"\"Hand-replace the three library stragglers from the run-4 LLM pass.\n\nRun from the repo root on the Mac:\n\n    python3.12 - < this file\n\nReplaces, in out/library/generated:\n  - BookRepository.search_books_by_title_author_isbn (author join via the\n    Author table, the AuthorRepository.find_books_by_author precedent)\n  - LibraryService.return_book (persist the loan, guard double returns)\n  - LibraryService.borrow_book (return the created loan, 14-day choice)\n\nthen compiles both modules and smokes a throwaway copy: author search\nfinds the book, borrow returns the loan, return persists, a second\nreturn is refused. The review tags go with the replaced docstrings.\n\"\"\"\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nGEN = Path(\"out/library/generated\")\n\nSEARCH = '''    def search_books_by_title_author_isbn(self, query: str = None) -> List[models.Book]:\n        \"\"\"Searches books by title, ISBN or author name.\"\"\"\n        needle = (query or \"\").lower()\n        authors = {author.get(\"id\"): (author.get(\"name\") or \"\").lower()\n                   for author in self._store.all(\"Author\")}\n        found = []\n        for record in self._store.all(self.ENTITY):\n            text = f\"{record.get('title') or ''} {record.get('isbn') or ''}\"\n            if needle in text.lower() or needle in authors.get(record.get(\"author_id\"), \"\"):\n                found.append(models.Book(**record))\n        return found'''\n\nRETURN = '''    def return_book(self, loan_id: int = None) -> models.Loan:\n        \"\"\"Marks the loan returned and puts the copy back on the shelf.\"\"\"\n        loan = self._repos['LoanRepository'].read_one_loan(loan_id)\n        if loan.return_date is not None:\n            raise errors.InvalidReturnDateError(\"Book already returned\")\n        book = self._repos['BookRepository'].read_one_book(loan.book_id)\n        loan.return_date = datetime.datetime.now()\n        loan.status = \"returned\"\n        updated_loan = self._repos['LoanRepository'].update_loan(loan_id, loan)\n        book.available_copies = (book.available_copies or 0) + 1\n        self._repos['BookRepository'].update_book(book.id, book)\n        return updated_loan'''\n\nBORROW = '''    def borrow_book(self, member_id: int = None, book_id: int = None) -> models.Loan:\n        \"\"\"Checks a copy is on the shelf, creates the loan, takes the copy.\"\"\"\n        member = self._repos['MemberRepository'].read_one_member(member_id)\n        book = self._repos['BookRepository'].read_one_book(book_id)\n        if (book.available_copies or 0) <= 0:\n            raise errors.InsufficientCopiesError(\"No available copies of this book\")\n        loan = models.Loan(\n            book_id=book.id,\n            member_id=member.id,\n            loan_date=datetime.datetime.now(),\n            due_date=datetime.datetime.now() + datetime.timedelta(days=14),  # loan period: not stated by the prompt\n            status=\"active\",\n        )\n        created = self._repos['LoanRepository'].create_loan(loan)\n        book.available_copies = (book.available_copies or 0) - 1\n        self._repos['BookRepository'].update_book(book.id, book)\n        return created'''\n\n\ndef replace_method(text, name, block):\n    start = text.index(f\"    def {name}(\")\n    rest = text[start:]\n    stop = re.search(r\"\\n(?=    def |class |\\Z)\", rest)\n    end = start + (stop.start() if stop else len(rest))\n    return text[:start] + block + text[end:]\n\n\nrepos_path = GEN / \"repositories.py\"\nservices_path = GEN / \"services.py\"\nrepos_text = repos_path.read_text(encoding=\"utf-8\")\nservices_text = services_path.read_text(encoding=\"utf-8\")\n\n# Refuse to patch a tree that is not the reviewed run-4 state.\nassert \"record.author.name\" in repos_text, \\\n    \"repositories.py is not the reviewed run-4 body — stop and re-check\"\nassert \"# Increment available copies for the book\" in services_text, \\\n    \"services.py return_book is not the reviewed run-4 body — stop\"\nassert \"timedelta(days=14)\" in services_text, \\\n    \"services.py borrow_book is not the reviewed run-4 body — stop\"\n\nrepos_path.write_text(replace_method(repos_text,\n                                     \"search_books_by_title_author_isbn\",\n                                     SEARCH), encoding=\"utf-8\")\nservices_text = replace_method(services_text, \"return_book\", RETURN)\nservices_text = replace_method(services_text, \"borrow_book\", BORROW)\nservices_path.write_text(services_text, encoding=\"utf-8\")\n\ncompile(repos_path.read_text(encoding=\"utf-8\"), \"repositories.py\", \"exec\")\ncompile(services_path.read_text(encoding=\"utf-8\"), \"services.py\", \"exec\")\nprint(\"patched: repositories.py search, services.py return_book + borrow_book\")\n\nwith tempfile.TemporaryDirectory() as tmp:\n    work = Path(tmp) / \"generated\"\n    shutil.copytree(GEN, work, ignore=shutil.ignore_patterns(\"*.db\", \"__pycache__\"))\n    seed = (\n        \"import sys; sys.path.insert(0, '.')\\n\"\n        \"import store\\n\"\n        \"s = store.Store('smoke.db')\\n\"\n        \"s.add('Author', 'id', {'name': 'Ursula Le Guin'})\\n\"\n        \"s.add('Book', 'id', {'title': 'A Wizard of Earthsea',\"\n        \" 'isbn': '978-0', 'author_id': 1, 'published_year': 1968,\"\n        \" 'available_copies': 1})\\n\"\n        \"s.add('Member', 'id', {'name': 'Ada', 'email': 'ada@example.com',\"\n        \" 'membership_date': '2026-01-15', 'is_active': True})\\n\"\n        \"s.close()\\n\"\n    )\n    subprocess.run([sys.executable, \"-c\", seed], cwd=work, check=True)\n\n    def cli(*args):\n        proc = subprocess.run(\n            [sys.executable, \"cli.py\", \"--db\", \"smoke.db\", *args],\n            cwd=work, capture_output=True, text=True)\n        return proc.returncode, (proc.stdout + proc.stderr).strip()\n\n    code, out = cli(\"book\", \"search\", \"-query\", \"le guin\")\n    assert code == 0 and \"Earthsea\" in out, (code, out)\n    print(\"smoke: author-name search finds the book\")\n    code, out = cli(\"borrow\", \"--member-id\", \"1\", \"--book-id\", \"1\")\n    assert code == 0 and '\"due_date\"' in out, (code, out)\n    print(\"smoke: borrow returns the created loan\")\n    code, out = cli(\"return\", \"--loan-id\", \"1\")\n    assert code == 0 and '\"returned\"' in out, (code, out)\n    code, out = cli(\"return\", \"--loan-id\", \"1\")\n    assert code == 1 and \"already returned\" in out, (code, out)\n    print(\"smoke: return persists, a second return is refused\")\nprint(\"done\")\n",

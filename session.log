                "type": "text",
                "text": "/Users/gillesstenger/Documents/esus/kernel/extraction/runner.py\ndef load_model(model_path, context_size=8192, logits_all=False, quiet=False):\n    \"\"\"Load the GGUF model with the settings every step shares.\"\"\"\n    device = \"CPU\" if resolve_gpu_layers() == GPU_LAYERS_NONE else \"Metal\"\n    threading = threading_parameters()\n    threads = threading.get(\"n_threads\", \"auto\")\n    if not quiet:\n        print(\n            f\"[model] {model_path} on {device}, n_ctx={context_size}, \"\n            f\"n_threads={threads}, logits_all={logits_all}, \"\n            f\"flash_attn={FLASH_ATTENTION}\",\n            file=sys.stderr,\n        )\n    started = time.time()\n    # `verbose=False` silences the wrapper's own logs, but the Metal compile\n    # banners and model-loader lines are written by the C layer straight to\n    # the file descriptors, bypassing that flag. In quiet mode they are\n    # redirected to devnull for the construction only — generation itself is\n    # silent, and any failure still raises as an exception.\n    model_kwargs = dict(\n        model_path=model_path,\n        n_ctx=context_size,\n        n_gpu_layers=resolve_gpu_layers(),\n        flash_attn=FLASH_ATTENTION,\n        logits_all=logits_all,\n        verbose=False,\n    )\n    if quiet:\n        with suppress_stdout_stderr(disable=False):\n            llm = Llama(**model_kwargs, **threading)\n    else:\n        llm = Llama(**model_kwargs, **threading)\n    if not quiet:\n        print(f\"[model] loaded in {time.time() - started:.1f}s\", file=sys.stderr)\n    return llm\n\n__init__.py\n__pycache__\naliases.py\nclassification.py\ncommand_lines.py\ndecisions.py\ndedupe.py\ngrammar_balance.py\ngrammar_builders.py\ngrammar_check.py\ngrammar_open.py\ngrammar_persistence.py\ngrammar.py\ninterfaces.py\npipeline.py\nprompts.py\nrepairs.py\nreturn_types.py\nrunner.py\nvocabulary.py\nwriter.py\n"

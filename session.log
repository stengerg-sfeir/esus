                "text": "Read file /home/gstenger/Documents/esus/kernel/extraction/runner.py, lines 225-314\n225:     and the requirements describe a whole tiny program. A mask would only be\n226:     able to say \"any text\", so none is used — and the output is verified by\n227:     running it, the only check that means anything there.\n228: \n229:     Raw continuation is the wrong frame for a free *ask*, though — see\n230:     `generate_chat`, which the stub filler prefers whenever the GGUF can\n231:     provide one.\n232:     \"\"\"\n233:     return _generate_impl(llm, prompt, None, label, temperature,\n234:                           max_new_tokens, seed)\n235: \n236: \n237: def generate_chat(llm, prompt, label, temperature=0.0, max_new_tokens=None, seed=None):\n238:     \"\"\"Generate free text through the model's chat template, returning a `StepResult`.\n239: \n240:     Raw completion is right for the document steps: a grammar mask makes the\n241:     output machine-readable, and there is nothing to converse about. A free\n242:     ask is different. An instruct model continued as raw text does not answer\n243:     it; it continues the *document*, and the continuation is reasoning.\n244:     Measured on Qwen3-4B-Instruct-2507 (`LibraryService.borrow_book`, the\n245:     same prompt at temperature 0, seed 20261012):\n246: \n247:       - raw: `finish_reason='length'` at 3584/3584 tokens, and again at\n248:         5905/5905 with the whole context — still mid-sentence reasoning;\n249:       - the GGUF's chat template: `finish_reason='stop'`, 220 tokens, a body\n250:         that starts at the first line.\n251: \n252:     The template is what selects the assistant mode. `has_chat_template`\n253:     lets the caller choose between the two framings per model.\n254:     \"\"\"\n255:     return _generate_impl(llm, prompt, None, label, temperature,\n256:                           max_new_tokens, seed, chat=True)\n257: \n258: \n259: def has_chat_template(llm):\n260:     \"\"\"True when the GGUF carries a chat template `create_chat_completion` uses.\n261: \n262:     Every model measured so far does; the check keeps a template-less GGUF\n263:     (and a bare test mock, which answers truthy for every attribute) on\n264:     `generate_free` instead of failing body by body.\n265:     \"\"\"\n266:     try:\n267:         metadata = llm.metadata or {}\n268:         template = metadata.get(\"tokenizer.chat_template\")\n269:     except Exception:  # a mock or a binding without the property\n270:         template = None\n271:     if isinstance(template, str) and template.strip():\n272:         return True\n273:     return isinstance(getattr(llm, \"chat_format\", None), str)\n274: \n275: \n276: def _generate_impl(llm, prompt, grammar, label, temperature, max_new_tokens,\n277:                    seed, chat=False):\n278:     \"\"\"One non-streaming call (see `generate` for why), timed and counted.\"\"\"\n279:     llm.reset()\n280: \n281:     budget = generation_budget(llm, prompt, max_new_tokens)\n282: \n283:     started = time.time()\n284:     if chat:\n285:         if grammar is not None:\n286:             raise ValueError(\"a chat call cannot carry a GBNF mask\")\n287:         call = dict(messages=[{\"role\": \"user\", \"content\": prompt}],\n288:                     max_tokens=budget, temperature=temperature)\n289:         if seed is not None:\n290:             call[\"seed\"] = seed\n291:         response = llm.create_chat_completion(**call)\n292:         choice = (response.get(\"choices\") or [{}])[0]\n293:         text = (choice.get(\"message\") or {}).get(\"content\") or \"\"\n294:     else:\n295:         call = dict(prompt=prompt, max_tokens=budget, temperature=temperature)\n296:         if grammar is not None:\n297:             call[\"grammar\"] = grammar\n298:         if seed is not None:\n299:             call[\"seed\"] = seed\n300:         response = llm(**call)\n301:         choice = (response.get(\"choices\") or [{}])[0]\n302:      
n                {\"name\": \"month\", \"type\": \"string\"},\n                {\"name\": \"amount_limit_cents\", \"type\": \"int\"}]}],\n            \"errors\": [], \"services\": [],\n            \"repositories\": [{\"entity\": \"Budget\",\n                              \"interface_name\": \"BudgetRepository\",\n                              \"methods\": [\n                                  {\"name\": \"read_all_budgets\", \"params\": [],\n                                   \"return_type\": \"List[Budget]\"},\n                                  {\"name\": \"read_budget_by_category_and_month\",\n                                   \"params\": [\n                                       {\"name\": \"category_id\", \"type\": \"int\"},\n                                       {\"name\": \"month\", \"type\": \"str\"}],\n                                   \"return_type\": \"Budget\"}]}],\n            \"mappings\": {}, \"match_index\": {}, \"adapters\": adapters,\n            \"entity_names\": [\"Budget\"],\n            \"components\": {\"facade\": {\"invocation\": invocation}},\n            \"routes\": [],\n        }\n```\n\nThe alternate test:\n```python\n    def test_alternate_needs_every_flag_and_names_the_missing_one(self):\n        ctx = self.budget_ctx()\n        text, stats = self.emitted(ctx)\n        line = next(l for l in text.splitlines() if \"('budget', 'list')\" in l)\n        self.assertIn(\"'read_budget_by_category_and_month'\", line)\n        self.assertLess(line.index(\"'read_budget_by_category_and_month'\"),\n                        line.index(\"'read_all_budgets'\"))\n        self.assertEqual(\n            stats[\"choice_routes\"],\n            [\"budget list: -category -month -> read_budget_by_category_and_month\"])\n        self.assertNotIn(\"dead_options\", stats)\n\n        class BudgetRepository:\n            def __init__(self, store):\n                pass\n            def read_all_budgets(self):\n                return [\"all-budgets\"]\n            def read_budget_by_category_and_month(self, category_id=None, month=None):\n                return [f\"filtered:{category_id}:{month}\"]\n\n        text_ok, out = ... run [\"budget\",\"list\",\"-category\",\"1\",\"-month\",\"2026-10\"]\n        self.assertEqual(code, 0)\n        self.assertIn(\"filtered:1:2026-10\", out)\n        code, out = run [\"budget\",\"list\"]\n        self.assertIn(\"all-budgets\", out)\n        code, out = run [\"budget\",\"list\",\"-category\",\"1\"]\n        self.assertEqual(code, 1)\n        self.assertIn(\"also needs -month\", out)\n```\n\nHmm — one thing: `_choose`'s `present` uses `_normalize(dest)`; for -category dest \"category\"; the choice need dest \"category\" ✓ (need built from bindings dests).\n\nBut how does the alternate's `argv` entry get fields bound? Via usage: bindings pairs [(\"category_id\",\"category\"),(\"month\",\"month\")]; emitted ADAPTERS argv for read_budget_by_category_and_month → {'category_id': 'category', 'month': 'month'} ✓. Then `_call`: fields list from input_fields: [(\"category_id\",(target_param,kind,required)), (\"month\",...)]; dest = argv[field_name]: argv maps 'category_id'→'category' ✓ present.get('category') = 1 ✓ → transform DIRECT → grouped['category_id']=1 ✓ month ✓ → method(category_id=1, month='2026-10') ✓.\n\nWait — `transform` DIRECT in my fixture; the emitted ADAPTERS fields tuple is (field_name, (target_param, kind, required)) with kind = transform? In out/expenses the fields tuples look like `('category_id', ('category_id', 'DIRECT', True))` presumably ✓.\n\nAlso the `-month 2026-10` flag type str ✓.\n\nAnd for the -category dest: is the dest \"category\"? The emitted option for \"-category\" gets dest = _sanitize('category') = 'category' ✓ and bind_field([\"category\"], \"category_id\") — does bind_field match \"category_id\" to dest \"category\"? Earlier defined: `<x>_id` alias — in the real dir it bound (route worked). But in my fixture the field name is \"category_id\" and dests are
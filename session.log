-x`.\", report)\n        self.assertEqual(rules(report), [])\n\n\n'''\nt = t.replace(anchor, new_tests + anchor, 1)\np.write_text(t)\nprint('appended')\nPYEOF\npython3 -m unittest tests.test_generator_readiness_rules 2>&1 | grep -E \"^(OK|FAILED|Ran)\""

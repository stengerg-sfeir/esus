face_coverage(\n            self.surface([\"product\", \"category\"]), \"Run `product add --sku`.\",\n            report)\n        self.assertEqual(rules(report), [])\n\n    def test_a_bare_line_with_no_flags_is_not_reported(self):\n        report = Report(\"t\")\n        check_surface_coverage(self.surface([\"book\"]), \"Run `library overdue`.\",\n                               report)\n        self.assertEqual(rules(report), [])\n\n\n'''\nt = t.replace(anchor, new_tests + anchor, 1)\np.write_text(t)\nprint('appended')\nPYEOF\npython3 -m unittest discover -s tests 2>&1 | grep -E \"^(OK|FAILED|Ran)\" && python3 probe_readiness.py --dirs library:out/library 2>&1 | head -n 12"

            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_truncation_retry.py, lines 1-262\n1: \"\"\"A truncated step is retried, and a still-truncated one is declared.\n2: \n3: Why this has a test at all: the retry used to fire only when the output failed to\n4: parse. A truncation that lands exactly on a valid list boundary parses, so it was\n5: accepted with no retry and no note — a short document that is indistinguishable\n6: from a complete one downstream. Measured on the corpus (expenses, step G): the\n7: truncated attempt produced 3584 tokens, failed to parse, and the retry recovered\n8: it at 2869. The parse failure is what saved it, and that was luck rather than\n9: design.\n10: \n11: The generator is stubbed, so the contract is pinned without a model: what ends\n12: the retry loop, what is stored, and what is logged.\n13: \"\"\"\n14: \n15: import sys\n16: import unittest\n17: from pathlib import Path\n18: \n19: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n20: \n21: from kernel.extraction import grammar_check, pipeline  # noqa: E402\n22: from kernel.extraction.runner import StepResult  # noqa: E402\n23: \n24: \n25: def result(text, truncated=False, tokens=10, seconds=1.0, budget=3584):\n26:     return StepResult(\"step\", text, tokens, seconds, \"length\" if truncated else \"stop\", budget)\n27: \n28: \n29: class FakeModel:\n30:     \"\"\"Just enough of a Llama to answer `n_ctx` and `tokenize`.\n31: \n32:     `runner.available_tokens` is the subject of the budget assertions, and it\n33:     only needs those two methods — so the ceiling arithmetic is tested without\n34:     loading a model.\n35:     \"\"\"\n36: \n37:     def __init__(self, context, prompt_tokens):\n38:         self._context = context\n39:         self._prompt_tokens = prompt_tokens\n40: \n41:     def n_ctx(self):\n42:         return self._context\n43: \n44:     def tokenize(self, data):\n45:         return list(range(self._prompt_tokens))\n46: \n47: \n48: class CollectingLog:\n49:     \"\"\"A log that keeps its lines, so the messages can be asserted.\"\"\"\n50: \n51:     def __init__(self):\n52:         self.lines = []\n53: \n54:     def write(self, message):\n55:         self.lines.append(message)\n56: \n57:     def flush(self):\n58:         pass\n59: \n60:     def joined(self):\n61:         return \"\\n\".join(self.lines)\n62: \n63: \n64: class TruncatedStepIsRetried(unittest.TestCase):\n65:     def setUp(self):\n66:         self.log = CollectingLog()\n67:         self.pipeline = pipeline.Pipeline(llm=None, classifier=None, log=self.log)\n68:         # The grammar is not the subject here; the caller is responsible for\n69:         # having validated it and this stub keeps the test model-free.\n70:         self._real_assert_valid = grammar_check.assert_valid\n71:         grammar_check.assert_valid = lambda text, label=\"grammar\": None\n72: \n73:     def tearDown(self):\n74:         grammar_check.assert_valid = self._real_assert_valid\n75: \n76:     def stub(self, *results):\n77:         \"\"\"Make the next generate() calls return `results` in order.\n78: \n79:         Returns the recorded (temperature, max_new_tokens) of each call, because\n80:         the budget the retry asks for is part of the contract.\n81:         \"\"\"\n82:         calls = []\n83: \n84:         def fake_generate(llm, prompt, grammar_text, label, temperature=0.1,\n85:                           max_new_tokens=None):\n86:             calls.append((temperature, max_new_tokens))\n87:             return results[len(calls) - 1]\n88: \n89:         self._real_generate = pipeline.runner.generate\n90:         pipeline.runner.generate = fake_generate\n91:         self.addCleanup(lambda: setattr(pipeline.runner, \"generate\", self._real_generate))\n92:         return calls\n93: \n94:     def test_a_truncated_document_that_parsed_is_still_retried(self):\n95:         \"\"\"The case the old code accepted silently.\"\"\"\n96:         calls = self.stub(\n97:             result('{\"widgets\": [1]}', truncated=True),\n98:             result('{\"widgets\": [1, 2, 3]}'),\n99:         )\n100:         body = self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n101:         self.assertEqual(len(calls), 2, \"a truncated document must be retried\")\n102:         self.assertEqual(body, [1, 2, 3], \"the retry's document is the one kept\")\n103:         self.assertIn(\"retrying once\", self.log.joined())\n104: \n105:     def test_an_untruncated_document_is_not_retried(self):\n106:         calls = self.stub(result('{\"widgets\": [1, 2]}'))\n107:         body = self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n108:         self.assertEqual(len(calls), 1)\n109:         self.assertEqual(body, [1, 2])\n110: \n111:     def test_unparseable_output_is_retried_as_before(self):\n112:         calls = self.stub(result(\"not json\"), result('{\"widgets\": [7]}'))\n113:         body = self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n114:         self.assertEqual(len(calls), 2)\n115:         self.assertEqual(body, [7])\n116:         self.assertIn(\"unusable JSON\", self.log.joined())\n117: \n118:     def test_a_still_truncated_retry_is_kept_and_declared(self):\n119:         \"\"\"Better an incomplete document than a missing one — but stated, not silent.\"\"\"\n120:         calls = self.stub(\n121:             result('{\"widgets\": [1]}', truncated=True),\n122:             result('{\"widgets\": [1, 2]}', truncated=True),\n123:         )\n124:         body = self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n125:         self.assertEqual(len(calls), 2)\n126:         self.assertEqual(body, [1, 2])\n127:         self.assertIn(\"still truncated after the retry\", self.log.joined())\n128: \n129:     def test_a_recovered_retry_is_not_declared_truncated(self):\n130:         \"\"\"The final message must reflect the last attempt, not the first.\"\"\"\n131:         self.stub(\n132:             result('{\"widgets\": [1]}', truncated=True),\n133:             result('{\"widgets\": [1, 2]}'),\n134:         )\n135:         self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n136:         self.assertNotIn(\"still truncated\", self.log.joined())\n137: \n138:     def test_both_attempts_unusable_stores_nothing(self):\n139:         self.stub(result(\"not json\"), result(\"also not json\"))\n140:         body = self.pipeline._generate(\"widgets\", \"prompt\", \"grammar\")\n141:         self.assertIsNone(body)\n142:         self.assertIn(\"dependent steps degrade\", self.log.joined())\n143: \n144: \n145: class TheRetryRaisesTheCeiling(unittest.TestCase):\n146:     \"\"\"A truncation is retried with the room the prompt left, not the ceiling that cut it.\n147: \n148:     This is the defect the first version of the retry had: it changed only the\n149:     temperature, so a step that hit `MAX_NEW_TOKENS` was retried under the very\n150:     ceiling that truncated it and truncated again. Expenses' adapters did exactly\n151:     that — twice at 3 584 tokens while the context still held room for thousands\n152:     more — and the document was lost.\n153:     \"\"\"\n154: \n155:     def setUp(self):\n156:         self.log = CollectingLog()\n157:         self._real_assert_valid = grammar_check.assert_valid\n158:         grammar_check.assert_valid = lambda text, label=\"grammar\": None\n159: \n160:     def tearDown(self):\n161:         grammar_check.assert_valid = self._real_assert_valid\n162: \n163:     def pipeline_with(self, context=8192, prompt_tokens=1600):\n164:         return pipeline.Pipeline(\n165:             llm=FakeModel(context, prompt_tokens), classifier=None, log=self.log\n166:         )\n167: \n168:     def stub(self, *results):\n169:         calls = []\n170: \n171:         def fake_generate(llm, prompt, grammar_text, label, temperature=0.1,\n172:                           max_new_tokens=None):\n173:             calls.append(max_new_tokens)\n174:             return results[len(calls) - 1]\n175: \n176:         self._real_generate = pipeline.runner.generate\n177:         pipeline.runner.generate = fake_generate\n178:         self.addCleanup(lambda: setattr(pipeline.runner, \"generate\", self._real_generate))\n179:         return calls\n180: \n181:     def test_the_retry_asks_for_the_room_the_prompt_left(self):\n182:         pipeline_ = self.pipeline_with(context=8192, prompt_tokens=1600)\n183:         calls = self.stub(\n184:             result('{\"widgets\": [1]}', truncated=True),\n185:             result('{\"widgets\": [1, 2, 3]}'),\n186:         )\n187:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n188:         self.assertIsNone(calls[0], \"the first attempt uses the default ceiling\")\n189:         # 8192 context - 1600 prompt tokens - 64 reserve\n190:         self.assertEqual(calls[1], 6528, \"the retry must be given the whole remaining context\")\n191: \n192:     def test_the_log_names_both_ceilings(self):\n193:         pipeline_ = self.pipeline_with()\n194:         self.stub(\n195:             result('{\"widgets\": [1]}', truncated=True, budget=3584),\n196:             result('{\"widgets\": [1, 2]}'),\n197:         )\n198:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n199:         logged = self.log.joined()\n200:         self.assertIn(\"3584-token ceiling\", logged, \"the attempt's ceiling is the diagnosis\")\n201:         self.assertIn(\"6528-token ceiling\", logged, \"the retry's ceiling is stated\")\n202: \n203:     def test_an_unparseable_attempt_does_not_raise_the_ceiling(self):\n204:         \"\"\"Only a truncation is a ceiling problem; a JSON failure is not.\"\"\"\n205:         pipeline_ = self.pipeline_with()\n206:         calls = self.stub(result(\"not json\"), result('{\"widgets\": [7]}'))\n207:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n208:         self.assertEqual(calls, [None, None], \"a parse failure keeps the default ceiling\")\n209: \n210:     def test_a_context_with_no_room_left_says_so(self):\n211:         \"\"\"The honest case: the ceiling cannot be raised, so the log says that.\"\"\"\n212:         pipeline_ = self.pipeline_with(context=8192, prompt_tokens=8000)\n213:         calls = self.stub(\n214:             result('{\"widgets\": [1]}', truncated=True, budget=3584),\n215:             result('{\"widgets\": [1, 2]}'),\n216:         )\n217:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n218:         # 8192 - 8000 - 64 = 128, which is less than the ceiling that truncated.\n219:         self.assertEqual(calls[1], 128)\n220:         self.assertIn(\"no room left to raise\", self.log.joined())\n221: \n222:     def test_an_untruncated_step_never_raises_anything(self):\n223:         pipeline_ = self.pipeline_with()\n224:         calls = self.stub(result('{\"widgets\": [1, 2]}'))\n225:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n226:         self.assertEqual(calls, [None], \"no retry, no raised ceiling\")\n227: \n228: \n229: class TheBudgetArithmetic(unittest.TestCase):\n230:     \"\"\"`available_tokens` / `generation_budget`, without a model.\"\"\"\n231: \n232:     def test_available_tokens_is_the_context_less_the_prompt_and_the_reserve(self):\n233:         from kernel.extraction import runner\n234: \n235:         llm = FakeModel(context=8192, prompt_tokens=1122)\n236:         self.assertEqual(runner.available_tokens(llm, \"a prompt\"), 8192 - 1122 - 64)\n237: \n238:     def test_generation_budget_clamps_a_request_to_the_room_available(self):\n239:         from kernel.extraction import runner\n240: \n241:         llm = FakeModel(context=8192, prompt_tokens=1600)\n242:         # Asking for more than the context can hold still returns the room there is.\n243:         self.assertEqual(runner.generation_budget(llm, \"p\", 99999), 6528)\n244:         # Asking for less is honoured.\n245:         self.assertEqual(runner.generation_budget(llm, \"p\", 256), 256)\n246:         # Asking for nothing uses the first-attempt ceiling.\n247:         self.assertEqual(runner.generation_budget(llm, \"p\"), runner.MAX_NEW_TOKENS)\n248: \n249:     def test_a_long_prompt_still_leaves_the_minimum_budget(self):\n250:         from kernel.extraction import runner\n251: \n252:         llm = FakeModel(context=8192, prompt_tokens=8192)\n253:         self.assertEqual(runner.available_tokens(llm, \"a prompt\"), runner.MIN_BUDGET)\n254: \n255:     def test_no_model_falls_back_to_the_default_ceiling(self):\n256:         from kernel.extraction import runner\n257: \n258:         self.assertEqual(runner.available_tokens(None, \"a prompt\"), runner.MAX_NEW_TOKENS)\n259: \n260: \n261: if __name__ == \"__main__\":\n262:     unittest.main(verbosity=2)"

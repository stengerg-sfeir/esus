                "type": "text",
                "text": "\"\"\"Repositories over an in-memory Store, one class per persistence port.\n\nCRUD, reads and filters run for real. Anything else raises\nNotImplementedError with its work order — an aggregate or guard body\nis specified by its pattern, not invented here.\n\"\"\"\n\nimport models\nimport errors\nfrom store import Store, match_criterion\n\n\ndef _record_values(data, field_names):\n    \"\"\"A dataclass or dict entity argument as a `{field: value}` dict.\"\"\"\n    if data is None:\n        return {}\n    if isinstance(data, dict):\n        return {name: data.get(name) for name in field_names}\n    return {name: getattr(data, name, None) for name in field_names}\n\n\n\nclass CategoryRepository:\n    ENTITY = \"Category\"\n    PK = \"id\"\n\n    def __init__(self, store):\n        self._store = store\n\n\n    def create_category(self, data: Category = None) -> Category:\n        \"\"\"create_category [crud:create: STANDARD_CRUD]\"\"\"\n        values = _record_values(data, ['id', 'name'])\n        record = self._store.add(self.ENTITY, self.PK, values, check_fk=[])\n        r\n\n    def read_one_category(self, id: int = None) -> Category:\n        \"\"\"read_one_category [crud:read_one: STANDARD_CRUD]\"\"\"\n        record = self._store.get(self.ENTITY, self.PK, id, error=errors.CategoryNotFoundError)\n        return Category(**record)\n\n    def delete_category(self, id: int = None) -> None:\n        \"\"\"delete_category [crud:delete: STANDARD_CRUD]\"\"\"\n        criteria = []\n        if id is not None:\n            matched = match_criterion(['id', 'name'], 'id')\n            if matched is None:\n                raise ValueError(f\"cannot filter Category by 'id'\")\n            field, operator = matched\n            criteria.append((field, operator, id))\n        found = self._store.select(self.ENTITY, criteria)\n        if not found:\n            raise errors.CategoryNotFoundError(f\"Category delete matched no records\")\n        for record in found:\n            self._store.delete(self.ENTITY, self.PK, record[self.PK])\n        return None\n\n\nclass ProductRepository:\n    ENTITY = \"Product\"\n    PK = \"id\"\n\n    def __init__(self, store):\n        self._store = store\n\n\n    def create_product(self, data: Product = None) -> Product:\n        \"\"\"create_product\n"

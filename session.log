         return [(\"spend_entity\", candidates[:6]),\n240:                 (\"limit_field\", own_numeric[:6]),\n241:                 (\"target_field\", None),\n242:                 (\"date_field\", None)]\n243:     return None\n244: \n245: \n246: def _param_is_entity(ctx, method, name):\n247:     \"\"\"True when a parameter carries a record rather than a scalar.\"\"\"\n248:     ptype = next((q.get(\"type\") for q in method.get(\"params\") or []\n249:                   if isinstance(q, dict) and q.get(\"name\") == name), None)\n250:     return codegen.is_entity_type(ptype, ctx[\"entity_names\"])\n251: \n252: \n253: def _guard_options(ctx, holder, method):\n254:     \"\"\"`[(slot, [candidates])]` for a service budget guard, or None.\n255: \n256:     Creation, scope, amount and error candidates enumerate upfront; the\n257:     limit waits on the chosen budget read (deferred). Aggregates count as\n258:     candidates once usable *or* answerable this session — a fresh aggregate\n259:     wires up the moment its own slots land, validated again at generation.\n260:     \"\"\"\n261:     acted = generator._guard_entity_param(ctx, method)\n262:     if acted is None:\n263:         return None\n264:     _, _, entity = acted\n265:     entity_name = next((n for n in ctx[\"entity_names\"]\n266:                         if codegen.is_entity_type(entity, [n])), None)\n267:     if entity_name is None:\n268:         return None\n269:     creates = [m[\"name\"] for _, m in generator._mechanical_creates(ctx, entity_name)]\n270:     if not creates:\n271:         return None\n272:     fields = _model_fields(ctx, entity_name)\n273:     dates = [n for n, t, _ in fields\n274:              if t in DATE_TYPES\n275:              or (t in (\"str\", \"string\")\n276:                  and any(h in normalize(n) for h in DATE_NAME_HINTS))]\n277:     amounts = _summable(fields)\n278:     if not dates or not amounts:\n279:         return None\n280:     aggregates = []\n281:     for agg_cls, agg_method 
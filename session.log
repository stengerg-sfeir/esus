ion,\\n\"\n42:     \"                'expense_date': expense.expense_date,\\n\"\n43:     \"                'category_id': expense.category_id,\\n\"\n44:     \"                'payment_method': expense.payment_method,\\n\"\n45:     \"                'is_recurring': expense.is_recurring\\n\"\n46:     \"            })\\n\"\n47:     \"```\",\n48:     # 2. ExpenseService.detect_recurring\n49:     \"        expenses = self._repos['ExpenseRepository'].read_all_expenses()\\n\"\n50:     \"        recurring_expenses = []\\n\"\n51:     \"\\n\"\n52:     \"        for expense in expenses:\\n\"\n53:     \"            if expense.is_recurring:\\n\"\n54:     \"                continue\\n\"\n55:     \"\\n\"\n56:     \"            category_id = expense.category_id\\n\"\n57:     \"            category_expenses = self._repos['ExpenseRepository'].read_expenses_by_category(category_id)\\n\"\n58:     \"\\n\"\n59:     \"            # Group expenses by month\\n\"\n60:     \"            monthly_expenses = {}\\n\"\n61:     \"            for exp in category_expenses:\\n\"\n62:     \"                month = exp.expense_date[:7]  # Format as YYYY-MM\\n\"\n63:     \"                if month not in monthly_expenses:\\n\"\n64:     \"                    monthly_expenses[month] = []\\n\"\n65:     \"                monthly_expenses[month].append(exp)\\n\"\n66:     \"\\n\"\n67:     \"            # Check for recurring pattern\\n\"\n68:     \"            for month, expenses_in_month in monthly_expenses.items():\\n\"\n69:     \"                if len(expenses_in_month) > 1:\\n\"\n70:     \"                    # Check if all expenses in the month have the same amount\\n\"\n71:     \"                    amounts = [exp.amount_cents for exp in expenses_in_month]\\n\"\n72:     \"                    if len(set(amounts)) == 1:\\n\"\n73:     \"                        # Check if the same amount appears in consecutive months\\n\"\n74:     \"                        for i in range(len(monthly_expenses) - 1):\\n\"\n75:
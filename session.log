            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/generator.py, lines 1-910\n1: #!/usr/bin/env python3\n2: \"\"\"Generate a runnable Python program from extraction output.\n3: \n4: The probe proves the documents agree; this writes the program they describe:\n5: \n6:     python generator.py out/expenses\n7: \n8: writes `out/expenses/generated/` — `models.py`, `errors.py`, `store.py`,\n9: `repositories.py`, `services.py`, `cli.py` — and refuses (exit 1) when the\n10: probe reports blockers or open ties, because generating from a document the\n11: probe rejects means inventing code silently.\n12: \n13: Bodies follow one rule per method (`kernel.codegen.plan_method`, which itself\n14: follows `kernel.tie_rules.effective_directive` — there is one definition, and\n15: this file does not reimplement it):\n16: \n17: - mechanical CRUD and filters run on an in-memory `Store`;\n18: - services delegate to the repository method of the same name;\n19: - everything else (aggregates, guards, exports, gaps, open ties) is a\n20:   `raise NotImplementedError` stub carrying its directive and refusal reason\n21:   in the docstring: a work order for the LLM pass, never an invented body.\n22: \n23: The CLI backend is `argparse` (stdlib) regardless of the declared technology —\n24: porting to click/pyimgui is later work, stated in the package docstring — and\n25: each `(command, subcommand)` is bound to the adapter that serves its verb, the\n26: binding baked into `cli.py` with its score beside it.\n27: \"\"\"\n28: \n29: import argparse\n30: import os\n31: import re\n32: import sys\n33: \n34: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n35: \n36: import probe_readiness  # noqa: E402\n37: from kernel import codegen  # noqa: E402\n38: from kernel.consistency.checks_surface import COMMAND_VERB_STEMS  # noqa: E402\n39: from kernel.consistency.loader import load_documents  # noqa: E402\n40: from kernel.consistency.naming import normalize  # noqa: E402\n41: from kernel.consistency.report import Report  # noqa: E402\n42: \n43: GENERATED_DIR = \"generated\"\n44: \n45: \n46: # --------------------------------------------------------------------------\n47: # document access\n48: # --------------------------------------------------------------------------\n49: \n50: def load_context(output_dir):\n51:     \"\"\"The generation context: every body plus the indexes the emitters need.\"\"\"\n52:     report = Report(os.path.basename(output_dir.rstrip(os.sep)))\n53:     documents = load_documents(output_dir, report)\n54:     models = [m for m in (documents.get(\"data_models\") or []) if isinstance(m, dict) and m.get(\"name\")]\n55:     errors = [e for e in (documents.get(\"errors\") or []) if isinstance(e, dict) and e.get(\"name\")]\n56:     services = [s for s in (documents.get(\"service_contracts\") or []) if isinstance(s, dict) and s.get(\"service_name\")]\n57:     ports = documents.get(\"persistence_ports\")\n58:     repositories = []\n59:     if isinstance(ports, dict) and isinstance(ports.get(\"repositories\"), list):\n60:         repositories = [r for r in ports[\"repositories\"] if isinstance(r, dict) and r.get(\"entity\")]\n61:     mappings = {}\n62:     if isinstance(ports, dict) and isinstance(ports.get(\"entity_mappings\"), list):\n63:         for mapping in ports[\"entity_mappings\"]:\n64:             if isinstance(mapping, dict) and mapping.get(\"entity\"):\n65:                 mappings[normalize(mapping[\"entity\"])] = mapping\n66:     matches = documents.get(\"pattern_matches\")\n67:     if not isinstance(matches, list):\n68:         matches = []\n69:     match_index = {}\n70:     for entry in matches:\n71:         if isinstance(entry, dict) and entry.get(\"source\"):\n72:             match_index[entry[\"source\"]] = entry\n73:     adapters = [a for a in (documents.get(\"interaction_adapters\") or []) if isinstance(a, dict) and a.get(\"action_name\")]\n74:     components = documents.get(\"components\")\n75:     if not isinstance(components, dict):\n76:         components = {}\n77:     return {\n78:         \"models\": models,\n79:         \"errors\": errors,\n80:         \"services\": services,\n81:         \"repositories\": repositories,\n82:         \"mappings\": mappings,\n83:         \"match_index\": match_index,\n84:         \"adapters\": adapters,\n85:         \"components\": components,\n86:         \"entity_names\": [m[\"name\"] for m in models],\n87:     }\n88: \n89: \n90: def model_of(ctx, entity_ref):\n91:     \"\"\"The data model for an entity name, matched leniently, or None.\"\"\"\n92:     if not entity_ref:\n93:         return None\n94:     wanted = normalize(entity_ref)\n95:     for model in ctx[\"models\"]:\n96:         if normalize(model[\"name\"]) == wanted:\n97:             return model\n98:     return None\n99: \n100: \n101: def primary_key_of(ctx, entity):\n102:     \"\"\"The mapping's primary key, else the model's, else `id`.\"\"\"\n103:     mapping = ctx[\"mappings\"].get(normalize(entity or \"\"))\n104:     if isinstance(mapping, dict) and mapping.get(\"primary_key\"):\n105:         return mapping[\"primary_key\"]\n106:     model = model_of(ctx, entity)\n107:     if model:\n108:         for field in model.get(\"fields\") or []:\n109:             if isinstance(field, dict) and field.get(\"primary_key\") and field.get(\"name\"):\n110:                 return field[\"name\"]\n111:     return \"id\"\n112: \n113: \n114: def fields_of(ctx, entity):\n115:     \"\"\"The `(name, field)` pairs of a model, or [] for unknown entities.\"\"\"\n116:     model = model_of(ctx, entity)\n117:     if not model or not isinstance(model.get(\"fields\"), list):\n118:         return []\n119:     return [(f[\"name\"], f) for f in model[\"fields\"] if isinstance(f, dict) and f.get(\"name\")]\n120: \n121: \n122: def _registered_error(ctx, entity):\n123:     \"\"\"A registered `*NotFound*`/`*Missing*` class mentioning the entity, or None.\"\"\"\n124:     wanted = normalize(entity or \"\")\n125:     for error in ctx[\"errors\"]:\n126:         name = error[\"name\"]\n127:         flat = normalize(name)\n128:         if wanted and wanted in flat and (\"notfound\" in flat or \"missing\" in flat):\n129:             return name\n130:     return None\n131: \n132: \n133: def method_error(ctx, method, entity):\n134:     \"\"\"The error expression for a lookup failure: the method's own first.\"\"\"\n135:     raises = [r for r in (method.get(\"raises\") or []) if isinstance(r, str)]\n136:     registered = {e[\"name\"] for e in ctx[\"errors\"]}\n137:     raises = [r for r in raises if r in registered]\n138:     wanted = normalize(entity or \"\")\n139:     for name in raises:\n140:         if wanted and wanted in normalize(name):\n141:             return f\"errors.{codegen.sanitize(name)}\"\n142:     if raises:\n143:         return f\"errors.{codegen.sanitize(raises[0])}\"\n144:     entity_error = _registered_error(ctx, entity)\n145:     if entity_error:\n146:         return f\"errors.{codegen.sanitize(entity_error)}\"\n147:     return \"LookupError\"\n148: \n149: \n150: # --------------------------------------------------------------------------\n151: # file emitters (each returns its text)\n152: # --------------------------------------------------------------------------\n153: \n154: HEADER_IMPORTS = \"\"\"from dataclasses import dataclass\n155: from decimal import Decimal\n156: import datetime\n157: from typing import Any, Dict, List, Optional\n158: \"\"\"\n159: \n160: \n161: def emit_init(ctx, stats):\n162:     lines = ['\"\"\"Generated program. Do not edit by hand: regenerate with `generator.py`.\"\"\"',\n163:              \"\",\n164:              f\"Source documents: {stats['source']}\",\n165:              f\"Methods: {stats['implemented']} implemented, {stats['stubs']} stubs \"\n166:              \"(each stub names its work order in its docstring).\",\n167:              \"CLI backend is argparse (stdlib); the declared facade technology is\",\n168:              \"recorded in the documents and porting the CLI to it is later work.\",\n169:              \"\"]\n170:     return \"\\n\".join(lines) + \"\\n\"\n171: \n172: \n173: def emit_models(ctx):\n174:     lines = ['\"\"\"Data models. Every field defaults to None: the store assigns integer',\n175:              'primary keys on insert, and updates merge only non-None values.\"\"\"',\n176:              \"\", HEADER_IMPORTS.strip(), \"\"]\n177:     for model in ctx[\"models\"]:\n178:         cls = codegen.sanitize(model[\"name\"], \"Model\")\n179:         lines += [\"\", \"\", \"@dataclass\", f\"class {cls}:\"]\n180:         fields = fields_of(ctx, model[\"name\"])\n181:         if not fields:\n182:             lines.append(\"    pass\")\n183:             continue\n184:         for name, field in fields:\n185:             pytype = codegen.map_type(field.get(\"type\"), ctx[\"entity_names\"])\n186:             if field.get(\"nullable\"):\n187:                 pytype = f\"Optional[{pytype}]\"\n188:             lines.append(f\"    {codegen.sanitize(name)}: {pytype} = None\")\n189:     return \"\\n\".join(lines) + \"\\n\"\n190: \n191: \n192: def emit_errors(ctx):\n193:     lines = ['\"\"\"Application errors, one class per registered failure.\"\"\"', \"\"]\n194:     if not ctx[\"errors\"]:\n195:         lines += [\"\", \"class AppError(Exception):\", '    \"\"\"Fallback when no errors were registered.\"\"\"', \"\"]\n196:         return \"\\n\".join(lines) + \"\\n\"\n197:     for error in ctx[\"errors\"]:\n198:         cls = codegen.sanitize(error[\"name\"], \"AppError\")\n199:         base = error.get(\"base\") if isinstance(error.get(\"base\"), str) and error[\"base\"].strip() else \"Exception\"\n200:         description = (error.get(\"description\") or \"\").strip()\n201:         lines += [\"\", \"\", f\"class {cls}({codegen.sanitize(base, 'Exception')}):\"]\n202:         lines.append(f'    \"\"\"{description}\"\"\"' if description else \"    pass\")\n203:     return \"\\n\".join(lines) + \"\\n\"\n204: \n205: \n206: def _signature(method, entity_names):\n207:     \"\"\"`(declaration, [(raw_name, ident, raw_type)])`, all defaulting to None.\"\"\"\n208:     parts = []\n209:     params = []\n210:     for param in method.get(\"params\") or []:\n211:         if not isinstance(param, dict):\n212:             continue\n213:         raw = param.get(\"name\") if isinstance(param.get(\"name\"), str) else \"\"\n214:         ident = codegen.sanitize(raw, \"param\")\n215:         ptype = param.get(\"type\")\n216:         params.append((raw, ident, ptype))\n217:         parts.append(f\"{ident}: {_qualify(codegen.map_type(ptype, entity_names), entity_names)} = None\")\n218:     return \", \".join(parts), params\n219: \n220: \n221: def _return_of(method, entity_names):\n222:     return _qualify(codegen.map_type(method.get(\"return_type\"), entity_names), entity_names)\n223: \n224: \n225: def _qualify(pytype, entity_names):\n226:     \"\"\"Prefix bare entity references with `models.` so annotations resolve.\"\"\"\n227:     if not isinstance(pytype, str) or not entity_names:\n228:         return pytype\n229:     names = sorted({n for n in entity_names if isinstance(n, str)}, key=len, reverse=True)\n230:     if not names:\n231:         return pytype\n232:     pattern = re.compile(r\"(?<![\\w.])(\" + \"|\".join(re.escape(n) for n in names) + r\")\\b\")\n233:     return pattern.sub(r\"models.\\1\", pytype)\n234: \n235: \n236: def _repo_index(ctx):\n237:     \"\"\"Normalized repo method name -> `[(repo_class, method)]` in ports order.\"\"\"\n238:     index = {}\n239:     for repo in ctx[\"repositories\"]:\n240:         cls = codegen.sanitize(repo.get(\"interface_name\") or repo.get(\"entity\"), \"Repository\")\n241:         for method in repo.get(\"methods\") or []:\n242:             if isinstance(method, dict) and method.get(\"name\"):\n243:                 index.setdefault(normalize(method[\"name\"]), []).append((cls, method))\n244:     return index\n245: \n246: \n247: def _service_delegate(ctx, method, repo_index):\n248:     \"\"\"The `(repo_class, repo_method)` of the same normalized name, or None.\n249: \n250:     Several repositories may declare one name; the one whose entity the method\n251:     names wins, else ports order decides — recorded in a comment beside the call.\n252:     \"\"\"\n253:     candidates = repo_index.get(normalize(method.get(\"name\") or \"\"), [])\n254:     if not candidates:\n255:         return None\n256:     if len(candidates) == 1:\n257:         return candidates[0]\n258:     haystack = normalize(method.get(\"name\") or \"\")\n259:     for cls, candidate in candidates:\n260:         _ = candidate\n261:         entity_hit = next((r.get(\"entity\") or \"\" for r in ctx[\"repositories\"]\n262:                            if codegen.sanitize(r.get(\"interface_name\") or r.get(\"entity\")) == cls), \"\")\n263:         if entity_hit and normalize(entity_hit) in haystack:\n264:             return (cls, candidate)\n265:     return sorted(candidates, key=lambda item: item[0])[0]\n266: \n267: \n268: def _fk_checks(ctx, entity):\n269:     \"\"\"`[(field, target_entity, target_field, ErrorOrNone)]` for a model's FKs.\"\"\"\n270:     checks = []\n271:     for name, field in fields_of(ctx, entity):\n272:         foreign = field.get(\"foreign_key\")\n273:         if not isinstance(foreign, dict) or not foreign.get(\"target_entity\"):\n274:             continue\n275:         err = _registered_error(ctx, foreign[\"target_entity\"])\n276:         checks.append((name, foreign[\"target_entity\"],\n277:                        foreign.get(\"target_field\") or \"id\",\n278:                        f\"errors.{codegen.sanitize(err)}\" if err else \"None\"))\n279:     return checks\n280: \n281: \n282: def _match_entry(ctx, holder_name, method_name):\n283:     return ctx[\"match_index\"].get(f\"contract:{holder_name}.{method_name}\")\n284: \n285: \n286: def _docstring(text):\n287:     return (text or \"\").strip().replace('\"\"\"', '\"')\n288: \n289: \n290: def emit_repositories(ctx, stats):\n291:     \"\"\"Repository classes with mechanical bodies.\"\"\"\n292:     lines = ['\"\"\"Repositories over an in-memory Store, one class per persistence port.',\n293:              \"\",\n294:              \"CRUD, reads and filters run for real. Anything else raises\",\n295:              \"NotImplementedError with its work order — an aggregate or guard body\",\n296:              \"is specified by its pattern, not invented here.\",\n297:              '\"\"\"',\n298:              \"\",\n299:              \"import models\",\n300:              \"import errors\",\n301:              \"from store import Store, match_criterion\",\n302:              \"\",\n303:              \"\",\n304:              \"def _record_values(data, field_names):\",\n305:              '    \"\"\"A dataclass or dict entity argument as a `{field: value}` dict.\"\"\"',\n306:              \"    if data is None:\",\n307:              \"        return {}\",\n308:              \"    if isinstance(data, dict):\",\n309:              \"        return {name: data.get(name) for name in field_names}\",\n310:              \"    return {name: getattr(data, name, None) for name in field_names}\",\n311:              \"\"]\n312:     for repo in ctx[\"repositories\"]:\n313:         entity = repo.get(\"entity\")\n314:         holder = repo.get(\"interface_name\") or entity\n315:         cls = codegen.sanitize(holder, \"Repository\")\n316:         pk = primary_key_of(ctx, entity)\n317:         model_cls = None\n318:         if model_of(ctx, entity):\n319:             model_cls = f\"models.{codegen.sanitize(entity, 'Model')}\"\n320:         field_names = [name for name, _ in fields_of(ctx, entity)]\n321:         fk_checks = _fk_checks(ctx, entity)\n322:         fk_literal = \"[\" + \", \".join(\n323:             f'(\"{f}\", \"{t}\", \"{tf}\", {e})' for f, t, tf, e in fk_checks) + \"]\"\n324:         lines += [\"\", \"\", f\"class {cls}:\",\n325:                   f'    ENTITY = \"{entity}\"',\n326:                   f'    PK = \"{pk}\"',\n327:                   \"\",\n328:                   \"    def __init__(self, store):\",\n329:                   \"        self._store = store\",\n330:                   \"\"]\n331:         for method in repo.get(\"methods\") or []:\n332:             if not isinstance(method, dict) or not method.get(\"name\"):\n333:                 continue\n334:             strategy, detail = codegen.plan_method(\n335:                 method, _match_entry(ctx, holder, method[\"name\"]), ctx[\"entity_names\"])\n336:             fname = codegen.sanitize(method[\"name\"], \"method\")\n337:             declaration, params = _signature(method, ctx[\"entity_names\"])\n338:             returns = _return_of(method, ctx[\"entity_names\"])\n339:             lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n340:                       f'        \"\"\"{_docstring(method.get(\"description\"))} [{strategy}: {detail}]\"\"\"']\n341:             body = _repo_body(ctx, strategy, detail, method, params, entity,\n342:                               model_cls, field_names, pk, fk_literal)\n343:             lines.extend(\"        \" + line if line else \"\" for line in body)\n344:             if strategy.startswith(\"crud:\"):\n345:                 stats[\"implemented\"] += 1\n346:             else:\n347:                 stats[\"stubs\"] += 1\n348:                 stats[\"stub_reasons\"].append(f\"{cls}.{fname}: {detail}\")\n349:     return \"\\n\".join(lines) + \"\\n\"\n350: \n351: \n352: def _repo_body(ctx, strategy, detail, method, params, entity, model_cls, field_names, pk, fk_literal):\n353:     \"\"\"The statement list of one repository method.\"\"\"\n354:     kind = strategy[5:] if strategy.startswith(\"crud:\") else None\n355:     err = method_error(ctx, method, entity)\n356:     if kind == \"create\":\n357:         return _create_body(ctx, method, params, entity, model_cls, field_names, fk_literal)\n358:     if kind == \"read_one\":\n359:         return _read_one_body(params, entity, model_cls, field_names, err)\n360:     if kind in (\"read_all\", \"filter\"):\n361:         return _select_body(params, entity, model_cls, field_names)\n362:     if kind == \"update\":\n363:         return _update_body(ctx, method, params, entity, model_cls, field_names, err)\n364:     if kind == \"delete\":\n365:         return _delete_body(params, entity, field_names, err)\n366:     name = method.get(\"name\") if isinstance(method.get(\"name\"), str) else \"?\"\n367:     return [\"raise NotImplementedError(\",\n368:             f'    \"{entity}.{name}: {strategy}: {detail}\")']\n369: \n370: \n371: def _entity_params(params, entity_names):\n372:     \"\"\"Split `(raw, ident, type)` params into `(entity_param|None, scalars)`.\"\"\"\n373:     entity_param = None\n374:     scalars = []\n375:     for raw, ident, ptype in params:\n376:         if entity_param is None and codegen.is_entity_type(ptype, entity_names):\n377:             entity_param = (raw, ident)\n378:         else:\n379:             scalars.append((raw, ident))\n380:     return entity_param, scalars\n381: \n382: \n383: def _result_wrap(model_cls):\n384:     if model_cls is None:\n385:         return \"return record\"\n386:     return f\"return {model_cls}(**record)\"\n387: \n388: \n389: def _create_body(ctx, method, params, entity, model_cls, field_names, fk_literal):\n390:     entity_param, scalars = _entity_params(params, ctx[\"entity_names\"])\n391:     lines = []\n392:     if entity_param is not None and not scalars:\n393:         lines.append(f\"values = _record_values({entity_param[1]}, {field_names!r})\")\n394:     else:\n395:         lines.append(\"values = {}\")\n396:         if entity_param is not None:\n397:             lines.append(f\"values.update(_record_values({entity_param[1]}, {field_names!r}))\")\n398:         for raw, ident in scalars:\n399:             lines.append(f\"if {ident} is not None:\")\n400:             lines.append(f\"    values[{raw!r}] = {ident}\")\n401:         lines.append(f\"unknown = [k for k in values if k not in {field_names!r}]\")\n402:         lines.append(\"if unknown:\")\n403:         lines.append(f\"    raise ValueError(f\\\"cannot create {entity} from {{unknown}}\\\")\")\n404:     lines.append(f\"record = self._store.add(self.ENTITY, self.PK, values, check_fk={fk_literal})\")\n405:     lines.append(_result_wrap(model_cls))\n406:     return lines\n407: \n408: \n409: def _criteria_block(params, entity, field_names):\n410:     \"\"\"`criteria = [...]`; each param is `(raw, ident[, type])`, `None` skipped.\"\"\"\n411:     lines = [\"criteria = []\"]\n412:     for item in params:\n413:         raw, ident = item[0], item[1]\n414:         lines.append(f\"if {ident} is not None:\")\n415:         lines.append(f\"    matched = match_criterion({field_names!r}, {raw!r})\")\n416:         lines.append(\"    if matched is None:\")\n417:         lines.append(f\"        raise ValueError(f\\\"cannot filter {entity} by {raw!r}\\\")\")\n418:         lines.append(\"    field, operator = matched\")\n419:         lines.append(f\"    criteria.append((field, operator, {ident}))\")\n420:     return lines\n421: \n422: \n423: def _read_one_body(params, entity, model_cls, field_names, err):\n424:     if len(params) == 1:\n425:         lines = [f\"record = self._store.get(self.ENTITY, self.PK, {params[0][1]}, error={err})\"]\n426:     else:\n427:         lines = _criteria_block(params, entity, field_names)\n428:         lines += [\"found = self._store.select(self.ENTITY, criteria)\",\n429:                   \"if len(found) != 1:\",\n430:                   f\"    raise {err}(f\\\"{entity} lookup matched {{len(found)}} records\\\")\",\n431:                   \"record = found[0]\"]\n432:     lines.append(_result_wrap(model_cls))\n433:     return lines\n434: \n435: \n436: def _select_body(params, entity, model_cls, field_names):\n437:     lines = _criteria_block(params, entity, field_names)\n438:     lines.append(\"found = self._store.select(self.ENTITY, criteria)\")\n439:     if model_cls is None:\n440:         lines.append(\"return [dict(r) for r in found]\")\n441:     else:\n442:         lines.append(f\"return [{model_cls}(**r) for r in found]\")\n443:     return lines\n444: \n445: \n446: def _update_body(ctx, method, params, entity, model_cls, field_names, err):\n447:     entity_param, scalars = _entity_params(params, ctx[\"entity_names\"])\n448:     if not scalars:\n449:         return [\"raise ValueError(\",\n450:                 f\"    \\\"{entity}.{method.get('name')}: update needs key parameters\\\")\"]\n451:     lines = _criteria_block(scalars, entity, field_names)\n452:     lines += [\"found = self._store.select(self.ENTITY, criteria)\",\n453:               \"if len(found) != 1:\",\n454:               f\"    raise {err}(f\\\"{entity} update matched {{len(found)}} records\\\")\",\n455:               \"patch = {}\"]\n456:     if entity_param is not None:\n457:         lines.append(f\"for key, value in _record_values({entity_param[1]}, {field_names!r}).items():\")\n458:         lines.append(\"    if value is not None:\")\n459:         lines.append(\"        patch[key] = value\")\n460:     for raw, ident in scalars:\n461:         lines.append(f\"if {ident} is not None and {raw!r} in {field_names!r}:\")\n462:         lines.append(f\"    patch[{raw!r}] = {ident}\")\n463:     lines.append(f\"record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error={err})\")\n464:     lines.append(_result_wrap(model_cls))\n465:     return lines\n466: \n467: \n468: def _delete_body(params, entity, field_names, err):\n469:     if not params:\n470:         return [\"raise ValueError(\",\n471:                 f\"    \\\"{entity}: delete needs key parameters\\\")\"]\n472:     lines = _criteria_block(params, entity, field_names)\n473:     lines += [\"found = self._store.select(self.ENTITY, criteria)\",\n474:               \"if not found:\",\n475:               f\"    raise {err}(f\\\"{entity} delete matched no records\\\")\",\n476:               \"for record in found:\",\n477:               \"    self._store.delete(self.ENTITY, self.PK, record[self.PK])\",\n478:               \"return None\"]\n479:     return lines\n480: \n481: \n482: # --------------------------------------------------------------------------\n483: # services (delegate on exact same-name repo methods, else stub)\n484: # --------------------------------------------------------------------------\n485: \n486: def emit_services(ctx, repo_index, stats):\n487:     \"\"\"Service classes: same-name delegation or documented stubs.\"\"\"\n488:     lines = ['\"\"\"Services. A method with the same name as a repository method delegates',\n489:              \"to it; anything else raises NotImplementedError with its work order.\",\n490:              '\"\"\"',\n491:              \"\",\n492:              \"import models\",\n493:              \"import errors\",\n494:              \"\"]\n495:     port_names = {normalize(r.get(\"interface_name\") or \"\") for r in ctx[\"repositories\"]}\n496:     for service in ctx[\"services\"]:\n497:         name = service.get(\"service_name\")\n498:         if normalize(name) in port_names:\n499:             continue\n500:         cls = codegen.sanitize(name, \"Service\")\n501:         lines += [\"\", \"\", f\"class {cls}:\",\n502:                   \"\",\n503:                   \"    def __init__(self, repos):\",\n504:                   \"        self._repos = repos\",\n505:                   \"\"]\n506:         for method in service.get(\"methods\") or []:\n507:             if not isinstance(method, dict) or not method.get(\"name\"):\n508:                 continue\n509:             strategy, detail = codegen.plan_method(\n510:                 method, _match_entry(ctx, name, method[\"name\"]), ctx[\"entity_names\"])\n511:             fname = codegen.sanitize(method[\"name\"], \"method\")\n512:             declaration, params = _signature(method, ctx[\"entity_names\"])\n513:             returns = _return_of(method, ctx[\"entity_names\"])\n514:             delegate = _service_delegate(ctx, method, repo_index)\n515:             if delegate is not None and strategy.startswith(\"crud:\"):\n516:                 target_cls, _ = delegate\n517:                 call = \", \".join(ident for _, ident, _ in params)\n518:                 lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n519:                           f'        \"\"\"{_docstring(method.get(\"description\"))} [delegates to {target_cls}.{fname}]\"\"\"',\n520:                           f\"        return self._repos[{target_cls!r}].{fname}({call})\"]\n521:                 stats[\"implemented\"] += 1\n522:                 continue\n523:             if delegate is not None:\n524:                 where = f\" [same-name repo method on {delegate[0]} is {detail}]\"\n525:             elif strategy.startswith(\"crud:\"):\n526:                 where = \" [no same-name repository method to delegate to]\"\n527:             else:\n528:                 where = f\" [{detail}]\"\n529:             lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n530:                       f'        \"\"\"{_docstring(method.get(\"description\"))}{where}\"\"\"',\n531:                       \"        raise NotImplementedError(\",\n532:                       f'            \"{cls}.{fname}: {detail}\")']\n533:             stats[\"stubs\"] += 1\n534:             stats[\"stub_reasons\"].append(f\"{cls}.{fname}: {detail}\")\n535:     return \"\\n\".join(lines) + \"\\n\"\n536: \n537: \n538: # --------------------------------------------------------------------------\n539: # CLI verbs -> adapters (one scoring rule, baked into cli.py with its scores)\n540: # --------------------------------------------------------------------------\n541: \n542: def _emit_options(indent, parser_var, options, stats):\n543:     \"\"\"`add_argument` lines; argparse already owns `help`/`version`.\n544: \n545:     A flag string taken twice on one parser (the documents give `-a` to two\n546:     options of `book list`) cannot register twice: the option keeps its free\n547:     strings, or is skipped with none left — reported, since one flag goes\n548:     unreachable either way.\n549:     \"\"\"\n550:     lines = []\n551:     seen = set()\n552:     taken = {\"-h\", \"--help\"}\n553:     for option in options or []:\n554:         if not isinstance(option, dict):\n555:             continue\n556:         raw = (option.get(\"name\") or option.get(\"short\") or \"\").strip()\n557:         if not raw.startswith(\"-\"):\n558:             raw = \"--\" + raw if raw else \"\"\n559:         if not raw:\n560:             continue\n561:         if raw.lstrip(\"-\").lower() in (\"help\", \"version\"):\n562:             stats.setdefault(\"skipped_options\", []).append(raw)\n563:             continue\n564:         dest = codegen.sanitize(raw.lstrip(\"-\").replace(\"-\", \"_\"), \"opt\")\n565:         if dest in seen:\n566:             continue\n567:         seen.add(dest)\n568:         flags = [raw]\n569:         short = (option.get(\"short\") or \"\").strip()\n570:         if short and short != raw:\n571:             flags.append(short)\n572:         flags = [f for f in flags if f not in taken]\n573:         if not flags:\n574:             stats.setdefault(\"skipped_options\", []).append(f\"{raw} (all flag strings taken)\")\n575:             continue\n576:         taken.update(flags)\n577:         otype = (option.get(\"type\") or \"str\").strip().lower()\n578:         required = bool(option.get(\"required\"))\n579:         default = option.get(\"default\")\n580:         parts = [f\"{flag!r}\" for flag in flags]\n581:         if otype == \"bool\":\n582:             parts.append(\"action='store_true'\" if not default else \"action='store_false'\")\n583:             if default:\n584:                 parts.append(\"default=True\")\n585:         elif otype == \"list\":\n586:             parts.append(\"nargs='*'\")\n587:             if default is not None:\n588:                 parts.append(f\"default={default!r}\")\n589:         else:\n590:             parts.append(f\"type={ {'str': 'str', 'int': 'int', 'float': 'float'}.get(otype, 'str')}\")\n591:             parts.append(f\"required={required!r}\")\n592:             if default is not None:\n593:                 parts.append(f\"default={default!r}\")\n594:         parts.append(f\"dest={dest!r}\")\n595:         lines.append(f\"{indent}{parser_var}.add_argument({', '.join(parts)})\")\n596:     return lines\n597: \n598: \n599: def emit_cli(ctx, bindings, stats):\n600:     \"\"\"An argparse CLI: every declared verb parses; bound verbs dispatch.\"\"\"\n601:     repo_classes = [codegen.sanitize(r.get(\"interface_name\") or r.get(\"entity\"), \"Repository\")\n602:                     for r in ctx[\"repositories\"]]\n603:     port_names = {normalize(r.get(\"interface_name\") or \"\") for r in ctx[\"repositories\"]}\n604:     service_classes = [codegen.sanitize(s[\"service_name\"], \"Service\") for s in ctx[\"services\"]\n605:                        if normalize(s[\"service_name\"]) not in port_names]\n606:     model_names = [codegen.sanitize(m[\"name\"], \"Model\") for m in ctx[\"models\"]]\n607:     actions = {a[\"action_name\"]: a for a in ctx[\"adapters\"]}\n608:     invocation = (ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}\n609:     argv = codegen.action_argv(ctx[\"adapters\"], bindings, invocation)\n610:     targets = codegen.action_targets(ctx[\"adapters\"], ctx[\"services\"], ctx[\"repositories\"], ctx[\"entity_names\"])\n611:     assembled = {}\n612:     for name, adapter in actions.items():\n613:         assembled[name] = [\n614:             f[\"field_name\"] for f in adapter.get(\"input_fields\") or []\n615:             if isinstance(f, dict) and f.get(\"field_name\")\n616:             and codegen.is_assembly_field(adapter, f[\"field_name\"], targets.get(name, {}))]\n617:     lines = ['\"\"\"Command line. Every declared verb parses; bound verbs dispatch to',\n618:              \"their adapter's service method, unbound ones fail with the reason.\",\n619:              \"\",\n620:              \"Transforms follow the adapter document: DIRECT passes through, ISO_DATE\",\n621:              \"validates ISO format, DECIMAL_TO_CENTS converts money to integer cents,\",\n622:              \"CSV_LIST splits on commas, LOOKUP_ID coerces to int (existence is\",\n623:              \"enforced by the repository's foreign-key check on write, or by the\",\n624:              \"record lookup itself on read).\",\n625:              '\"\"\"',\n626:              \"\",\n627:              \"import argparse\",\n628:              \"import dataclasses\",\n629:              \"import datetime\",\n630:              \"import json\",\n631:              \"import sys\",\n632:              \"\",\n633:              \"import models\",\n634:              \"import errors\",\n635:              \"from store import Store\",\n636:              \"import repositories\",\n637:              \"import services\",\n638:              \"\",\n639:              \"\",\n640:              \"MODELS = \" + repr(model_names),\n641:              \"REPOSITORIES = \" + repr(repo_classes),\n642:              \"SERVICES = \" + repr(service_classes),\n643:              \"\",\n644:              \"\",\n645:              \"def _transform(kind, value, field):\",\n646:              '    if kind == \"DIRECT\" or value is None:',\n647:              \"        return value\",\n648:              '    if kind == \"ISO_DATE\":',\n649:              \"        datetime.date.fromisoformat(str(value))\",\n650:              \"        return value\",\n651:              '    if kind == \"DECIMAL_TO_CENTS\":',\n652:              \"        return int(round(float(value) * 100))\",\n653:              '    if kind == \"CSV_LIST\":',\n654:               \"        items = value if isinstance(value, list) else [value]\",\n655:               \"        split = []\",\n656:               \"        for part in items:\",\n657:               \"            split.extend(p.strip() for p in str(part).split(\\\",\\\") if p.strip())\",\n658:               \"        return split\",\n659:              '    if kind == \"LOOKUP_ID\":',\n660:              \"        return int(value)\",\n661:              '    if kind == \"ENUM_LOOKUP\":',\n662:              \"        return str(value)\",\n663:              '    raise ValueError(f\"unknown transform {kind!r} for {field!r}\")',\n664:              \"\",\n665:              \"\",\n666:              \"def _show(result):\",\n667:              \"    if result is None:\",\n668:              \"        return\",\n669:              \"    if isinstance(result, list):\",\n670:              \"        for item in result:\",\n671:              \"            _show(item)\",\n672:              \"        return\",\n673:              \"    if dataclasses.is_dataclass(result):\",\n674:              \"        print(json.dumps(dataclasses.asdict(result), default=str))\",\n675:              \"        return\",\n676:              \"    print(result)\",\n677:              \"\",\n678:              \"\",\n679:              \"ADAPTERS = {\"]\n680:     for name in sorted(actions):\n681:         adapter = actions[name]\n682:         lines.append(f\"    {name!r}: {{\")\n683:         lines.append(f\"        'service': {adapter.get('target_service')!r},\")\n684:         lines.append(f\"        'method': {adapter.get('target_method')!r},\")\n685:         lines.append(\"        'fields': [\")\n686:         for field in adapter.get(\"input_fields\") or []:\n687:             if not isinstance(field, dict):\n688:                 continue\n689:             lines.append(\n690:                 f\"            ({field.get('field_name')!r}, \"\n691:                 f\"({field.get('target_param')!r}, {field.get('transform')!r}, \"\n692:                 f\"{bool(field.get('required'))!r})),\")\n693:         lines.append(\"        ],\")\n694:         lines.append(f\"        'argv': {argv.get(name, {})!r},\")\n695:         lines.append(f\"        'targets': {targets.get(name, {})!r},\")\n696:         lines.append(f\"        'assembled': {assembled.get(name, [])!r},\")\n697:         lines.append(\"    },\")\n698:         for field in adapter.get(\"input_fields\") or []:\n699:             if not isinstance(field, dict) or not field.get(\"field_name\"):\n700:                 continue\n701:             if argv.get(name, {}).get(field[\"field_name\"]) is None:\n702:                 stats.setdefault(\"unbound_fields\", []).append(\n703:                     f\"{name}.{field['field_name']} (required={bool(field.get('required'))})\")\n704:     lines.append(\"}\")\n705:     lines += [\"\", \"\", \"BINDINGS = {  # (command, subcommand) -> (action, score)\"]\n706:     for (command, sub), bound in sorted(bindings.items(), key=lambda item: str(item[0])):\n707:         if bound is None:\n708:             lines.append(f\"    {(command, sub)!r}: None,\")\n709:             stats[\"unmapped\"].append(f\"{command} {sub}\" if sub else f\"{command}\")\n710:         else:\n711:             action, score = bound\n712:             lines.append(f\"    {(command, sub)!r}: ({action!r}, {score}),\")\n713:     lines.append(\"}\")\n714:     lines += [\"\", \"\",\n715:               \"def _normalize(text):\",\n716:               '    return \"\".join(c for c in str(text).lower() if c.isalnum())',\n717:               \"\",\n718:               \"\",\n719:               \"def build_parser():\",\n720:               f\"    parser = argparse.ArgumentParser(prog={stats['prog']!r})\",\n721:               \"    sub = parser.add_subparsers(dest='command')\"]\n722:     invocation = (ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}\n723:     for command in invocation.get(\"commands\") or []:\n724:         if not isinstance(command, dict) or not command.get(\"name\"):\n725:             continue\n726:         cname = command[\"name\"]\n727:         cvar = codegen.sanitize(cname, \"cmd\")\n728:         subs = [s for s in (command.get(\"subcommands\") or [])\n729:                 if isinstance(s, dict) and s.get(\"name\")]\n730:         if not subs:\n731:             options = codegen.leaf_options(invocation, cname, None)\n732:             lines.append(f\"    p_{cvar} = sub.add_parser({cname!r})\")\n733:             lines.extend(_emit_options(\"    \", f\"p_{cvar}\", options, stats))\n734:             lines.append(\"    p_\" + cvar + \".set_defaults(_binding=\" + repr((cname, None)) + \")\")\n735:         else:\n736:             lines.append(f\"    p_{cvar} = sub.add_parser({cname!r})\")\n737:             lines.append(f\"    sub_{cvar} = p_{cvar}.add_subparsers(dest='subcommand')\")\n738:             for item in subs:\n739:                 sname = item[\"name\"]\n740:                 svar = codegen.sanitize(sname, \"sub\")\n741:                 options = codegen.leaf_options(invocation, cname, sname)\n742:                 lines.append(f\"    p_{cvar}_{svar} = sub_{cvar}.add_parser({sname!r})\")\n743:                 lines.extend(_emit_options(\"    \", f\"p_{cvar}_{svar}\", options, stats))\n744:                 lines.append(\"    p_\" + cvar + \"_\" + svar + \".set_defaults(_binding=\" + repr((cname, sname)) + \")\")\n745:     lines += [\"    return parser\",\n746:               \"\",\n747:               \"\",\n748:               \"def _call(bound, values, deps):\",\n749:               \"    action, _score = bound\",\n750:               \"    spec = ADAPTERS[action]\",\n751:               \"    service = deps['services'][_sanitize(spec['service'])]\",\n752:               \"    method = getattr(service, _sanitize(spec['method']))\",\n753:               \"    present = {_normalize(k): v for k, v in values.items()}\",\n754:               \"    argv = spec.get('argv', {})\",\n755:               \"    targets = spec.get('targets', {})\",\n756:               \"    assembled = set(spec.get('assembled', []))\",\n757:               \"    grouped = {}\",\n758:               \"    for field_name, (target_param, kind, required) in spec['fields']:\",\n759:               \"        if field_name in assembled:\",\n760:               \"            continue  # built from its sibling fields, not from argv\",\n761:               \"        dest = argv.get(field_name)\",\n762:               \"        if dest is None or present.get(_normalize(dest)) is None:\",\n763:               \"            if required:\",\n764:               \"                raise ValueError(f\\\"missing required field {field_name!r} for {action!r}\\\")\",\n765:               \"            continue\",\n766:               \"        value = _transform(kind, present[_normalize(dest)], field_name)\",\n767:               \"        if targets.get(target_param) is not None:\",\n768:               \"            grouped.setdefault(target_param, {})[field_name] = value\",\n769:               \"        else:\",\n770:               \"            grouped[target_param] = value\",\n771:               \"    call_kwargs = {}\",\n772:               \"    for target_param, value in grouped.items():\",\n773:               \"        model_name = targets.get(target_param)\",\n774:               \"        if model_name is not None and isinstance(value, dict):\",\n775:               \"            call_kwargs[_sanitize(target_param)] = getattr(models, model_name)(**value)\",\n776:               \"        else:\",\n777:               \"            call_kwargs[_sanitize(target_param)] = value\",\n778:               \"    return method(**call_kwargs)\",\n779:               \"\",\n780:               \"\",\n781:               \"def _sanitize(text):\",\n782:               '    cleaned = \"\".join(c if c.isalnum() or c == \"_\" else \"_\" for c in str(text))',\n783:               '    cleaned = cleaned.strip(\"_\") or \"opt\"',\n784:               '    return \"_\" + cleaned if cleaned[:1].isdigit() else cleaned',\n785:               \"\",\n786:               \"\",\n787:               \"def build_cli():\",\n788:               \"    store = Store()\",\n789:               \"    repos = {cls_name: getattr(repositories, cls_name)(store) for cls_name in REPOSITORIES}\",\n790:               \"    hired = {cls_name: getattr(services, cls_name)(repos) for cls_name in SERVICES}\",\n791:               \"    entities = {_normalize(name): getattr(models, name) for name in MODELS}\",\n792:               \"    return build_parser(), {'store': store, 'repos': repos,\",\n793:               \"                           'services': {**repos, **hired},\",\n794:               \"                           'entities': entities}\",\n795:               \"\",\n796:               \"\",\n797:               \"def main(argv=None):\",\n798:               \"    parser, deps = build_cli()\",\n799:               \"    return dispatch(parser, parser.parse_args(argv), deps)\",\n800:               \"\",\n801:               \"\",\n802:               \"def dispatch(parser, args, deps):\",\n803:               \"    \\\"\\\"\\\"Run one parsed command against shared dependencies.\\\"\\\"\\\"\",\n804:               \"    binding = getattr(args, '_binding', None)\",\n805:               \"    if binding is None:\",\n806:               \"        parser.print_usage()\",\n807:               \"        return 2\",\n808:               \"    bound = BINDINGS.get(tuple(binding))\",\n809:               \"    if bound is None:\",\n810:               \"        print(f\\\"no adapter bound for {' '.join(binding)} — not implemented\\\")\",\n811:               \"        return 1\",\n812:               \"    values = {key: value for key, value in vars(args).items()\",\n813:               \"              if key not in ('command', 'subcommand', '_binding')}\",\n814:               \"    try:\",\n815:               \"        _show(_call(bound, values, deps))\",\n816:               \"    except Exception as error:\",\n817:               \"        print(f\\\"error: {error}\\\")\",\n818:               \"        return 1\",\n819:               \"    return 0\",\n820:               \"\",\n821:               \"\",\n822:               'if __name__ == \"__main__\":',\n823:               \"    sys.exit(main())\",\n824:               \"\"]\n825:     return \"\\n\".join(lines) + \"\\n\"\n826: \n827: \n828: # --------------------------------------------------------------------------\n829: # assembly\n830: # --------------------------------------------------------------------------\n831: \n832: def render_program(ctx, stats):\n833:     \"\"\"Every file of the package as `{filename: text}`.\"\"\"\n834:     stats.setdefault(\"skipped_options\", [])\n835:     stats.setdefault(\"unmapped\", [])\n836:     repo_index = _repo_index(ctx)\n837:     files = {\n838:         \"models.py\": emit_models(ctx),\n839:         \"errors.py\": emit_errors(ctx),\n840:         \"repositories.py\": emit_repositories(ctx, stats),\n841:         \"services.py\": emit_services(ctx, repo_index, stats),\n842:     }\n843:     with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),\n844:                            \"kernel\", \"codegen_store_template.py\"),\n845:               encoding=\"utf-8\") as handle:\n846:         files[\"store.py\"] = handle.read()\n847:     from kernel.consistency.checks_surface import COMMAND_VERB_STEMS\n848:     invocation = (ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}\n849:     bindings, unmapped = codegen.bind_commands(ctx[\"adapters\"], invocation, COMMAND_VERB_STEMS)\n850:     for item in unmapped:\n851:         if item not in stats[\"unmapped\"]:\n852:             stats[\"unmapped\"].append(item)\n853:     stats[\"bindings\"] = {f\"{c} {s}\" if s else c: (b[0], b[1]
                "text": "            self._db.close()\n            self._db = None\n\n    def _space(self, entity):\n        return self._records.setdefault(entity, {})\n\n    def add(self, entity, pk_name, values, check_fk=()):\n        \"\"\"Store a copy of `values`; assign an integer key when it is None.\"\"\"\n        space = self._space(entity)\n        record = {name: _iso(value) for name, value in values.items()}\n        key = record.get(pk_name)\n        if key is None:\n            key = self._next_id.get(entity, 1)\n            while key in space:\n                key += 1\n            record[pk_name] = key\n            self._next_id[entity] = key + 1\n        elif key in space:\n            raise ValueError(f\"{entity} with {pk_name}={key!r} already exists\")\n        for field_name, target_entity, target_field, exc in check_fk:\n            self._check_fk(entity, record, field_name,\n                           target_entity, target_field, exc)\n        space[key] = record\n        self._persist(entity, key)\n        return dict(record)\n\n    def _check_fk(self, entity, record, field_name,\n                  target_entity, target_field, exc):\n        value = record.get(field_name)\n        if value is None:\n            return\n        for candidate in self._space(target_entity).values():\n            if candidate.get(target_field) == value:\n                return\n        message = (f\"{entity}.{field_name}={value!r} references missing \"\n                   f\"{target_entity}.{target_field}\")\n        raise exc(message) if exc is not None else KeyError(message)\n\n    def get(self, entity, pk_name, key, error=None):\n        \"\"\"One record by key, or `error` (default `KeyError`).\"\"\"\n        try:\n            return dict(self._space(entity)[key])\n        except KeyError:\n            message = f\"{entity} with {pk_name}={key!r} not found\"\n            raise error(message) if error is not None else KeyError(message)\n\n    def all(self, entity):\n        \"\"\"Every record of an entity, in insertion order.\"\"\"\n        return [dict(record) for record in self._space(entity).values()]\n\n    def update(self, entity, pk_name, key, values, error=None):\n        \"\"\"Merge `values` into the record at `key`; unknown keys fail like `get`.\"\"\"\n        space = self._space(entity)\n        if key not in space:\n            message = f\"{entity} with {pk_name}={key!r} not found\"\n            raise error(message) if error is not None else KeyError(message)\n        merged = dict(space[key])\n        for field_name, value in values.items():\n            if value is not None:\n                merged[field_name] = _iso(value)\n        space[key] = merged\n        self._persist(entity, key)\n        return dict(merged)\n\n    def delete(self, entity, pk_name, key, error=None):\n        \"\"\"Remove the record at `key`; unknown keys fail like `get`.\"\"\"\n        space = self._space(entity)\n        if key not in space:\n            message = f\"{entity} with {pk_name}={key!r} not found\"\n            raise error(message) if error is not None else KeyError(message)\n        del space[key]\n        self._persist(entity, key)\n\n    def select(self, entity, criteria):\n        \"\"\"Records matching every `(field, operator, value)` criterion.\"\"\"\n        matches = []\n        prepared = [(field, operator, _iso(value))\n                    for field, operator, value in criteria]\n        for record in self._space(entity).values():\n            if all(_holds(record.get(field), operator, value)\n                   for field, operator, value in prepared):\n                matches.append(dict(record))\n        return matches\n\n\ndef _iso(value):\n    \"\"\"`datetime.date`/`datetime.datetime` become ISO strings; else no-op.\n\n    Dates normalize at the door, for records as for criteria, so memory\n    and file agree by construction: a body that stored\n    `datetime.date.today()` reads back the same `\"2026-10-19\"` a reload\n    would give, and a criterion comparing against a date object matches\n    the stored string instead of failing the comparison.\n    \"\"\"\n    if isinstance(value, (datetime.date, datetime.datetime)):\n        return value.isoformat()\n    return value\n\n\ndef _holds(actual, operator, expected):\n    if operator == \"eq\":\n        return actual == expected\n    if operator == \"ge\":\n        return actual is not None and actual >= expected\n    if operator == \"le\":\n        return actual is not None and actual <= expected\nclass LoanRepository:\n    ENTITY = \"Loan\"\n    PK = \"id\"\n\n    def __init__(self, store):\n        self._store = store\n\n\n    def create_loan(self, loan: models.Loan = None) -> models.Loan:\n        \"\"\"Creates a new loan entry with the provided details. [crud:create: STANDARD_CRUD]\"\"\"\n        values = _record_values(loan, ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status'])\n        record = self._store.add(self.ENTITY, self.PK, values, check_fk=[(\"book_id\", \"Book\", \"id\", errors.BookNotFoundError), (\"member_id\", \"Member\", \"id\", errors.MemberNotFoundError)])\n        return models.Loan(**record)\n\n    def read_one_loan(self, loan_id: int = None) -> models.Loan | None:\n        \"\"\"Reads a single loan by its ID. [crud:read_one: STANDARD_CRUD]\"\"\"\n        record = self._store.get(self.ENTITY, self.PK, loan_id, error=errors.LoanNotFoundError)\n        return models.Loan(**record)\n\n    def read_all_loans(self) -> List[models.Loan]:\n        \"\"\"Reads all loans from the database. [crud:read_all: READ_ALL]\"\"\"\n        criteria = []\n        found = self._store.select(self.ENTITY, criteria)\n        return [models.Loan(**r) for r in found]\n\n    def update_loan(self, loan_id: int = None, loan: models.Loan = None) -> models.Loan:\n        \"\"\"Updates a loan's details by its ID. [crud:update: STANDARD_CRUD]\"\"\"\n        criteria = []\n        if loan_id is not None:\n            criteria.append(('id', 'eq', loan_id))\n        found = self._store.select(self.ENTITY, criteria)\n        if len(found) != 1:\n            raise errors.LoanNotFoundError(f\"Loan update matched {len(found)} records\")\n        patch = {}\n        for key, value in _record_values(loan, ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status']).items():\n            if value is not None:\n                patch[key] = value\n        if loan_id is not None and 'loan_id' in ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status']:\n            patch['loan_id'] = loan_id\n        record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error=errors.LoanNotFoundError)\n        return models.Loan(**record)\n\n    def delete_loan(self, loan_id: int = None) -> bool:\n        \"\"\"Deletes a loan by its ID. [crud:delete: STANDARD_CRUD]\"\"\"\n        criteria = []\n        if loan_id is not None:\n            criteria.append(('id', 'eq', loan_id))\n        found = self._store.select(self.ENTITY, criteria)\n        if not found:\n            raise errors.LoanNotFoundError(f\"Loan delete matched no records\")\n        for record in found:\n            self._store.delete(self.ENTITY, self.PK, record[self.PK])\n        return None\n\n    def get_active_loans(self) -> List[models.Loan]:\n        \"\"\"Finds all active loans. [FILTER_CRITERION via answered slots: criterion_field=status, criterion_value=active]\"\"\"\n        criteria = [('status', 'eq', 'active')]\n        found = self._store.select(self.ENTITY, criteria)\n        return [models.Loan(**record) for record in found]\n\n    def get_overdue_loans(self) -> List[models.Loan]:\n        \"\"\"Finds all overdue loans. [THRESHOLD_SCAN via answered slots: comparison_field=due_date, operator=<, threshold=today]\"\"\"\n        bound = datetime.date.today().isoformat()\n        out = []\n        for record in self._store.select(self.ENTITY, []):\n            key = str(record.get('due_date') or '')[:10]\n            hit = key < str(bound)[:10]\n            if hit:\n                out.append(models.Loan(**record))\n        return out\n\n    def get_member_loan_history(self, member_id: int = None) -> List[models.Loan]:\n        \"\"\"Finds all loans for a specific member. [crud:filter: FILTER_BY_FIELD: by parameter shape]\"\"\"\n        criteria = []\n        if member_id is not None:\n            criteria.append(('member_id', 'eq', member_id))\n        found = self._store.select(self.ENTITY, criteria)\n        return [models.Loan(**r) for r in found]\n\n    def get_book_loan_history(self, book_id: int = None) -> List[models.Loan]:\n        \"\"\"Finds all loans for a specific book. [crud:filter: FILTER_BY_FIELD: by parameter shape]\"\"\"\n        criteria = []\n        if book_id is not None:\n            criteria.append(('book_id', 'eq', book_id))\n        found = self._store.select(self.ENTITY, criteria)\n        return [models.Loan(**r) for r in found]\n"

istency import checks_surface as surface_checks\n43-\n44-    tokens = text.split()\n45-    if any(surface_checks.FLAG_TOKEN.match(token) for token in tokens):\n46-        return True\n47-    return (len(tokens) == 2\n48-            and bool(surface_checks.SPAN_WORD.fullmatch(tokens[0]))\n"

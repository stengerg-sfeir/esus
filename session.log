                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/pipeline.py, lines 78-132\n78:     def run(self, requirements, start=None):\n79:         # Kept so the post-contract error repair can consult the requirements — the\n80:         # only authority on whether a declared-but-unraised error belongs.\n81:         self.requirements = requirements\n82:         steps = [\n83:             (INTENTIONS, lambda: self._step_intentions(requirements)),\n84:             (DATA_MODELS, lambda: self._step_data_models(requirements)),\n85:             (ERRORS, lambda: self._step_errors(requirements)),\n86:             (INVARIANTS, lambda: self._step_invariants(requirements)),\n87:             (COMPONENTS, lambda: self._step_components(requirements)),\n88:             (SERVICE_CONTRACTS, lambda: self._step_contracts(requirements)),\n89:             (\"errors_repair\", self._repair_errors),\n90:             (PATTERN_MATCHES, self._step_patterns),\n91:             (INTERACTION_ADAPTERS, lambda: self._step_adapters(requirements)),\n92:             (PERSISTENCE_PORTS, lambda: self._step_persistence(requirements)),\n93:         ]\n94:         index = 0\n95:         if start is not None:\n96:             # Resuming (`extract_arch.py --from-step`) reruns one failed step\n97:             # against the earlier steps' archived documents instead of the\n98:             # whole pipeline: a D-fix validates in minutes, not half an hour.\n99:             # Documents already in `self.documents` are the context the\n100:             # remaining steps chain from.\n101:             index = [name for name, _ in steps].index(start)\n102:         for _, step in steps[index:]:\n103:             step()\n104:         return self.documents\n105: \n106:     def _generate(self, key, prompt, grammar_text, temperature=TEMPERATURE,\n107:                   retry_temperature=RETRY_TEMPERATURE):\n108:         \"\"\"Validate the grammar, generate, and store the document under `key`.\n109: \n110:         One unusable document used to cost the whole run: library's missing\n111:         components.json and every downstream warning came from a single\n112:         malformed step. A grammar-constrained step fails only when the model\n113:         writes something the grammar permits but JSON rejects, so one retry at a\n114:         higher temperature recovers it cheaply. Coverage retries (a miss the\n115:         checker names) keep the cold temperature instead — see TEMPERATURE.\n116:         \"\"\"\n117:         grammar_check.assert_valid(grammar_text, label=f\"step {key}\")\n118: \n119:         body = None\n120:         # The ceiling the retry runs under. It starts as None, meaning the\n121:         # first-attempt ceiling of `MAX_NEW_TOKENS`.\n122:         retry_budget = None\n123:         for attempt, attempt_temperature in enumerate((temperature, retry_temperature)):\n124:             result = runner.generate(\n125:                 self.llm, prompt, grammar_text, key,\n126:                 temperature=attempt_temperature,\n127:                 max_new_tokens=retry_budget,\n128:                 seed=SEED,\n129:             )\n130:             self.results.append(result)\n131:             self.log.write(result.describe())\n132: \n[Output truncated. Continue reading with offset: 133]"

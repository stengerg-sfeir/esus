        {
          "type": "tool",
          "id": "call_01a12eec77ba7475995592e402e22404",
          "name": "read",
          "executed": false,
          "providerState": {
            "itemId": "fc_01a12eec77ba7475995592e402e22404"
          },
          "state": {
            "status": "completed",
            "input": {
              "path": "/Users/gillesstenger/Documents/esus/kernel/consistency/checks_surface.py"
            },
            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_surface.py, lines 1-264\n1: \"\"\"Does the recorded CLI surface contain the commands the requirements name?\n2: \n3: Every other check compares one document with another. This one compares a\n4: document with the prose it was extracted from, which is the distinction that\n5: matters here: `invocation` was previously checked against the parser technology\n6: and against itself, so a command the requirements name and the surface omits was\n7: invisible. expenses recorded `category` and `budget` with **no subcommands at\n8: all** while its requirements name three each, and nothing could see it.\n9: \n10: The comparison is deliberately narrow. It reads the one notation every prompt in\n11: the corpus uses — `<noun> <verb> --flag` — and it only reports a pair when the\n12: noun is a command the surface already has. When the noun is not a command, the\n13: pair is skipped rather than guessed at: `library borrow book` puts the *program*\n14: name before the verb, and a rule that could not tell a tool name from a command\n15: would report a finding for correct output. The rule was widened after library\n16: showed its cost: it read only `<noun> <verb> --flag`, so a bracketed optional\n17: flag (`<verb> [--flag]`) hid the verb entirely, and it only ever compared a noun\n18: the surface already had, so a whole command group the surface omitted was\n19: invisible. library declares one command (`book`) where the requirements name\n20: nine lines; the old rule reported one of them.\n21: \"\"\"\n22: \n23: import re\n24: from collections import Counter\n25: \n26: # `<noun> <verb> --flag` or `<noun> <verb> [--flag`: the token before a flag is\n27: # the verb, and the token before that is the thing it acts on. The optional `[`\n28: # accepts the prompts' `<verb> [--optional-flag]` notation, which the first\n29: # version of this rule read as no flag at all and so never compared.\n30: COMMAND_PAIR = re.compile(r\"\\b([a-z][a-z0-9_-]*)\\s+([a-z][a-z0-9_-]*)\\s+\\[?-{1,2}[a-z]\")\n31: \n32: # The word a command line starts with inside its backticks — the program name on\n33: # every prompt in the corpus (`library book add` starts with `library`).\n34: COMMAND_START = re.compile(r\"`\\s*([a-z][a-z0-9_-]*)\")\n35: \n36: # Global flags are not verbs, and a command is free to declare them.\n37: GLOBAL_FLAGS = (\"help\", \"version\")\n38: \n39: # A noun that precedes this many distinct verbs is a command group the surface\n40: # omitted; a noun seen once is passed over.\n41: MISSING_COMMAND_THRESHOLD = 2\n42: \n43: \n44: def check_surface_coverage(components, requirements, report):\n45:     \"\"\"Report commands and subcommands the requirements name and the surface lacks.\n46: \n47:     Returns the number of checks performed, so a caller can tell \"the surface\n48:     agrees with the requirements\" from \"there was nothing to compare\".\n49:     \"\"\"\n50:     if not requirements or not isinstance(components, dict):\n51:         return 0\n52:     facade = components.get(\"facade\")\n53:     if not isinstance(facade, dict):\n54:         return 0\n55:     invocation = facade.get(\"invocation\")\n56:     if not isinstance(invocation, dict):\n57:         # A program with no arguments declares `invocation: null`, and it is a\n58:         # valid recorded answer rather than a gap to report.\n59:         return 0\n60: \n61:     commands = _commands_by_name(invocation)\n62:     if not commands:\n63:         return 0\n64: \n65:     verbs_by_noun = {}\n66:     for noun, verb in COMMAND_PAIR.findall(requirements):\n67:         verbs_by_noun.setdefault(noun, set()).add(verb)\n68: \n69:     # The program name is not a command, and a subcommand of any command is\n70:     # already part of the surface; neither is a missing command. Without these\n71:     # two exclusions the rule reported `library` (the program) and `report` (a\n72:     # subcommand of `expense`) as missing commands.\n73:     program = _program_name(requirements)\n74:     known_subcommands = {sub for subs in commands.values() for sub in subs}\n75: \n76:     checkable = 0\n77:     for noun, verbs in sorted(verbs_by_noun.items()):\n78:         if noun in commands:\n79:             checkable += 1\n80:             for verb in sorted(verbs):\n81:                 if verb in commands[noun] or verb in GLOBAL_FLAGS:\n82:                     continue\n83:                 report.warning(\n84:                     \"missing_command\",\n85:                     f\"components.facade.invocation: the requirements name '{noun} {verb}' but \"\n86:                     f\"the command '{noun}' declares no '{verb}' subcommand (it declares: \"\n87:                     f\"{', '.join(sorted(commands[noun])) or 'none'})\",\n88:                 )\n89:             continue\n90:         if noun == program or noun in known_subcommands:\n91:             continue\n92:         if len(verbs) >= MISSING_COMMAND_THRESHOLD:\n93:             # The noun is not a command the surface declares, yet the\n94:             # requirements use it before several different verbs: a whole\n95:             # command group the surface omitted, not the program name and not a\n96:             # stray phrase. Reported once, as a missing command.\n97:             checkable += 1\n98:             report.warning(\n99:                 \"missing_command\",\n100:                 f\"components.facade.invocation: the requirements name the command '{noun}' \"\n101:                 f\"(for {', '.join(sorted(verbs))}) but the surface declares no such command \"\n102:                 f\"(it declares: {', '.join(sorted(commands)) or 'none'})\",\n103:             )\n104:     return checkable\n105: \n106: \n107: def _program_name(requirements):\n108:     \"\"\"The word the command lines start with, or None.\n109: \n110:     Every prompt writes a command line as `<program> ...`, and the program\n111:     appears on every line, so it is the most common first word inside the\n112:     backticks. It is excluded from the missing-command check: a program name is\n113:     not a command, and on library's single-word lines (`library borrow --x`) it\n114:     is the noun the pair rule sees.\n115:     \"\"\"\n116:     starts = COMMAND_START.findall(requirements)\n117:     if not starts:\n118:         return None\n119:     return Counter(starts).most_common(1)[0][0]\n120: \n121: \n122: def _commands_by_name(invocation):\n123:     \"\"\"Map each command to the set of its subcommand names.\"\"\"\n124:     commands = {}\n125:     entries = invocation.get(\"commands\")\n126:     if not isinstance(entries, list):\n127:         return commands\n128:     for entry in entries:\n129:         if not isinstance(entry, dict):\n130:             continue\n131:         name = entry.get(\"name\")\n132:         if not isinstance(name, str) or not name.strip():\n133:             continue\n134:         subcommands = entry.get(\"subcommands\")\n135:         names = set()\n136:         if isinstance(subcommands, list):\n137:             for sub in subcommands:\n138:                 if isinstance(sub, dict) and isinstance(sub.get(\"name\"), str):\n139:                     names.add(sub[\"name\"])\n140:         commands[name.strip()] = names\n141:     return commands\n142: \n143: \n144: # The verbs a CLI exposes and the method-name stems that can serve them. A\n145: # command and its method rarely share a spelling — `book add` is `create_book`,\n146: # `book list` is `read_all_books` — so a verb is matched by a family of stems\n147: # rather than by equality. The map is deliberately generous: this rule reports a\n148: # command nothing could plausibly implement, not one whose method is spelled\n149: # differently but recognisably serves it.\n150: COMMAND_VERB_STEMS = {\n151:     \"add\": (\"add\", \"create\", \"save\", \"insert\", \"new\"),\n152:     \"create\": (\"add\", \"create\", \"save\", \"insert\", \"new\"),\n153:     \"list\": (\"all\", \"list\"),\n154:     \"search\": (\"search\", \"query\", \"find\", \"filter\"),\n155:     \"update\": (\"update\", \"edit\", \"set\"),\n156:     \"delete\": (\"delete\", \"remove\"),\n157:     \"remove\": (\"delete\", \"remove\"),\n158:     \"get\": (\"get\", \"find\", \"read\"),\n159:     \"show\": (\"get\", \"find\", \"read\"),\n160:     \"report\": (\"report\", \"summary\", \"stats\", \"value\"),\n161:     \"export\": (\"export\", \"write\", \"dump\"),\n162:     \"confirm\": (\"confirm\",),\n163:     \"cancel\": (\"cancel\",),\n164:     \"restock\": (\"restock\",),\n165:     \"borrow\": (\"borrow\", \"loan\"),\n166:     \"return\": (\"return\",),\n167:     \"renew\": (\"renew\",),\n168:     \"detect\": (\"detect\",),\n169:     \"assign\": (\"assign\",),\n170:     \"history\": (\"history\",),\n171: }\n172: \n173: \n174: def check_command_backing(components, services, report):\n175:     \"\"\"Report a CLI verb no service method could implement.\n176: \n177:     This is the second half of the CLI-surface check and the one a code\n178:     generator needs most: `missing_command` compares the surface with the\n179:     *requirements*, and this compares it with the *methods*. A command the\n180:     surface declares and no method serves is a command the generator cannot\n181:     write — it would have to invent the call — and nothing else in the checker\n182:     can see it, because a command resolves against no other document.\n183: \n184:     A **note**, not a warning: the match is by name stem, and the checker cannot\n185:     prove no method serves the verb, only that none is named for it. `order\n186:     confirm` on 60 is reported beside `cancel_order` (which the same run\n187:     declares), so the note points at the method to add rather than asserting one\n188:     is absent.\n189: \n190:     Returns the number of command verbs checked.\n191:     \"\"\"\n192:     if not isinstance(components, dict) or not isinstance(services, list):\n193:         return 0\n194:     facade = components.get(\"facade\")\n195:     if not isinstance(facade, dict):\n196:         return 0\n197:     invocation = facade.get(\"invocation\")\n198:     if not isinstance(invocation, dict):\n199:         return 0\n200: \n201:     methods = _method_names(services)\n202:     if not methods:\n203:         return 0\n204: \n205:     checked = 0\n206:     for command, verb in _command_verbs(invocation):\n207:         checked += 1\n208:         stems = COMMAND_VERB_STEMS.get(verb, (verb,))\n209:         if _served_by_stems(stems, methods):\n210:             continue\n211:         report.note(\n212:             \"unbacked_command\",\n213:             f\"components.facade.invocation: the command '{command} {verb}' has no method behind \"\n214:             f\"it — no service method name matches, so a generator cannot write the call\",\n215:         )\n216:     return checked\n217: \n218: \n219: def _method_names(services):\n220:     \"\"\"Every method name across the services, normalised for a substring match.\"\"\"\n221:     names = []\n222:     for service in services:\n223:         if not isinstance(service, dict):\n224:             continue\n225:         for method in service.get(\"methods\") or []:\n226:             if isinstance(method, dict) and isinstance(method.get(\"name\"), str):\n227:                 names.append(_normalise(method[\"name\"]))\n228:     return names\n229: \n230: \n231: def _command_verbs(invocation):\n232:     \"\"\"Yield (command, verb) for each subcommand, or the command when it has none.\n233: \n234:     A flat command (`expense report`) exposes the verb as its subcommand; a\n235:     command with subcommands is not itself a verb, so it is not checked — the\n236:     verbs are.\n237:     \"\"\"\n238:     entries = invocation.get(\"commands\")\n239:     if not isinstance(entries, list):\n240:         return\n241:     for entry in entries:\n242:         if not isinstance(entry, dict):\n243:             continue\n244:         name = entry.get(\"name\")\n245:         if not isinstance(name, str) or not name.strip():\n246:             continue\n247:         subcommands = [\n248:             sub.get(\"name\")\n249:             for sub in (entry.get(\"subcommands\") or [])\n250:             if isinstance(sub, dict) and isinstance(sub.get(\"name\"), str)\n251:         ]\n252:         if subcommands:\n253:             for sub in subcommands:\n254:                 yield name.strip(), sub.strip().lower()\n255:         else:\n256:             yield name.strip(), name.strip().lower()\n257: \n258: \n259: def _served_by_stems(stems, methods):\n260:     return any(any(stem in method for stem in stems) for method in methods)\n261: \n262: \n263: def _normalise(value):\n264:     return value.replace(\"_\", \"\").replace(\"-\", \"\").lower()"

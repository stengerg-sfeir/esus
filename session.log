                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/naming.py, lines 1-121\n1: \"\"\"Identifier normalization and name resolution for the consistency checks.\n2: \n3: Each extraction step names entities and services independently, so the same\n4: concept comes back spelled several ways (\"wine_id\", \"WineId\", \"WineService\"\n5: vs \"wine_service\"). Every cross-reference check resolves a name through this\n6: module rather than comparing raw strings.\n7: \"\"\"\n8: \n9: import difflib\n10: import re\n11: from dataclasses import dataclass, field\n12: \n13: _NON_ALPHANUMERIC = re.compile(r\"[^a-z0-9]+\")\n14: _ROLE_SUFFIXES = (\"repository\", \"service\", \"manager\", \"handler\", \"repo\")\n15: \n16: MATCH_EXACT = \"exact\"\n17: MATCH_VARIANT = \"variant\"\n18: MATCH_NONE = \"none\"\n19: \n20: # Class-name suffixes that must never appear where a bare entity name is expected.\n21: CLASS_SUFFIXES = (\"Repository\", \"Service\")\n22: \n23: SUGGESTION_LIMIT = 3\n24: SUGGESTION_CUTOFF = 0.6\n25: \n26: \n27: def normalize(identifier):\n28:     \"\"\"Return the comparable form of an identifier ('Wine_ID' -> 'wineid').\"\"\"\n29:     return _NON_ALPHANUMERIC.sub(\"\", str(identifier).lower())\n30: \n31: \n32: def strip_role_suffix(identifier):\n33:     \"\"\"normalize() with a trailing role word removed ('WineService' -> 'wine').\"\"\"\n34:     base = normalize(identifier)\n35:     for suffix in _ROLE_SUFFIXES:\n36:         if base.endswith(suffix) and len(base) > len(suffix):\n37:             return base[: -len(suffix)]\n38:     return base\n39: \n40: \n41: def match_known(candidate, known_names, strip_roles=False):\n42:     \"\"\"Resolve `candidate` against `known_names`.\n43: \n44:     Returns (MATCH_EXACT | MATCH_VARIANT | MATCH_NONE, resolved_name_or_None).\n45:     MATCH_VARIANT means the two names agree once punctuation and casing (and,\n46:     when `strip_roles` is set, a trailing role word) are removed.\n47:     \"\"\"\n48:     if not candidate:\n49:         return MATCH_NONE, None\n50:     if candidate in known_names:\n51:         return MATCH_EXACT, candidate\n52: \n53:     target = normalize(candidate)\n54:     for name in known_names:\n55:         if normalize(name) == target:\n56:             return MATCH_VARIANT, name\n57: \n58:     if strip_roles:\n59:         target = strip_role_suffix(candidate)\n60:         for name in known_names:\n61:             if strip_role_suffix(name) == target:\n62:                 return MATCH_VARIANT, name\n63: \n64:     return MATCH_NONE, None\n65: \n66: \n67: def suggest(candidate, known_names, limit=SUGGESTION_LIMIT):\n68:     \"\"\"Return up to `limit` known names close to `candidate`, for messages.\"\"\"\n69:     normalized = {}\n70:     for name in known_names:\n71:         normalized.setdefault(normalize(name), name)\n72:     close = difflib.get_close_matches(\n73:         normalize(candidate), list(normalized), n=limit, cutoff=SUGGESTION_CUTOFF\n74:     )\n75:     return [normalized[match] for match in close]\n76: \n77: \n78: @dataclass\n79: class EntityIndex:\n80:     \"\"\"The extracted data models, addressable by name with variant resolution.\"\"\"\n81: \n82:     models: list = field(default_factory=list)\n83: \n84:     @classmethod\n85:     def from_models(cls, models):\n86:         if not isinstance(models, list):\n87:             models = []\n88:         return cls([model for model in models if isinstance(model, dict)])\n89: \n90:     @property\n91:     def names(self):\n92:         return [model.get(\"name\") for model in self.models if model.get(\"name\")]\n93: \n94:     def _model(self, entity_name):\n95:         for model in self.models:\n96:             if model.get(\"name\") == entity_name:\n97:                 return model\n98:         return {}\n99: \n100:     def _fields(self, entity_name):\n101:         fields = self._model(entity_name).get(\"fields\", [])\n102:         if not isinstance(fields, list):\n103:             return []\n104:         return [item for item in fields if isinstance(item, dict)]\n105: \n106:     def resolve(self, entity_name):\n107:         \"\"\"Return (match_tier, declared_model_name_or_None).\"\"\"\n108:         return match_known(entity_name, self.names)\n109: \n110:     def fields_of(self, entity_name):\n111:         return [item.get(\"name\") for item in self._fields(entity_name) if item.get(\"name\")]\n112: \n113:     def primary_keys(self, entity_name):\n114:         return [item.get(\"name\") for item in self._fields(entity_name)\n115:                 if item.get(\"primary_key\") and item.get(\"name\")]\n116: \n117:     def suggest(self, entity_name, limit=SUGGESTION_LIMIT):\n118:         return suggest(entity_name, self.names, limit)\n119: \n120:     def suggest_field(self, entity_name, field_name, limit=SUGGESTION_LIMIT):\n121:         return suggest(field_name, self.fields_of(entity_name), limit)"

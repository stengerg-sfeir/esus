            "status": "completed",
            "input": {
              "content": "#!/usr/bin/env python3\n\"\"\"Generate a runnable Python program from extraction output.\n\nThe probe proves the documents agree; this writes the program they describe:\n\n    python generator.py out/expenses\n\nwrites `out/expenses/generated/` — `models.py`, `errors.py`, `store.py`,\n`repositories.py`, `services.py`, `cli.py` — and refuses (exit 1) when the\nprobe reports blockers or open ties, because generating from a document the\nprobe rejects means inventing code silently.\n\nBodies follow one rule per method (`kernel.codegen.plan_method`, which itself\nfollows `kernel.tie_rules.effective_directive` — there is one definition, and\nthis file does not reimplement it):\n\n- mechanical CRUD and filters run on an in-memory `Store`;\n- services delegate to the repository method of the same name;\n- everything else (aggregates, guards, exports, gaps, open ties) is a\n  `raise NotImplementedError` stub carrying its directive and refusal reason\n  in the docstring: a work order for the LLM pass, never an invented body.\n\nThe CLI backend is `argparse` (stdlib) regardless of the declared technology —\nporting to click/pyimgui is later work, stated in the package docstring — and\neach `(command, subcommand)` is bound to the adapter that serves its verb, the\nbinding baked into `cli.py` with its score beside it.\n\"\"\"\n\nimport argparse\nimport os\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n\nimport probe_readiness  # noqa: E402\nfrom kernel import codegen  # noqa: E402\nfrom kernel.consistency.checks_surface import COMMAND_VERB_STEMS  # noqa: E402\nfrom kernel.consistency.loader import load_documents  # noqa: E402\nfrom kernel.consistency.naming import normalize  # noqa: E402\nfrom kernel.consistency.report import Report  # noqa: E402\n\nGENERATED_DIR = \"generated\"\n\n\n# --------------------------------------------------------------------------\n# document access\n# --------------------------------------------------------------------------\n\ndef load_context(output_dir):\n    \"\"\"The generation context: every body plus the indexes the emitters need.\"\"\"\n    report = Report(os.path.basename(output_dir.rstrip(os.sep)))\n    documents = load_documents(output_dir, report)\n    models = documents.get(\"data_models\") or []\n    if not isinstance(models, list):\n        models = []\n    models = [m for m in models if isinstance(m, dict) and m.get(\"name\")]\n    errors = documents.get(\"errors\") or []\n    if not isinstance(errors, list):\n        errors = []\n    errors = [e for e in errors if isinstance(e, dict) and e.get(\"name\")]\n    services = documents.get(\"service_contracts\") or []\n    if not isinstance(services, list):\n        services = []\n    services = [s for s in services if isinstance(s, dict) and s.get(\"service_name\")]\n    ports = documents.get(\"persistence_ports\")\n    repositories = []\n    if isinstance(ports, dict) and isinstance(ports.get(\"repositories\"), list):\n        repositories = [r for r in ports[\"repositories\"]\n                        if isinstance(r, dict) and r.get(\"entity\")]\n    mappings = {}\n    if isinstance(ports, dict) and isinstance(ports.get(\"entity_mappings\"), list):\n        for mapping in ports[\"entity_mappings\"]:\n            if isinstance(mapping, dict) and mapping.get(\"entity\"):\n                mappings[normalize(mapping[\"entity\"])] = mapping\n    matches = documents.get(\"pattern_matches\") or []\n    if not isinstance(matches, list):\n        matches = []\n    match_index = {}\n    for entry in matches:\n        if isinstance(entry, dict) and entry.get(\"source\"):\n            match_index[entry[\"source\"]] = entry\n    adapters = documents.get(\"interaction_adapters\") or []\n    if not isinstance(adapters, list):\n        adapters = []\n    adapters = [a for a in adapters if isinstance(a, dict) and a.get(\"action_name\")]\n    components = documents.get(\"components\")\n    if not isinstance(components, dict):\n        components = {}\n    return {\n        \"models\": models,\n        \"errors\": errors,\n        \"services\": services,\n        \"repositories\": repositories,\n        \"mappings\": mappings,\n        \"match_index\": match_index,\n        \"adapters\": adapters,\n        \"components\": components,\n        \"entity_names\": [m[\"name\"] for m in models],\n    }\n\n\ndef model_of(ctx, entity_ref):\n    \"\"\"The data model for an entity name, matched leniently, or None.\"\"\"\n    if not entity_ref:\n        return None\n    wanted = normalize(entity_ref)\n    for model in ctx[\"models\"]:\n        if normalize(model[\"name\"]) == wanted:\n            return model\n    return None\n\n\ndef primary_key_of(ctx, entity):\n    \"\"\"The mapping's primary key, else the model's, else `id`.\"\"\"\n    mapping = ctx[\"mappings\"].get(normalize(entity or \"\"))\n    if isinstance(mapping, dict) and mapping.get(\"primary_key\"):\n        return mapping[\"primary_key\"]\n    model = model_of(ctx, entity)\n    if model:\n        for field in model.get(\"fields\") or []:\n            if isinstance(field, dict) and field.get(\"primary_key\") and field.get(\"name\"):\n                return field[\"name\"]\n    return \"id\"\n\n\ndef fields_of(ctx, entity):\n    \"\"\"The `(name, field)` pairs of a model, or [] for unknown entities.\"\"\"\n    model = model_of(ctx, entity)\n    if not model or not isinstance(model.get(\"fields\"), list):\n        return []\n    return [(f[\"name\"], f) for f in model[\"fields\"]\n            if isinstance(f, dict) and f.get(\"name\")]\n\n\ndef error_for(ctx, entity, kind=\"missing\"):\n    \"\"\"A registered error class for a missing record, or None.\n\n    Picks a `raises`-style name mentioning the entity (`*NotFound*`,\n    `*Missing*`); without one the caller falls back to `LookupError`, so the\n    failure is still typed rather than silent.\n    \"\"\"\n    wanted = normalize(entity or \"\")\n    markers = (\"notfound\", \"missing\") if kind == \"missing\" else (\"notfound\", \"missing\")\n    for error in ctx[\"errors\"]:\n        name = error[\"name\"]\n        if normalize(name) and wanted in normalize(name) and any(m in normalize(name) for m in markers):\n            return name\n    return None\n\n\ndef method_error(ctx, method, entity):\n    \"\"\"The error expression for a lookup failure, preferring the method's own.\"\"\"\n    raises = [r for r in (method.get(\"raises\") or []) if isinstance(r, str)]\n    registered = {e[\"name\"] for e in ctx[\"errors\"]}\n    raises = [r for r in raises if r in registered]\n    wanted = normalize(entity or \"\")\n    for name in raises:\n        if wanted and wanted in normalize(name):\n            return f\"errors.{codegen.sanitize(name)}\"\n    if raises:\n        return f\"errors.{codegen.sanitize(raises[0])}\"\n    entity_error = error_for(ctx, entity)\n    if entity_error:\n        return f\"errors.{codegen.sanitize(entity_error)}\"\n    return \"LookupError\"\n\n\n# --------------------------------------------------------------------------\n# parameter matching (filters share this with the CLI, hence one definition)\n# --------------------------------------------------------------------------\n\ndef match_param(field_names, param):\n    \"\"\"Map a filter parameter to `(field, operator)` or None.\n\n    Exact normalized equality is `eq`; a `start_`/`from_` prefix is `ge` and\n    an `end_`/`to_` prefix is `le` against the field containing the remainder\n    (`start_date` filters `expense_date`). `None` values are skipped by\n    callers; a non-`None` value with no match is the caller's `ValueError`.\n    \"\"\"\n    wanted = normalize(param or \"\")\n    if not wanted:\n        return None\n    for field in field_names:\n        if normalize(field) == wanted:\n            return (field, \"eq\")\n    for prefix, operator in ((\"start\", \"ge\"), (\"from\", \"ge\"),\n                             (\"end\", \"le\"), (\"to\", \"le\")):\n        if wanted.startswith(prefix) and len(wanted) > len(prefix):\n            rest = wanted[len(prefix):]\n            for field in field_names:\n                if rest and (rest in normalize(field) or normalize(field) in rest):\n                    return (field, operator)\n    return None\n\n\ndef is_entity_type(text, entity_names):\n    \"\"\"True when a parameter/return spelling names a declared entity.\"\"\"\n    if not isinstance(text, str):\n        return False\n    identifiers = set(re.findall(r\"[A-Za-z_][A-Za-z0-9_]*\", text))\n    known = {normalize(name) for name in entity_names}\n    return any(normalize(token) in known for token in identifiers)\n\n\nimport re  # noqa: E402  (kept beside its user per repo import order)\n\n\n# --------------------------------------------------------------------------\n# file emitters (each returns its text)\n# --------------------------------------------------------------------------\n\nHEADER_IMPORTS = \"\"\"from dataclasses import dataclass\nfrom decimal import Decimal\nimport datetime\nfrom typing import Any, Dict, List, Optional\n\"\"\"\n\n\ndef emit_init(ctx, stats):\n    lines = ['\"\"\"Generated program. Do not edit by hand: regenerate with `generator.py`.\"\"\"',\n             \"\",\n             f\"Source documents: {stats['source']}\",\n             f\"Methods: {stats['implemented']} implemented, {stats['stubs']} stubs \"\n             \"(each stub names its work order in its docstring).\",\n             \"CLI backend is argparse (stdlib); the declared facade technology is\",\n             \"recorded in the documents and porting the CLI to it is later work.\",\n             \"\"]\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef emit_models(ctx):\n    lines = ['\"\"\"Data models. Every field defaults to None: the store assigns integer',\n             'primary keys on insert, and updates merge only non-None values.\"\"\"',\n             \"\", HEADER_IMPORTS.strip(), \"\"]\n    for model in ctx[\"models\"]:\n        cls = codegen.sanitize(model[\"name\"], \"Model\")\n        lines += [\"\", \"\", \"@dataclass\", f\"class {cls}:\"]\n        fields = fields_of(ctx, model[\"name\"])\n        if not fields:\n            lines.append(\"    pass\")\n            continue\n        for name, field in fields:\n            pytype = codegen.map_type(field.get(\"type\"), ctx[\"entity_names\"])\n            if field.get(\"nullable\"):\n                pytype = f\"Optional[{pytype}]\"\n            lines.append(f\"    {codegen.sanitize(name)}: {pytype} = None\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef emit_errors(ctx):\n    lines = ['\"\"\"Application errors, one class per registered failure.\"\"\"', \"\"]\n    if not ctx[\"errors\"]:\n        lines += [\"\", \"class AppError(Exception):\", '    \"\"\"Fallback when no errors were registered.\"\"\"', \"\"]\n        return \"\\n\".join(lines) + \"\\n\"\n    for error in ctx[\"errors\"]:\n        cls = codegen.sanitize(error[\"name\"], \"AppError\")\n        base = error.get(\"base\") if isinstance(error.get(\"base\"), str) and error[\"base\"].strip() else \"Exception\"\n        base = codegen.sanitize(base, \"Exception\")\n        description = (error.get(\"description\") or \"\").strip()\n        lines += [\"\", \"\", f\"class {cls}({base}):\"]\n        lines.append(f'    \"\"\"{description}\"\"\"' if description else \"    pass\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef _signature(method, entity_names):\n    \"\"\"`(declaration, param_names)` with every parameter defaulting to None.\"\"\"\n    parts = []\n    names = []\n    for param in method.get(\"params\") or []:\n        if not isinstance(param, dict):\n            continue\n        raw = param.get(\"name\") if isinstance(param.get(\"name\"), str) else \"\"\n        ident = codegen.sanitize(raw, \"param\")\n        names.append((raw, ident))\n        pytype = codegen.map_type(param.get(\"type\"), entity_names)\n        parts.append(f\"{ident}: {pytype} = None\")\n    return \", \".join(parts), names\n\n\ndef _return_of(method, entity_names):\n    pytype = codegen.map_type(method.get(\"return_type\"), entity_names)\n    return pytype if pytype != \"Any\" else \"Any\"\n\n\ndef _repo_index(ctx):\n    \"\"\"Normalized repo method name -> `[(repo_class, method)]` in ports order.\"\"\"\n    index = {}\n    for repo in ctx[\"repositories\"]:\n        cls = codegen.sanitize(repo.get(\"interface_name\") or repo.get(\"entity\"), \"Repository\")\n        for method in repo.get(\"methods\") or []:\n            if isinstance(method, dict) and method.get(\"name\"):\n                index.setdefault(normalize(method[\"name\"]), []).append((cls, method))\n    return index\n\n\ndef _service_delegate(ctx, service_name, method, repo_index):\n    \"\"\"The `(repo_class, repo_method)` an exact same-named repo method gives, or None.\"\"\"\n    candidates = repo_index.get(normalize(method.get(\"name\") or \"\"), [])\n    if not candidates:\n        return None\n    if len(candidates) == 1:\n        return candidates[0]\n    wanted = normalize(method.get(\"name\") or \"\")\n    for cls, candidate in candidates:\n        if wanted and wanted in normalize(candidate.get(\"name\") or \"\"):\n            return (cls, candidate)\n    return sorted(candidates)[0]\n\n\ndef _fk_checks(ctx, entity):\n    \"\"\"`[(field, target_entity, target_field, ErrorOrNone)]` for a model's FKs.\"\"\"\n    checks = []\n    for name, field in fields_of(ctx, entity):\n        foreign = field.get(\"foreign_key\")\n        if not isinstance(foreign, dict):\n            continue\n        target = foreign.get(\"target_entity\")\n        if not target:\n            continue\n        err = error_for(ctx, target)\n        err = f\"errors.{codegen.sanitize(err)}\" if err else \"None\"\n        checks.append((name, target, foreign.get(\"target_field\") or \"id\", err))\n    return checks\n\n\ndef emit_repositories(ctx, stats):\n    \"\"\"Repository classes with mechanical bodies; returns `(text, stats)`.\"\"\"\n    lines = ['\"\"\"Repositories over an in-memory Store, one class per persistence port.',\n             \"\",\n             \"CRUD, reads and filters run for real. Anything else raises\",\n             \"NotImplementedError with its work order — an aggregate or guard body\",\n             \"is specified by its pattern, not invented here.\",\n             '\"\"\"',\n             \"\",\n             \"import models\",\n             \"import errors\",\n             \"from store import Store\",\n             \"\",\n             \"\",\n             \"def _values(data, field_names):\",\n             '    \"\"\"A dataclass or dict entity argument as a `{field: value}` dict.\"\"\"',\n             \"    if isinstance(data, dict):\",\n             \"        return {name: data.get(name) for name in field_names}\",\n             \"    if data is None:\",\n             \"        return {}\",\n             \"    get = getattr(data, '__dataclass_fields__', None)\",\n             \"    if get is not None:\",\n             \"        import dataclasses\",\n             \"        return {name: getattr(data, name, None) for name in field_names\",\n             \"                if name in dataclasses.asdict(data) or True}\",\n             \"    return {name: getattr(data, name, None) for name in field_names}\",\n             \"\"]\n    for repo in ctx[\"repositories\"]:\n        entity = repo.get(\"entity\")\n        cls = codegen.sanitize(repo.get(\"interface_name\") or entity, \"Repository\")\n        pk = primary_key_of(ctx, entity)\n        model_cls = codegen.sanitize(entity, \"Model\") if model_of(ctx, entity) else \"dict\"\n        field_names = [name for name, _ in fields_of(ctx, entity)]\n        fk_checks = _fk_checks(ctx, entity)\n        fk_literal = \"[\" + \", \".join(\n            f'(\"{f}\", \"{t}\", \"{tf}\", {e})' for f, t, tf, e in fk_checks) + \"]\"\n        lines += [\"\", \"\", f\"class {cls}:\",\n                  f'    ENTITY = \"{entity}\"',\n                  f'    PK = \"{pk}\"',\n                  \"\",\n                  \"    def __init__(self, store):\",\n                  \"        self._store = store\",\n                  \"\"]\n        for method in repo.get(\"methods\") or []:\n            if not isinstance(method, dict) or not method.get(\"name\"):\n                continue\n            entry = ctx[\"match_index\"].get(\n                f\"contract:{repo.get('interface_name')}.{method['name']}\")\n            if entry is None:\n                entry = ctx[\"match_index\"].get(\n                    f\"contract:{repo.get('service_name', '')}.{method['name']}\")\n            strategy, detail = codegen.plan_method(method, entry, ctx[\"entity_names\"])\n            fname = codegen.sanitize(method[\"name\"], \"method\")\n            declaration, params = _signature(method, ctx[\"entity_names\"])\n            returns = _return_of(method, ctx[\"entity_names\"])\n            description = (method.get(\"description\") or \"\").strip().replace('\"\"\"', '\"')\n            lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n                      f'        \"\"\"{description} [{strategy}: {detail}]\"\"\"']\n            body = _repo_body(ctx, strategy, detail, method, params, entity,\n                              model_cls, field_names, pk, fk_literal)\n            lines.extend(\"        \" + line if line else \"\" for line in body)\n            if strategy.startswith(\"crud:\"):\n                stats[\"implemented\"] += 1\n            else:\n                stats[\"stubs\"] += 1\n                stats[\"stub_reasons\"].append(f\"{cls}.{fname}: {detail}\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef _repo_body(ctx, strategy, detail, method, params, entity,\n               model_cls, field_names, pk, fk_literal):\n    \"\"\"The statement list of one repository method.\"\"\"\n    kind = strategy[5:] if strategy.startswith(\"crud:\") else None\n    err = method_error(ctx, method, entity)\n    if kind == \"create\":\n        return _create_body(params, entity, model_cls, field_names, pk, fk_literal)\n    if kind == \"read_one\":\n        return _read_one_body(params, entity, model_cls, field_names, pk, err)\n    if kind in (\"read_all\", \"filter\"):\n        return _select_body(params, entity, model_cls, field_names)\n    if kind == \"update\":\n        return _update_body(ctx, params, entity, model_cls, field_names, pk, err)\n    if kind == \"delete\":\n        return _delete_body(params, entity, model_cls, field_names, pk, err)\n    return [\"raise NotImplementedError(\",\n            f'    \"{entity}.{method.get(\"name\")}: {detail}\")']\n\n\ndef _entity_param(params, entity_names):\n    \"\"\"The `(raw, ident)` of the parameter typed as a declared entity, if one.\"\"\"\n    for raw, ident in params:\n        for param in [raw]:\n            _ = param\n        # NOTE: matched by the caller through _signature order; re-derive here\n        # from the raw spelling so renames stay consistent.\n        pass\n    return None\n\n\ndef _create_body(params, entity, model_cls, field_names, pk, fk_literal):\n    lines = []\n    if len(params) == 1:\n        _, ident = params[0]\n        lines.append(f\"values = _values({ident}, {field_names!r})\")\n    else:\n        lines.append(\"values = {\")\n        for raw, ident in params:\n            lines.append(f\"    {raw!r}: {ident},\")\n        lines.append(\"}\")\n        lines.append(f\"values = {{k: v for k, v in values.items() if k in {field_names!r}}}\")\n        lines.append(\"for name in values:\")\n        lines.append(\"    if name not in \" + repr(field_names) + \":\")\n        lines.append(\"        raise ValueError(f\\\"unknown field {name!r} for \" + entity + \"\\\")\")\n    # NOTE: `values` above is keyed by raw document names; raw names that are\n    # not valid identifiers were sanitized in the signature, so re-key them.\n    lines.append(f\"record = self._store.add(self.ENTITY, self.PK, values, check_fk={fk_literal})\")\n    if model_cls == \"dict\":\n        lines.append(\"return record\")\n    else:\n        lines.append(f\"return {model_cls}(**record)\")\n    return lines\n\n\ndef _read_one_body(params, entity, model_cls, field_names, pk, err):\n    if len(params) == 1:\n        _, ident = params[0]\n        lines = [f\"record = self._store.get(self.ENTITY, self.PK, {ident}, error={err})\"]\n    else:\n        lines = [\"criteria = []\"]\n        for raw, ident in params:\n            lines.append(f\"if {ident} is not None:\")\n            lines.append(f\"    criteria.append(({raw!r}, 'eq', {ident}))\")\n        lines += [\"found = self._store.select(self.ENTITY, criteria)\",\n                  \"if len(found) != 1:\",\n                  f\"    raise {err}(f\\\"{entity} lookup matched {{len(found)}} records\\\")\",\n                  \"record = found[0]\"]\n    if model_cls == \"dict\":\n        lines.append(\"return record\")\n    else:\n        lines.append(f\"return {model_cls}(**record)\")\n    return lines\n\n\ndef _select_body(params, entity, model_cls, field_names):\n    lines = [\"criteria = []\"]\n    for raw, ident in params:\n        lines.append(f\"if {ident} is not None:\")\n        lines.append(f\"    matched = match_param({field_names!r}, {raw!r})\")\n        lines.append(f\"    if matched is None:\")\n        lines.append(f\"        raise ValueError(f\\\"cannot filter {entity} by {raw!r}\\\")\")\n        lines.append(f\"    field, operator = matched\")\n        lines.append(f\"    criteria.append((field, operator, {ident}))\")\n    lines.append(\"return [\")\n    if model_cls == \"dict\":\n        lines.append(\"    record for record in self._store.select(self.ENTITY, criteria)\")\n    else:\n        lines.append(f\"    {model_cls}(**record)\")\n        lines.append(\"    for record in self._store.select(self.ENTITY, criteria)\")\n    lines.append(\"]\")\n    lines.append(\"\")\n    lines.append(\"def match_param(field_names, param):\")\n    lines.append('    \"\"\"In cli.py\\'s twin: kept beside its user (see generator.py).\"\"\"')\n    lines.append(\"    raise NotImplementedError\")\n    # NOTE: replaced below — the real helper lives in cli.py's twin `match_criterion`.\n    lines[:] = lines[: len(lines) - 6]\n    lines.append(\"found = self._store.select(self.ENTITY, criteria)\")\n    return lines\n\n\ndef emit_services(ctx, repo_index, stats):\n    \"\"\"Service classes: same-name delegation or documented stubs.\"\"\"\n    lines = ['\"\"\"Services. A method with the same name as a repository method delegates',\n             \"to it; anything else raises NotImplementedError with its work order.\",\n             '\"\"\"',\n             \"\",\n             \"import models\",\n             \"import errors\",\n             \"\"]\n    port_names = {normalize(r.get(\"interface_name\") or \"\") for r in ctx[\"repositories\"]}\n    for service in ctx[\"services\"]:\n        name = service.get(\"service_name\")\n        if normalize(name) in port_names:\n            continue\n        cls = codegen.sanitize(name, \"Service\")\n        lines += [\"\", \"\", f\"class {cls}:\",\n                  \"\",\n                  \"    def __init__(self, repos):\",\n                  \"        self._repos = repos\",\n                  \"\"]\n        for method in service.get(\"methods\") or []:\n            if not isinstance(method, dict) or not method.get(\"name\"):\n                continue\n            entry = ctx[\"match_index\"].get(f\"contract:{name}.{method['name']}\")\n            strategy, detail = codegen.plan_method(method, entry, ctx[\"entity_names\"])\n            fname = codegen.sanitize(method[\"name\"], \"method\")\n            declaration, params = _signature(method, ctx[\"entity_names\"])\n            returns = _return_of(method, ctx[\"entity_names\"])\n            description = (method.get(\"description\") or \"\").strip().replace('\"\"\"', '\"')\n            delegate = _service_delegate(ctx, name, method, repo_index)\n            if delegate is not None and strategy.startswith(\"crud:\"):\n                target_cls, _ = delegate\n                call = \", \".join(ident for _, ident in params)\n                lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n                          f'        \"\"\"{description} [delegates to {target_cls}]\"\"\"',\n                          f\"        return self._repos[{target_cls!r}].{fname}({call})\"]\n                stats[\"implemented\"] += 1\n                continue\n            if delegate is not None:\n                where = f\" [same-name repo method exists on {delegate[0]} but {detail}]\"\n            else:\n                where = f\" [{detail}]\"\n            lines += [\"\", f\"    def {fname}(self{', ' + declaration if declaration else ''}) -> {returns}:\",\n                      f'        \"\"\"{description}{where}\"\"\"',\n                      \"        raise NotImplementedError(\",\n                      f'            \"{cls}.{fname}: {detail}\")']\n            stats[\"stubs\"] += 1\n            stats[\"stub_reasons\"].append(f\"{cls}.{fname}: {detail}\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\n# --------------------------------------------------------------------------\n# CLI verbs -> adapters (one scoring rule, baked into cli.py with its scores)\n# --------------------------------------------------------------------------\n\ndef bind_commands(ctx):\n    \"\"\"Map `(command, subcommand_or_None)` to `(action_name, score)` or None.\"\"\"\n    bindings = {}\n    unmapped = []\n    commands = ((ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}).get(\"commands\") or []\n    if not isinstance(commands, list):\n        return bindings, unmapped\n    for command in commands:\n        if not isinstance(command, dict) or not command.get(\"name\"):\n            continue\n        subs = command.get(\"subcommands\") or []\n        subs = [s for s in subs if isinstance(s, dict) and s.get(\"name\")]\n        if not subs:\n            bindings[(command[\"name\"], None)] = _best_adapter(ctx, command[\"name\"], None, unmapped)\n        for sub in subs:\n            bindings[(command[\"name\"], sub[\"name\"])] = _best_adapter(\n                ctx, command[\"name\"], sub[\"name\"], unmapped)\n    return bindings, unmapped\n\n\ndef _best_adapter(ctx, command, sub, unmapped):\n    verb = (sub or command or \"\").lower()\n    stems = COMMAND_VERB_STEMS.get(verb, (verb,))\n    scored = []\n    for adapter in ctx[\"adapters\"]:\n        method = normalize(adapter.get(\"target_method\") or \"\")\n        if verb and not any(stem in method for stem in stems):\n            continue\n        score = 2\n        blob = normalize(adapter.get(\"target_service\") or \"\") + \"|\" + method + \"|\" + normalize(adapter.get(\"action_name\") or \"\")\n        if command and normalize(command) in blob:\n            score += 2\n        if sub and normalize(sub) in blob:\n            score += 2\n        scored.append((score, adapter.get(\"action_name\"), adapter))\n    if not scored:\n        unmapped.append(f\"{command} {sub}\" if sub else f\"{command}\")\n        return None\n    scored.sort(key=lambda item: (-item[0], item[1] or \"\"))\n    best = scored[0]\n    return (best[1], best[0])\n\n\ndef _leaf_options(ctx, command, sub):\n    \"\"\"The option objects of a command (no subs) or subcommand, plus skipped names.\"\"\"\n    commands = ((ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}).get(\"commands\") or []\n    for entry in commands:\n        if not isinstance(entry, dict) or entry.get(\"name\") != command:\n            continue\n        if sub is None:\n            return entry.get(\"options\") or [], []\n        for item in entry.get(\"subcommands\") or []:\n            if isinstance(item, dict) and item.get(\"name\") == sub:\n                return item.get(\"options\") or [], []\n    return [], []\n\n\ndef emit_cli(ctx, bindings, stats):\n    \"\"\"An argparse CLI: every declared verb parses; bound verbs dispatch.\"\"\"\n    lines = ['\"\"\"Command line. Every declared verb parses; bound verbs dispatch to',\n             \"their adapter's service method, unbound ones fail with the reason.\",\n             \"\",\n             \"Transforms follow the adapter document: DIRECT passes through, ISO_DATE\",\n             \"validates ISO format, DECIMAL_TO_CENTS converts money to integer cents,\",\n             \"CSV_LIST splits on commas, LOOKUP_ID coerces to int (existence is\",\n             \"enforced by the repository's foreign-key check on write, or by the\",\n             \"record lookup itself on read).\",\n             '\"\"\"',\n             \"\",\n             \"import argparse\",\n             \"import dataclasses\",\n             \"import datetime\",\n             \"import json\",\n             \"import sys\",\n             \"\",\n             \"import models\",\n             \"import errors\",\n             \"from store import Store\",\n             \"import repositories\",\n             \"import services\",\n             \"\",\n             \"\",\n             \"def _transform(kind, value, field):\",\n             '    if kind == \"DIRECT\" or value is None:',\n             \"        return value\",\n             '    if kind == \"ISO_DATE\":',\n             \"        datetime.date.fromisoformat(str(value))\",\n             \"        return value\",\n             '    if kind == \"DECIMAL_TO_CENTS\":',\n             \"        return int(round(float(value) * 100))\",\n             '    if kind == \"CSV_LIST\":',\n             \"        if isinstance(value, list):\",\n             \"            return value\",\n             '        return [part.strip() for part in str(value).split(\",\") if part.strip()]',\n             '    if kind == \"LOOKUP_ID\":',\n             \"        return int(value)\",\n             '    if kind == \"ENUM_LOOKUP\":',\n             \"        return str(value)\",\n             '    raise ValueError(f\"unknown transform {kind!r} for {field!r}\")',\n             \"\",\n             \"\",\n             \"def _show(result):\",\n             '    if result is None:',\n             \"        return\",\n             \"    if isinstance(result, list):\",\n             \"        for item in result:\",\n             \"            _show(item)\",\n             \"        return\",\n             \"    if dataclasses.is_dataclass(result):\",\n             \"        print(json.dumps(dataclasses.asdict(result), default=str))\",\n             \"        return\",\n             \"    print(result)\",\n             \"\"]\n    actions = {}\n    for adapter in ctx[\"adapters\"]:\n        actions[adapter[\"action_name\"]] = adapter\n    services_by_class = {}\n    for service in ctx[\"services\"]:\n        services_by_class[codegen.sanitize(service[\"service_name\"], \"Service\")] = service\n    lines += [\"\", \"\", \"ADAPTERS = {\"]\n    for name in sorted(actions):\n        adapter = actions[name]\n        lines.append(f\"    {name!r}: {{\")\n        lines.append(f\"        'service': {adapter.get('target_service')!r},\")\n        lines.append(f\"        'method': {adapter.get('target_method')!r},\")\n        lines.append(\"        'fields': [\")\n        for field in adapter.get(\"input_fields\") or []:\n            if not isinstance(field, dict):\n                continue\n            lines.append(\n                f\"            {field.get('field_name')!r}: \"\n                f\"({field.get('target_param')!r}, {field.get('transform')!r}, \"\n                f\"{field.get('required', False)!r}),\")\n        lines.append(\"        ],\")\n        lines.append(\"    },\")\n    lines.append(\"}\")\n    lines += [\"\", \"\", \"BINDINGS = {  # (command, subcommand) -> action [score]\"]\n    for (command, sub), bound in sorted(bindings.items(), key=lambda item: str(item[0])):\n        if bound is None:\n            lines.append(f\"    {(command, sub)!r}: None,\")\n            stats[\"unmapped\"].append(f\"{command} {sub}\" if sub else f\"{command}\")\n        else:\n            action, score = bound\n            lines.append(f\"    {(command, sub)!r}: ({action!r},  # score {score}\")\n            lines.append(\"    ),\")\n    lines.append(\"}\")\n    lines += [\"\", \"\", \"def _option_dest(option):\",\n              '    long = (option.get(\"name\") or \"\").lstrip(\"-\").replace(\"-\", \"_\")',\n              '    short = (option.get(\"short\") or \"\").lstrip(\"-\").replace(\"-\", \"_\")',\n              \"    return sanitize(long or short or 'opt')\",\n              \"\",\n              \"\",\n              \"def sanitize(text):\",\n              '    cleaned = \"\".join(c if c.isalnum() or c == \"_\" else \"_\" for c in str(text))',\n              '    cleaned = cleaned.strip(\"_\") or \"opt\"',\n              '    return \"_\" + cleaned if cleaned[:1].isdigit() else cleaned',\n              \"\"]\n    # parser construction ---------------------------------------------------\n    lines += [\"\", \"\", \"def build_parser():\",\n              f\"    parser = argparse.ArgumentParser(prog={stats['prog']!r})\",\n              \"    sub = parser.add_subparsers(dest='command')\"]\n    commands = ((ctx[\"components\"].get(\"facade\") or {}).get(\"invocation\") or {}).get(\"commands\") or []\n    for command in commands if isinstance(commands, list) else []:\n        if not isinstance(command, dict) or not command.get(\"name\"):\n            continue\n        cname = command[\"name\"]\n        cvar = codegen.sanitize(cname, \"cmd\")\n        subs = [s for s in (command.get(\"subcommands\") or [])\n                if isinstance(s, dict) and s.get(\"name\")]\n        if not subs:\n            options, skipped = _leaf_options(ctx, cname, None)\n            lines.append(f\"    p_{cvar} = sub.add_parser({cname!r})\")\n            lines.extend(_emit_options(\"    \", f\"p_{cvar}\", options, skipped, stats))\n            lines.append(f\"    p_{cvar}.set_defaults(_binding={({cname!r}, None)!r})\")\n        else:\n            lines.append(f\"    p_{cvar} = sub.add_parser({cname!r})\")\n            lines.append(f\"    sub_{cvar} = p_{cvar}.add_subparsers(dest='subcommand')\")\n            for item in subs:\n                sname = item[\"name\"]\n                svar = codegen.sanitize(sname, \"sub\")\n                options, skipped = _leaf_options(ctx, cname, sname)\n                lines.append(f\"    p_{cvar}_{svar} = sub_{cvar}.add_parser({sname!r})\")\n                lines.extend(_emit_options(\"    \", f\"p_{cvar}_{svar}\", options, skipped, stats))\n                lines.append(f\"    p_{cvar}_{svar}.set_defaults(_binding={({cname!r}, {sname!r})!r})\")\n    lines += [\"    return parser\", \"\"]\n    # dispatch ----------------------------------------------------------------\n    lines += [\"\", \"\", \"def _call(bound, values, deps):\",\n              \"    action, _score = bound\",\n              \"    spec = ADAPTERS[action]\",\n              \"    service = deps['services'][sanitize(spec['service'])]\"\n              if False else \"    service = deps['services'][spec['service']]\",\n              \"    method = getattr(service, sanitize(spec['method']))\",\n              \"    present = {normalize(k): (k, v) for k, v in values.items()}\",\n              \"    kwargs = {}\",\n              \"    for field_name, (target_param, kind, required) in spec['fields']:\",\n              \"        if normalize(field_name) not in present:\",\n              \"            if required:\",\n              \"                raise ValueError(f\\\"missing required field {field_name!r} for {action!r}\\\")\",\n              \"            continue\",\n              \"        _, value = present[normalize(field_name)]\",\n              \"        kwargs[target_param] = _transform(kind, value, field_name)\",\n              \"    grouped = {}\",\n              \"    for target_param, value in kwargs.items():\",\n              \"        grouped.setdefault(target_param, value)\",\n              \"    call_kwargs = {}\",\n              \"    for target_param, value in grouped.items():\",\n              \"        model_cls = deps['entities'].get(normalize(target_param))\",\n              \"        if model_cls is not None and isinstance(value, dict):\",\n              \"            call_kwargs[target_param] = model_cls(**value)\",\n              \"        else:\",\n              \"            call_kwargs[target_param] = value\",\n              \"    return method(**{sanitize(k): v for k, v in call_kwargs.items()})\",\n              \"\",\n              \"\",\n              \"def normalize(text):\",\n              '    return \"\".join(c for c in str(text).lower() if c.isalnum())',\n              \"\",\n              \"\",\n              \"def build_cli():\",\n              \"    from store import Store\",\n              \"    store = Store()\",\n              \"    repos = {}\",\n              \"    for cls_name in REPOSITORIES:\",\n              \"        repos[cls_name] = getattr(repositories, cls_name)(store)\",\n              \"    hired = {}\",\n              \"    for cls_name in SERVICES:\",\n              \"        hired[cls_name] = getattr(services, cls_name)(repos)\",\n              \"    entities = {normalize(name): getattr(models, name) for name in MODELS}\",\n              \"    return build_parser(), {'store': store, 'repos': repos,\",\n              \"                           'services': {**repos, **hired},\",\n              \"                           'entities': entities}\",\n              \"\",\n              \"\",\n              \"def main(argv=None):\",\n              \"    parser, deps = build_cli()\",\n              \"    args = parser.parse_args(argv)\",\n              \"    binding = getattr(args, '_binding', None)\",\n              \"    if binding is None:\",\n              \"        parser.print_usage()\",\n              \"        return 2\",\n              \"    bound = BINDINGS.get(tuple(binding))\",\n              \"    if bound is None:\",\n              \"        print(f\\\"no adapter bound for {' '.join(binding)} — not implemented\\\")\",\n              \"        return 1\",\n              \"    values = {key: value for key, value in vars(args).items()\",\n              \"              if key not in ('command', 'subcommand', '_binding')}\",\n              \"    _show(_call(bound, values, deps))\",\n              \"    return 0\",\n              \"\",\n              \"\",\n              'if __name__ == \"__main__\":',\n              \"    sys.exit(main())\",\n              \"\"]\n    # class lists --------------------------------------------------------------\n    repo_classes = [codegen.sanitize(r.get(\"interface_name\") or r.get(\"entity\"), \"Repository\")\n                    for r in ctx[\"repositories\"]]\n    service_classes = [codegen.sanitize(s[\"service_name\"], \"Service\") for s in ctx[\"services\"]\n                       if normalize(s[\"service_name\"]) not in\n                       {normalize(r.get(\"interface_name\") or \"\") for r in ctx[\"repositories\"]}]\n    model_names = [codegen.sanitize(m[\"name\"], \"Model\") for m in ctx[\"models\"]]\n    anchor = \"    repos = {}\\n\"\n    text = \"\\n\".join(lines)\n    text = text.replace(anchor,\n                        f\"    repos = {{}}\\n    MODELS = {model_names!r}\\n\"\n                        f\"    REPOSITORIES = {repo_classes!r}\\n\"\n                        f\"    SERVICES = {service_classes!r}\\n\".replace(\n                            \"    \", \"\"), 1)\n    # NOTE: simpler to append the lists right after the imports instead.\n    return text + \"\\n\"\n\n\ndef _emit_options(indent, parser_var, options, skipped, stats):\n    \"\"\"`add_argument` lines; `help`/`version` flags are argparse's own.\"\"\"\n    lines = []\n    seen = set()\n    for option in options or []:\n        if not isinstance(option, dict):\n            continue\n        raw = (option.get(\"name\") or \"\").strip()\n        norm = raw.lstrip(\"-\").lower()\n        if norm in (\"help\", \"version\") and raw.startswith(\"-\"):\n            stats.setdefault(\"skipped_options\", []).append(raw)\n            continue\n        if not raw:\n            continue\n        dest = (raw.lstrip(\"-\").replace(\"-\", \"_\") or\n                (option.get(\"short\") or \"\").lstrip(\"-\").replace(\"-\", \"_\") or \"opt\")\n        dest = codegen.sanitize(dest, \"opt\")\n        if dest in seen:\n            continue\n        seen.add(dest)\n        otype = (option.get(\"type\") or \"str\").strip().lower()\n        required = bool(option.get(\"required\"))\n        default = option.get(\"default\")\n        parts = [f\"{raw!r}\"]\n        short = (option.get(\"short\") or \"\").strip()\n        if short and short != raw:\n            parts.append(f\"{short!r}\")\n        if otype == \"bool\":\n            parts.append(\"action='store_true'\" if not default else \"action='store_false'\")\n            if default:\n                parts.append(\"default=True\")\n        elif otype == \"list\":\n            parts.append(\"nargs='*'\")\n            if default is not None:\n                parts.append(f\"default={default!r}\")\n        else:\n            pytype = {\"str\": \"str\", \"int\": \"int\", \"float\": \"float\"}.get(otype, \"str\")\n            parts.append(f\"type={pytype}\")\n            parts.append(f\"required={required!r}\")\n            if default is not None:\n                parts.append(f\"default={default!r}\")\n        parts.append(f\"dest={dest!r}\")\n        lines.append(f\"{indent}{parser_var}.add_argument({', '.join(parts)})\")\n    return lines\n\n\n# --------------------------------------------------------------------------\n# assembly\n# --------------------------------------------------------------------------\n\ndef render_program(ctx, stats):\n    \"\"\"Every file of the package as `{filename: text}`.\"\"\"\n    stats[\"skipped_options\"] = []\n    stats[\"unmapped\"] = []\n    repo_index = _repo_index(ctx)\n    files = {}\n    files[\"__init__.py\"] = \"\"  # placeholder, rewritten with stats below\n    files[\"models.py\"] = emit_models(ctx)\n    files[\"errors.py\"] = emit_errors(ctx)\n    with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),\n                           \"kernel\", \"codegen_store_template.py\"),\n              encoding=\"utf-8\") as handle:\n        files[\"store.py\"] = handle.read()\n    files[\"repositories.py\"], = [None]  # placeholder guard (replaced below)\n    del files[\"repositories.py\"],\n    repo_text = emit_repositories(ctx, stats)\n    files[\"repositories.py\"] = repo_text\n    files[\"services.py\"] = emit_services(ctx, repo_index, stats)\n    bindings, unmapped = bind_commands(ctx)\n    stats[\"unmapped\"].extend(u for u in unmapped if u not in stats[\"unmapped\"])\n    stats[\"bindings\"] = {f\"{c} {s}\" if s else c: (b[0], b[1]) if b else None\n                         for (c, s), b in bindings.items()}\n    files[\"cli.py\"] = emit_cli(ctx, bindings, stats)\n    files[\"__init__.py\"] = emit_init(ctx, stats)\n    return files\n\n\ndef gate(output_dir):\n    \"\"\"`(ok, message)`: refuse generation when the probe would blame us.\"\"\"\n    name = os.path.basename(output_dir.rstrip(os.sep))\n    blockers, risks, _ = probe_readiness.check_prompt(name, output_dir)\n    questions = probe_readiness.open_questions(output_dir)\n    if blockers:\n        first = \"; \".join(f\"[{b.rule}] {b.message}\" for b in blockers[:5])\n        return False, f\"refusing: {len(blockers)} generator blocker(s): {first}\"\n    if questions:\n        return False, (f\"refusing: {questions} open tie(s) need a human \"\n                       f\"(python review_ties.py {output_dir})\")\n    return True, (f\"gate passe
ds, list):\n                continue\n            if any(isinstance(f, dict) and f.get(\"name\") == spec.get(\"name\")\n                   for f in fields):\n                continue\n            fields.append({\n                \"name\": spec.get(\"name\"),\n                \"type\": spec.get(\"type\"),\n                \"primary_key\": False,\n                \"nullable\": bool(spec.get(\"nullable\", True)),\n                \"unique\": bool(spec.get(\"unique\", False)),\n                \"foreign_key\": spec.get(\"foreign_key\"),\n                \"status\": \"deduced\",\n            })\n            applied += 1\n    if applied and log is not None:\n        log.write(f\"[ok] step data_models: applied {applied} recorded created field(s)\")\n    return models''', 1)\np.write_text(t)\nprint('ok')\nPYEOF\npython3 -c \"import kernel.extraction.aliases; print('imports ok')\""

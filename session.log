177-\n178-\n179-def _tie_reason(payload):\n180-    candidates = payload.get(\"candidates\") if isinstance(payload, dict) else None\n181-    if candidates:\n182-        return f\"open tie between {' and '.join(candidates)}: review skipped\"\n183-    return \"unclassifiable match entry\"\n184-\n185-\n186-def canon_tokens(text):\n187-    \"\"\"Lowercased `_`/`-`-separated tokens with CLI date synonyms folded.\n188-\n189-    `--from-date` and `--start-date` name the same bound: leading `from`\n190-    becomes `start` and leading `to` becomes `end`. Only the first token is\n191-    folded, so `total` and `tomorrow` are untouched.\n192-    \"\"\"\n193-    tokens = [t for t in re.split(r\"[_-]+\", str(text or \"\").lower()) if t]\n194-    if tokens and tokens[0] == \"from\":\n195-        tokens[0] = \"start\"\n196-    if tokens and tokens[0] == \"to\":\n197-        tokens[0] = \"end\"\n198-    return tokens\n199-\n"

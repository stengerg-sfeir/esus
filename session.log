                "text": "Read file /home/gstenger/Documents/esus/review_contracts.py, lines 1-651\n1: #!/usr/bin/env python3\n2: \"\"\"Ask the human for behavior facts a method needs and no document states.\n3: \n4: The generator can check a body against the API it was shown, but it cannot\n5: know that returning a book means setting `return_date` to now, incrementing\n6: one field and saving two repositories. Putting that knowledge in the\n7: generator would make it library-shaped; putting it in the requirements would\n8: make every test a wording test. It belongs in a human-confirmed record beside\n9: the documents.\n10: \n11: This review reads the existing `out/...` documents (no model run needed),\n12: proposes the domain-neutral parts it can see — fields changed by verb, model\n13: created, declared-error preconditions, the repository calls that save them —\n14: and asks the human only for the values an English sentence does not settle:\n15: the amount, the date/status value, the order, and any condition behind an\n16: error such as `InvalidReturnDateError`. The answers are written to\n17: `method_contracts.json`, stamped with the requirements sha; `generator.py`\n18: reads them on every run. Skipping a required value records nothing, so the\n19: stub stays and the question reopens.\n20: \n21: Usage:\n22:     python review_contracts.py out/library          # ask open contracts\n23:     python review_contracts.py out/library --list   # show proposals only\n24: \n25: This is deliberately a separate pass from extraction. `extract_arch.py\n26: --chat` runs it at the end when asked; a full extraction is not required to\n27: create the file for an existing tree.\n28: \"\"\"\n29: \n30: import ast\n31: import os\n32: import re\n33: import sys\n34: \n35: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n36: \n37: import generator  # noqa: E402\n38: from kernel.consistency.loader import load_requirements  # noqa: E402\n39: from kernel.consistency.naming import normalize  # noqa: E402\n40: from kernel.extraction import contracts as contract_rules  # noqa: E402\n41: from kernel.extraction.decisions import requirements_sha  # noqa: E402\n42: \n43: NUMERIC_TYPES = (\"int\", \"integer\", \"float\", \"double\", \"decimal\", \"number\",\n44:                  \"money\")\n45: DATE_TYPES = (\"date\", \"datetime\")\n46: DATE_NAME_HINTS = (\"date\", \"month\", \"year\", \"day\", \"time\", \"created\",\n47:                    \"updated\")\n48: BOOL_TYPES = (\"bool\", \"boolean\")\n49: \n50: # The verbs that mean \"write this field\". The noun after the verb is matched\n51: # against model fields; the parser never sees a domain name of its own.\n52: EFFECT_VERBS = (\n53:     (r\"increments?|increases?|raises?\", \"increment\"),\n54:     (r\"decrements?|decreases?|reduces?|removes?|subtracts?\", \"decrement\"),\n55:     (r\"sets?|updates?|changes?|toggles?\", \"set\"),\n56: )\n57: CREATE_VERBS = r\"creates?|adds?\"\n58: # English number words are not field names; make quantity/qty one term so a\n59: # factory description (\"stock quantity\") can reach a `stock_qty` field.\n60: SYNONYMS = ((\"quantities\", \"qty\"), (\"quantity\", \"qty\"),\n61:             (\"count\", \"qty\"), (\"copies\", \"copies\"))\n62: \n63: \n64: def _fields(ctx):\n65:     \"\"\"`[(class, field, type, field_dict)]` for every model.\"\"\"\n66:     rows = []\n67:     for model in ctx.get(\"models\") or []:\n68:         class_name = model.get(\"name\")\n69:         for field in model.get(\"fields\") or []:\n70:             if isinstance(field, dict) and field.get(\"name\"):\n71:                 rows.append((class_name, field[\"name\"],\n72:                              (field.get(\"type\") or \"\").strip().lower(),\n73:                              field))\n74:     return rows\n75: \n76: \n77: def _params(method):\n78:     return [param[\"name\"] for param in method.get(\"params\") or []\n79:             if isinstance(param, dict) and isinstance(param.get(\"name\"), str)]\n80: \n81: \n82: def _synonym_text(text):\n83:     lowered = str(text).lower()\n84:     for word, replacement in SYNONYMS:\n85:         lowered = re.sub(rf\"\\b{re.escape(word)}\\b\", replacement, lowered)\n86:     return lowered\n87: \n88: \n89: def _match_field(noun, fields):\n90:     \"\"\"The model field a noun phrase names, or None.\n91: \n92:     The longest field whose normalized name appears in the phrase wins, so\n93:     \"is_active status\" reaches `is_active` rather than the shorter `status`\n94:     (which belongs to another model). A field name that contains the phrase\n95:     also matches (\"copies\" -> `available_copies`).\n96:     \"\"\"\n97:     phrase = normalize(_synonym_text(noun))\n98:     if not phrase:\n99:         return None\n100:     best = None\n101:     for class_name, field_name, field_type, field in fields:\n102:         field_norm = normalize(field_name)\n103:         if not field_norm:\n104:             continue\n105:         if field_norm in phrase:\n106:             score = len(field_norm)\n107:         elif len(phrase) >= 4 and phrase in field_norm:\n108:             score = len(phrase)\n109:         else:\n110:             continue\n111:         if best is None or score > best[0]:\n112:             best = (score, class_name, field_name, field_type, field)\n113:     if best is None:\n114:         return None\n115:     _score, class_name, field_name, field_type, field = best\n116:     return class_name, field_name, field_type, field\n117: \n118: \n119: def _match_class(noun, ctx):\n120:     \"\"\"The model class a noun phrase names, or None.\"\"\"\n121:     phrase = normalize(noun)\n122:     best = None\n123:     for name in ctx.get(\"entity_names\") or []:\n124:         normalized = normalize(name)\n125:         if normalized and normalized in phrase:\n126:             if best is None or len(normalized) > len(normalize(best)):\n127:                 best = name\n128:     return best\n129: \n130: \n131: def _repo_for(ctx
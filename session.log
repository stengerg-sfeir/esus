',\n1053:              \"\",\n1054:              \"\",\n1055:              \"def _collect(panel, state, specs):\",\n1056:              '    \"\"\"Split widgets into `(model_kwargs, scalar_kwargs)` for one call.\"\"\"',\n1057:              \"    names = {f['name'] for f in panel['fields']}\",\n1058:              \"    model_kwargs, scalar_kwargs = {}, {}\",\n1059:              \"    for spec in specs:\",\n1060:              \"        if spec['entity'] or spec['raw'] in names:\",\n1061:              \"            continue  # assembled into the model instance below\",\n1062:              \"        value = _parse(spec['kind'], state['inputs'].get(spec['raw'], ''))\",\n1063:              \"        scalar_kwargs[spec['py']] = value\",\n1064:              \"    for field in panel['fields']:\",\n1065:              \"        value = _parse(field['kind'], state['inputs'].get(field['name'], ''))\",\n1066:              \"        if value is not None:\",\n1067:              \"            model_kwargs[field['name']] = value\",\n1068:              \"    return model_kwargs, scalar_kwargs\",\n1069:              \"\",\n1070:              \"\",\n1071:              \"def _invoke(panel, repo, state, op_name):\",\n1072:              '    op = panel[\"ops\"].get(op_name)',\n1073:              \"    if op is None:\",\n1074:              '        state[\"message\"] = f\"no {op_name} method\"',\n1075:              \"        return\",\n1076:              \"    try:\",\n1077:              \"        model_kwargs, scalar_kwargs = _collect(panel, state, op['specs'])\",\n1078:              \"        call_kwargs = dict(scalar_kwargs)\",\n1079:              \"        for spec in op['specs']:\",\n1080:              \"            if spec['entity']:\",\n1081:              \"                model_cls = getattr(models, panel['model'])\",\n1082:              \"                call_kwargs[spec['py']] = model_cls(**model_kwargs)\",\n1083:              \"        if not any(s['entity'] for s in op['specs']):
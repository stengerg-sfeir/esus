                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/extract_archi.py, lines 1-107\n1: #!/usr/bin/env python3\n2: \"\"\"Extract a software architecture from requirements, one step at a time.\n3: \n4: Reads the requirements on stdin and writes one `<step>.json` per document into\n5: the output directory, plus `run.log`. Each step is handed the names its\n6: predecessors produced — in its prompt as an authoritative list, and in its GBNF\n7: grammar as the only strings it can write — so the documents agree by\n8: construction rather than by repair.\n9: \n10: Usage:\n11:     python3.12 extract_archi.py --model MODEL.gguf --output out/library \\\\\n12:         < prompts/prompt_library_system.txt\n13: \"\"\"\n14: \n15: import argparse\n16: import sys\n17: from pathlib import Path\n18: \n19: from kernel.extraction import pipeline as pipeline_module\n20: from kernel.extraction import runner, writer\n21: \n22: \n23: def build_parser():\n24:     parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n25:     parser.add_argument(\"--model\", required=True, help=\"Path to the GGUF model\")\n26:     parser.add_argument(\n27:         \"--output\",\n28:         required=True,\n29:         help=\"Directory to write the step documents and run.log into\",\n30:     )\n31:     parser.add_argument(\n32:         \"--context\",\n33:         type=int,\n34:         default=8192,\n35:         help=\"Context size in tokens (default 8192)\",\n36:     )\n37:     parser.add_argument(\n38:         \"--check\",\n39:         action=\"store_true\",\n40:         help=\"Run the consistency checker over the output once the run finishes\",\n41:     )\n42:     return parser\n43: \n44: \n45: def main():\n46:     args = build_parser().parse_args()\n47: \n48:     requirements = sys.stdin.read().strip()\n49:     if not requirements:\n50:         print(\"error: no requirements were provided on stdin\", file=sys.stderr)\n51:         return 1\n52: \n53:     output_dir = Path(args.output)\n54:     log = writer.RunLog(output_dir / writer.RUN_LOG_NAME)\n55:     log.write(f\"[run] requirements: {len(requirements)} characters\")\n56: \n57:     extractor = runner.load_model(args.model, context_size=args.context, logits_all=False)\n58: \n59:     # The classifier is a second model whose context is built with\n60:     # `logits_all=True`, which only step F's `logprobs` needs — every other step\n61:     # would pay that cost for nothing. It is therefore loaded lazily, the first\n62:     # time a run actually has something to classify, so a program with no domain\n63:     # (hello, cli_tool) loads one model rather than two. See\n64:     # `Pipeline._step_patterns`.\n65:     pipeline = pipeline_module.Pipeline(\n66:         extractor,\n67:         log=log,\n68:         classifier_factory=lambda: runner.load_model(\n69:             args.model, context_size=args.context, logits_all=True\n70:         ),\n71:     )\n72:     documents = pipeline.run(requirements)\n73: \n74:     for path in writer.write_documents(output_dir, documents):\n75:         log.write(f\"[write] {path}\")\n76:     # The requirements accompany the documents so the checker can later compare\n77:     # the recorded surface against what was actually asked for.\n78:     log.write(f\"[write] {writer.write_requirements(output_dir, requirements)}\")\n79: \n80:     tokens = sum(result.tokens for result in pipeline.results)\n81:     seconds = sum(result.seconds for result in pipeline.results)\n82:     log.write(\n83:         f\"[run] {len(pipeline.results)} steps, {tokens} generated tokens in {seconds:.1f}s\"\n84:     )\n85:     log.flush()\n86: \n87:     if args.check:\n88:         return check_output(output_dir)\n89:     return 0\n90: \n91: \n92: def check_output(output_dir):\n93:     \"\"\"Run the consistency checker over a finished run.\"\"\"\n94:     from kernel.consistency import check_directory, render_report\n95: \n96:     report = check_directory(str(output_dir), output_dir.name)\n97:     print(render_report(report, show_all=True))\n98:     errors, warnings = report.counts\n99:     summary = f\"consistency: {errors} error(s), {warnings} warning(s)\"\n100:     if report.notes:\n101:         summary += f\", {len(report.notes)} note(s)\"\n102:     print(summary)\n103:     return 1 if errors else 0\n104: \n105: \n106: if __name__ == \"__main__\":\n107:     sys.exit(main())"

(f\"unknown operator {operator!r}\")\n168: \n169: \n170: def match_criterion(field_names, param):\n171:     \"\"\"Map a filter parameter to `(field, operator)` or None.\n172: \n173:     Twin of `kernel.codegen.match_param` — copied here so generated programs\n174:     are dependency-free. Exact normalized equality is `eq`; a `<x>_id`\n175:     parameter names the entity's own `id` when no field matches. A\n176:     `start_`/`from_`/`min_` prefix is `ge` and an `end_`/`to_`/`max_`\n177:     prefix is `le` against the field containing the remainder (`start_date`\n178:     filters `expense_date`); a remainder matching several fields refuses.\n179:     \"\"\"\n180:     wanted = \"\".join(character for character in str(param or \"\").lower()\n181:                      if character.isalnum())\n182:     if not wanted:\n183:         return None\n184:     for field in field_names:\n185:         if \"\".join(c for c in str(field).lower() if c.isalnum()) == wanted:\n186:             return (field, \"eq\")\n187:     for prefix, operator in ((\"start\", \"ge\"), (\"from\", \"ge\"),\n188:                              (\"end\", \"le\"), (\"to\", \"le\"),\n189:                              (\"min\", \"ge\"), (\"max\", \"le\")):\n190:         if wanted.startswith(prefix) and len(wanted) > len(prefix):\n191:             rest = wanted[len(prefix):]\n192:             candidates = []\n193:             for field in field_names:\n194:                 flat = \"\".join(c for c in str(field).lower()\n195:                                if c.isalnum())\n196:                 if rest and (rest in flat or flat in rest):\n197:                     candidates.append(field)\n198:             if len(candidates) == 1:\n199:                 return (candidates[0], operator)\n200:     raw = str(param or \"\").strip().lower()\n201:     if raw.endswith(\"_id\") and len(raw) > 3:\n202:         for field in field_names:\n203:             if \"\".join(c for c in str(field).lower()\n204:                       
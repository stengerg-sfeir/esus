                "text": "Read file /Users/gillesstenger/Documents/esus/review_aliases.py, lines 107-186\n107: def _question(adapters, leaf_of, argv, invocation, action, field,\n108:               entity, kind, model_fields=()):\n109:     \"\"\"One askable pair, stated as a contract, not internals.\n110: \n111:     kind 'model' asks which model field the value fills (the adapter names\n112:     no declared one); kind 'flag' asks which flag supplies a required value\n113:     no leaf flag covers. Either way the answer renames the adapter field\n114:     only — service, method and parameter are shown qualified so the human\n115:     sees exactly what maps to where.\n116:     \"\"\"\n117:     adapter = next((a for a in adapters\n118:                     if isinstance(a, dict) and a.get(\"action_name\") == action), {})\n119:     entry = next((f for f in adapter.get(\"input_fields\") or []\n120:                   if isinstance(f, dict) and f.get(\"field_name\") == field), {})\n121:     service = adapter.get(\"target_service\")\n122:     method = adapter.get(\"target_method\")\n123:     target = entry.get(\"target_param\")\n124:     leaves = leaf_of.get(action, [])\n125:     leafpaths = [\" \".join(part for part in leaf if part) for leaf in leaves]\n126:     leaf_flags = []\n127:     for command, sub in leaves:\n128:         for option in codegen.leaf_options(invocation, command, sub):\n129:             if isinstance(option, dict) and option.get(\"name\"):\n130:                 if option[\"name\"] not in leaf_flags:\n131:                     leaf_flags.append(option[\"name\"])\n132:     supplied = []\n133:     dest = (argv.get(action) or {}).get(field)\n134:     if dest:\n135:         for (command, sub), leafpath in zip(leaves, leafpaths):\n136:             for option in codegen.leaf_options(invocation, command, sub):\n137:                 if (isinstance(option, dict)\n138:                         and codegen.option_dest(option) == dest\n139:                         and option.get(\"name\")):\n140:                     pair = (leafpath, option[\"name\"])\n141:                     if pair not in supplied:\n142:                         supplied.append(pair)\n143:     problems = []\n144:     if kind == \"model\" and entity:\n145:         problems.append(\n146:             f\"{entity} declares no '{field}' field, so building it fails.\")\n147:     if kind == \"flag\":\n148:         where = leafpaths[0] if len(leafpaths) == 1 else \"its command\"\n149:         problems.append(\n150:             f\"no flag on '{where}' supplies this required value — \"\n151:             f\"the action parses but can never run.\")\n152:     if kind == \"model\" and entity:\n153:         question_line = f\"Which {entity} field does this value fill?\"\n154:         suggestions = suggest_model_fields(model_fields, entity, field)\n155:     else:\n156:         question_line = \"Which flag supplies this value?\"\n157:         suggestions = suggest_flags(\n158:             sorted({d for d in (argv.get(action) or {}).values() if d}), field)\n159:     spellings = {}\n160:     for command, sub in leaves:\n161:         for option in codegen.leaf_options(invocation, command, sub):\n162:             if isinstance(option, dict) and option.get(\"name\"):\n163:                 known = codegen.option_dest(option)\n164:                 if known and known not in spellings:\n165:                     spellings[known] = option[\"name\"]\n166:     return {\n167:         \"action\": action,\n168:         \"field\": field,\n169:         \"service\": service,\n170:         \"method\": method,\n171:         \"target\": target,\n172:         \"transform\": entry.get(\"transform\"),\n173:         \"entity\": entity,\n174:         \"kind\": kind,\n175:         \"leaves\": leafpaths,\n176:         \"flags\": sorted({d for d in (argv.get(action) or {}).values() if d}),\n177:         \"leaf_flags\": leaf_flags,\n178:         \"supplied\": supplied,\n179:         \"problem\": problems,\n180: 
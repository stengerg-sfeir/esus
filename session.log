                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/pipeline.py, lines 325-439\n325:     def _step_contracts(self, requirements):\n326:         \"\"\"Step E: service names are new, so the grammar stays open.\n327: \n328:         Gated on there being entities, as step H is gated on persistence: a\n329:         service contract exists to act on a domain, so no domain means no\n330:         services. Ungated, this step invented a `HelloWorldService` for a\n331:         program whose data model was, correctly, empty — and step G then\n332:         faithfully built an adapter onto it.\n333:         \"\"\"\n334:         entities = self._entities()\n335:         if not entities:\n336:             self.log.write(\"[ok] step contracts: step B produced no entities — no services\")\n337:             self.documents[SERVICE_CONTRACTS] = []\n338:             return\n339:         vocab = vocabulary.Vocabulary(\n340:             entities=entities,\n341:             crud_operations=vocabulary.crud_requirements(self.documents.get(COMPONENTS)),\n342:             errors=self.documents.get(ERRORS) or (),\n343:         )\n344:         # E owns the repositories it declares, so it must be told which\n345:         # operations each entity needs — otherwise it writes \"standard CRUD\"\n346:         # from an adjective rather than from the list, and every delete is lost.\n347:         block = prompts.requirements_block(vocab)\n348:         grammar = grammar_open.service_contracts()\n349:         body = self._generate(\n350:             SERVICE_CONTRACTS,\n351:             prompts.service_contracts(requirements, block),\n352:             grammar,\n353:         )\n354:         # A signature is a specification the generated body must honour, so a\n355:         # method that returns `dict[str, object]` where the entity is known is a\n356:         # defect no generation can repair without overriding the contract.\n357:         if isinstance(body, list):\n358:             self.documents[SERVICE_CONTRACTS] = return_types.repair_contract_returns(\n359:                 body, self._entities(), self.log\n360:             )\n361:         # The operations block is a minimum the interface must provide, but the\n362:         # grammar cannot enforce that a create/delete method exists — absence is\n363:         # always representable. A miss is retried once with the miss itself\n364:         # appended, exactly as named.\n365:         missing = _unmet_operations(\n366:             self.documents.get(COMPONENTS),\n367:             {\n368:                 SERVICE_CONTRACTS: self.documents.get(SERVICE_CONTRACTS),\n369:                 PERSISTENCE_PORTS: self.documents.get(PERSISTENCE_PORTS),\n370:             },\n371:         )\n372:         if missing:\n373:             self.log.write(\n374:                 f\"[!] step contracts omits {len(missing)} required operation(s) — \"\n375:                 f\"retrying once\"\n376:             )\n377:             body = self._generate(\n378:                 SERVICE_CONTRACTS,\n379:                 prompts.service_contracts(_with_miss_note(requirements, missing), block),\n380:                 grammar,\n381:             )\n382:             if isinstance(body, list):\n383:                 self.documents[SERVICE_CONTRACTS] = return_types.repair_contract_returns(\n384:                     body, self._entities(), self.log\n385:                 )\n386:             still = _unmet_operations(\n387:                 self.documents.get(COMPONENTS),\n388:                 {\n389:                     SERVICE_CONTRACTS: self.documents.get(SERVICE_CONTRACTS),\n390:                     PERSISTENCE_PORTS: self.documents.get(PERSISTENCE_PORTS),\n391:                 },\n392:             )\n393:             if still:\n394:                 self.log.write(\n395:                     f\"[!] step contracts still omits {len(still)} required operation(s) — \"\n396:                     f\"kept, the probe will report it\"\n397:                 )\n398: \n399:     def _repair_errors(self):\n400:         \"\"\"Remove the two error contradictions the grammar cannot express (§9.28).\n401: \n402:         Run after step E because both documents have to exist first: the registry\n403:         is what `raises` resolves against, and the keep/drop decision for a\n404:         duplicate subject follows which name a method actually raises. The\n405:         constraints are global — two names meaning one thing, a create raising\n406:         its own not-found — so no GBNF expresses them, and the check for each is\n407:         shared with the checker to keep one definition.\n408:         \"\"\"\n409:         services = self.documents.get(SERVICE_CONTRACTS)\n410:         errors, services = repairs.repair_errors(\n411:             self.documents.get(ERRORS), services, self.log\n412:         )\n413:         # A declared error that no method raises is dead code. The registry keeps\n414:         # one when a method raises it, when the requirements name it, or when a\n415:         # distinctive word of its name is grounded in the requirements; otherwise\n416:         # it is dropped (§9.34).\n417:         errors = repairs.repair_unraised_errors(\n418:             errors, services, getattr(self, \"requirements\", \"\"), self.log\n419:         )\n420:         self.documents[ERRORS] = errors\n421:         if isinstance(services, list):\n422:             self.documents[SERVICE_CONTRACTS] = services\n423: \n424:     def _step_patterns(self):\n425:         \"\"\"Step F: classify invariants and contract methods into kernel patterns.\n426: \n427:         The classifier model is loaded here, on the first run that actually has\n428:         something to classify, rather than at startup. Its context is built with\n429:         `logits_all=True` — the pattern classifier reads per-token `logprobs`,\n430:         which nothing else needs — so it is a second full model load, and a\n431:         program with no domain (hello, cli_tool) must not pay for one it will\n432:         never call. Building it here means a no-domain run loads one model.\n433:         \"\"\"\n434:         items = classification.classification_items(self.documents)\n435:         if not items:\n436:             self.log.write(\"[ok] step patterns: nothing to classify\")\n437:             self.documents[PATTERN_MATCHES] = []\n438:             return\n439:         if self.classifier is None and self.classifier_factory is not None:\n[Output truncated. Continue reading with offset: 440]"

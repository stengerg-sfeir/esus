n] requirements: {len(requirements)} characters\")\n251:     log.write(f\"[run] temperature={pipeline_module.TEMPERATURE} seed={pipeline_module.SEED}\")\n252:     if start is not None:\n253:         log.write(f\"[run] resuming at step {start} from archived documents\")\n254:         # RunLog overwrites on flush: carry the earlier rounds forward, or\n255:         # every resume erases the history that explains the current documents.\n256:         try:\n257:             previous = (output_dir / writer.RUN_LOG_NAME).read_text(encoding=\"utf-8\").splitlines()\n258:         except OSError:\n259:             previous = []\n260:         if previous:\n261:             log.lines[:0] = previous + [\"[run] --- resumed ---\"]\n262: \n263:     extractor = runner.load_model(args.model, context_size=args.context,\n264:                                     logits_all=False,\n265:                                     quiet=getattr(args, \"quiet\", False))\n266: \n267:     # The classifier is a second model whose context is built with\n268:     # `logits_all=True`, which only step F's `logprobs` needs — every other step\n269:     # would pay that cost for nothing. It is therefore loaded lazily, the first\n270:     # time a run actually has something to classify, so a program with no domain\n271:     # (hello, cli_tool) loads one model rather than two. See\n272:     # `Pipeline._step_patterns`.\n273:     pipeline = pipeline_module.Pipeline(\n274:         extractor,\n275:         log=log,\n276:         classifier_factory=lambda: runner.load_model(\n277:             args.model, context_size=args.context, logits_all=True,\n278:             quiet=getattr(args, \"quiet\", False)\n279:         ),\n280:         progress_fn=lambda name, summary: print(f\"{name}: {summary}\"),\n281:     )\n282:     pipeline.documents.update(preloaded)\n283:     documents = pipeline.run(requirements, start=start)\n284: \n285:     # A human decision outranks a coin flip: re-apply the recorded answers to\n286:     
              "newString": "def _option_dest(option):\n    \"\"\"The argparse dest for an option object (mirrors `_emit_options`).\"\"\"\n    if not isinstance(option, dict):\n        return None\n    raw = (option.get(\"name\") or option.get(\"short\") or \"\").strip()\n    if not raw.startswith(\"-\"):\n        raw = \"--\" + raw if raw else \"\"\n    if not raw or raw.lstrip(\"-\").lower() in (\"help\", \"version\"):\n        return None\n    return codegen.sanitize(raw.lstrip(\"-\").replace(\"-\", \"_\"), \"opt\")\n\n\ndef _bind_field(dests, field):\n    \"\"\"An option dest for an adapter field: exact match, else unique containment.\n\n    CLI flags abbreviate (`--price` for `price_cents`, `--category` for\n    `category_id`); containment in either direction resolves those, and an\n    ambiguous or absent match is None — reported in the generation summary,\n    enforced (for required fields) at runtime.\n    \"\"\"\n    wanted = normalize(field or \"\")\n    if not wanted:\n        return None\n    exact = [d for d in dests if normalize(d) == wanted]\n    if len(exact) == 1:\n        return exact[0]\n    if exact:\n        return None\n    fuzzy = [d for d in dests\n             if normalize(d) and (normalize(d) in wanted or wanted in normalize(d))]\n    return fuzzy[0] if len(fuzzy) == 1 else None\n\n\ndef _action_argv(ctx, bindings):\n    \"\"\"`{action_name: {field_name: dest_or_None}}` over the bound leaves' flags.\"\"\"\n    leaves = {}\n    for (command, sub), bound in bindings.items():\n        if bound is None:\n            continue\n        options, _ = _leaf_options(ctx, command, sub)\n        dests = [d for d in (_option_dest(o) for o in options) if d]\n        leaves.setdefault(bound[0], []).append(dests)\n    argv = {}\n    for adapter in ctx[\"adapters\"]:\n        name = adapter.get(\"action_name\")\n        union = []\n        for dests in leaves.get(name, []):\n            union.extend(d for d in dests if d not in union)\n        argv[name] = {}\n        for field in adapter.get(\"input_fields\") or []:\n            if isinstance(field, dict) and field.get(\"field_name\"):\n                argv[name][field[\"field_name\"]] = _bind_field(union, field[\"field_name\"])\n    return argv",

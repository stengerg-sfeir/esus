cation\": invocation}},\n            \"routes\": routes,\n        }\n```\n\nFor the route test, the emitted module list needs Member model ✓ (models default includes Member).\n\nRoute runtime fake:\n```python\n        class MemberRepository:\n            def __init__(self, store):\n                pass\n            def read_all_members(self):\n                return [\"all-members\"]\n            def find_active_members(self):\n                return [\"active-members\"]\n```\n\nAssertions:\n```python\n    def test_recorded_route_wins_when_its_flag_is_passed(self):\n        route = {\"kind\": \"route\", \"command\": \"member\", \"subcommand\": \"list\",\n                 \"flag\": \"active_only\", \"service\": \"MemberRepository\",\n                 \"method\": \"find_active_members\", \"decided_by\": \"user\"}\n        ctx = self.member_ctx([route])\n        text, stats = self.emitted(ctx)\n        line = next(l for l in text.splitlines() if \"('member', 'list')\" in l)\n        self.assertIn(\"'find_active_members'\", line)\n        self.assertLess(line.index(\"'find_active_members'\"), line.index(\"'list_members'\"))\n        self.assertNotIn(\"dead_options\", stats)\n        self.assertEqual(stats[\"choice_routes\"],\n                         [\"member list: -active-only -> find_active_members\"])\n```\nWait — `leaf[\"dead\"]` for the routed flag: consumed by route need ✓ → dead list empty → `stats.setdefault(\"dead_options\", [])` never called → stats has no \"dead_options\" key ✓ assertNotIn.\n\nHmm — but \"list_members\" appears in the route line too? The line: `('member', 'list'): [('find_active_members', 5, (('active_only', 'truthy', '-active-only'),)), ('list_members', 5, ())],` — index order: find_active_members first ✓.\n\nThen exec:\n```python\n        code, out = self.run_cli(text, {\"MemberRepository\": MemberRepository},\n                                 [\"member\", \"list\", \"-active-only\"])\n        self.assertEqual(code, 0)\n        self.assert
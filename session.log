                "text": "Read file /Users/gillesstenger/Documents/esus/extract_arch.py, lines 1-431\n1: #!/usr/bin/env python3\n2: \"\"\"Extract a software architecture from requirements, one step at a time.\n3: \n4: Reads the requirements on stdin (or --requirements PATH) and writes one\n5: `<step>.json` per document into the output directory, plus `run.log`. Each\n6: step is handed the names its predecessors produced — in its prompt as an\n7: authoritative list, and in its GBNF grammar as the only strings it can\n8: write — so the documents agree by construction rather than by repair.\n9: \n10: With --chat, the run continues after writing: the probe judges the output,\n11: and the tie and alias reviews ask about whatever needs a human, right here —\n12: one entry point for the attended pipeline.\n13: \n14: Usage:\n15:     python3.12 extract_arch.py --model MODEL.gguf --output out/library \\\\\n16:         < prompts/prompt_library_system.txt\n17:     python3.12 extract_arch.py --model MODEL.gguf --output out/library \\\\\n18:         --requirements prompts/prompt_library_system.txt --chat\n19: \"\"\"\n20: \n21: import argparse\n22: import os\n23: import sys\n24: from pathlib import Path\n25: \n26: from kernel.extraction import pipeline as pipeline_module\n27: from kernel.extraction import runner, writer\n28: from kernel.extraction.aliases import apply_aliases, apply_model_fields, load_aliases\n29: from kernel.extraction.decisions import apply_decisions, load_decisions\n30: \n31: \n32: def build_parser():\n33:     parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n34:     parser.add_argument(\"--model\", required=True, help=\"Path to the GGUF model\")\n35:     parser.add_argument(\n36:         \"--output\",\n37:         required=True,\n38:         help=\"Directory to write the step documents and run.log into\",\n39:     )\n40:     parser.add_argument(\n41:         \"--context\",\n42:         type=int,\n43:         default=8192,\n44:         help=\"Context size in tokens (default 8192)\",\n45:     )\n46:     parser.add_argument(\n47:         \"--check\",\n48:         action=\"store_true\",\n49:         help=\"Run the consistency checker over the output once the run finishes\",\n50:     )\n51:     parser.add_argument(\n52:         \"--requirements\",\n53:         default=None,\n54:         metavar=\"PATH\",\n55:         help=\"Read requirements from PATH instead of stdin (required for \"\n56:              \"--chat, so stdin stays free for answers)\",\n57:     )\n58:     parser.add_argument(\n59:         \"--chat\",\n60:         action=\"store_true\",\n61:         help=\"After writing, loop: probe, review what needs a human, resume \"\n62:              \"the earliest step that can heal the rest — keeping a strictly \"\n63:              \"better state or rolling back — until clean, stuck, or 3 rounds\",\n64:     )\n65:     parser.add_argument(\n66:         \"--from-step\",\n67:         default=None,\n68:         choices=(\n69:             pipeline_module.INTENTIONS,\n70:             pipeline_module.DATA_MODELS,\n71:             pipeline_module.ERRORS,\n72:             pipeline_module.INVARIANTS,\n73:             pipeline_module.COMPONENTS,\n74:             pipeline_module.SERVICE_CONTRACTS,\n75:             pipeline_module.PATTERN_MATCHES,\n76:             pipeline_module.INTERACTION_ADAPTERS,\n77:             pipeline_module.PERSISTENCE_PORTS,\n78:         ),\n79:         help=\"Resume at one step, chaining from the archived documents instead \"\n80:              \"of rerunning the whole pipeline (requirements are read from the \"\n81:              \"output directory's requirements.txt, not stdin)\",\n82:     )\n83:     return parser\n84: \n85: \n86: def resolve_requirements(args):\n87:     \"\"\"The requirements text from --requirements or stdin, or None when empty.\"\"\"\n88:     if args.requirements is not None:\n89:         try:\n90:             text = Path(args.requirements).read_text(encoding=\"utf-8\").strip()\n91:         except OSError as error:\n92:             print(f\"error: cannot read {args.requirements}: {error}\", file=sys.stderr)\n93:             return None\n94:         if not text:\n95:             print(f\"error: {args.requirements} is empty\", file=sys.stderr)\n96:             return None\n97:         return text\n98:     text = sys.stdin.read().strip()\n99:     if not text:\n100:         print(\"error: no requirements were provided on stdin\", file=sys.stderr)\n101:         return None\n102:     return text\n103: \n104: \n105: def chat_flow(output_dir, out_fn=print, tie_runner=None, alias_runner=None):\n106:     \"\"\"Probe, ask, re-probe: the attended tail of an extraction run.\n107: \n108:     Runs the probe over `output_dir`; when ties need a human, runs the tie\n109:     review, and when field pairs do, the alias review. Structural blockers\n110:     (missing commands, uncovered fields, unknown model fields) are reported,\n111:     never asked — no answer the user can type fixes those; a rerun or a code\n112:     fix does. Returns the remaining blockers (a list — the loop judges\n113:     them without re-probing). `*_runner` override the reviews\n114:     (output_dir -> (asked, answered)) for tests.\n115:     \"\"\"\n116:     import probe_readiness\n117:     import review_aliases\n118:     import review_ties\n119: \n120:     name = os.path.basename(str(output_dir).rstrip(os.sep))\n121:     blockers, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n122:     questions = probe_readiness.open_questions(str(output_dir))\n123:     if questions:\n124:         out_fn(f\"{questions} tie(s) need a human — starting the tie review\")\n125:         (tie_runner or review_ties.run_review)(str(output_dir))\n126:     pairs, _ = review_aliases.collect_questions(str(output_dir))\n127:     if pairs:\n128:         out_fn(f\"{len(pairs)} field mapping(s) need a human — starting the alias review\")\n129:         (alias_runner or review_aliases.run_review)(str(output_dir))\n130:     final, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n131:     out_fn(f\"chat: {len(final)} blocker(s) remain\")\n132:     for finding in final:\n133:         out_fn(f\"  - [{finding.rule}] {finding.message}\")\n134:     return final\n135: \n136: \n137: def main():\n138:     args = build_parser().parse_args()\n139:     return run(args)\n140: \n141: \n142: def run(args):\n143:     \"\"\"One extraction round (initial or resume); returns the exit code.\"\"\"\n144: \n145:     output_dir = Path(args.output)\n146:     start = args.from_step\n147:     if args.chat and args.requirements is None and start is None:\n148:         # Questions arrive over stdin: a piped requirements text would leave\n149:         # every question at EOF, silently skipping the whole point of --chat.\n150:         print(\"error: --chat needs --requirements PATH (stdin stays free for answers)\",\n151:               file=sys.stderr)\n152:         return 2\n153:     if start is None:\n154:         requirements = resolve_requirements(args)\n155:         if requirements is None:\n156:             return 1\n157:         preloaded = {}\n158:     else:\n159:         # Resuming: the archived requirements are the run's own, so the rerun\n160:         # judges itself against what it was actually given — never against a\n161:         # retyped prompt on stdin.\n162:         from kernel.consistency.loader import load_documents, load_requirements\n163:         from kernel.consistency.report import Report\n164: \n165:         requirements = load_requirements(str(output_dir))\n166:         if not requirements:\n167:             print(f\"error: {output_dir} has no requirements.txt to resume from\",\n168:                   file=sys.stderr)\n169:             return 1\n170:         report = Report(output_dir.name)\n171:         preloaded = load_documents(str(output_dir), report).bodies\n172:         if report.errors:\n173:             print(f\"error: {output_dir} holds unusable documents:\",\n174:                   file=sys.stderr)\n175:             for finding in report.errors:\n176:                 print(f\"  {finding.render()}\", file=sys.stderr)\n177:             return 1\n178: \n179:     log = writer.RunLog(output_dir / writer.RUN_LOG_NAME)\n180:     log.write(f\"[run] requirements: {len(requirements)} characters\")\n181:     log.write(f\"[run] temperature={pipeline_module.TEMPERATURE} seed={pipeline_module.SEED}\")\n182:     if start is not None:\n183:         log.write(f\"[run] resuming at step {start} from archived documents\")\n184:         # RunLog overwrites on flush: carry the earlier rounds forward, or\n185:         # every resume erases the history that explains the current documents.\n186:         try:\n187:             previous = (output_dir / writer.RUN_LOG_NAME).read_text(encoding=\"utf-8\").splitlines()\n188:         except OSError:\n189:             previous = []\n190:         if previous:\n191:             log.lines[:0] = previous + [\"[run] --- resumed ---\"]\n192: \n193:     extractor = runner.load_model(args.model, context_size=args.context, logits_all=False)\n194: \n195:     # The classifier is a second model whose context is built with\n196:     # `logits_all=True`, which only step F's `logprobs` needs — every other step\n197:     # would pay that cost for nothing. It is therefore loaded lazily, the first\n198:     # time a run actually has something to classify, so a program with no domain\n199:     # (hello, cli_tool) loads one model rather than two. See\n200:     # `Pipeline._step_patterns`.\n201:     pipeline = pipeline_module.Pipeline(\n202:         extractor,\n203:         log=log,\n204:         classifier_factory=lambda: runner.load_model(\n205:             args.model, context_size=args.context, logits_all=True\n206:         ),\n207:     )\n208:     pipeline.documents.update(preloaded)\n209:     documents = pipeline.run(requirements, start=start)\n210: \n211:     # A human decision outranks a coin flip: re-apply the recorded answers to\n212:     # near-tied classifications, so one review settles each tie permanently.\n213:     recorded = load_decisions(output_dir)\n214:     if recorded and isinstance(documents.get(pipeline_module.PATTERN_MATCHES), list):\n215:         documents[pipeline_module.PATTERN_MATCHES] = apply_decisions(\n216:             documents[pipeline_module.PATTERN_MATCHES], recorded, log,\n217:             requirements_text=requirements,\n218:         )\n219: \n220:     # Human-asserted field mappings outrank flag spellings the model chose:\n221:     # one recorded alias settles each pair permanently, like decisions do.\n222:     mapped = load_aliases(output_dir)\n223:     if mapped and isinstance(documents.get(pipeline_module.INTERACTION_ADAPTERS), list):\n224:         documents[pipeline_module.INTERACTION_ADAPTERS] = apply_aliases(\n225:             documents[pipeline_module.INTERACTION_ADAPTERS], mapped, log,\n226:             requirements_text=requirements,\n227:         )\n228:     if mapped and isinstance(documents.get(pipeline_module.DATA_MODELS), list):\n229:         documents[pipeline_module.DATA_MODELS] = apply_model_fields(\n230:             documents[pipeline_module.DATA_MODELS], mapped, log,\n231:             requirements_text=requirements,\n232:         )\n233: \n234:     for path in writer.write_documents(output_dir, documents):\n235:         log.write(f\"[write] {path}\")\n236:     # The requirements accompany the documents so the checker can later compare\n237:     # the recorded surface against what was actually asked for.\n238:     log.write(f\"[write] {writer.write_requirements(output_dir, requirements)}\")\n239: \n240:     tokens = sum(result.tokens for result in pipeline.results)\n241:     seconds = sum(result.seconds for result in pipeline.results)\n242:     log.write(\n243:         f\"[run] {len(pipeline.results)} steps, {tokens} generated tokens in {seconds:.1f}s\"\n244:     )\n245:     log.flush()\n246: \n247:     if args.check:\n248:         status = check_output(output_dir)\n249:     else:\n250:         status = 0\n251:     if args.chat:\n252:         remaining = chat_loop(\n253:             output_dir,\n254:             lambda start: resume_in_subprocess(args, output_dir, start),\n255:             out_fn=print,\n256:         )\n257:         return 1 if remaining or status else 0\n258:     return status\n259: \n260: \n261: # --------------------------------------------------------------------------\n262: # chat loop: probe, review, resume — keeping better, rolling back worse\n263: # --------------------------------------------------------------------------\n264: \n265: ROUND_LIMIT = 3\n266: \n267: # Resume attempts per round: both crashes seen so far landed in classifier\n268: # decode (llama_decode -3, transient Metal state) and succeeded on the next\n269: # run, so a crashed resume is retried rather than aborting the session.\n270: # Retries run as fresh child processes (see resume_in_subprocess): reloading\n271: # beside a crashed decode fails with pressure errors, so in-process retry\n272: # would poison its own well.\n273: RESUME_ATTEMPTS = 2\n274: \n275: # Findings a rerun can heal, mapped to the earliest step that owns them. A\n276: # rule absent here (malformed documents, placeholders, duplicate names) is\n277: # not a coverage miss but a structural defect: no round of generation fixes\n278: # it, so the loop stops and reports instead of burning model calls.\n279: RULE_STEPS = {\n280:     \"missing_command\": pipeline_module.COMPONENTS,\n281:     \"missing_flag\": pipeline_module.COMPONENTS,\n282:     \"unbacked_command\": pipeline_module.COMPONENTS,\n283:     \"unmet_crud_operation\": pipeline_module.SERVICE_CONTRACTS,\n284:     \"uncovered_field\": pipeline_module.INTERACTION_ADAPTERS,\n285:     \"unknown_model_field\": pipeline_module.INTERACTION_ADAPTERS,\n286: }\n287: STEP_ORDER = (\n288:     pipeline_module.COMPONENTS,\n289:     pipeline_module.SERVICE_CONTRACTS,\n290:     pipeline_module.INTERACTION_ADAPTERS,\n291: )\n292: \n293: \n294: def resume_in_subprocess(args, output_dir, start):\n295:     \"\"\"One resume round in a child process; raise on failure.\n296: \n297:     Model runs are isolated per attempt on purpose: a crashed decode can\n298:     leave Metal state unusable, and reloading beside the wreckage fails\n299:     with pressure errors (`Failed to load model`) that look like missing\n300:     files. The child inherits stdio, so its run.log lines stream live, and\n301:     anything it leaves behind dies with it — the loop's snapshot decides\n302:     what survives, never a half-written directory.\n303:     \"\"\"\n304:     import subprocess\n305: \n306:     script = Path(__file__).resolve().parent / \"extract_arch.py\"\n307:     completed = subprocess.run(\n308:         [sys.executable, str(script),\n309:          \"--model\", args.model, \"--output\", str(output_dir),\n310:          \"--context\", str(args.context), \"--from-step\", start],\n311:     )\n312:     if completed.returncode != 0:\n313:         raise RuntimeError(f\"resume exited {completed.returncode}\")\n314: \n315: \n316: def resume_step_for(blockers):\n317:     \"\"\"The earliest pipeline step that can heal one of these findings, or None.\"\"\"\n318:     steps = {RULE_STEPS[finding.rule] for finding in blockers if finding.rule in RULE_STEPS}\n319:     if not steps:\n320:         return None\n321:     return min(steps, key=STEP_ORDER.index)\n322: \n323: \n324: def snapshot_output(output_dir):\n325:     \"\"\"Copy the output dir aside for rollback; return the snapshot path.\"\"\"\n326:     output_dir = Path(output_dir)\n327:     snapshot = output_dir.parent / f\".chat_snapshot_{output_dir.name}\"\n328:     import shutil\n329: \n330:     if snapshot.is_dir():\n331:         shutil.rmtree(snapshot)\n332:     shutil.copytree(output_dir, snapshot)\n333:     return snapshot\n334: \n335: \n336: def restore_snapshot(snapshot, output_dir):\n337:     \"\"\"Roll back to the snapshot, keeping the snapshot itself as evidence.\"\"\"\n338:     import shutil\n339: \n340:     shutil.rmtree(output_dir)\n341:     shutil.copytree(snapshot, output_dir)\n342: \n343: \n344: def chat_loop(output_dir, rerun, out_fn=print, max_rounds=ROUND_LIMIT,\n345:               tie_runner=None, alias_runner=None):\n346:     \"\"\"Probe, review, resume — until clean, stuck, or out of rounds.\n347: \n348:     `rerun(start)` performs one model round from `start` (raising on crash).\n349:     Each round keeps a strictly better state or rolls back to the snapshot:\n350:     the loop can never leave the documents worse than it found them, and it\n351:     always terminates — 0 blockers, nothing rerunnable, a crash, a\n352:     non-improving round, or `max_rounds`. Returns remaining blockers.\n353:     \"\"\"\n354:     import probe_readiness\n355: \n356:     name = os.path.basename(str(output_dir).rstrip(os.sep))\n357:     current = None\n358:     for _ in range(max(1, max_rounds)):\n359:         blockers = chat_flow(output_dir, out_fn=out_fn,\n360:                              tie_runner=tie_runner, alias_runner=alias_runner)\n361:         if not blockers:\n362:             return 0\n363:         step = resume_step_for(blockers)\n364:         if step is None:\n365:             out_fn(\"chat: remaining blockers need more than a rerun \"\n366:                    \"(see rules above) — stopping\")\n367:             return len(blockers)\n368:         snapshot = snapshot_output(output_dir)\n369:         before = len(blockers)\n370:         try:\n371:             attempt_resume(rerun, step, out_fn)\n372:         except Exception as error:\n373:             restore_snapshot(snapshot, output_dir)\n374:             out_fn(f\"chat: resume crashed twice ({error}) — rolled back to {before} blocker(s); \"\n375:                    f\"pre-round state kept at {snapshot}\")\n376:             return before\n377:         after, _, _ = probe_readiness.check_prompt(name, str(output_dir))\n378:         current = after\n379:         if len(after) < before:\n380:             out_fn(f\"chat: round improved {before}->{len(after)} — continuing\")\n381:             _drop_snapshot(snapshot)\n382:             continue\n383:         restore_snapshot(snapshot, output_dir)\n384:         out_fn(f\"chat: round did not improve ({before}->{len(after)}) — \"\n385:                f\"rolled back, keeping {before} blocker(s); pre-round state kept at {snapshot}\")\n386:         return before\n387:     out_fn(f\"chat: {max_rounds} rounds done — stopping\")\n388:     return len(current) if current is not None else 0\n389: \n390: \n391: def attempt_resume(rerun, step, out_fn=print, attempts=RESUME_ATTEMPTS):\n392:     \"\"\"Run one resume round, retrying a crashed attempt.\n393: \n394:     Raises the last error when every attempt crashes, so the caller rolls\n395:     back to the snapshot instead of continuing on a half-written directory.\n396:     \"\"\"\n397:     error = None\n398:     for attempt in range(1, max(1, attempts) + 1):\n399:         try:\n400:             rerun(step)\n401:             return\n402:         except Exception as exc:\n403:             error = exc\n404:             if attempt < max(1, attempts):\n405:                 out_fn(f\"chat: resume crashed ({error}) — retrying the resume \"\n406:                        f\"({attempt + 1}/{max(1, attempts)})\")\n407:     raise error\n408: \n409: \n410: def _drop_snapshot(snapshot):\n411:     import shutil\n412: \n413:     shutil.rmtree(snapshot, ignore_errors=True)\n414: \n415: \n416: def check_output(output_dir):\n417:     \"\"\"Run the consistency checker over a finished run.\"\"\"\n418:     from kernel.consistency import check_directory, render_report\n419: \n420:     report = check_directory(str(output_dir), output_dir.name)\n421:     print(render_report(report, show_all=True))\n422:     errors, warnings = report.counts\n423:     summary = f\"consistency: {errors} error(s), {warnings} warning(s)\"\n424:     if report.notes:\n425:         summary += f\", {len(report.notes)} note(s)\"\n426:     print(summary)\n427:     return 1 if errors else 0\n428: \n429: \n430: if __name__ == \"__main__\":\n431:     sys.exit(main())"

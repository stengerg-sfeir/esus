",\n          \"raises\": []\n        },\n        {\n          \"name\": \"update_author\",\n          \"description\": \"Updates an author's details by its ID.\",\n          \"params\": [\n            {\n              \"name\": \"author_id\",\n              \"type\": \"int\"\n            },\n            {\n              \"name\": \"author\",\n              \"type\": \"Author\"\n            }\n          ],\n          \"return_type\": \"Author\",\n          \"raises\": [\n            \"AuthorNotFoundError\"\n          ]\n        },\n        {\n          \"name\": \"delete_author\",\n          \"description\": \"Deletes an author by its ID.\",\n          \"params\": [\n            {\n              \"name\": \"author_id\",\n              \"type\": \"int\"\n            }\n          ],\n          \"return_type\": \"bool\",\n          \"raises\": [\n            \"AuthorNotFoundError\"\n          ]\n        },\n        {\n          \"name\": \"find_books_by_author\",\n          \"description\": \"Finds all books by a specific author.\",\n          \"params\": [\n            {\n              \"name\": \"author_id\",\n              \"type\": \"int\"\n            }\n          ],\n          \"return_type\": \"List[Book]\",\n          \"raises\": [\n            \"AuthorNotFoundError\"\n          ]\n        }\n      ]\n    },\n    {\n      \"service_name\": \"MemberRepository\",\n      \"methods\": [\n        {\n          \"name\": \"create_member\",\n          \"description\": \"Creates a new member entry with the provided details.\",\n          \"params\": [\n            {\n              \"name\": \"member\",\n              \"type\": \"Member\"\n            },\n            {\n              \"name\": \"email\",\n              \"type\": \"str\"\n            }\n          ],\n          \"return_type\": \"Member\",\n          \"raises\": [\n            \"MemberAlreadyExistsError\"\n          ]\n        },\n        {\n          \"name\": \"read_one_member\",\n          \"description
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/check_consistency.py, lines 1-61\n1: #!/usr/bin/env python3\n2: \"\"\"Cross-check the internal consistency of extract_archi.py output.\n3: \n4: Each directory passed to --dirs is given as \"name:path\" and must hold the\n5: per-step JSON documents written by extract_archi.py. The exit code is 0 when no\n6: error was found and 1 otherwise.\n7: \n8: Usage:\n9:     python check_consistency.py --dirs hello:out/hello library:out/library\n10: \"\"\"\n11: \n12: import argparse\n13: import sys\n14: \n15: from kernel.consistency import check_directory, render_grand_total, render_report\n16: \n17: USAGE_FORMAT = \"NAME:PATH\"\n18: \n19: \n20: def parse_directory_argument(entry):\n21:     \"\"\"Split a 'name:path' argument into its two parts.\"\"\"\n22:     name, separator, path = entry.partition(\":\")\n23:     if not separator or not name.strip() or not path.strip():\n24:         raise argparse.ArgumentTypeError(f\"expected '{USAGE_FORMAT}', got '{entry}'\")\n25:     return name.strip(), path.strip()\n26: \n27: \n28: def build_parser():\n29:     parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n30:     parser.add_argument(\n31:         \"--dirs\",\n32:         nargs=\"+\",\n33:         required=True,\n34:         type=parse_directory_argument,\n35:         metavar=USAGE_FORMAT,\n36:         help=\"One or more output directories to check (format: name:path).\",\n37:     )\n38:     parser.add_argument(\n39:         \"--all-findings\",\n40:         action=\"store_true\",\n41:         dest=\"show_all\",\n42:         help=\"List every finding instead of truncating long sections.\",\n43:     )\n44:     return parser\n45: \n46: \n47: def main():\n48:     args = build_parser().parse_args()\n49: \n50:     reports = [check_directory(path, name) for name, path in args.dirs]\n51: \n52:     for report in reports:\n53:         print(render_report(report, show_all=args.show_all))\n54:     print(render_grand_total(reports))\n55: \n56:     total_errors = sum(report.counts[0] for report in reports)\n57:     return 1 if total_errors else 0\n58: \n59: \n60: if __name__ == \"__main__\":\n61:     sys.exit(main())"

            },
            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_patterns.py, lines 1-394\n1: \"\"\"Validation of step F's output, the one document nothing read.\n2: \n3: `pattern_matches.json` is produced by step F and written to disk, but no check\n4: ever loaded it: the classifier's output was unexamined, so a pattern id outside\n5: the vocabulary passed silently.\n6: \n7: The allowed ids come from `kernel.pattern_catalog` — the same dependency-free\n8: module the classifier reads — so the two can never disagree about what a\n9: `pattern_id` may be. Three of those ids are answers rather than patterns:\n10: \n11: - `STANDARD_CRUD` — plain create/read/update/delete by key. Correct, expected,\n12:   and **not** a finding: no named pattern describes it.\n13: - `NO_MATCH` — fits no domain. A gap.\n14: - `NO_PATTERN_IN_DOMAIN` — the domain fits, no pattern in it does. A gap.\n15: \n16: The two gaps are reported as `missing_pattern`, one note each, and they are the\n17: coverage report for the vocabulary: the texts that produce them say which pattern\n18: is missing. `STANDARD_CRUD` is never reported, because it names nothing absent.\n19: \n20: Three checks are structural and currently find nothing, and they are here as\n21: guards rather than as findings: a `contract:<Service>.<method>` source must\n22: resolve to a method the service contracts declare, `confidence` must be a number\n23: in [0, 1], and an unknown `pattern_id` is still an `unknown_reference`.\n24: \"\"\"\n25: \n26: from kernel.consistency.methods import is_missing\n27: from kernel.pattern_catalog import (\n28:     GAP_PATTERN_IDS,\n29:     NO_MATCH,\n30:     SENTINEL_PATTERN_IDS,\n31:     known_pattern_ids,\n32: )\n33: \n34: SOURCE_INVARIANT = \"invariant\"\n35: SOURCE_CONTRACT = \"contract\"\n36: \n37: # The confidence is the product of two softmaxes — the domain and then the\n38: # pattern — so it is structurally lower than either stage alone: a confident\n39: # 0.9 domain with a 0.7 pattern reports 0.63. A match below 0.2 therefore means\n40: # both stages were unsure.\n41: #\n42: # Reported as a NOTE, not a warning, on the same reasoning as an empty section:\n43: # the checker has no ground truth for the match, so it cannot tell a\n44: # low-confidence-but-correct classification from a wrong one, and calling it a\n45: # defect would assert something the checker cannot substantiate. Chosen from the\n46: # corpus: 0.2 isolates five matches, while 0.5 would report 88 and bury them.\n47: #\n48: # Re-derive this floor whenever the option list changes: adding or removing\n49: # answers moves probability mass, so every confidence shifts with it.\n50: LOW_CONFIDENCE = 0.2\n51: \n52: # How close the top two answers may be before the match is reported as\n53: # undecided. `LOW_CONFIDENCE` above asks \"was the winner unsure?\", which cannot\n54: # see the case this one exists for: a 0.70 that beat 0.69 is a coin-flip and a\n55: # 0.70 that beat 0.05 is a decision, and both report 0.70. The margin between\n56: # the winner and the runner-up is what separates them, and `pattern_matches`\n57: # carries it (`runner_up_pattern_id`, `margin`) for exactly this check.\n58: #\n59: # This is the check that would have named the defect the floor could not: the\n60: # same kind of requirement (`read_all_*`) landing on a gap in one prompt and on\n61: # `FILTER_WITH_PAGINATION` in another was a near-tie reported as a decision.\n62: # Calibrated against the corpus after the read-shape vocabulary was completed;\n63: # re-derive it whenever the option list changes, as with the floor.\n64: NARROW_MARGIN = 0.15\n65: \n66: # Step 1's own threshold, on its own scale — a raw softmax gap, where `margin`\n67: # below is that gap multiplied by the domain probability. It mirrors\n68: # `classification.DOMAIN_NARROW_MARGIN` and **must be kept equal to it**; it is\n69: # duplicated rather than imported because the checker may not import the\n70: # extraction package, which reaches `llama_cpp` through the classifier. The same\n71: # constraint already applies to `NARROW_MARGIN`.\n72: DOMAIN_NARROW_MARGIN = 0.15\n73: \n74: # The three decisions a match may carry, mirroring `classification`. Written as\n75: # literals here for the same reason as the thresholds.\n76: DECIDED = \"decided\"\n77: UNDECIDED = \"undecided\"\n78: UNDEFINED = \"undefined\"\n79: DECISIONS = frozenset({DECIDED, UNDECIDED, UNDEFINED})\n80: \n81: # Which stage was near-tied.\n82: STAGE_DOMAIN = \"domain\"\n83: STAGE_PATTERN = \"pattern\"\n84: \n85: \n86: def check_pattern_matches(matches, documents, report):\n87:     \"\"\"Validate pattern_matches against the catalogues and the contracts.\"\"\"\n88:     if matches is None:\n89:         return\n90: \n91:     known = _known_pattern_ids(report)\n92:     declared = _declared_methods(documents)\n93: \n94:     for entry in matches:\n95:         if not isinstance(entry, dict):\n96:             report.error(\"invalid_value\", \"pattern_matches: an entry is not an object\")\n97:             continue\n98:         _check_pattern_id(entry, known, report)\n99:         _check_confidence(entry, report)\n100:         _check_margin(entry, report)\n101:         _check_claim(entry, report)\n102:         _check_source(entry, declared, report)\n103: \n104:     _report_gaps(matches, report)\n105: \n106: \n107: def _report_gaps(matches, report):\n108:     \"\"\"One note per gap answer: the vocabulary's coverage report.\n109: \n110:     `NO_MATCH` says no domain fits; `NO_PATTERN_IN_DOMAIN` says the domain fits\n111:     but no pattern inside it does. Both name something the catalogue lacks, and\n112:     each entry carries the text that produced it, so the notes answer \"which\n113:     pattern should be added next?\" rather than merely scoring the run.\n114: \n115:     `STANDARD_CRUD` is deliberately absent: it is the correct answer for ordinary\n116:     CRUD, names nothing missing, and would otherwise drown the report with one\n117:     note per repository method.\n118:     \"\"\"\n119:     for entry in matches:\n120:         if not isinstance(entry, dict):\n121:             continue\n122:         pattern_id = entry.get(\"pattern_id\")\n123:         if pattern_id not in GAP_PATTERN_IDS:\n124:             continue\n125:         reason = (\n126:             \"fits no domain\"\n127:             if pattern_id == NO_MATCH\n128:             else \"fits a domain but no pattern inside it\"\n129:         )\n130:         # A gap that came from a refusal names the pattern the classifier wanted\n131:         # and the evidence that ruled it out. That is the difference between a\n132:         # coverage report and a shrug: \"claimed AGGREGATE_BY_FK_AND_DATE, refused\n133:         # because it returns collection\" is a specification for the pattern to\n134:         # add, which is what the gap exists to say.\n135:         claimed = entry.get(\"claimed_pattern_id\")\n136:         rejection = entry.get(\"rejection\")\n137:         if rejection:\n138:             detail = (\n139:                 f\"the classifier claimed '{claimed}' and it was refused: {rejection} \"\n140:                 f\"— the catalogue has no pattern for a method of this shape\"\n141:             )\n142:         else:\n143:             detail = \"no pattern covers it\"\n144:         report.note(\n145:             \"missing_pattern\",\n146:             f\"pattern_matches: {entry.get('text')!r} {reason} — {detail} \"\n147:             f\"('{pattern_id}', confidence {entry.get('confidence')})\",\n148:         )\n149: \n150: \n151: def _check_pattern_id(entry, known, report):\n152:     pattern_id = entry.get(\"pattern_id\")\n153:     if is_missing(pattern_id):\n154:         report.warning(\"placeholder_value\", \"pattern_matches: an entry has no pattern_id\")\n155:         return\n156:     if known is not None and pattern_id not in known:\n157:         report.warning(\n158:             \"unknown_reference\",\n159:             f\"pattern_matches: pattern_id '{pattern_id}' is in neither pattern catalogue\",\n160:         )\n161: \n162: \n163: def _check_confidence(entry, report):\n164:     confidence = entry.get(\"confidence\")\n165:     if isinstance(confidence, bool) or not isinstance(confidence, (int, float)):\n166:         report.error(\n167:             \"invalid_value\",\n168:             f\"pattern_matches: confidence should be a number, found {confidence!r}\",\n169:         )\n170:         return\n171:     if not 0 <= confidence <= 1:\n172:         report.error(\n173:             \"invalid_value\",\n174:             f\"pattern_matches: confidence {confidence} is outside [0, 1]\",\n175:         )\n176:         return\n177:     if entry.get(\"pattern_id\") in SENTINEL_PATTERN_IDS:\n178:         # A sentinel is already accounted for: a gap is reported by\n179:         # `_report_gaps`, and `STANDARD_CRUD` is a legitimate answer. Its\n180:         # confidence is a separate question, and flagging it here would report\n181:         # the same entry twice under two different rules.\n182:         return\n183:     if confidence < LOW_CONFIDENCE:\n184:         report.note(\n185:             \"low_confidence\",\n186:             f\"pattern_matches: '{entry.get('pattern_id')}' matched {entry.get('text')!r} \"\n187:             f\"at confidence {confidence:.2f} — below the {LOW_CONFIDENCE} floor\",\n188:         )\n189: \n190: \n191: def _check_margin(entry, report):\n192:     \"\"\"Report a match whose top two answers were too close to call.\n193: \n194:     Two categories the generator routes on, and the document now names both:\n195:     `undefined` is a gap (reported by `_report_gaps`) and `undecided` is a\n196:     near-tie, reported here. A `decided` match is not reported at all.\n197: \n198:     **Two guards run before the note, because they are defects rather than\n199:     signals:**\n200: \n201:     - A `runner_up_pattern_id` equal to the recorded `pattern_id` is a margin\n202:       computed against the winner. It can never move the answer, so the\n203:       runner-up was mis-recorded — this is the bug that let three notes read\n204:       `'FILTER_BY_FIELD' ... over 'FILTER_BY_FIELD'`, and it is reported as an\n205:       error so it cannot return silently (`classification._runner_up`).\n206:     - A `decision` outside the three known values is a shape error.\n207: \n208:     Both stages are judged, and the **domain** stage first, because it decides\n209:     which pattern list step 2 even saw: a near-tied domain means the pattern\n210:     margin describes a choice among possibly-wrong options. A document written\n211:     before the field existed still reports from the margin alone.\n212:     \"\"\"\n213:     pattern_id = entry.get(\"pattern_id\")\n214:     runner_up = entry.get(\"runner_up_pattern_id\")\n215:     decision = entry.get(\"decision\")\n216:     if runner_up and runner_up == pattern_id:\n217:         report.error(\n218:             \"invalid_value\",\n219:             f\"pattern_matches: '{pattern_id}' matched {entry.get('text')!r} with itself \"\n220:             f\"as the runner-up — a margin against the winner cannot decide anything\",\n221:         )\n222:         return\n223:     if decision is not None and decision not in DECISIONS:\n224:         report.error(\n225:             \"unsupported_value\",\n226:             f\"pattern_matches: decision {decision!r} is not one of \"\n227:             f\"{sorted(DECISIONS)}\",\n228:         )\n229:         return\n230:     if pattern_id in GAP_PATTERN_IDS:\n231:         # A gap is not a choice, so there are no two answers for a margin to\n232:         # separate — a number here is a defect, not a signal. They came out large\n233:         # and negative before this (`-0.48` on six of seven gaps), because the\n234:         # figure compared the entry's own sentinel probability against the\n235:         # claim's.\n236:         if decision == UNDEFINED and entry.get(\"margin\") is not None:\n237:             report.error(\n238:                 \"invalid_value\",\n239:                 f\"pattern_matches: '{pattern_id}' has no pattern but carries a margin of \"\n240:                 f\"{entry.get('margin')} — a gap is not a choice between two answers\",\n241:             )\n242:         return\n243: \n244:     if decision == DECIDED:\n245:         return\n246: \n247:     if decision == UNDECIDED:\n248:         if entry.get(\"undecided_stage\") == STAGE_DOMAIN:\n249:             _report_domain_near_tie(entry, report)\n250:         else:\n251:             _report_pattern_near_tie(entry, report)\n252:         return\n253:     if decision == UNDEFINED:\n254:         return\n255: \n256:     # No `decision`: a document from before the field existed. Fall back to the\n257:     # margin, and to the domain stage first for the same reason as above.\n258:     domain_margin = entry.get(\"domain_margin\")\n259:     if _is_narrow(domain_margin, DOMAIN_NARROW_MARGIN):\n260:         _report_domain_near_tie(entry, report)\n261:         return\n262:     if _is_narrow(entry.get(\"margin\"), NARROW_MARGIN) and runner_up:\n263:         _report_pattern_near_tie(entry, report)\n264: \n265: \n266: def _is_narrow(margin, threshold):\n267:     \"\"\"True when a margin is a number below its threshold.\"\"\"\n268:     if not isinstance(margin, (int, float)) or isinstance(margin, bool):\n269:         return False\n270:     return margin < threshold\n271: \n272: \n273: def _report_domain_near_tie(entry, report):\n274:     \"\"\"Step 1's top two domains were too close to call.\n275: \n276:     Worth more than the pattern-stage note: the domain picks which pattern list\n277:     step 2 is even shown, so a near-tie here is a choice between two *sets* of\n278:     answers, and the recorded pattern is one of only one set's.\n279:     \"\"\"\n280:     report.note(\n281:         \"narrow_margin\",\n282:         f\"pattern_matches: the domains for {entry.get('text')!r} were too close to call — \"\n283:         f\"'{entry.get('domain')}' beat '{entry.get('domain_runner_up')}' by \"\n284:         f\"{entry.get('domain_margin')} — so the pattern chosen inside it may differ \"\n285:         f\"between runs\",\n286:     )\n287: \n288: \n289: def _report_pattern_near_tie(entry, report):\n290:     \"\"\"Step 2's top two patterns were too close to call.\"\"\"\n291:     report.note(\n292:         \"narrow_margin\",\n293:         f\"pattern_matches: '{entry.get('pattern_id')}' matched {entry.get('text')!r} \"\n294:         f\"by a margin of {entry.get('margin')} over '{entry.get('runner_up_pattern_id')}' \"\n295:         f\"— the answer was near-tied, so it may differ between runs\",\n296:     )\n297: \n298: \n299: def _check_claim(entry, report):\n300:     \"\"\"Note a match whose recorded pattern is not the one the classifier chose.\n301: \n302:     The claim was impossible for the method's return type, so the next\n303:     shape-compatible candidate replaced it (`kernel.extraction.classification`).\n304:     The correction is deterministic and the recorded pattern is the right one, so\n305:     this is a note and not a defect — but it is worth naming, because a run with\n306:     many corrections is telling us the classifier reaches for an aggregate on a\n307:     method that returns records, and that is a description to sharpen.\n308: \n309:     A gap is skipped: `_report_gaps` already reports it, with the same claim.\n310:     \"\"\"\n311:     rejection = entry.get(\"rejection\")\n312:     if not rejection:\n313:         return\n314:     pattern_id = entry.get(\"pattern_id\")\n315:     if pattern_id in GAP_PATTERN_IDS:\n316:         return\n317:     report.note(\n318:         \"corrected_claim\",\n319:         f\"pattern_matches: {entry.get('text')!r} was claimed as \"\n320:         f\"'{entry.get('claimed_pattern_id')}' and recorded as '{pattern_id}' — {rejection}\",\n321:     )\n322: \n323: \n324: def _check_source(entry, declared, report):\n325:     source = entry.get(\"source\")\n326:     if is_missing(source):\n327:         report.warning(\"placeholder_value\", \"pattern_matches: an entry has no source\")\n328:         return\n329:     if source == SOURCE_INVARIANT:\n330:         return\n331:     if not source.startswith(f\"{SOURCE_CONTRACT}:\"):\n332:         report.error(\n333:             \"unsupported_value\",\n334:             f\"pattern_matches: source '{source}' is neither '{SOURCE_INVARIANT}' \"\n335:             f\"nor '{SOURCE_CONTRACT}:<Service>.<method>'\",\n336:         )\n337:         return\n338: \n339:     reference = source.split(\":\", 1)[1]\n340:     if \".\" not in reference:\n341:         report.error(\n342:             \"invalid_identifier\",\n343:             f\"pattern_matches: source '{source}' does not name a service and a method\",\n344:         )\n345:         return\n346:     service, method = reference.rsplit(\".\", 1)\n347:     if service not in declared:\n348:         report.warning(\n349:             \"unknown_reference\",\n350:             f\"pattern_matches: source '{source}' names service '{service}', \"\n351:             f\"which service_contracts does not declare\",\n352:         )\n353:     elif method not in declared[service]:\n354:         report.warning(\n355:             \"unknown_reference\",\n356:             f\"pattern_matches: source '{source}' names '{method}', \"\n357:             f\"which {service} does not declare\",\n358:         )\n359: \n360: \n361: def _known_pattern_ids(report):\n362:     \"\"\"Every pattern id that may legitimately appear, or None when unreadable.\n363: \n364:     The set comes from `kernel.pattern_catalog` — the same module the classifier\n365:     reads — so it includes the three answers that are not catalogue patterns.\n366:     Validating against the catalogue files alone flagged those deliberate answers\n367:     as references to something that does not exist.\n368: \n369:     None means \"cannot tell\", so an unreadable catalogue reports itself once\n370:     rather than turning every match into an unknown reference.\n371:     \"\"\"\n372:     try:\n373:         return known_pattern_ids()\n374:     except (OSError, ValueError) as error:\n375:         report.error(\"malformed_document\", f\"pattern catalogue unreadable: {error}\")\n376:         return None\n377: \n378: \n379: def _declared_methods(documents):\n380:     \"\"\"service -> the method names it declares, for resolving contract sources.\"\"\"\n381:     services = documents.get(\"service_contracts\")\n382:     if not isinstance(services, list):\n383:         return {}\n384:     declared = {}\n385:     for service in services:\n386:         if not isinstance(service, dict) or not service.get(\"service_name\"):\n387:             continue\n388:         methods = service.get(\"methods\")\n389:         declared[service[\"service_name\"]] = {\n390:             method.get(\"name\")\n391:             for method in (methods if isinstance(methods, list) else [])\n392:             if isinstance(method, dict) and method.get(\"name\")\n393:         }\n394:     return declared"
              }

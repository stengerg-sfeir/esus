                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/probe_readiness.py, lines 1-206\n1: \"\"\"Would a code generator have to invent anything? Checks the documents directly.\n2: \n3: The consistency checker proves the documents agree with each other. A generator\n4: needs more: every command backed by a method, every adapter resolving, every\n5: crud operation implemented by its own entity's interface, every parameter\n6: well-typed, every raised error registered. This probe measures those, per\n7: prompt, and prints the blockers a generator would have to paper over.\n8: \n9: A CLI verb and a service method rarely share a spelling (`add` is `create_book`,\n10: `list` is `read_all_books`), so a verb is matched by a family of method-name\n11: stems — that is a rename the generator does once, not an invention.\n12: \n13: Every check is scoped to the interface that owns the thing being checked. An\n14: earlier version searched *all* services' methods for a crud operation, so\n15: `ExpenseRepository.create_expense` satisfied a `Category create` claim and the\n16: probe reported readiness for a repository that had no create method at all\n17: (expenses, 2026-08-10). A blocker must be judged against the interface that\n18: would have to implement it.\n19: \"\"\"\n20: \n21: import json\n22: import os\n23: \n24: OUT = \"out\"\n25: PROMPTS = (\"hello\", \"cli_tool\", \"inventory\", \"gui\", \"expenses\", \"60\", \"library\")\n26: \n27: VERB_STEMS = {\n28:     \"add\": (\"add\", \"create\", \"save\", \"insert\", \"new\"),\n29:     \"create\": (\"add\", \"create\", \"save\", \"insert\", \"new\"),\n30:     \"list\": (\"all\", \"list\"),\n31:     \"search\": (\"search\", \"query\", \"find\", \"filter\"),\n32:     \"update\": (\"update\", \"edit\", \"set\"),\n33:     \"delete\": (\"delete\", \"remove\"),\n34:     \"get\": (\"get\", \"find\", \"read\"),\n35:     \"report\": (\"report\", \"stats\", \"summary\", \"value\"),\n36:     \"low-stock\": (\"lowstock\",),\n37:     \"value\": (\"value\",),\n38:     \"confirm\": (\"confirm\",),\n39:     \"cancel\": (\"cancel\",),\n40:     \"restock\": (\"restock\",),\n41: }\n42: OP_STEMS = {\n43:     \"create\": (\"add\", \"create\", \"save\", \"insert\"),\n44:     \"read_one\": (\"byid\", \"readone\", \"read\", \"find\", \"get\"),\n45:     \"read_all\": (\"all\", \"list\"),\n46:     \"update\": (\"update\", \"edit\"),\n47:     \"delete\": (\"delete\", \"remove\"),\n48: }\n49: \n50: \n51: def load(name, key):\n52:     path = os.path.join(OUT, name, f\"{key}.json\")\n53:     if not os.path.exists(path):\n54:         return None\n55:     with open(path) as handle:\n56:         return json.load(handle).get(key)\n57: \n58: \n59: def norm(value):\n60:     return value.replace(\"_\", \"\").replace(\"-\", \"\").lower() if isinstance(value, str) else \"\"\n61: \n62: \n63: def service_index(services):\n64:     index = {}\n65:     for service in services or []:\n66:         methods = {norm(m.get(\"name\")) for m in service.get(\"methods\", [])}\n67:         index[norm(service.get(\"service_name\"))] = methods\n68:     return index\n69: \n70: \n71: def flatten_commands(commands):\n72:     pairs = []\n73:     for command in commands or []:\n74:         pairs.append((command.get(\"name\"), None))\n75:         for sub in command.get(\"subcommands\") or []:\n76:             pairs.append((command.get(\"name\"), sub.get(\"name\")))\n77:     return pairs\n78: \n79: \n80: def entity_methods(entry, services, ports):\n81:     \"\"\"The methods that could implement an entity's operations, and only those.\n82: \n83:     The operations of `crud_services[].entity` belong to that entity's own\n84:     interface: its repository in `persistence_ports`, plus any service named for\n85:     the entity.\n86:     \"\"\"\n87:     entity = norm(entry.get(\"entity\"))\n88:     methods = set()\n89:     for repo in ports.get(\"repositories\", []):\n90:         if norm(repo.get(\"entity\")) == entity:\n91:             methods.update(norm(m.get(\"name\")) for m in repo.get(\"methods\", []))\n92:     for service in services:\n93:         name = norm(service.get(\"service_name\"))\n94:         if entity and entity in name:\n95:             methods.update(norm(m.get(\"name\")) for m in service.get(\"methods\", []))\n96:     return methods\n97: \n98: \n99: def served_by_stems(stems, methods):\n100:     return any(any(stem in method for stem in stems) for method in methods)\n101: \n102: \n103: def check_prompt(name):\n104:     blockers = []\n105:     services = load(name, \"service_contracts\") or []\n106:     ports = load(name, \"persistence_ports\") or {}\n107:     components = load(name, \"components\") or {}\n108:     models = load(name, \"data_models\") or []\n109:     errors = load(name, \"errors\") or []\n110:     adapters = load(name, \"interaction_adapters\") or []\n111:     index = service_index(services)\n112:     all_methods = set().union(*index.values()) if index else set()\n113: \n114:     facade = components.get(\"facade\") or {}\n115:     invocation = facade.get(\"invocation\") or {}\n116:     for command, sub in flatten_commands(invocation.get(\"commands\")):\n117:         verb = norm(sub or command)\n118:         stems = VERB_STEMS.get(verb, (verb,))\n119:         if verb and not served_by_stems(stems, all_methods):\n120:             where = f\"{command} {sub}\" if sub else f\"{command}\"\n121:             blockers.append(f\"command '{where}' has no method\")\n122: \n123:     for adapter in adapters:\n124:         target = norm(adapter.get(\"target_service\"))\n125:         if target not in index:\n126:             blockers.append(f\"adapter -> unknown service '{adapter.get('target_service')}'\")\n127:             continue\n128:         method = norm(adapter.get(\"target_method\"))\n129:         if method not in index[target]:\n130:             blockers.append(f\"adapter -> method '{adapter.get('target_method')}' not in service\")\n131:             continue\n132:         params = {\n133:             norm(p.get(\"name\"))\n134:             for service in services\n135:             if norm(service.get(\"service_name\")) == target\n136:             for m in service.get(\"methods\", [])\n137:             if norm(m.get(\"name\")) == method\n138:             for p in m.get(\"params\", [])\n139:         }\n140:         for field in adapter.get(\"input_fields\", []):\n141:             if norm(field.get(\"target_param\")) not in params:\n142:                 blockers.append(\n143:                     f\"adapter {adapter.get('action_name')} -> unknown param '{field.get('target_param')}'\"\n144:                 )\n145: \n146:     for entry in components.get(\"crud_services\") or []:\n147:         owned = entity_methods(entry, services, ports)\n148:         for op in entry.get(\"operations\", []):\n149:             stems = OP_STEMS.get(op, (norm(op),))\n150:             if not served_by_stems(stems, owned):\n151:                 blockers.append(f\"{entry.get('entity')} op '{op}' has no method of its own\")\n152: \n153:     fields_by_entity = {\n154:         norm(model.get(\"name\")): {norm(f.get(\"name\")) for f in model.get(\"fields\", [])}\n155:         for model in models\n156:     }\n157:     mapped = {norm(m.get(\"entity\")) for m in ports.get(\"entity_mappings\", [])}\n158:     for repo in ports.get(\"repositories\", []):\n159:         if norm(repo.get(\"entity\")) not in mapped:\n160:             blockers.append(f\"repository '{repo.get('entity')}' has no mapping\")\n161:     for mapping in ports.get(\"entity_mappings\", []):\n162:         entity = norm(mapping.get(\"entity\"))\n163:         pk = norm(mapping.get(\"primary_key\"))\n164:         if entity in fields_by_entity and pk and pk not in fields_by_entity[entity]:\n165:             blockers.append(f\"mapping pk '{mapping.get('primary_key')}' not a field of {mapping.get('entity')}\")\n166: \n167:     holders = list(services) + list(ports.get(\"repositories\", []))\n168:     for holder in holders:\n169:         owner = holder.get(\"service_name\") or holder.get(\"interface_name\") or holder.get(\"entity\")\n170:         for method in holder.get(\"methods\", []):\n171:             if not (method.get(\"return_type\") or \"\").strip():\n172:                 blockers.append(f\"{owner}.{method.get('name')} has no return type\")\n173:             for param in method.get(\"params\", []):\n174:                 pname = (param.get(\"name\") or \"\").strip()\n175:                 ptype = (param.get(\"type\") or \"\").strip()\n176:                 if not pname or pname.lower() in (\"none\", \"void\", \":\", \"nonetype\"):\n177:                     blockers.append(f\"{owner}.{method.get('name')} placeholder param name '{pname}'\")\n178:                 if not ptype:\n179:                     blockers.append(f\"{owner}.{method.get('name')}.{pname} has no type\")\n180: \n181:     registered = {norm(e.get(\"name\")) for e in errors}\n182:     for holder in holders:\n183:         owner = holder.get(\"service_name\") or holder.get(\"interface_name\")\n184:         for method in holder.get(\"methods\", []):\n185:             for raised in method.get(\"raises\") or []:\n186:                 if norm(raised) not in registered:\n187:                     blockers.append(f\"{owner}.{method.get('name')} raises unregistered '{raised}'\")\n188:     return blockers\n189: \n190: \n191: def main():\n192:     total = 0\n193:     for name in PROMPTS:\n194:         if not os.path.isdir(os.path.join(OUT, name)):\n195:             print(f\"{name:10} MISSING OUTPUT\")\n196:             continue\n197:         blockers = check_prompt(name)\n198:         total += len(blockers)\n199:         print(f\"{name:10} {len(blockers)} blocker(s)\")\n200:         for blocker in blockers:\n201:             print(f\"           - {blocker}\")\n202:     print(f\"\\nTOTAL generator blockers: {total}\")\n203: \n204: \n205: if __name__ == \"__main__\":\n206:     main()"
              }

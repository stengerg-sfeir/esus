            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/pipeline.py, lines 288-332\n288:         # The prompt orders every requirements command line onto the surface,\n289:         # but the grammar cannot enforce presence — omission is always\n290:         # representable. A surface missing a named command (or a named flag\n291:         # behind a declared verb, like inventory's flagless `product add`)\n292:         # leaves a path the CLI parses but can never run, so a miss is\n293:         # retried once with the miss itself appended to the requirements,\n294:         # exactly as named.\n295:         missing = _missing_commands(body, requirements) + _missing_flags(body, requirements)\n296:         if missing:\n297:             self.log.write(\n298:                 f\"[!] step components omits {len(missing)} surface item(s) the requirements \"\n299:                 f\"name — retrying once\"\n300:             )\n301:             first = body\n302:             retry = self._generate(\n303:                 COMPONENTS,\n304:                 prompts.components(\n305:                     _with_miss_note(\n306:                         requirements, missing,\n307:                         command_lines=_command_lines(requirements),\n308:                     ),\n309:                     block,\n310:                 ),\n311:                 grammar,\n312:             )\n313:             if isinstance(retry, dict):\n314:                 repairs.repair_placeholder_subcommands(retry, self.log)\n315:                 repairs.repair_missing_flags(\n316:                     retry, requirements, self.documents.get(DATA_MODELS), self.log\n317:                 )\n318:                 retry_misses = (_missing_commands(retry, requirements)\n319:                                 + _missing_flags(retry, requirements))\n320:             else:\n321:                 retry_misses = list(missing)\n322:             body, _ = _settle_retry(\n323:                 
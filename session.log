                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_interfaces.py, lines 1-72\n1: \"\"\"Agreement between the two documents that declare the same repository.\n2: \n3: Step E writes repositories as *services* in `service_contracts`; step H writes\n4: them as *ports* in `persistence_ports`. Both call them `XxxRepository`, and\n5: nothing in either document's own checks relates them: the adapter checks resolve\n6: against `service_contracts`, while a code generator would implement\n7: `persistence_ports`. A divergence therefore means the two halves of the\n8: architecture describe different classes under one name — the adapters would\n9: target methods the implementation does not have.\n10: \n11: Only same-named interfaces are compared, matched on the checker's `normalize`,\n12: so a `WineService` is never confused with a `WineRepository`.\n13: \"\"\"\n14: \n15: from kernel.consistency.methods import collect_methods\n16: from kernel.consistency.naming import normalize\n17: \n18: \n19: def check_interface_agreement(documents, report):\n20:     \"\"\"Report every repository whose declared methods differ between documents.\"\"\"\n21:     services = documents.get(\"service_contracts\")\n22:     ports = documents.get(\"persistence_ports\")\n23:     if not isinstance(services, list) or not isinstance(ports, dict):\n24:         return\n25: \n26:     repositories = ports.get(\"repositories\")\n27:     if not isinstance(repositories, list):\n28:         return\n29: \n30:     declared = {}\n31:     for service in services:\n32:         if isinstance(service, dict) and service.get(\"service_name\"):\n33:             declared[normalize(service[\"service_name\"])] = service\n34: \n35:     for repository in repositories:\n36:         if not isinstance(repository, dict):\n37:             continue\n38:         service = declared.get(normalize(repository.get(\"interface_name\")))\n39:         if service is None:\n40:             continue\n41: \n42:         in_service = _method_names(service)\n43:         in_ports = _method_names(repository)\n44:         if set(in_service) == set(in_ports):\n45:             continue\n46: \n47:         report.warning(\n48:             \"inconsistent_interface\",\n49:             f\"{repository.get('interface_name')} ({repository.get('entity')}) is declared with \"\n50:             f\"different methods in service_contracts and persistence_ports: only in \"\n51:             f\"service_contracts {_summary(in_service, in_ports)}, only in persistence_ports \"\n52:             f\"{_summary(in_ports, in_service)}\",\n53:         )\n54: \n55: \n56: def _method_names(container):\n57:     \"\"\"Map each normalised method name to the spelling the document declares.\n58: \n59:     Keying by the normalised form compares the two documents leniently, while the\n60:     value keeps the message readable: `get_all_wines`, not `getallwines`.\n61:     \"\"\"\n62:     names = {}\n63:     for method in collect_methods(container):\n64:         name = method.get(\"name\")\n65:         if isinstance(name, str) and name.strip():\n66:             names.setdefault(normalize(name), name)\n67:     return names\n68: \n69: \n70: def _summary(source, other):\n71:     \"\"\"The declared names present in `source` and absent from `other`.\"\"\"\n72:     return sorted(source[key] for key in source if key not in other) or \"none\""

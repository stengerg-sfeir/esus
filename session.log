                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_aliases.py, lines 1-120\n1: \"\"\"Field aliases: asserted once by a human, honored deterministically after.\n2: \n3: Applying renames the recorded field (its target never moves); stale pairs,\n4: predated prompts and name collisions are skipped visibly rather than\n5: applied. The review flow is pinned without a human: numbered suggestions,\n6: free-text flags and skips all record exactly what was answered.\n7: \"\"\"\n8: \n9: import json\n10: import sys\n11: import tempfile\n12: import unittest\n13: from pathlib import Path\n14: \n15: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n16: \n17: from kernel.extraction import aliases  # noqa: E402\n18: from kernel.extraction.decisions import requirements_sha  # noqa: E402\n19: from review_aliases import ask, run_review, suggest_flags  # noqa: E402\n20: \n21: \n22: def adapters():\n23:     return [{\"action_name\": \"export\", \"target_service\": \"S\",\n24:              \"target_method\": \"export_data\",\n25:              \"input_fields\": [\n26:                  {\"field_name\": \"file_path\", \"target_param\": \"file_path\",\n27:                   \"transform\": \"DIRECT\", \"required\": True},\n28:                  {\"field_name\": \"start_date\", \"target_param\": \"start_date\",\n29:                   \"transform\": \"DIRECT\", \"required\": False}]}]\n30: \n31: \n32: class Log:\n33:     def __init__(self):\n34:         self.lines = []\n35: \n36:     def write(self, text):\n37:         self.lines.append(text)\n38: \n39: \n40: class ApplyAliasesTests(unittest.TestCase):\n41:     RECORD = {\"action\": \"export\", \"field\": \"file_path\", \"flag\": \"output\",\n42:               \"requirements_sha\": requirements_sha(\"x\")}\n43: \n44:     def test_a_matching_record_renames_the_field_only(self):\n45:         docs = adapters()\n46:         aliases.apply_aliases(docs, [dict(self.RECORD)], Log(), requirements_text=\"x\")\n47:         field = docs[0][\"input_fields\"][0]\n48:         self.assertEqual(field[\"field_name\"], \"output\")\n49:         self.assertEqual(field[\"target_param\"], \"file_path\")\n50: \n51:     def test_a_stale_pair_applies_to_nothing(self):\n52:         docs = adapters()\n53:         log = Log()\n54:         aliases.apply_aliases(\n55:             docs, [{\"action\": \"gone\", \"field\": \"file_path\", \"flag\": \"output\"}],\n56:             log, requirements_text=\"x\")\n57:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"file_path\")\n58:         self.assertEqual(log.lines, [])\n59: \n60:     def test_a_collision_is_skipped_loudly(self):\n61:         docs = adapters()\n62:         docs[0][\"input_fields\"].append(\n63:             {\"field_name\": \"output\", \"target_param\": \"other\",\n64:              \"transform\": \"DIRECT\", \"required\": False})\n65:         log = Log()\n66:         aliases.apply_aliases(docs, [dict(self.RECORD)], log, requirements_text=\"x\")\n67:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"file_path\")\n68:         self.assertTrue(any(\"collides\" in line for line in log.lines))\n69: \n70:     def test_a_predated_prompt_drops_the_record(self):\n71:         docs = adapters()\n72:         log = Log()\n73:         stamped = {\"action\": \"export\", \"field\": \"file_path\", \"flag\": \"output\",\n74:                    \"requirements_sha\": aliases.requirements_sha(\"old prompt\")}\n75:         aliases.apply_aliases(docs, [stamped], log,\n76:                               requirements_text=\"different prompt\")\n77:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"file_path\")\n78:         self.assertTrue(any(\"predates a prompt change\" in line for line in log.lines))\n79: \n80:     def test_a_legacy_record_without_a_stamp_applies(self):\n81:         docs = adapters()\n82:         legacy = {\"action\": \"export\", \"field\": \"file_path\", \"flag\": \"output\"}\n83:         aliases.apply_aliases(docs, [legacy], Log(), requirements_text=\"anything\")\n84:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"output\")\n85: \n86: \n87: class CreateRecordRoutingTests(unittest.TestCase):\n88:     \"\"\"Creation records are not renames: the adapter field keeps its name.\n89: \n90:     A record carrying a `create` spec asserts a model field exists (owned by\n91:     apply_model_fields), not that the adapter field should move. Routing it\n92:     through the rename reported a collision of the field against itself —\n93:     noise that read like a defect in the run log.\n94:     \"\"\"\n95: \n96:     def adapters(self):\n97:         return [{\"action_name\": \"add_book\", \"target_service\": \"R\",\n98:                  \"target_method\": \"m\",\n99:                  \"input_fields\": [\n100:                      {\"field_name\": \"author_id\", \"target_param\": \"book\",\n101:                       \"transform\": \"DIRECT\", \"required\": True}]}]\n102: \n103:     def test_a_create_record_leaves_the_adapter_untouched_silently(self):\n104:         log = Log()\n105:         record = {\"action\": \"add_book\", \"field\": \"author_id\",\n106:                   \"flag\": \"author_id\",\n107:                   \"create\": {\"entity\": \"Book\", \"name\": \"author_id\"}}\n108:         docs = self.adapters()\n109:         aliases.apply_aliases(docs, [record], log, requirements_text=\"x\")\n110:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"author_id\")\n111:         self.assertEqual(log.lines, [])\n112: \n113:     def test_a_same_name_rename_is_a_silent_no_op(self):\n114:         log = Log()\n115:         record = {\"action\": \"add_book\", \"field\": \"author_id\",\n116:                   \"flag\": \"author_id\"}\n117:         docs = self.adapters()\n118:         aliases.apply_aliases(docs, [record], log, requirements_text=\"x\")\n119:         self.assertEqual(docs[0][\"input_fields\"][0][\"field_name\"], \"author_id\")\n120:         self.assertEqual(log.lines, [])\n[Output truncated. Continue reading with offset: 121]"

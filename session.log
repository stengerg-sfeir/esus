ember.id, loan_date=now,\n    due_date=now + datetime.timedelta(days=14), status=\"active\"))\nbook.available_copies -= 1\nbooks.update_book(book.id, book)\nprint(\"copies before return:\", books.read_one_book(book.id).available_copies)\ntry:\n    returned = service.return_book(loan.id)\n    print(\"returned:\", returned)\nexcept Exception as error:\n    print(\"FAILED:\", type(error).__name__, error)\nstored = loans.read_one_loan(loan.id)\nprint(\"stored:\", stored)\nprint(\"copies after return:\", books.read_one_book(book.id).available_copies)\nif stored.return_date is not None:\n    print(\"return_date vs now (seconds):\",\n          abs((datetime.datetime.fromisoformat(stored.return_date)\n               - now).total_seconds()) if isinstance(stored.return_date, str)\n          else abs((stored.return_date - now).total_seconds()))\n\nprint(\"\\n== searches ==\")\nfor label, fn in ((\"repo\", books.search_books_by_title_author_isbn),\n                  (\"service\", service.search_books)):\n    for query in (\"Dispossessed\", \"Le Guin\", \"9780060512750\", \"nope\"):\n        try:\n            found = fn(query)\n            print(f\"{label} {query!r}: {[b.title for b in found]}\")\n        except Exception as error:\n            print(f\"{label} {query!r}: {type(error).__name__}: {error}\")\n",

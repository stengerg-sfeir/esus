raryService.return_book\n    loan = self._repos['LoanRepository'].read_one_loan(loan_id)\n    if loan is None:\n        raise errors.LoanNotFoundError(loan_id)\n    if loan.status != \"active\":\n        raise errors.InvalidReturnDateError(loan_id)\n    loan.return_date = datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    loan.status = \"returned\"\n    book_id = loan.book_id\n    book = self._repos['BookRepository'].read_one_book(book_id)\n    if book is None:\n        raise errors.BookNotFoundError(book_id)\n    book.available_copies += 1\n    updated_book = self._repos['BookRepository'].update_book(book_id, book)\n    updated_loan = self._repos['LoanRepository'].update_loan(loan_id, loan)\n    return updated_loan\n\n========================= LibraryService.borrow_book\n    loan = self._repos['LoanRepository'].create_loan(\n        models.Loan(book_id=book_id, member_id=member_id, loan_date=datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n                    due_date=(datetime.datetime.now() + datetime.timedelta(days=14)).strftime(\"%Y-%m-%d %H:%M:%S\"),\n                    status=\"active\")\n    )\n    book = self._repos['BookRepository'].read_one_book(book_id)\n    if book is None:\n        raise errors.BookNotFoundError(book_id)\n    if book.available_copies <= 0:\n        raise errors.InsufficientCopiesError(book_id)\n    book.available_copies -= 1\n    updated_book = self._repos['BookRepository'].update_book(book_id, book)\n    return loan\n\n"

                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_generator.py, lines 445-509\n445: class PlanTests(unittest.TestCase):\n446:     def test_match_param_covers_prefixes_and_rejects_noise(self):\n447:         self.assertEqual(codegen.match_param([\"expense_date\"], \"start_date\"),\n448:                          (\"expense_date\", \"ge\"))\n449:         self.assertEqual(codegen.match_param([\"id\"], \"id\"), (\"id\", \"eq\"))\n450:         self.assertIsNone(codegen.match_param([\"name\"], \"total\"))\n451: \n452:     def test_sanitize_never_returns_a_non_identifier(self):\n453:         for raw in [\"\", \"9lives\", \"a b-c\", \"none\"]:\n454:             ident = codegen.sanitize(raw)\n455:             self.assertTrue(ident.isidentifier(), raw)\n456: \n457:     def test_a_flag_string_taken_twice_degrades_gracefully(self):\n458:         \"\"\"`book list` gives `-a` to two options: the second keeps its long flag.\"\"\"\n459:         stats = {}\n460:         lines = generator._emit_options(\"\", \"p\", [\n461:             {\"name\": \"-author\", \"short\": \"-a\", \"type\": \"bool\", \"required\": False, \"default\": None},\n462:             {\"name\": \"-author-only\", \"short\": \"-a\", \"type\": \"bool\", \"required\": False, \"default\": None},\n463:         ], stats)\n464:         second = next(line for line in lines if \"author-only\" in line)\n465:         self.assertIn(\"'-author-only'\", second)\n466:         self.assertNotIn(\"'-a',\", second)\n467: \n468:     def test_scoring_prefers_the_command_own_entity(self):\n469:         \"\"\"`budget add` reaches the budget creator, not `add_category`.\"\"\"\n470:         from kernel.consistency.checks_surface import COMMAND_VERB_STEMS\n471:         adapters = [\n472:             {\"action_name\": \"add_category\", \"target_service\": \"CategoryRepository\",\n473:              \"target_method\": \"create_category\", \"input_fields\": []},\n474:             {\"action_name\": \"create_budget\", \"target_service\": \"BudgetRepository\",\n475:              \"target_method\": \"create_budget\", \"input_fields\": []},\n476:         ]\n477:         invocation = {\"commands\": [{\"name\": \"budget\",\n478:                                     \"subcommands\": [{\"name\": \"add\", \"options\": []}]}]}\n479:         bindings, unmapped = codegen.bind_commands(adapters, invocation, COMMAND_VERB_STEMS)\n480:         self.assertEqual(bindings[(\"budget\", \"add\")][0], \"create_budget\")\n481:         self.assertEqual(unmapped, [])\n482: \n483:     def test_field_binding_folds_abbreviations_and_date_aliases(self):\n484:         dests = [\"name\", \"price\", \"category\", \"from_date\", \"to_date\", \"method\"]\n485:         self.assertEqual(codegen.bind_field(dests, \"price_cents\"), \"price\")\n486:         self.assertEqual(codegen.bind_field(dests, \"category_id\"), \"category\")\n487:         self.assertEqual(codegen.bind_field(dests, \"start_date\"), \"from_date\")\n488:         self.assertEqual(codegen.bind_field(dests, \"end_date\"), \"to_date\")\n489:         self.assertEqual(codegen.bind_field(dests, \"payment_method\"), \"method\")\n490:         self.assertIsNone(codegen.bind_field(dests, \"file_path\"))\n491:         self.assertIsNone(codegen.bind_field([\"start_date\", \"end_date\"], \"date\"))\n492: \n493:     def test_uncovered_fields_judge_bound_leaves_only(self):\n494:         \"\"\"A required flag missing on the owning leaf strands the action;\n495:         orphan actions and sibling-assembled `data` do not.\"\"\"\n496:         adapters = [\n497:             {\"action_name\": \"do_it\", \"target_service\": \"S\", \"target_method\": \"do_it\",\n498:              \"input_fields\": [\n499:                  {\"field_name\": \"name\", \"target_param\": \"name\", \"transform\": \"DIRECT\", \"required\": True},\n500:                  {\"field_name\": \"amount\", \"target_param\": \"amount\", \"transform\": \"DIRECT\", \"required\": True}]},\n501:           
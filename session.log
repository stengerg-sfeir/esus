            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/review_ties.py, lines 1-151\n1: #!/usr/bin/env python3\n2: \"\"\"Ask the user about the near-tied classifications that change the generated body.\n3: \n4: Step F records `decision: undecided` when the top two answers were too close to\n5: call. Ties whose sides compile to the same body are resolved by rule\n6: (`kernel.tie_rules`); the rest — a guard means a different check, and neither\n7: the classifier nor the generator knows which failure the requirement means —\n8: are questions for the requirements author, and this is where they are asked.\n9: \n10: Usage:\n11:     python review_ties.py out/library\n12: \n13: Each open question shows the text, the source, both candidates with confidence\n14: and margin, and the concrete alternative where one exists. Answers persist in\n15: `decisions.json` beside the documents and are re-applied on every extraction\n16: run, so one answer settles the tie permanently; the on-disk document is\n17: patched too, so no rerun is needed. `skip` leaves a question open.\n18: \"\"\"\n19: \n20: import json\n21: import os\n22: import sys\n23: \n24: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n25: \n26: from kernel import tie_rules  # noqa: E402\n27: from kernel.consistency.loader import load_requirements  # noqa: E402\n28: from kernel.extraction.decisions import (  # noqa: E402\n29:     apply_decisions,\n30:     load_decisions,\n31:     requirements_sha,\n32:     save_decisions,\n33: )\n34: \n35: \n36: def collect_questions(matches, decided_texts):\n37:     \"\"\"Every tie needing a human that has no recorded answer yet.\"\"\"\n38:     return [\n39:         entry for entry in matches\n40:         if tie_rules.needs_user(entry) and entry.get(\"text\") not in decided_texts\n41:     ]\n42: \n43: \n44: def describe_question(index, total, entry):\n45:     \"\"\"The lines presenting one tie: text, source, and both sides.\"\"\"\n46:     lines = [\n47:         f\"--- question {index}/{total} ---\",\n48:         f\"text:   {entry.get('text')}\",\n49:         f\"source: {entry.get('source')}\",\n50:         f\"1) recorded:   {entry.get('pattern_id')} \"\n51:         f\"(confidence {entry.get('confidence')})\",\n52:     ]\n53:     alternative = tie_rules.alternative_of(entry)\n54:     if alternative is not None:\n55:         lines.append(f\"2) alternative: {alternative}\")\n56:     else:\n57:         lines.append(\n58:             \"2) alternative: (no concrete pattern — the other domain was never \"\n59:             \"classified; keep 1 or skip)\"\n60:         )\n61:     if entry.get(\"margin\") is not None:\n62:         lines.append(f\"margin: {entry.get('margin')}\")\n63:     if entry.get(\"domain_margin\") is not None:\n64:         lines.append(f\"domain margin: {entry.get('domain_margin')}\")\n65:     return lines\n66: \n67: \n68: def ask(entry, input_fn=input):\n69:     \"\"\"Pose one tie; return the chosen pattern id, or None on skip/invalid.\"\"\"\n70:     alternative = tie_rules.alternative_of(entry)\n71:     try:\n72:         answer = input_fn(\"choose 1, 2, or skip: \").strip().lower()\n73:     except (EOFError, KeyboardInterrupt):\n74:         return None\n75:     if answer in (\"1\", \"keep\", \"recorded\"):\n76:         return entry.get(\"pattern_id\")\n77:     if answer in (\"2\", \"alternative\") and isinstance(alternative, str):\n78:         return alternative\n79:     return None\n80: \n81: \n82: def run_review(output_dir, input_fn=input, out_fn=print):\n83:     \"\"\"Ask every open question; return (asked, answered).\"\"\"\n84:     matches_path = os.path.join(output_dir, \"pattern_matches.json\")\n85:     try:\n86:         with open(matches_path, encoding=\"utf-8\") as handle:\n87:             payload = json.load(handle)\n88:     except (OSError, ValueError) as error:\n89:         out_fn(f\"error: cannot read {matches_path}: {error}\")\n90:         return 0, 0\n91:     matches = payload.get(\"pattern_matches\")\n92:     if not isinstance(matches, list):\n93:         out_fn(f\"error: {matches_path} has no 'pattern_matches' list\")\n94:         return 0, 0\n95: \n96:     decisions = load_decisions(output_dir)\n97:     decided_texts = {\n98:         record.get(\"text\") for record in decisions if isinstance(record, dict)\n99:     }\n100:     prompt_sha = requirements_sha(load_requirements(output_dir))\n101:     questions = collect_questions(matches, decided_texts)\n102:     if not questions:\n103:         out_fn(\"no open tie questions — nothing to decide\")\n104:         return 0, 0\n105: \n106:     answered = 0\n107:     for number, entry in enumerate(questions, start=1):\n108:         for line in describe_question(number, len(questions), entry):\n109:             out_fn(line)\n110:         chosen = ask(entry, input_fn)\n111:         if not isinstance(chosen, str):\n112:             out_fn(\"skipped — left open\")\n113:             continue\n114:         candidates = [entry.get(\"pattern_id\"), tie_rules.alternative_of(entry)]\n115:         record = {\n116:             \"text\": entry.get(\"text\"),\n117:             \"chosen_pattern_id\": chosen,\n118:             \"candidates\": [name for name in candidates if isinstance(name, str)],\n119:             \"decided_by\": \"user\",\n120:         }\n121:         if prompt_sha is not None:\n122:             # Without the stamp, a later prompt edit would keep applying an\n123:             # answer given under different words. Missing requirements (a\n124:             # hand-made directory) simply record no stamp.\n125:             record[\"requirements_sha\"] = prompt_sha\n126:         decisions.append(record)\n127:         answered += 1\n128: \n129:     save_decisions(output_dir, decisions)\n130:     with open(matches_path, encoding=\"utf-8\") as handle:\n131:         payload = json.load(handle)\n132:     payload[\"pattern_matches\"] = apply_decisions(payload.get(\"pattern_matches\"), decisions)\n133:     with open(matches_path, \"w\", encoding=\"utf-8\") as handle:\n134:         json.dump(payload, handle, indent=2, ensure_ascii=False)\n135:         handle.write(\"\\n\")\n136:     out_fn(f\"answered {answered} of {len(questions)}; decisions in decisions.json\")\n137:     return len(questions), answered\n138: \n139: \n140: def main(argv=None):\n141:     args = list(sys.argv[1:] if argv is None else argv)\n142:     if len(args) != 1:\n143:         print(__doc__.splitlines()[0], file=sys.stderr)\n144:         print(\"usage: python review_ties.py OUT_DIR\", file=sys.stderr)\n145:         return 2\n146:     asked, _ = run_review(args[0])\n147:     return 0\n148: \n149: \n150: if __name__ == \"__main__\":\n151:     sys.exit(main())"

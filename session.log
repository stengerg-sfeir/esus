                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_repairs.py, lines 262-321\n262: class PlaceholderSubcommandTests(unittest.TestCase):\n263:     \"\"\"A subcommand named `none` states there is none, and is dropped.\n264: \n265:     Library's bare `` `library overdue` `` line came back as command `overdue`\n266:     with subcommand `none`: no method serves it, so the probe reports\n267:     `unbacked_command` and the generator cannot write the call. Dropping it\n268:     leaves the bare command the requirements describe.\n269:     \"\"\"\n270: \n271:     def components(self, subcommands):\n272:         return {\n273:             \"facade\": {\n274:                 \"invocation\": {\n275:                     \"commands\": [\n276:                         {\"name\": \"overdue\", \"subcommands\": subcommands}\n277:                     ]\n278:                 }\n279:             }\n280:         }\n281: \n282:     def test_a_none_subcommand_is_dropped(self):\n283:         body = self.components([{\"name\": \"none\", \"options\": []}])\n284:         log = Log()\n285:         repairs.repair_placeholder_subcommands(body, log)\n286:         self.assertEqual(\n287:             body[\"facade\"][\"invocation\"][\"commands\"][0][\"subcommands\"], []\n288:         )\n289:         self.assertEqual(len(log.lines), 1)\n290: \n291:     def test_real_siblings_are_kept(self):\n292:         body = self.components([{\"name\": \"add\"}, {\"name\": \"none\"}, {\"name\": \"list\"}])\n293:         repairs.repair_placeholder_subcommands(body, Log())\n294:         self.assertEqual(\n295:             [s[\"name\"] for s in body[\"facade\"][\"invocation\"][\"commands\"][0][\"subcommands\"]],\n296:             [\"add\", \"list\"],\n297:         )\n298: \n299:     def test_case_does_not_save_a_placeholder(self):\n300:         body = self.components([{\"name\": \"None\"}])\n301:         repairs.repair_placeholder_subcommands(body, Log())\n302:         self.assertEqual(\n303:             body[\"facade\"][\"invocation\"][\"commands\"][0][\"subcommands\"], []\n304:         )\n305: \n306:     def test_a_clean_surface_is_left_alone(self):\n307:         body = self.components([{\"name\": \"add\"}])\n308:         log = Log()\n309:         repairs.repair_placeholder_subcommands(body, log)\n310:         self.assertEqual(\n311:             [s[\"name\"] for s in body[\"facade\"][\"invocation\"][\"commands\"][0][\"subcommands\"]],\n312:             [\"add\"],\n313:         )\n314:         self.assertEqual(log.lines, [])\n315: \n316:     def test_a_body_with_no_surface_is_left_alone(self):\n317:         self.assertEqual(repairs.repair_placeholder_subcommands({}, Log()), {})\n318:         self.assertIsNone(repairs.repair_placeholder_subcommands(None, Log()))\n319: \n320: \n321: class MissingFlagRepairTests(unittest.TestCase):\n[Output truncated. Continue reading with offset: 322]"

                "text": "\"\"\"Smoke the typed/final-block tree: return should be right; borrow order is suspect.\"\"\"\nimport datetime\nimport sys\n\nsys.path.insert(0, \"/tmp/opencode/library_qwen_exact_typed\")\n\nimport models  # noqa: E402\nimport repositories  # noqa: E402\nimport services  # noqa: E402\nfrom store import Store  # noqa: E402\n\nstore = Store(\":memory:\")\nbooks = repositories.BookRepository(store)\nauthors = repositories.AuthorRepository(store)\nmembers = repositories.MemberRepository(store)\nloans = repositories.LoanRepository(store)\nservice = services.LibraryService({\n    \"BookRepository\": books,\n    \"AuthorRepository\": authors,\n    \"MemberRepository\": members,\n    \"LoanRepository\": loans,\n})\n\nauthor = authors.create_author(models.Author(name=\"Ursula K. Le Guin\"))\nbook = books.create_book(models.Book(\n    title=\"The Dispossessed\", isbn=\"9780060512750\", published_year=1974,\n    available_copies=2, author_id=author.id))\nzero = books.create_book(models.Book(\n    title=\"No Copies Left\", isbn=\"0000000000002\", published_year=2020,\n    available_copies=0, author_id=author.id))\nmember = members.create_member(models.Member(\n    name=\"Ada\", email=\"ada@example.test\", is_active=True))\n\nprint(\"== borrow happy ==\")\nloan = None\ntry:\n    loan = service.borrow_book(member.id, book.id)\n    print(\"loan:\", loan)\nexcept Exception as error:\n    print(\"FAILED:\", type(error).__name__, error)\nprint(\"copies stored:\", books.read_one_book(book.id).available_copies,\n      \"| loans:\", len(loans.read_all_loans()))\n\nprint(\"\\n== borrow zero copies ==\")\nbefore = len(loans.read_all_loans())\ntry:\n    service.borrow_book(member.id, zero.id)\n    print(\"no error raised\")\nexcept Exception as error:\n    print(\"raised:\", type(error).__name__, error)\nafter = len(loans.read_all_loans())\nprint(f\"loans before={before} after={after} (phantom: {after != before})\")\n\nprint(\"\\n== return the happy loan ==\")\nif loan is not None:\n    try:\n        returned = service.return_book(loan.id)\n        print(\"returned:\", returned)\n    except Exception as error:\n        print(\"FAILED:\", type(error).__name__, error)\n    stored = loans.read_one_loan(loan.id)\n    print(\"stored:\", stored)\n    print(\"copies after return:\", books.read_one_book(book.id).available_copies)\n    if stored.return_date:\n        stamp = (datetime.datetime.fromisoformat(stored.return_date)\n                 if isinstance(stored.return_date, str) else stored.return_date)\n        print(\"return_date vs now (hours):\",\n              round((stamp - datetime.datetime.now()).total_seconds() / 3600, 2))\n\nprint(\"\\n== renew / search ==\")\nprint(\"renew toggled:\", service.renew_membership(member.id).is_active,\n      members.read_one_member(member.id).is_active)\nfor label, fn in ((\"repo\", books.search_books_by_title_author_isbn),\n                  (\"service\", service.search_books)):\n    for query in (\"Dispossessed\", \"Le Guin\", \"9780060512750\"):\n        print(f\"{label} {query!r}: {[b.title for b in fn(query)]}\")\nrepo search: {'Dispossessed': ['The Dispossessed'], 'Le Guin': ['The Dispossessed'], '9780060512750': ['The Dispossessed']}\nservice search: {'Dispossessed': ['The Dispossessed'], 'Le Guin': ['The Dispossessed'], '9780060512750': ['The Dispossessed']}\nrenew: True True\nborrow: NotImplementedError LibraryService.borrow_book: rule plain-method: method needs custom logic\nreturn: NotImplementedError LibraryService.return_book: pattern STANDARD_CRUD: no mechanical reading\n"

            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_generator_readiness_rules.py, lines 1-309\n1: \"\"\"The rules that compare a document with what the requirements asked for.\n2: \n3: Most judge a document against another document or against a name it states\n4: itself; `missing_command` reads the requirements prose, and `unbacked_command`\n5: reads the methods — a command the surface declares and no service implements.\n6: Each test pins a decision, and — where a rule deliberately stays silent — pins\n7: that silence too, because a rule that fires on a correct document is worse than\n8: no rule.\n9: \"\"\"\n10: \n11: import sys\n12: import unittest\n13: from pathlib import Path\n14: \n15: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n16: \n17: from kernel.consistency.checks_adapters import (  # noqa: E402\n18:     _check_target_param,\n19:     _check_transform_fits_the_field,\n20: )\n21: from kernel.consistency.checks_errors import (  # noqa: E402\n22:     check_duplicate_error_subject,\n23:     check_unreachable_not_found,\n24: )\n25: from kernel.consistency.checks_surface import (  # noqa: E402\n26:     check_command_backing,\n27:     check_surface_coverage,\n28: )\n29: from kernel.consistency.report import Report  # noqa: E402\n30: from kernel.extraction import grammar_open  # noqa: E402\n31: \n32: \n33: def rules(report):\n34:     return [finding.rule for finding in report.findings]\n35: \n36: \n37: def field(name, target, transform=\"DIRECT\"):\n38:     return {\"field_name\": name, \"target_param\": target, \"transform\": transform}\n39: \n40: \n41: def surface(commands, positional=None, options=None):\n42:     \"\"\"A whole components document, because the check reads `components.facade`.\"\"\"\n43:     return {\n44:         \"facade\": {\n45:             \"type\": \"cli\",\n46:             \"technology\": \"click\",\n47:             \"invocation\": {\n48:                 \"positional\": positional or [],\n49:                 \"options\": options or [],\n50:                 \"commands\": commands,\n51:             },\n52:         }\n53:     }\n54: \n55: \n56: def command(name, subcommands=(), options=()):\n57:     return {\n58:         \"name\": name,\n59:         \"options\": [{\"name\": option, \"type\": \"bool\"} for option in options],\n60:         \"subcommands\": [{\"name\": sub, \"options\": []} for sub in subcommands],\n61:     }\n62: \n63: \n64: class MissingCommandTests(unittest.TestCase):\n65:     def test_a_subcommand_the_requirements_name_is_reported(self):\n66:         report = Report(\"t\")\n67:         components = surface([command(\"category\", subcommands=[\"list\"])])\n68:         check_surface_coverage(components, \"Use it as `category add --name` to add.\", report)\n69:         self.assertIn(\"missing_command\", rules(report))\n70: \n71:     def test_a_present_subcommand_is_not_reported(self):\n72:         report = Report(\"t\")\n73:         components = surface([command(\"category\", subcommands=[\"add\"])])\n74:         check_surface_coverage(components, \"Use it as `category add --name` to add.\", report)\n75:         self.assertEqual(rules(report), [])\n76: \n77:     def test_the_program_name_before_a_verb_is_not_reported(self):\n78:         \"\"\"`library borrow book` names the tool, not a command, so nothing is missing.\"\"\"\n79:         report = Report(\"t\")\n80:         components = surface([command(\"borrow\", subcommands=[\"book\"])])\n81:         check_surface_coverage(components, \"Run `library borrow book --id 3`.\", report)\n82:         self.assertEqual(rules(report), [])\n83: \n84:     def test_a_null_invocation_is_not_reported(self):\n85:         report = Report(\"t\")\n86:         components = {\"type\": \"cli\", \"technology\": \"none\", \"invocation\": None}\n87:         check_surface_coverage(components, \"Run `tool thing --flag`.\", report)\n88:         self.assertEqual(rules(report), [])\n89: \n90:     def test_no_requirements_means_no_check(self):\n91:         report = Report(\"t\")\n92:         components = surface([command(\"category\")])\n93:         check_surface_coverage(components, None, report)\n94:         self.assertEqual(rules(report), [])\n95: \n96: \n97: class CommandShapeTests(unittest.TestCase):\n98:     \"\"\"The command shape that makes `-add` beside subcommand `add` unrepresentable.\n99: \n100:     Two prompt sentences failed to stop the collision, so it is closed in the\n101:     grammar instead. These tests pin the closure structurally, which is all that\n102:     can be checked without a model: the branch that admits subcommands and the\n103:     branch that admits any option are different rules, so no single command can be\n104:     built with both.\n105:     \"\"\"\n106: \n107:     def grammar_text(self):\n108:         \"\"\"`components()` already returns the grammar document as one string.\"\"\"\n109:         return grammar_open.components()\n110: \n111:     def line(self, prefix):\n112:         return next(\n113:             text for text in self.grammar_text().splitlines() if text.startswith(prefix)\n114:         )\n115: \n116:     def test_a_command_with_subcommands_admits_only_global_options(self):\n117:         nested = self.line(\"cli-command-nested ::=\")\n118:         self.assertIn(\"cli-global-option-list\", nested)\n119:         self.assertNotIn(\"cli-option-list\", nested)\n120: \n121:     def test_a_command_without_subcommands_admits_any_option(self):\n122:         flat = self.line(\"cli-command-flat ::=\")\n123:         self.assertIn(\"cli-option-list\", flat)\n124:         self.assertIn('\"[\" ws \"]\"', flat)\n125: \n126:     def test_the_two_shapes_are_the_only_commands(self):\n127:         rule_line = self.line(\"cli-command ::=\")\n128:         self.assertIn(\"cli-command-nested\", rule_line)\n129:         self.assertIn(\"cli-command-flat\", rule_line)\n130: \n131:     def test_a_global_option_name_is_one_of_four(self):\n132:         rule_line = self.line(\"global-option-name ::=\")\n133:         for name in (\"-help\", \"--help\", \"-version\", \"--version\"):\n134:             self.assertIn(f'\\\\\"{name}\\\\\"', rule_line)\n135:         self.assertNotIn(\"add\", rule_line)\n136: \n137: \n138: class MismatchedTransformTests(unittest.TestCase):\n139:     def test_a_count_converted_to_cents_is_reported(self):\n140:         report = Report(\"t\")\n141:         _check_transform_fits_the_field(field(\"copies\", \"copies\", \"DECIMAL_TO_CENTS\"), \"add_book\", \"copies\", report)\n142:         self.assertIn(\"mismatched_transform\", rules(report))\n143: \n144:     def test_a_money_amount_converted_to_cents_is_not_reported(self):\n145:         report = Report(\"t\")\n146:         _check_transform_fits_the_field(\n147:             field(\"amount_cents\", \"amount_cents\", \"DECIMAL_TO_CENTS\"), \"add_expense\", \"amount_cents\", report\n148:         )\n149:         self.assertEqual(rules(report), [])\n150: \n151:     def test_a_single_name_read_as_a_list_is_reported(self):\n152:         report = Report(\"t\")\n153:         _check_transform_fits_the_field(field(\"name\", \"name\", \"CSV_LIST\"), \"add_category\", \"name\", report)\n154:         self.assertIn(\"mismatched_transform\", rules(report))\n155: \n156:     def test_a_list_field_read_as_a_list_is_not_reported(self):\n157:         report = Report(\"t\")\n158:         _check_transform_fits_the_field(\n159:             field(\"tag_ids\", \"tag_ids\", \"CSV_LIST\"), \"add_book\", \"tag_ids\", report\n160:         )\n161:         self.assertEqual(rules(report), [])\n162: \n163:     def test_a_date_field_parsed_as_a_date_is_not_reported(self):\n164:         report = Report(\"t\")\n165:         _check_transform_fits_the_field(\n166:             field(\"expense_date\", \"expense_date\", \"ISO_DATE\"), \"add_expense\", \"expense_date\", report\n167:         )\n168:         self.assertEqual(rules(report), [])\n169: \n170:     def test_a_direct_transform_is_never_judged(self):\n171:         report = Report(\"t\")\n172:         _check_transform_fits_the_field(field(\"anything\", \"anything\", \"DIRECT\"), \"do_it\", \"anything\", report)\n173:         self.assertEqual(rules(report), [])\n174: \n175: \n176: class MisplacedFieldTests(unittest.TestCase):\n177:     def test_a_field_sent_past_its_own_parameter_is_reported(self):\n178:         \"\"\"expenses' `update_budget`: field `month` goes into `budget` while `month` exists.\"\"\"\n179:         report = Report(\"t\")\n180:         _check_target_param(\n181:             field(\"month\", \"budget\"), \"update_budget\", \"month\",\n182:             {\"category_id\", \"month\", \"amount_limit_cents\"}, report,\n183:         )\n184:         self.assertIn(\"misplaced_field\", rules(report))\n185: \n186:     def test_a_field_sent_to_its_own_parameter_is_not_reported(self):\n187:         report = Report(\"t\")\n188:         _check_target_param(\n189:             field(\"category_id\", \"category_id\"), \"add_expense\", \"category_id\",\n190:             {\"expense\", \"category_id\"}, report,\n191:         )\n192:         self.assertEqual(rules(report), [])\n193: \n194:     def test_a_field_with_no_parameter_of_its_own_is_not_reported(self):\n195:         \"\"\"Description folded into an aggregate parameter has no same-named one to prefer.\"\"\"\n196:         report = Report(\"t\")\n197:         _check_target_param(\n198:             field(\"description\", \"expense\"), \"add_expense\", \"description\",\n199:             {\"expense\", \"category_id\"}, report,\n200:         )\n201:         self.assertEqual(rules(report), [])\n202: \n203: \n204: class UnreachableErrorTests(unittest.TestCase):\n205:     def test_an_unraised_not_found_error_with_a_reader_is_reported(self):\n206:         report = Report(\"t\")\n207:         services = [\n208:             {\n209:                 \"service_name\": \"ProductRepository\",\n210:                 \"methods\": [{\"name\": \"get_product_by_id\", \"raises\": []}],\n211:             }\n212:         ]\n213:         check_unreachable_not_found([{\"name\": \"MissingProductError\"}], services, (\"MissingProductError\",), report)\n214:         self.assertIn(\"unreachable_error\", rules(report))\n215: \n216:     def test_a_not_found_error_the_reader_raises_is_not_reported(self):\n217:         report = Report(\"t\")\n218:         services = [\n219:             {\n220:                 \"service_name\": \"ProductRepository\",\n221:                 \"methods\": [{\"name\": \"get_product_by_id\", \"raises\": [\"MissingProductError\"]}],\n222:             }\n223:         ]\n224:         check_unreachable_not_found([{\"name\": \"MissingProductError\"}], services, (\"MissingProductError\",), report)\n225:         self.assertEqual(rules(report), [])\n226: \n227:     def test_an_error_whose_subject_nothing_reads_is_not_reported(self):\n228:         \"\"\"`MalformedCSVError` belongs to a layer the checker does not model.\"\"\"\n229:         report = Report(\"t\")\n230:         services = [{\"service_name\": \"FileService\", \"methods\": [{\"name\": \"load_file\", \"raises\": []}]}]\n231:         check_unreachable_not_found([{\"name\": \"MalformedCSVError\"}], services, (\"MalformedCSVError\",), report)\n232:         self.assertEqual(rules(report), [])\n233: \n234:     def test_no_services_means_no_check(self):\n235:         report = Report(\"t\")\n236:         check_unreachable_not_found([{\"name\": \"MissingProductError\"}], [], (\"MissingProductError\",), report)\n237:         self.assertEqual(rules(report), [])\n238: \n239: \n240: class DuplicateErrorSubjectTests(unittest.TestCase):\n241:     def test_two_names_for_one_missing_record_are_reported(self):\n242:         report = Report(\"t\")\n243:         names = (\"CategoryNotFoundError\", \"MissingCategoryError\")\n244:         check_duplicate_error_subject([{\"name\": name} for name in names], names, report)\n245:         self.assertIn(\"duplicate_error_subject\", rules(report))\n246: \n247:     def test_one_name_per_missing_record_is_not_reported(self):\n248:         report = Report(\"t\")\n249:         names = (\"CategoryNotFoundError\", \"ProductNotFoundError\")\n250:         check_duplicate_error_subject([{\"name\": name} for name in names], names, report)\n251:         self.assertEqual(rules(report), [])\n252: \n253: \n254: class UnbackedCommandTests(unittest.TestCase):\n255:     \"\"\"A command the surface declares and no service method can implement.\n256: \n257:     The second half of the surface check: `missing_command` compares the surface\n258:     with the requirements, this compares it with the methods. A generator cannot\n259:     write a call no method serves, and nothing else in the checker can see it.\n260:     \"\"\"\n261: \n262:     def services(self, *method_names):\n263:         return [\n264:             {\n265:                 \"service_name\": \"OrderService\",\n266:                 \"methods\": [{\"name\": name, \"description\": name, \"params\": [], \"return_type\": \"void\"} for name in method_names],\n267:             }\n268:         ]\n269: \n270:     def test_a_verb_no_method_serves_is_reported(self):\n271:         report = Report(\"t\")\n272:         components = surface([command(\"order\", subcommands=[\"confirm\"])])\n273:         check_command_backing(components, self.services(\"create_order\", \"cancel_order\"), report)\n274:         self.assertIn(\"unbacked_command\", rules(report))\n275: \n276:     def test_a_verb_served_by_a_synonym_is_not_reported(self):\n277:         \"\"\"`book add` is implemented by `create_book`; the rename is the generator's.\"\"\"\n278:         report = Report(\"t\")\n279:         components = surface([command(\"book\", subcommands=[\"add\", \"list\"])])\n280:         check_command_backing(components, self.services(\"create_book\", \"read_all_books\"), report)\n281:         self.assertEqual(rules(report), [])\n282: \n283:     def test_a_search_verb_is_served_by_a_search_method(self):\n284:         report = Report(\"t\")\n285:         components = surface([command(\"order\", subcommands=[\"search\"])])\n286:         check_command_backing(components, self.services(\"search_orders_by_customer_id\"), report)\n287:         self.assertEqual(rules(report), [])\n288: \n289:     def test_a_null_invocation_is_not_reported(self):\n290:         report = Report(\"t\")\n291:         components = {\"facade\": {\"type\": \"cli\", \"technology\": \"none\", \"invocation\": None}}\n292:         check_command_backing(components, self.services(\"create_order\"), report)\n293:         self.assertEqual(rules(report), [])\n294: \n295:     def test_no_services_means_no_check(self):\n296:         report = Report(\"t\")\n297:         components = surface([command(\"order\", subcommands=[\"confirm\"])])\n298:         check_command_backing(components, [], report)\n299:         self.assertEqual(rules(report), [])\n300: \n301:     def test_an_extra_service_does_not_hide_a_missing_one(self):\n302:         report = Report(\"t\")\n303:         components = surface([command(\"invoice\", subcommands=[\"confirm\"])])\n304:         check_command_backing(components, self.services(\"cancel_order\"), report)\n305:         self.assertIn(\"unbacked_command\", rules(report))\n306: \n307: \n308: if __name__ == \"__main__\":\n309:     unittest.main()"

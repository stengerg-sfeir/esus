            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_adapters.py, lines 1-358\n1: \"\"\"Consistency checks for the interaction adapters.\n2: \n3: Each adapter maps an external action onto a domain service call, so every\n4: field it declares must resolve against service_contracts (service and method)\n5: and data_models (lookup entity).\n6: \"\"\"\n7: \n8: from dataclasses import dataclass, field\n9: \n10: from kernel.consistency.methods import collect_methods, is_missing, is_placeholder, param_names\n11: from kernel.consistency.naming import (\n12:     MATCH_NONE,\n13:     MATCH_VARIANT,\n14:     SUGGESTION_LIMIT,\n15:     match_known,\n16:     normalize,\n17:     suggest,\n18: )\n19: from kernel.consistency.report import with_suggestions\n20: \n21: TRANSFORMS = (\"DIRECT\", \"LOOKUP_ID\", \"DECIMAL_TO_CENTS\", \"ISO_DATE\", \"CSV_LIST\", \"ENUM_LOOKUP\")\n22: ADAPTER_AGGREGATION_THRESHOLD = 3\n23: LOOKUP_TRANSFORM = \"LOOKUP_ID\"\n24: \n25: # What a field's own name has to say for a transform to be right for it. A\n26: # transform describes how a value's *representation* changes, which no field\n27: # declares, so the only evidence is the name — this is therefore a name-based\n28: # rule like `missing_parameters`, and it is deliberately narrow: it judges only\n29: # the three transforms whose meaning implies a kind of value, and stays silent on\n30: # DIRECT, LOOKUP_ID and ENUM_LOOKUP. Measured on the corpus it finds eleven in\n31: # expenses (`name` transformed as a comma-separated list, `description` converted\n32: # to cents, `icon` as a list), one in inventory, one in gui (`stock_quantity` as a\n33: # list) and one in library (`copies` to cents).\n34: MONEY_FIELD_HINTS = (\n35:     \"price\", \"cost\", \"amount\", \"total\", \"cents\", \"balance\", \"salary\", \"budget\",\n36:     \"limit\", \"spend\", \"income\", \"value\", \"fee\", \"payment\", \"revenue\", \"subtotal\",\n37: )\n38: DATE_FIELD_HINTS = (\n39:     \"date\", \"day\", \"month\", \"year\", \"time\", \"timestamp\", \"due\", \"expiry\", \"expires\",\n40:     \"created\", \"updated\", \"start\", \"end\",\n41: )\n42: CSV_FIELD_HINTS = (\"list\", \"ids\", \"tags\", \"items\", \"fields\", \"columns\", \"values\", \"names\")\n43: \n44: \n45: @dataclass\n46: class ServiceIndex:\n47:     \"\"\"The declared service contracts, addressable by name and method.\"\"\"\n48: \n49:     declared: dict = field(default_factory=dict)\n50:     methods: dict = field(default_factory=dict)\n51: \n52:     @classmethod\n53:     def from_services(cls, services):\n54:         index = cls()\n55:         if not isinstance(services, list):\n56:             return index\n57:         for service in services:\n58:             if not isinstance(service, dict):\n59:                 continue\n60:             name = service.get(\"service_name\")\n61:             if is_missing(name):\n62:                 continue\n63:             key = normalize(name)\n64:             index.declared.setdefault(key, name)\n65:             collected = index.methods.setdefault(key, {})\n66:             for method in collect_methods(service):\n67:                 if method.get(\"name\"):\n68:                     collected.setdefault(normalize(method[\"name\"]), method)\n69:         return index\n70: \n71:     @property\n72:     def names(self):\n73:         return sorted(set(self.declared.values()))\n74: \n75:     def resolve(self, candidate):\n76:         \"\"\"Return (match_tier, declared_service_name_or_None).\"\"\"\n77:         return match_known(candidate, self.names, strip_roles=True)\n78: \n79:     def method(self, service_key, method_name):\n80:         return self.methods.get(service_key, {}).get(normalize(method_name))\n81: \n82:     def method_labels(self, service_key):\n83:         methods = self.methods.get(service_key, {})\n84:         return [method.get(\"name\") for method in methods.values() if method.get(\"name\")]\n85: \n86:     def label(self, service_key):\n87:         return self.declared.get(service_key, service_key)\n88: \n89:     def suggest(self, candidate, limit=SUGGESTION_LIMIT):\n90:         return suggest(candidate, self.names, limit)\n91: \n92:     def suggest_method(self, service_key, candidate, limit=SUGGESTION_LIMIT):\n93:         return suggest(candidate, self.method_labels(service_key), limit)\n94: \n95: \n96: def check_interaction_adapters(adapters, services, facts, report):\n97:     \"\"\"Validate every adapter against the services and entities it references.\"\"\"\n98:     if adapters is None:\n99:         return\n100:     if not adapters:\n101:         # A note, like data_models and service_contracts: a program whose data\n102:         # model is empty has nothing for an adapter to invoke, and an empty\n103:         # adapter list is the correct answer rather than a defect.\n104:         report.note(\"empty_section\", \"interaction_adapters: list is empty\")\n105:         return\n106: \n107:     service_index = ServiceIndex.from_services(services)\n108:     unresolved = []\n109:     checkable = 0\n110: \n111:     for adapter in adapters:\n112:         if not isinstance(adapter, dict):\n113:             report.error(\"invalid_value\", \"interaction_adapters: an entry is not an object\")\n114:             continue\n115: \n116:         action = adapter.get(\"action_name\")\n117:         if is_missing(action) or is_placeholder(action):\n118:             report.error(\"invalid_identifier\", \"interaction_adapters: an adapter has no action_name\")\n119:             continue\n120: \n121:         service_key, target_service = _resolve_target_service(adapter, action, service_index, report)\n122:         if not is_missing(target_service):\n123:             checkable += 1\n124:         if service_key is None and not is_missing(target_service):\n125:             unresolved.append((action, target_service))\n126: \n127:         method = _check_target_method(adapter, action, service_key, service_index, report)\n128:         _check_input_fields(adapter, action, method, facts, report)\n129: \n130:     _report_unresolved_targets(unresolved, checkable, service_index, report)\n131: \n132: \n133: def _resolve_target_service(adapter, action, service_index, report):\n134:     \"\"\"Return (normalized service key or None, raw target_service value).\"\"\"\n135:     target_service = adapter.get(\"target_service\")\n136:     if is_missing(target_service):\n137:         report.error(\"invalid_value\", f\"interaction_adapters: '{action}' has no target_service\")\n138:         return None, target_service\n139: \n140:     tier, resolved = service_index.resolve(target_service)\n141:     if tier is MATCH_NONE:\n142:         return None, target_service\n143: \n144:     if tier is MATCH_VARIANT:\n145:         report.warning(\n146:             \"name_variant\",\n147:             f\"interaction_adapters: '{action}' targets service '{target_service}' which is spelled \"\n148:             f\"'{resolved}' in service_contracts\",\n149:         )\n150:     return normalize(resolved), target_service\n151: \n152: \n153: def _check_target_method(adapter, action, service_key, service_index, report):\n154:     \"\"\"Validate target_method; return the resolved method object when known.\"\"\"\n155:     target_method = adapter.get(\"target_method\")\n156:     if is_missing(target_method):\n157:         report.error(\"invalid_value\", f\"interaction_adapters: '{action}' has no target_method\")\n158:         return None\n159:     if service_key is None:\n160:         return None\n161: \n162:     method = service_index.method(service_key, target_method)\n163:     if method is None:\n164:         report.warning(\n165:             \"unknown_reference\",\n166:             with_suggestions(\n167:                 f\"interaction_adapters: '{action}' targets method '{target_method}' which \"\n168:                 f\"{service_index.label(service_key)} does not declare\",\n169:                 service_index.suggest_method(service_key, target_method),\n170:             ),\n171:         )\n172:     return method\n173: \n174: \n175: def _check_input_fields(adapter, action, method, facts, report):\n176:     input_fields = adapter.get(\"input_fields\")\n177:     if not isinstance(input_fields, list):\n178:         report.error(\"invalid_value\", f\"interaction_adapters: '{action}' input_fields should be a list\")\n179:         return\n180:     # An action that takes no input legitimately declares an empty list.\n181:     declared_params = set(param_names(method)) if method else None\n182:     seen = set()\n183: \n184:     for field_entry in input_fields:\n185:         if not isinstance(field_entry, dict):\n186:             report.error(\"invalid_value\", f\"interaction_adapters: '{action}' has an input field that is not an object\")\n187:             continue\n188: \n189:         field_name = field_entry.get(\"field_name\")\n190:         if is_missing(field_name):\n191:             report.error(\n192:                 \"invalid_identifier\",\n193:                 f\"interaction_adapters: '{action}' has an input field with no field_name\",\n194:             )\n195:             continue\n196: \n197:         if normalize(field_name) in seen:\n198:             report.warning(\n199:                 \"duplicate_entry\",\n200:                 f\"interaction_adapters: '{action}' declares input field '{field_name}' more than once\",\n201:             )\n202:         seen.add(normalize(field_name))\n203: \n204:         _check_transform(field_entry, action, field_name, facts, report)\n205:         _check_transform_fits_the_field(field_entry, action, field_name, report)\n206:         _check_target_param(field_entry, action, field_name, declared_params, report)\n207: \n208:         required = field_entry.get(\"required\")\n209:         if not isinstance(required, bool):\n210:             report.error(\n211:                 \"invalid_value\",\n212:                 f\"interaction_adapters: '{action}.{field_name}' required should be a boolean, found {required!r}\",\n213:             )\n214: \n215: \n216: def _check_transform(field_entry, action, field_name, facts, report):\n217:     transform = field_entry.get(\"transform\")\n218:     if transform not in TRANSFORMS:\n219:         report.error(\n220:             \"unsupported_value\",\n221:             f\"interaction_adapters: '{action}.{field_name}' transform '{transform}' is not one of \"\n222:             f\"{', '.join(TRANSFORMS)}\",\n223:         )\n224: \n225:     lookup_entity = field_entry.get(\"lookup_entity\")\n226:     if transform == LOOKUP_TRANSFORM and is_missing(lookup_entity):\n227:         report.warning(\n228:             \"inconsistent_adapter\",\n229:             f\"interaction_adapters: '{action}.{field_name}' uses LOOKUP_ID but sets no lookup_entity\",\n230:         )\n231:         return\n232:     if transform != LOOKUP_TRANSFORM and not is_missing(lookup_entity):\n233:         report.warning(\n234:             \"inconsistent_adapter\",\n235:             f\"interaction_adapters: '{action}.{field_name}' sets lookup_entity '{lookup_entity}' but its \"\n236:             f\"transform is '{transform}'\",\n237:         )\n238:         return\n239:     if not is_missing(lookup_entity) and facts.entities.names:\n240:         tier, resolved = facts.entities.resolve(lookup_entity)\n241:         if tier is MATCH_NONE:\n242:             report.warning(\n243:                 \"unknown_reference\",\n244:                 with_suggestions(\n245:                     f\"interaction_adapters: '{action}.{field_name}' looks up unknown entity '{lookup_entity}'\",\n246:                     facts.entities.suggest(lookup_entity),\n247:                 ),\n248:             )\n249:         elif tier is MATCH_VARIANT:\n250:             report.warning(\n251:                 \"name_variant\",\n252:                 f\"interaction_adapters: '{action}.{field_name}' looks up '{lookup_entity}' which is spelled \"\n253:                 f\"'{resolved}' in data_models\",\n254:             )\n255: \n256: \n257: def _check_transform_fits_the_field(field_entry, action, field_name, report):\n258:     \"\"\"The transform must match the kind of value the field's name describes.\n259: \n260:     A transform is a claim about a value's representation, and the document never\n261:     records a field's representation — only its name and its type. So this is\n262:     judged on the name, and only for the three transforms that name a kind of\n263:     value. A count is not a money amount and a single name is not a list, which is\n264:     what the rule catches.\n265:     \"\"\"\n266:     transform = field_entry.get(\"transform\")\n267:     lowered = field_name.strip().lower()\n268:     if transform == \"DECIMAL_TO_CENTS\" and not _mentions(lowered, MONEY_FIELD_HINTS):\n269:         report.warning(\n270:             \"mismatched_transform\",\n271:             f\"interaction_adapters: '{action}.{field_name}' is converted with DECIMAL_TO_CENTS, \"\n272:             f\"which is for a money amount — the field's name does not describe one\",\n273:         )\n274:     elif transform == \"CSV_LIST\" and not _mentions(lowered, CSV_FIELD_HINTS):\n275:         report.warning(\n276:             \"mismatched_transform\",\n277:             f\"interaction_adapters: '{action}.{field_name}' is read as a comma-separated list, \"\n278:             f\"but the field's name describes one value\",\n279:         )\n280:     elif transform == \"ISO_DATE\" and not _mentions(lowered, DATE_FIELD_HINTS):\n281:         report.warning(\n282:             \"mismatched_transform\",\n283:             f\"interaction_adapters: '{action}.{field_name}' is parsed as a date, but the field's \"\n284:             f\"name describes something else\",\n285:         )\n286: \n287: \n288: def _mentions(name, hints):\n289:     return any(hint in name for hint in hints)\n290: \n291: \n292: def _check_target_param(field_entry, action, field_name, declared_params, report):\n293:     target_param = field_entry.get(\"target_param\")\n294:     if is_missing(target_param):\n295:         report.error(\"invalid_value\", f\"interaction_adapters: '{action}.{field_name}' has no target_param\")\n296:         return\n297:     if declared_params is None:\n298:         return\n299: \n300:     # A field whose own name is a parameter of the method belongs to that\n301:     # parameter, and the check needs no judgement: the method has already said\n302:     # where the value goes. Deciding otherwise silently drops the field —\n303:     # expenses' `add_expense` sends `category_id` into the `expense` object while\n304:     # the method declares a `category_id` of its own, and `update_budget` sends\n305:     # `month` into `budget` while a `month` parameter exists. Both were accepted\n306:     # because only \"is this a parameter at all\" was asked.\n307:     declared = {normalize(name) for name in declared_params}\n308:     if normalize(field_name) in declared and normalize(field_name) != normalize(target_param):\n309:         report.warning(\n310:             \"misplaced_field\",\n311:             f\"interaction_adapters: '{action}.{field_name}' maps to param '{target_param}', but the \"\n312:             f\"target method declares a param named '{field_name}' — the field belongs to that one\",\n313:         )\n314:         return\n315: \n316:     if target_param in declared_params:\n317:         return\n318: \n319:     tier, resolved = match_known(target_param, sorted(declared_params))\n320:     if tier is MATCH_VARIANT:\n321:         report.warning(\n322:             \"name_variant\",\n323:             f\"interaction_adapters: '{action}.{field_name}' maps to param '{target_param}' which the method \"\n324:             f\"spells '{resolved}'\",\n325:         )\n326:     else:\n327:         report.warning(\n328:             \"unknown_reference\",\n329:             with_suggestions(\n330:                 f\"interaction_adapters: '{action}.{field_name}' maps to param '{target_param}' which the \"\n331:                 f\"target method does not declare\",\n332:                 suggest(target_param, sorted(declared_params)),\n333:             ),\n334:         )\n335: \n336: \n337: def _report_unresolved_targets(unresolved, checkable, service_index, report):\n338:     if not unresolved:\n339:         return\n340: \n341:     targets = sorted({target for _, target in unresolved})\n342:     if len(unresolved) >= ADAPTER_AGGREGATION_THRESHOLD:\n343:         report.warning(\n344:             \"unresolved_adapter_target\",\n345:             f\"interaction_adapters: {len(unresolved)} of {checkable} adapters target a service that \"\n346:             f\"service_contracts does not declare ({', '.join(targets)}); service_contracts declares \"\n347:             f\"{', '.join(service_index.names) or 'nothing'} — steps E and G name services differently.\",\n348:         )\n349:         return\n350: \n351:     for action, target in unresolved:\n352:         report.warning(\n353:             \"unresolved_adapter_target\",\n354:             with_suggestions(\n355:                 f\"interaction_adapters: '{action}' targets unknown service '{target}'\",\n356:                 service_index.suggest(target),\n357:             ),\n358:         )"
              }
            ],
            "metadata": {
              "truncated": false
            }
          },

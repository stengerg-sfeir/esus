   if loan.return_date is not None:\n42:             raise errors.InvalidReturnDateError(\"Book already returned\")\n43:         book = self._repos['BookRepository'].read_one_book(loan.book_id)\n44:         loan.return_date = datetime.datetime.now()\n45:         loan.status = \"returned\"\n46:         updated_loan = self._repos['LoanRepository'].update_loan(loan_id, loan)\n47:         book.available_copies = (book.available_copies or 0) + 1\n48:         self._repos['BookRepository'].update_book(book.id, book)\n49:         return updated_loan'''\n50: \n51: BORROW = '''    def borrow_book(self, member_id: int = None, book_id: int = None) -> models.Loan:\n52:         \"\"\"Checks a copy is on the shelf, creates the loan, takes the copy.\"\"\"\n53:         member = self._repos['MemberRepository'].read_one_member(member_id)\n54:         book = self._repos['BookRepository'].read_one_book(book_id)\n55:         if (book.available_copies or 0) <= 0:\n56:             raise errors.InsufficientCopiesError(\"No available copies of this book\")\n57:         loan = models.Loan(\n58:             book_id=book.id,\n59:             member_id=member.id,\n60:             loan_date=datetime.datetime.now(),\n61:             due_date=datetime.datetime.now() + datetime.timedelta(days=14),  # loan period: not stated by the prompt\n62:             status=\"active\",\n63:         )\n64:         created = self._repos['LoanRepository'].create_loan(loan)\n65:         book.available_copies = (book.available_copies or 0) - 1\n66:         self._repos['BookRepository'].update_book(book.id, book)\n67:         return created'''\n68: \n69: \n70: def replace_method(text, name, block):\n71:     start = text.index(f\"    def {name}(\")\n72:     rest = text[start:]\n73:     stop = re.search(r\"\\n(?=    def |class |\\Z)\", rest)\n74:     end = start + (stop.start() if stop else len(rest))\n75:     return text[:start] + block + text[end:]\n76: \n77: \n78: repos_path = GEN / \"repositories.py\"\n79: services_path = GEN / \"services.py\"\n80: repos_text = repos_path.read_text(encoding=\"utf-8\")\n81: services_text = services_path.read_text(encoding=\"utf-8\")\n82: \n83: # Refuse to patch a tree that is not the reviewed run-4 state.\n84: assert \"record.author.name\" in repos_text, \\\n85:     \"repositories.py is not the reviewed run-4 body — stop and re-check\"\n86: assert \"# Increment available copies for the book\" in services_text, \\\n87:     \"services.py return_book is not the reviewed run-4 body — stop\"\n88: assert \"timedelta(days=14)\" in services_text, \\\n89:     \"services.py borrow_book is not the reviewed run-4 body — stop\"\n90: \n91: repos_path.write_text(replace_method(repos_text,\n92:                                      \"search_books_by_title_author_isbn\",\n93:                                      SEARCH), encoding=\"utf-8\")\n94: services_text = replace_method(services_text, \"return_book\", RETURN)\n95: services_text = replace_method(services_text, \"borrow_book\", BORROW)\n96: services_path.write_text(services_text, encoding=\"utf-8\")\n97: \n98: compile(repos_path.read_text(encoding=\"utf-8\"), \"repositories.py\", \"exec\")\n99: compile(services_path.read_text(encoding=\"utf-8\"), \"services.py\", \"exec\")\n100: print(\"patched: repositories.py search, services.py return_book + borrow_book\")\n101: \n102: with tempfile.TemporaryDirectory() as tmp:\n103:     work = Path(tmp) / \"generated\"\n104:     shutil.copytree(GEN, work, ignore=shutil.ignore_patterns(\"*.db\", \"__pycache__\"))\n105:     seed = (\n106:         \"import sys; sys.path.insert(0, '.')\\n\"\n107:         \"import store\\n\"\n108:         \"s = store.Store('smoke.db')\\n\"\n109:         \"s.add('Author', 'id', {'name': 'Ursula Le Guin'})\\n\"\n110:         \"s.add('Book', 'id', {'title': 'A Wizard of Earthsea',\"\n111:         \" 'isbn': '978-0', 'author_id': 1, 'published_year': 1968,\"\n112:         \" 'available_copies': 1})\\n\"\n113:         \"s.add('Member', 'id', {'name': 'Ada', 'email': 'ada@example.com',\"\n114:         \" 'membership_date': '2026-01-15', 'is_active': True})\\n\"\n115:         \"s.close()\\n\"\n116:     )\n117:     subprocess.run([sys.executable, \"-c\", seed], cwd=work, check=True)\n118: \n119:     def cli(*args):\n120:         proc = subprocess.run(\n121:             [sys.executable, \"cli.py\", \"--db\", \"smoke.db\", *args],\n122:             cwd=work, capture_output=True, text=True)\n123:         return proc.returncode, (proc.stdout + proc.stderr).strip()\n124: \n125:     code, out = cli(\"book\", \"search\", \"-query\", \"le guin\")\n126:     assert code == 0 and \"Earthsea\" in out, (code, out)\n127:     print(\"smoke: author-name search finds the book\")\n128:     code, out = cli(\"borrow\", \"--member-id\", \"1\", \"--book-id\", \"1\")\n129:     assert code == 0 and '\"due_date\"' in out, (code, out)\n130:     print(\"smoke: borrow returns the created loan\")\n131:     code, out = cli(\"return\", \"--loan-id\", \"1\")\n132:     assert code == 0 and '\"returned\"' in out, (code, out)\n133:     code, out = cli(\"return\", \"--loan-id\", \"1\")\n134:     assert code == 1 and \"already returned\" in out, (code, out)\n135:     print(\"smoke: return persists, a second return is refused\")\n136: print(\"done\")"

1:                 \"doc TEXT NOT NULL, PRIMARY KEY (entity, key))\")\n42:             self._load()\n43: \n44:     def _key(self, key):\n45:         \"\"\"A stable TEXT key: `1` and `\"1\"` stay distinct records.\"\"\"\n46:         return json.dumps(key, sort_keys=True)\n47: \n48:     def _load(self):\n49:         \"\"\"Restore records and id counters from the file, if any.\"\"\"\n50:         for entity, key, doc in self._db.execute(\n51:                 \"SELECT entity, key, doc FROM records\"):\n52:             self._records.setdefault(entity, {})[json.loads(key)] = json.loads(doc)\n53:         for entity, space in self._records.items():\n54:             ints = [key for key in space\n55:                     if isinstance(key, int) and not isinstance(key, bool)]\n56:             if ints:\n57:                 self._next_id[entity] = max(ints) + 1\n58: \n59:     def _persist(self, entity, key):\n60:         \"\"\"Write one record through (or its deletion) and commit.\"\"\"\n61:         if self._db is None:\n62:             return\n63:         if key not in self._records.get(entity, {}):\n64:             self._db.execute(\"DELETE FROM records WHERE entity = ? AND key = ?\",\n65:                              (entity, self._key(key)))\n66:         else:\n67:             self._db.execute(\n68:                 \"INSERT OR REPLACE INTO records (entity, key, doc) VALUES (?, ?, ?)\",\n69:                 (entity, self._key(key),\n70:                  json.dumps(self._records[entity][key], sort_keys=True)))\n71:         self._db.commit()\n72: \n73:     def close(self):\n74:         \"\"\"Flush and release the file, if any (commits already happened).\"\"\"\n75:         if self._db is not None:\n76:             self._db.commit()\n77:             self._db.close()\n78:             self._db = None\n79: \n80:     def _space(self, entity):\n81:         return self._records.setdefault(entity, {})\n82: \n83:     def add(self, entity, pk_name, values, check_fk=()):\n84:         \"\"\"Store a copy of `values`; assign an integer key when it is None.\"\"\"\n85:         space = self._space(entity)\n86:         record = dict(values)\n87:         key = record.get(pk_name)\n88:         if key is None:\n89:             key = self._next_id.get(entity, 1)\n90:             while key in space:\n91:                 key += 1\n92:             record[pk_name] = key\n93:             self._next_id[entity] = key + 1\n94:         elif key in space:\n95:             raise ValueError(f\"{entity} with {pk_name}={key!r} already exists\")\n96:         for field_name, target_entity, target_field, exc in check_fk:\n97:             self._check_fk(entity, record, field_name,\n98:                            target_entity, target_field, exc)\n99:         space[key] = record\n100:         self._persist(entity, key)\n101:         return dict(record)\n102: \n103:     def _check_fk(self, entity, record, field_name,\n104:                   target_entity, target_field, exc):\n105:         value = record.get(field_name)\n106:         if value is None:\n107:             return\n108:         for candidate in self._space(target_entity).values():\n109:             if candidate.get(target_field) == value:\n110:                 return\n111:         message = (f\"{entity}.{field_name}={value!r} references missing \"\n112:                    f\"{target_entity}.{target_field}\")\n113:         raise exc(message) if exc is not None else KeyError(message)\n114: \n115:     def get(self, entity, pk_name, key, error=None):\n116:         \"\"\"One record by key, or `error` (default `KeyError`).\"\"\"\n117:         try:\n118:             return dict(self._space(entity)[key])\n119:         except KeyError:\n120:             message = f\"{entity} with {pk_name}={key!r} not found\"\n121:             raise error(message) if error is not None else KeyError(message)\n122: \n123:     def all(self, entity):\n124:         \"\"\"Every record of an entity, in insertion order.\"\"\"\n125:         return [dict(re
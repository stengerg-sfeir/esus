              "newString": "def _complete_slots(pattern, slots):\n    \"\"\"True when every required slot is answered (COUNT needs no target).\"\"\"\n    required = SLOT_REQUIREMENTS.get(pattern, ())\n    if pattern.startswith(\"AGGREGATE\") and slots.get(\"aggregate_func\") == \"COUNT\":\n        required = tuple(slot for slot in required if slot != \"target_field\")\n    return all(slots.get(slot) not in (None, \"\") for slot in required)\n\n\ndef _slots_usable(pattern, slots, method):\n    \"\"\"True when recorded slots are well-formed enough to emit from.\n\n    Completeness is not enough: a hand-written record could name an unknown\n    func or a threshold that is neither `today` nor a parameter, and the\n    emitter would write a body that fails at runtime. Anything off here is\n    a stub, exactly as if the question were still open.\n    \"\"\"\n    if not _complete_slots(pattern, slots):\n        return False\n    if not all(isinstance(slots.get(slot), str)\n               for slot in SLOT_REQUIREMENTS.get(pattern, ())):\n        return False\n    params = {p.get(\"name\") for p in method.get(\"params\") or []\n              if isinstance(p, dict) and isinstance(p.get(\"name\"), str)}\n    if pattern.startswith(\"AGGREGATE\"):\n        if slots.get(\"aggregate_func\") not in (\"SUM\", \"COUNT\", \"AVG\", \"MIN\", \"MAX\"):\n            return False\n        if slots.get(\"fk_field\") and not any(\n                normalize(slots[\"fk_field\"]) == normalize(name) for name in params):\n            # An fk slice without a feeding parameter filters nothing: the\n            # slot names a field no argument supplies.\n            if pattern == \"AGGREGATE_BY_FK_AND_DATE\" or slots.get(\"fk_field\"):\n                pass\n        return True\n    if pattern == \"THRESHOLD_SCAN\":\n        if slots.get(\"operator\") not in (\"<\", \"<=\", \">\", \">=\", \"=\"):\n            return False\n        threshold = slots.get(\"threshold\")\n        return threshold == \"today\" or threshold in params\n    return True",

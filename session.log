            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_models.py, lines 1-167\n1: \"\"\"Consistency checks for the extracted data models.\n2: \n3: Covers field-level defects (duplicate or unnamed fields, missing or nullable\n4: primary keys) and foreign keys, which are the only cross-entity references\n5: inside data_models.json.\n6: \"\"\"\n7: \n8: from kernel.consistency.methods import is_missing\n9: from kernel.consistency.naming import EntityIndex, MATCH_NONE, MATCH_VARIANT\n10: from kernel.consistency.report import with_suggestions\n11: \n12: RELATIONSHIPS = (\"many_to_one\", \"one_to_one\", \"one_to_many\")\n13: \n14: \n15: def check_data_models(models, report):\n16:     \"\"\"Validate data_models and return the EntityIndex built from it.\"\"\"\n17:     index = EntityIndex.from_models(models)\n18:     if models is None:\n19:         return index\n20:     if not models:\n21:         # A note, not an error: the checker cannot see the requirements, so it\n22:         # cannot tell \"this program has no records\" from \"the step failed\". The\n23:         # contradictory case — persistence required but nothing named to\n24:         # persist — is caught in checks_components, which can see both fields.\n25:         report.note(\"empty_section\", \"data_models: list is empty\")\n26:         return index\n27: \n28:     seen = {}\n29:     for model in models:\n30:         if not isinstance(model, dict):\n31:             report.error(\"invalid_value\", \"data_models: an entry is not an object\")\n32:             continue\n33:         name = model.get(\"name\")\n34:         if is_missing(name):\n35:             report.error(\"invalid_identifier\", \"data_models: a model has no name\")\n36:             continue\n37:         key = name.strip().lower()\n38:         if key in seen:\n39:             report.error(\"duplicate_entry\", f\"data_models: duplicate model name '{name}'\")\n40:             continue\n41:         seen[key] = name\n42:         _check_model(model, name, index, report)\n43: \n44:     return index\n45: \n46: \n47: def _check_model(model, name, index, report):\n48:     fields = model.get(\"fields\")\n49:     if not isinstance(fields, list):\n50:         report.error(\"invalid_value\", f\"data_models: model '{name}' has no fields list\")\n51:         return\n52:     if not fields:\n53:         report.warning(\"empty_section\", f\"data_models: model '{name}' has no fields\")\n54: \n55:     field_names, primary_keys, fields_by_name = _collect_fields(fields, name, report)\n56: \n57:     seen = {}\n58:     for field_name in field_names:\n59:         key = field_name.strip().lower()\n60:         if key in seen:\n61:             report.error(\n62:                 \"duplicate_entry\",\n63:                 f\"data_models: model '{name}' declares field '{field_name}' more than once\",\n64:             )\n65:         seen[key] = field_name\n66: \n67:     _check_primary_keys(name, primary_keys, fields_by_name, report)\n68:     _check_foreign_keys(name, fields_by_name, index, report)\n69: \n70: \n71: def _collect_fields(fields, model_name, report):\n72:     field_names = []\n73:     primary_keys = []\n74:     fields_by_name = {}\n75: \n76:     for item in fields:\n77:         if not isinstance(item, dict):\n78:             report.error(\"invalid_value\", f\"data_models: model '{model_name}' has a field that is not an object\")\n79:             continue\n80:         field_name = item.get(\"name\")\n81:         if is_missing(field_name):\n82:             report.error(\"invalid_identifier\", f\"data_models: model '{model_name}' has a field with no name\")\n83:             continue\n84:         field_names.append(field_name)\n85:         fields_by_name[field_name] = item\n86:         if item.get(\"primary_key\"):\n87:             primary_keys.append(field_name)\n88: \n89:     return field_names, primary_keys, fields_by_name\n90: \n91: \n92: def _check_primary_keys(model_name, primary_keys, fields_by_name, report):\n93:     if not primary_keys:\n94:         report.warning(\"missing_primary_key\", f\"data_models: model '{model_name}' declares no primary key\")\n95:         return\n96:     for key in primary_keys:\n97:         field = fields_by_name.get(key, {})\n98:         if field.get(\"nullable\"):\n99:             report.warning(\n100:                 \"nullable_primary_key\",\n101:                 f\"data_models: {model_name}.{key} is a primary key but nullable=true\",\n102:             )\n103:         if field.get(\"unique\") is False:\n104:             # A primary key is unique by definition, so the two flags contradict\n105:             # each other. `unique` was never read anywhere in this package, so\n106:             # the value was free to be wrong on every model.\n107:             report.warning(\n108:                 \"non_unique_primary_key\",\n109:                 f\"data_models: {model_name}.{key} is a primary key but unique=false\",\n110:             )\n111: \n112: \n113: def _check_foreign_keys(model_name, fields_by_name, index, report):\n114:     for field_name, field in fields_by_name.items():\n115:         foreign_key = field.get(\"foreign_key\")\n116:         if not isinstance(foreign_key, dict):\n117:             continue\n118: \n119:         target = foreign_key.get(\"target_entity\")\n120:         if is_missing(target):\n121:             report.error(\n122:                 \"invalid_value\",\n123:                 f\"data_models: {model_name}.{field_name} has a foreign_key with no target_entity\",\n124:             )\n125:             continue\n126: \n127:         tier, resolved = index.resolve(target)\n128:         if tier is MATCH_NONE and index.names:\n129:             report.warning(\n130:                 \"unknown_reference\",\n131:                 with_suggestions(\n132:                     f\"data_models: {model_name}.{field_name} FK targets unknown entity '{target}'\",\n133:                     index.suggest(target),\n134:                 ),\n135:             )\n136:             continue\n137:         if tier is MATCH_VARIANT:\n138:             report.warning(\n139:                 \"name_variant\",\n140:                 f\"data_models: {model_name}.{field_name} FK target '{target}' is spelled \"\n141:                 f\"'{resolved}' elsewhere\",\n142:             )\n143: \n144:         _check_foreign_key_target_field(model_name, field_name, foreign_key, resolved or target, index, report)\n145: \n146:         relationship = foreign_key.get(\"relationship\")\n147:         if relationship not in RELATIONSHIPS:\n148:             report.error(\n149:                 \"unsupported_value\",\n150:                 f\"data_models: {model_name}.{field_name} FK relationship '{relationship}' \"\n151:                 f\"is not one of {', '.join(RELATIONSHIPS)}\",\n152:             )\n153: \n154: \n155: def _check_foreign_key_target_field(model_name, field_name, foreign_key, target_entity, index, report):\n156:     target_field = foreign_key.get(\"target_field\")\n157:     if is_missing(target_field):\n158:         report.error(\"invalid_value\", f\"data_models: {model_name}.{field_name} FK has no target_field\")\n159:     elif target_field not in index.fields_of(target_entity):\n160:         report.warning(\n161:             \"unknown_reference\",\n162:             with_suggestions(\n163:                 f\"data_models: {model_name}.{field_name} FK targets field '{target_field}' \"\n164:                 f\"which {target_entity} does not declare\",\n165:                 index.suggest_field(target_entity, target_field),\n166:             ),\n167:         )"
              }

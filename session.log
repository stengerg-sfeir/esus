                "type": "text",
                "text": "Read file /home/gstenger/Documents/esus/kernel/extraction/decisions.py, lines 1-126\n1: \"\"\"User-recorded answers to near-tied classifications.\n2: \n3: `review_ties.py` asks about the ties `kernel.tie_rules` cannot resolve and\n4: stores each answer here, in the output directory beside the documents. The\n5: extractor re-applies them after classification on every run, so a human\n6: decision survives reruns and the JSON stays stable; the review also patches\n7: the on-disk document, so the current output is fixed without a rerun.\n8: \n9: A decision record carries the classified text (the exact match key), the\n10: chosen pattern id, and the candidates it was chosen from, so a stale answer —\n11: for a text no run produces any more — is visible rather than silently applied.\n12: It also carries the sha of the requirements it was decided under: answers are\n13: only re-applied while the prompt is unchanged, because a reworded prompt can\n14: move the meaning a text had. A record predating a prompt change is dropped\n15: with a log line — the tie reopens and is re-asked — while records from before\n16: hashes existed keep applying, having nothing to compare against.\n17: \"\"\"\n18: \n19: import hashlib\n20: import json\n21: from pathlib import Path\n22: \n23: DECISIONS_NAME = \"decisions.json\"\n24: DECISIONS_KEY = \"decisions\"\n25: DECIDED = \"decided\"\n26: DECIDED_BY_USER = \"user\"\n27: \n28: \n29: def load_decisions(output_dir):\n30:     \"\"\"The recorded decisions, or [] when there are none or the file is unusable.\"\"\"\n31:     try:\n32:         payload = json.loads((Path(output_dir) / DECISIONS_NAME).read_text(encoding=\"utf-8\"))\n33:     except (OSError, ValueError):\n34:         return []\n35:     if not isinstance(payload, dict):\n36:         return []\n37:     records = payload.get(DECISIONS_KEY)\n38:     return [item for item in records] if isinstance(records, list) else []\n39: \n40: \n41: def save_decisions(output_dir, decisions):\n42:     \"\"\"Write the decision records beside the documents.\"\"\"\n43:     path = Path(output_dir) / DECISIONS_NAME\n44:     path.write_text(\n45:         json.dumps({DECISIONS_KEY: decisions}, indent=2, ensure_ascii=False) + \"\\n\",\n46:         encoding=\"utf-8\",\n47:     )\n48:     return path\n49: \n50: \n51: def requirements_sha(requirements_text):\n52:     \"\"\"The sha256 of a run's requirements, whitespace-normalized.\n53: \n54:     Both sides normalize: `extract_arch.py` strips stdin but not the archived\n55:     file, and the review reads the archived file — without this they would\n56:     never agree.\n57:     \"\"\"\n58:     if not isinstance(requirements_text, str):\n59:         return None\n60:     return hashlib.sha256(requirements_text.strip().encode(\"utf-8\")).hexdigest()\n61: \n62: \n63: def apply_decisions(matches, decisions, log=None, requirements_text=None):\n64:     \"\"\"Point every match whose text was decided at the chosen pattern.\n65: \n66:     Returns a new list; unmatched entries and non-dicts pass through untouched,\n67:     so applying an empty or stale record set is the identity. Each patched\n68:     entry keeps its alternatives and gains `decision: decided` with\n69:     `decided_by: user`, which is what stops the review from asking again.\n70:     When `requirements_text` is given, a record stamped with a different\n71:     prompt sha is dropped with a log line instead of applied: the tie reopens\n72:     and the review asks again under the new prompt.\n73: \n74:     A decision that *overrides* the recorded winner rewrites the whole\n75:     verdict, not just the winner's name: the rejected side becomes the\n76:     runner-up, and the margin and stage go, because a softmax gap against the\n77:     rejected pattern cannot decide anything once a human has. Leaving the old\n78:     runner-up in place would record the winner against itself — the exact\n79:     `invalid_value` the checker reports. Keeping the recorded winner only\n80:     stamps the flags; the entry is already coherent.\n81:     \"\"\"\n82:     if not isinstance(matches, list):\n83:         return matches\n84:     current = requirements_sha(requirements_text) if requirements_text else None\n85:     chosen = {}\n86:     for record in decisions or []:\n87:         if not (isinstance(record, dict)\n88:                 and isinstance(record.get(\"text\"), str)\n89:                 and isinstance(record.get(\"chosen_pattern_id\"), str)):\n90:             continue\n91:         stamped = record.get(\"requirements_sha\")\n92:         if (current is not None and isinstance(stamped, str)\n93:                 and stamped != current):\n94:             if log is not None:\n95:                 log.write(\n96:                     f\"[!] step patterns: decision for '{record['text'][:60]}' \"\n97:                     f\"predates a prompt change — dropped, will be re-asked\"\n98:                 )\n99:             continue\n100:         chosen[record[\"text\"]] = record[\"chosen_pattern_id\"]\n101:     if not chosen:\n102:         return matches\n103:     applied = 0\n104:     patched = []\n105:     for entry in matches:\n106:         if (\n107:             isinstance(entry, dict)\n108:             and isinstance(entry.get(\"text\"), str)\n109:             and entry.get(\"text\") in chosen\n110:         ):\n111:             winner = chosen[entry[\"text\"]]\n112:             update = {\"pattern_id\": winner,\n113:                       \"decision\": DECIDED, \"decided_by\": DECIDED_BY_USER,\n114:                       \"undecided_stage\": None}\n115:             if winner != entry.get(\"pattern_id\"):\n116:                 # Overridden: the recorded winner is the rejected side now.\n117:                 update[\"runner_up_pattern_id\"] = entry.get(\"pattern_id\")\n118:                 update[\"runner_up_confidence\"] = entry.get(\"confidence\")\n119:                 update[\"margin\"] = None\n120:             patched.append({**entry, **update})\n121:             applied += 1\n122:         else:\n123:             patched.append(entry)\n124:     if applied and log is not None:\n125:         log.write(f\"[ok] step patterns: applied {applied} recorded user decision(s)\")\n126:     return patched"
              }

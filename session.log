          "state": {
            "status": "completed",
            "input": {
              "newString": "# --------------------------------------------------------------------------\n# slotted patterns (human-answered slots -> mechanical bodies)\n# --------------------------------------------------------------------------\n\n# Required slots per pattern, from the kernel catalogues. COUNT needs no\n# target (it counts rows); everything else does.\nSLOT_REQUIREMENTS = {\n    \"AGGREGATE_BY_FK\": (\"fk_field\", \"target_field\", \"aggregate_func\"),\n    \"AGGREGATE_BY_FK_AND_DATE\": (\"fk_field\", \"date_field\", \"target_field\",\n                                 \"aggregate_func\"),\n    \"THRESHOLD_SCAN\": (\"comparison_field\", \"operator\", \"threshold\"),\n}\n\n\ndef _slot_pattern(ctx, holder, method):\n    \"\"\"The slottable pattern id for a method, or None (with its slots).\"\"\"\n    entry = _match_entry(ctx, holder, method.get(\"name\"))\n    if not isinstance(entry, dict):\n        return None, {}\n    kind, payload = tie_rules.effective_directive(entry)\n    if kind != \"pattern\" or payload not in SLOT_PATTERNS:\n        return None, {}\n    record = ctx.get(\"slots\", {}).get((holder, method.get(\"name\")))\n    if not isinstance(record, dict) or not isinstance(record.get(\"slots\"), dict):\n        return payload, {}\n    return payload, record[\"slots\"]\n\n\ndef _complete_slots(pattern, slots):\n    \"\"\"True when every required slot is answered (COUNT needs no target).\"\"\"\n    required = SLOT_REQUIREMENTS.get(pattern, ())\n    if pattern.startswith(\"AGGREGATE\") and slots.get(\"aggregate_func\") == \"COUNT\":\n        required = tuple(slot for slot in required if slot != \"target_field\")\n    return all(slots.get(slot) not in (None, \"\") for slot in required)\n\n\ndef _slot_fk_param(method, fk_field):\n    \"\"\"The parameter feeding the fk filter, or None when the method takes none.\"\"\"\n    if not fk_field:\n        return None\n    for param in method.get(\"params\") or []:\n        if isinstance(param, dict) and normalize(param.get(\"name\") or \"\") == normalize(fk_field):\n            return param.get(\"name\")\n    return None\n\n\ndef _slot_date_role(method):\n    \"\"\"`range`, `prefix:<param>` or None: how the signature carries dates.\"\"\"\n    names = [normalize(p.get(\"name\") or \"\") for p in method.get(\"params\") or []\n             if isinstance(p, dict)]\n    canon = [[c for c in codegen.canon_tokens(name)] for name in names]\n    flat = [\" \".join(tokens) for tokens in canon]\n    has_start = any(tokens[:1] == [\"start\"] for tokens in canon)\n    has_end = any(tokens[:1] == [\"end\"] for tokens in canon)\n    if has_start and has_end:\n        return \"range\"\n    for name in names:\n        if name in (\"month\", \"year\"):\n            return f\"prefix:{name}\"\n    _ = flat\n    return None\n\n\ndef _repo_slot_body(ctx, entity, model_cls, field_names, method, pattern, slots):\n    \"\"\"An aggregate or threshold body from answered slots; None if unusable.\"\"\"\n    fname = method.get(\"name\") if isinstance(method.get(\"name\"), str) else \"?\"\n    if pattern.startswith(\"AGGREGATE\"):\n        return _repo_aggregate_body(entity, model_cls, field_names, method,\n                                    fname, slots)\n    return _repo_threshold_body(entity, model_cls, field_names, method,\n                                fname, slots)\n\n\ndef _repo_aggregate_body(entity, model_cls, field_names, method, fname, slots):\n    \"\"\"SUM/COUNT/AVG/MIN/MAX over records matching the fk and date slices.\"\"\"\n    func = slots.get(\"aggregate_func\")\n    target = slots.get(\"target_field\")\n    fk_param = _slot_fk_param(method, slots.get(\"fk_field\"))\n    date_role = _slot_date_role(method)\n    date_field = slots.get(\"date_field\")\n    header = (f\"{func}({target})\" if func != \"COUNT\" else \"COUNT\") \\\n        + f\" over {entity} matching \" \\\n        + \", \".join(part for part in (\n            f\"{slots.get('fk_field')}={fk_param}\" if fk_param else None,\n            f\"{date_field} in {date_role}\" if date_role and date_field else None,\n        ) if part) or \"all records\"\n    lines = []\n    if func == \"COUNT\":\n        lines.append(\"count = 0\")\n    elif func == \"AVG\":\n        lines += [\"total = 0\", \"count = 0\"]\n    elif func in (\"MIN\", \"MAX\"):\n        lines.append(\"best = None\")\n    else:\n        lines.append(\"total = 0\")\n    lines.append(f\"for record in self._store.select(self.ENTITY, []):\")\n    if fk_param:\n        lines.append(f\"    if {fk_param} is not None and \"\n                     f\"record.get({slots['fk_field']!r}) != {fk_param}:\")\n        lines.append(f\"        continue\")\n    if date_role == \"range\" and date_field:\n        lines.append(f\"    if start_date is not None and \"\n                     f\"str(record.get({date_field!r}) or '') < str(start_date):\")\n        lines.append(f\"        continue\")\n        lines.append(f\"    if end_date is not None and \"\n                     f\"str(record.get({date_field!r}) or '') > str(end_date):\")\n        lines.append(f\"        continue\")\n    elif date_role and date_role.startswith(\"prefix:\") and date_field:\n        param = date_role.split(\":\", 1)[1]\n        lines.append(f\"    if {param} is not None and not \"\n                     f\"str(record.get({date_field!r}) or '').startswith(str({param})):\")\n        lines.append(f\"        continue\")\n    if func == \"COUNT\":\n        lines.append(\"    count += 1\")\n    elif func == \"AVG\":\n        lines.append(f\"    total += record.get({target!r}) or 0\")\n        lines.append(\"    count += 1\")\n    elif func == \"MIN\":\n        lines.append(f\"    value = record.get({target!r})\")\n        lines.append(\"    best = value if best is None or (value is not None and value < best) else best\")\n    elif func == \"MAX\":\n        lines.append(f\"    value = record.get({target!r})\")\n        lines.append(\"    best = value if best is None or (value is not None and value > best) else best\")\n    else:\n        lines.append(f\"    total += record.get({target!r}) or 0\")\n    if func == \"COUNT\":\n        lines.append(\"return count\")\n    elif func == \"AVG\":\n        lines.append(\"return (total / count) if count else 0\")\n    elif func in (\"MIN\", \"MAX\"):\n        lines.append(\"return best\")\n    else:\n        lines.append(\"return total\")\n    lines[0:0] = [f'\"\"\"{header} [{func}]\"\"\"']\n    return lines\n\n\ndef _repo_threshold_body(entity, model_cls, field_names, method, fname, slots):\n    \"\"\"Records whose field crosses the threshold: param, literal or today.\"\"\"\n    field = slots.get(\"comparison_field\")\n    operator = slots.get(\"operator\")\n    threshold = slots.get(\"threshold\")\n    ops = {\"<\": \"<\", \"<=\": \"<=\", \">\": \">\", \">=\": \">=\", \"=\": \"==\"}\n    symbol = ops.get(operator, \"<\")\n    lines = []\n    if threshold == \"today\":\n        lines.append(\"bound = datetime.date.today().isoformat()\")\n    elif any(isinstance(p, dict) and p.get(\"name\") == threshold\n             for p in method.get(\"params\") or []):\n        lines.append(f\"bound = {codegen.sanitize(threshold, 'param')}\")\n    else:\n        lines.append(f\"bound = {threshold!r}\")\n    lines.append(\"out = []\")\n    lines.append(f\"for record in self._store.select(self.ENTITY, []):\")\n    lines.append(f\"    key = str(record.get({field!r}) or '')[:10]\")\n    lines.append(f\"    if isinstance(bound, str):\")\n    lines.append(f\"        hit = key {symbol} bound[:10]\")\n    lines.append(f\"    else:\")\n    lines.append(f\"        hit = record.get({field!r}) is not None and \"\n                 f\"record.get({field!r}) {symbol} bound\")\n    lines.append(f\"    if hit:\")\n    lines.append(f\"        record_out = record\")\n    if model_cls is None:\n        lines.append(f\"        out.append(dict(record_out))\")\n    else:\n        lines.append(f\"        out.append({model_cls}(**record_out))\")\n    lines.append(\"return out\")\n    lines[0:0] = [f'\"\"\"{entity} where {field} {operator} {threshold} [THRESHOLD_SCAN]\"\"\"']\n    return lines",
              "oldString": "# --------------------------------------------------------------------------\n# CLI verbs -> adapters (one scoring rule, baked into cli.py with its scores)\n# --------------------------------------------------------------------------",

ipeline.runner, \"generate\", self._real_generate))\n179:         return calls\n180: \n181:     def test_the_retry_asks_for_the_room_the_prompt_left(self):\n182:         pipeline_ = self.pipeline_with(context=8192, prompt_tokens=1600)\n183:         calls = self.stub(\n184:             result('{\"widgets\": [1]}', truncated=True),\n185:             result('{\"widgets\": [1, 2, 3]}'),\n186:         )\n187:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n188:         self.assertIsNone(calls[0], \"the first attempt uses the default ceiling\")\n189:         # 8192 context - 1600 prompt tokens - 64 reserve\n190:         self.assertEqual(calls[1], 6528, \"the retry must be given the whole remaining context\")\n191: \n192:     def test_the_log_names_both_ceilings(self):\n193:         pipeline_ = self.pipeline_with()\n194:         self.stub(\n195:             result('{\"widgets\": [1]}', truncated=True, budget=3584),\n196:             result('{\"widgets\": [1, 2]}'),\n197:         )\n198:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n199:         logged = self.log.joined()\n200:         self.assertIn(\"3584-token ceiling\", logged, \"the attempt's ceiling is the diagnosis\")\n201:         self.assertIn(\"6528-token ceiling\", logged, \"the retry's ceiling is stated\")\n202: \n203:     def test_an_unparseable_attempt_does_not_raise_the_ceiling(self):\n204:         \"\"\"Only a truncation is a ceiling problem; a JSON failure is not.\"\"\"\n205:         pipeline_ = self.pipeline_with()\n206:         calls = self.stub(result(\"not json\"), result('{\"widgets\": [7]}'))\n207:         pipeline_._generate(\"widgets\", \"prompt\", \"grammar\")\n208:         self.assertEqual(calls, [None, None], \"a parse failure keeps the default ceiling\")\n209: \n210:     def test_a_context_with_no_room_left_says_so(self):\n211:         \"\"\"The honest case: the ceiling cannot be raised, so the log says that.\"\"\"\n212:         pipeline_ = self.pipeline_wi
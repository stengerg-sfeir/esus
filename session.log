                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/aliases.py, lines 1-164\n1: \"\"\"Human-asserted field mappings: `{action, field}` means `{flag}`.\n2: \n3: Some adapter fields no rule can map: `file_path` where the leaf offers\n4: `--output`, `copies` where the model declares `available_copies`. No\n5: containment, no shared spelling — only the requirements author knows they\n6: name one value. The review (`review_aliases.py`) asks about exactly those\n7: pairs, and the answer persists here beside the documents.\n8: \n9: Application is a rename, not a ruling: the adapter field takes the flag's\n10: spelling while its target parameter stays put (`file_path` becomes `output`\n11: into `file_path`). Everything downstream — the probe's uncovered and\n12: unknown-field rules, the generator's flag binding — then judges the renamed\n13: adapter with no special cases. A record whose action or field a run no\n14: longer produces is skipped visibly, never applied blindly.\n15: \n16: Like pattern decisions, each record carries the prompt sha it was decided\n17: under and is only re-applied while the prompt stands; a record predating a\n18: prompt change is dropped with a log line and its pair reopens for review.\n19: \"\"\"\n20: \n21: import json\n22: from pathlib import Path\n23: \n24: from kernel.extraction.decisions import requirements_sha\n25: \n26: ALIASES_NAME = \"field_aliases.json\"\n27: ALIASES_KEY = \"aliases\"\n28: DECIDED_BY_USER = \"user\"\n29: \n30: \n31: def load_aliases(output_dir):\n32:     \"\"\"The recorded mappings, or [] when there are none or the file is unusable.\"\"\"\n33:     try:\n34:         payload = json.loads((Path(output_dir) / ALIASES_NAME).read_text(encoding=\"utf-8\"))\n35:     except (OSError, ValueError):\n36:         return []\n37:     if not isinstance(payload, dict):\n38:         return []\n39:     records = payload.get(ALIASES_KEY)\n40:     return [item for item in records] if isinstance(records, list) else []\n41: \n42: \n43: def save_aliases(output_dir, aliases):\n44:     \"\"\"Write the mapping records beside the documents.\"\"\"\n45:     path = Path(output_dir) / ALIASES_NAME\n46:     path.write_text(\n47:         json.dumps({ALIASES_KEY: aliases}, indent=2, ensure_ascii=False) + \"\\n\",\n48:         encoding=\"utf-8\",\n49:     )\n50:     return path\n51: \n52: \n53: def apply_aliases(adapters, aliases, log=None, requirements_text=None):\n54:     \"\"\"Rename recorded fields to their asserted flag spellings.\n55: \n56:     Returns the adapters (mutated in place, like the other repairs): every\n57:     `{action, field}` the run still produces and whose prompt still stands\n58:     takes the recorded flag name. Stale pairs and predated prompts are\n59:     skipped with a log line each — an approval for vanished words applies to\n60:     nothing.\n61:     \"\"\"\n62:     if not isinstance(adapters, list):\n63:         return adapters\n64:     current = requirements_sha(requirements_text) if requirements_text else None\n65:     applied = 0\n66:     for record in aliases or []:\n67:         if not (isinstance(record, dict)\n68:                 and isinstance(record.get(\"action\"), str)\n69:                 and isinstance(record.get(\"field\"), str)\n70:                 and isinstance(record.get(\"flag\"), str)):\n71:             continue\n72:         stamped = record.get(\"requirements_sha\")\n73:         if (current is not None and isinstance(stamped, str)\n74:                 and stamped != current):\n75:             if log is not None:\n76:                 log.write(\n77:                     f\"[!] step adapters: alias {record['action']}.{record['field']} \"\n78:                     f\"predates a prompt change — dropped, will be re-asked\"\n79:                 )\n80:             continue\n81:         if isinstance(record.get(\"create\"), dict):\n82:             # A creation record asserts a model field, not a rename: the\n83:             # adapter field keeps its name by design, and apply_model_fields\n84:             # owns the model side. Routing it through the rename below would\n85:             # report a collision against itself.\n86:             continue\n87:         for adapter in adapters:\n88:             if not (isinstance(adapter, dict)\n89:                     and adapter.get(\"action_name\") == record[\"action\"]):\n90:                 continue\n91:             fields = [f for f in adapter.get(\"input_fields\") or []\n92:                       if isinstance(f, dict)]\n93:             target = next((f for f in fields\n94:                            if f.get(\"field_name\") == record[\"field\"]), None)\n95:             if target is None:\n96:                 continue\n97:             if record[\"field\"] == record[\"flag\"]:\n98:                 continue\n99:             if any(f is not target and f.get(\"field_name\") == record[\"flag\"]\n100:                    for f in fields):\n101:                 if log is not None:\n102:                     log.write(\n103:                         f\"[!] step adapters: alias {record['action']}.{record['field']} \"\n104:                         f\"collides with an existing '{record['flag']}' — skipped\"\n105:                     )\n106:                 continue\n107:             target[\"field_name\"] = record[\"flag\"]\n108:             applied += 1\n109:     if applied and log is not None:\n110:         log.write(f\"[ok] step adapters: applied {applied} recorded field alias(es)\")\n111:     return adapters\n112: \n113: \n114: def apply_model_fields(models, aliases, log=None, requirements_text=None):\n115:     \"\"\"Ensure every reviewed-created field exists on its model.\n116: \n117:     The review writes the field immediately; reruns regenerate the model\n118:     from requirements and would drop it, so each run re-applies the\n119:     recorded creations first. Entries without a `create` spec, stale\n120:     entities, present fields and predated prompts are skipped — creation\n121:     answers once, it does not insist.\n122:     \"\"\"\n123:     if not isinstance(models, list):\n124:         return models\n125:     current = requirements_sha(requirements_text) if requirements_text else None\n126:     applied = 0\n127:     for record in aliases or []:\n128:         if not isinstance(record, dict):\n129:             continue\n130:         spec = record.get(\"create\")\n131:         if not isinstance(spec, dict):\n132:             continue\n133:         stamped = record.get(\"requirements_sha\")\n134:         if (current is not None and isinstance(stamped, str)\n135:                 and stamped != current):\n136:             if log is not None:\n137:                 log.write(\n138:                     f\"[!] step data_models: created field \"\n139:                     f\"{spec.get('entity')}.{spec.get('name')} \"\n140:                     f\"predates a prompt change — dropped, will be re-asked\"\n141:                 )\n142:             continue\n143:         for model in models:\n144:             if not (isinstance(model, dict) and model.get(\"name\") == spec.get(\"entity\")):\n145:                 continue\n146:             fields = model.get(\"fields\")\n147:             if not isinstance(fields, list):\n148:                 continue\n149:             if any(isinstance(f, dict) and f.get(\"name\") == spec.get(\"name\")\n150:                    for f in fields):\n151:                 continue\n152:             fields.append({\n153:                 \"name\": spec.get(\"name\"),\n154:                 \"type\": spec.get(\"type\"),\n155:                 \"primary_key\": False,\n156:                 \"nullable\": bool(spec.get(\"nullable\", True)),\n157:                 \"unique\": bool(spec.get(\"unique\", False)),\n158:                 \"foreign_key\": spec.get(\"foreign_key\"),\n159:                 \"status\": \"deduced\",\n160:             })\n161:             applied += 1\n162:     if applied and log is not None:\n163:         log.write(f\"[ok] step data_models: applied {applied} recorded created field(s)\")\n164:     return models"
              }

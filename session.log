            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/methods.py, lines 1-141\n1: \"\"\"Method and parameter checks shared by service contracts and repositories.\n2: \n3: Both documents carry the same shape (a list of methods, each with named and\n4: typed parameters), so the same contract is enforced in one place.\n5: \"\"\"\n6: \n7: import re\n8: \n9: from kernel.consistency.naming import normalize\n10: \n11: PLACEHOLDER_VALUES = {\"\", \"none\", \"null\", \"nil\", \"n/a\", \"na\", \"todo\", \"tbd\", \"undefined\"}\n12: \n13: # A method whose name promises an argument must declare one. The parameter list is\n14: # what is missing, so the only evidence left is the name — and some names are\n15: # self-evidently incomplete: `create()` cannot know what to create and\n16: # `get_wine_by_id()` cannot know which wine.\n17: WRITE_VERB_PREFIXES = (\"create\", \"add\", \"save\", \"insert\", \"update\", \"delete\", \"remove\", \"set\")\n18: KEYED_BY_SUFFIX = re.compile(r\"_by_(id|email|name|sku|isbn|title|code|key|slug|number)$\")\n19: # Aggregates are excluded: \"by X\" there means \"grouped by X\", which takes no\n20: # argument, so `get_total_stock_value_by_category()` is complete as declared.\n21: AGGREGATE_WORDS = (\n22:     \"total\", \"sum\", \"summary\", \"report\", \"count\", \"value\", \"aggregate\", \"stat\", \"history\",\n23: )\n24: \n25: \n26: def is_placeholder(value):\n27:     \"\"\"True for the junk values the extractor leaves in names and types.\"\"\"\n28:     return normalize(value) in PLACEHOLDER_VALUES\n29: \n30: \n31: def is_missing(value):\n32:     \"\"\"True for empty strings and non-strings.\"\"\"\n33:     return not isinstance(value, str) or not value.strip()\n34: \n35: \n36: def collect_methods(container):\n37:     \"\"\"Return the method objects of a service or repository entry.\"\"\"\n38:     methods = container.get(\"methods\")\n39:     if not isinstance(methods, list):\n40:         return []\n41:     return [method for method in methods if isinstance(method, dict)]\n42: \n43: \n44: def param_names(method):\n45:     \"\"\"Return every declared parameter name of a method.\"\"\"\n46:     params = method.get(\"params\")\n47:     if not isinstance(params, list):\n48:         return []\n49:     return [param[\"name\"] for param in params if isinstance(param, dict) and param.get(\"name\")]\n50: \n51: \n52: def check_method_list(methods, owner_label, report):\n53:     \"\"\"Validate the method block of one service or repository.\"\"\"\n54:     if not isinstance(methods, list) or not methods:\n55:         report.warning(\"empty_section\", f\"{owner_label} declares no methods\")\n56:         return\n57: \n58:     seen_names = set()\n59:     for method in methods:\n60:         if not isinstance(method, dict):\n61:             report.error(\"invalid_value\", f\"{owner_label} contains a method that is not an object\")\n62:             continue\n63:         _check_method(method, owner_label, seen_names, report)\n64: \n65: \n66: def _check_method(method, owner_label, seen_names, report):\n67:     name = method.get(\"name\")\n68:     if is_missing(name) or is_placeholder(name):\n69:         report.error(\"invalid_identifier\", f\"{owner_label} has a method with no name\")\n70:         return\n71: \n72:     if normalize(name) in seen_names:\n73:         report.warning(\"duplicate_entry\", f\"{owner_label} declares method '{name}' more than once\")\n74:     seen_names.add(normalize(name))\n75: \n76:     description = method.get(\"description\")\n77:     if is_missing(description) or is_placeholder(description):\n78:         report.warning(\"placeholder_value\", f\"{owner_label}.{name} has no description\")\n79: \n80:     return_type = method.get(\"return_type\")\n81:     if is_missing(return_type):\n82:         report.warning(\"placeholder_value\", f\"{owner_label}.{name} has no return_type\")\n83: \n84:     _check_params(method, owner_label, name, report)\n85:     _check_params_are_declared(method, owner_label, name, report)\n86: \n87: \n88: def _missing_arguments_reason(name):\n89:     \"\"\"Why a name cannot be honoured without parameters, or None when it can.\"\"\"\n90:     lowered = name.lower()\n91:     if any(word in lowered for word in AGGREGATE_WORDS):\n92:         return None\n93:     if lowered.startswith(WRITE_VERB_PREFIXES):\n94:         return \"it writes or removes something and must say what\"\n95:     if KEYED_BY_SUFFIX.search(lowered):\n96:         return \"it looks an entity up by a key and must take that key\"\n97:     return None\n98: \n99: \n100: def _check_params_are_declared(method, owner_label, name, report):\n101:     \"\"\"Flag a method that promises arguments and declares none.\"\"\"\n102:     params = method.get(\"params\")\n103:     if isinstance(params, list) and params:\n104:         return\n105:     reason = _missing_arguments_reason(name)\n106:     if reason is None:\n107:         return\n108:     report.warning(\n109:         \"missing_parameters\",\n110:         f\"{owner_label}.{name} declares no parameters, but {reason}\",\n111:     )\n112: \n113: \n114: def _check_params(method, owner_label, name, report):\n115:     params = method.get(\"params\")\n116:     if not isinstance(params, list):\n117:         report.error(\"invalid_value\", f\"{owner_label}.{name} params should be a list\")\n118:         return\n119: \n120:     seen_names = set()\n121:     for param in params:\n122:         if not isinstance(param, dict):\n123:             report.error(\"invalid_value\", f\"{owner_label}.{name} contains a parameter that is not an object\")\n124:             continue\n125: \n126:         param_name = param.get(\"name\")\n127:         param_type = param.get(\"type\")\n128:         if is_missing(param_name) or is_placeholder(param_name) or is_placeholder(param_type):\n129:             report.warning(\n130:                 \"placeholder_value\",\n131:                 f\"{owner_label}.{name} has a placeholder parameter \"\n132:                 f\"(name={param_name!r}, type={param_type!r})\",\n133:             )\n134:             continue\n135: \n136:         if normalize(param_name) in seen_names:\n137:             report.warning(\n138:                 \"duplicate_entry\",\n139:                 f\"{owner_label}.{name} declares parameter '{param_name}' more than once\",\n140:             )\n141:         seen_names.add(normalize(param_name))"
              }

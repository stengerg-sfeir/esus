:\n321:     return any(any(stem in method for stem in stems) for method in methods)\n322: \n323: \n324: def _normalise(value):\n325:     return value.replace(\"_\", \"\").replace(\"-\", \"\").lower()\n326: \n327: \n328: # A flag token inside backticks: `[--budget]`, `--from-date`, `[---category]`.\n329: # Brackets mark an optional flag; the name is letters, digits, `_` and `-`.\n330: # Three dashes are tolerated: a typo for an optional long flag, which must\n331: # still resolve to the flag it means rather than vanish from the check.\n332: FLAG_TOKEN = re.compile(r\"\\[?-{1,3}([a-z][a-z0-9_-]*)\")\n333: \n334: # A backtick span that can carry a command line at all: prose spans like\n335: # `UNIQUE(category_id, month)` name no command and are skipped by shape, not\n336: # by guessing.\n337: SPAN_WORD = re.compile(r\"[a-z][a-z0-9_-]*\")\n338: \n339: \n340: def check_flag_coverage(components, requirements, report):\n341:     \"\"\"Report flags the requirements pass and the surface cannot accept.\n342: \n343:     `missing_command` compares verbs; this compares the flags behind them. A\n344:     verb the surface declares with none of its data flags (inventory's\n345:     `product add` carries only `-help`/`-version` while the requirements pass\n346:     `--sku` and `--name`) parses and then can never run — the same stranded\n347:     path as a missing command, one level down.\n348: \n349:     Deliberately narrow, like the verb rule: only backtick spans are read, the\n[Output truncated. Continue reading with offset: 350]"

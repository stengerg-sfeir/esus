              "newString": "    return checkable\n\n\ndef _check_top_level_commands(commands, requirements, program, report):\n    \"\"\"Report program-led lines whose verb never became a command.\n\n    A line with one word between the program name and its flags\n    (`library borrow --member-id --book-id`) makes that word a top-level\n    command carrying its own options — the prompt's own rule for the shape.\n    The pair rule cannot see these lines (it needs two words before a flag),\n    so a vanished `borrow` was invisible: no missing command (the noun is the\n    program), no unbacked command (undeclared verbs resolve against nothing).\n    A bare line with no flags (`library overdue`) names no options and is\n    left alone — there is nothing to check it against.\n    \"\"\"\n    if not program:\n        return 0\n    seen = set()\n    checkable = 0\n    for span in re.findall(r\"`([^`]*)`\", requirements):\n        tokens = span.split()\n        if len(tokens) < 3 or tokens[0] != program:\n            continue\n        word = tokens[1].strip(\"[](),.;:\")\n        if not SPAN_WORD.fullmatch(word):\n            continue\n        flag = tokens[2].lstrip(\"[\")\n        if not flag.startswith(\"-\"):\n            continue\n        if word in commands or word in seen:\n            continue\n        seen.add(word)\n        checkable += 1\n        report.warning(\n            \"missing_command\",\n            f\"components.facade.invocation: the requirements make '{word}' a \"\n            f\"top-level command (`{span.strip()}`) but the surface declares \"\n            f\"no such command (it declares: {', '.join(sorted(commands)) or 'none'})\",\n        )\n    return checkable\n\n\ndef _program_name(requirements):",

                'is_recurring': expense.is_recurring\\n\"\n    \"            })\\n\"\n    \"```\",\n    # 2. ExpenseService.detect_recurring\n    \"        expenses = self._repos['ExpenseRepository'].read_all_expenses()\\n\"\n    \"        recurring_expenses = []\\n\"\n    \"\\n\"\n    \"        for expense in expenses:\\n\"\n    \"            if expense.is_recurring:\\n\"\n    \"                continue\\n\"\n    \"\\n\"\n    \"            category_id = expense.category_id\\n\"\n    \"            category_expenses = self._repos['ExpenseRepository'].read_expenses_by_category(category_id)\\n\"\n    \"\\n\"\n    \"            # Group expenses by month\\n\"\n    \"            monthly_expenses = {}\\n\"\n    \"            for exp in category_expenses:\\n\"\n    \"                month = exp.expense_date[:7]  # Format as YYYY-MM\\n\"\n    \"                if month not in monthly_expenses:\\n\"\n    \"                    monthly_expenses[month] = []\\n\"\n    \"                monthly_expenses[month].append(exp)\\n\"\n    \"\\n\"\n    \"            # Check for recurring pattern\\n\"\n    \"            for month, expenses_in_month in monthly_expenses.items():\\n\"\n    \"                if len(expenses_in_month) > 1:\\n\"\n    \"                    # Check if all expenses in the month have the same amount\\n\"\n    \"                    amounts = [exp.amount_cents for exp in expenses_in_month]\\n\"\n    \"                    if len(set(amounts)) == 1:\\n\"\n    \"                        # Check if the same amount appears in consecutive months\\n\"\n    \"                        for i in range(len(monthly_expenses) - 1):\\n\"\n    \"                            current_month = monthly_expenses.keys()[i]\\n\"\n    \"                            next_month = monthly_expenses.keys()[i + 1]\\n\"\n    \"                            current_amounts = [exp.amount_cents for exp in monthly_expenses[current_month]]\\n\"\n    \"                            next_amounts = [exp.amount_cent
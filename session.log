            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/loader.py, lines 1-157\n1: \"\"\"Safe loading of the per-step extraction documents.\n2: \n3: \"Safe\" means one unusable file never aborts the run: a missing, unreadable,\n4: malformed or wrongly shaped document becomes a finding and is skipped, so the\n5: remaining checks still run and the report is still produced.\n6: \"\"\"\n7: \n8: import json\n9: from dataclasses import dataclass\n10: from pathlib import Path\n11: \n12: # Steps A-E always run. Step H is skipped when step D declares no persistence, so\n13: # `persistence_ports.json` may legitimately be absent — it is, for the hello-world\n14: # prompt. `interaction_adapters` is optional for a weaker reason: step G is never\n15: # skipped, so the document is absent only when that step failed to produce usable\n16: # JSON. Note that `Documents.missing` is consulted only by checks_persistence (for\n17: # `persistence_ports`), so an absent adapters document currently produces no\n18: # finding at all rather than a tolerated one.\n19: CORE_DOCUMENTS = (\n20:     \"intentions\",\n21:     \"invariants\",\n22:     \"data_models\",\n23:     # Step E' runs before step E and is never skipped: a program without a\n24:     # domain can still fail, and its error types have nowhere else to be\n25:     # recorded. Its document is therefore always written.\n26:     \"errors\",\n27:     \"components\",\n28:     \"service_contracts\",\n29:     # Step F classifies the invariants and contract methods. It is never\n30:     # skipped, so its document is always written and its absence is a defect\n31:     # rather than a tolerated state — which is why nothing checked it before,\n32:     # and why `checks_patterns` now can.\n33:     \"pattern_matches\",\n34: )\n35: OPTIONAL_DOCUMENTS = (\"interaction_adapters\", \"persistence_ports\")\n36: DOCUMENT_NAMES = CORE_DOCUMENTS + OPTIONAL_DOCUMENTS\n37: \n38: LIST_DOCUMENTS = (\n39:     \"intentions\",\n40:     \"invariants\",\n41:     \"data_models\",\n42:     \"errors\",\n43:     \"service_contracts\",\n44:     \"interaction_adapters\",\n45:     \"pattern_matches\",\n46: )\n47: \n48: \n49: @dataclass\n50: class Documents:\n51:     \"\"\"The loaded document bodies, plus the names of the absent ones.\"\"\"\n52: \n53:     bodies: dict\n54:     missing: tuple = ()\n55: \n56:     def get(self, name, default=None):\n57:         return self.bodies.get(name, default)\n58: \n59: \n60: def load_requirements(output_dir):\n61:     \"\"\"The requirements a run was given, when the run recorded them.\n62: \n63:     Written beside the documents by `extract_archi.py`. A directory from before\n64:     that change has no such file, and its absence is not a finding: the coverage\n65:     check simply does not run, rather than reporting every older run for a file\n66:     it could not have written.\n67:     \"\"\"\n68:     path = Path(output_dir) / \"requirements.txt\"\n69:     if not path.is_file():\n70:         return None\n71:     try:\n72:         return path.read_text(encoding=\"utf-8\")\n73:     except OSError:\n74:         return None\n75: \n76: \n77: def load_documents(output_dir, report):\n78:     \"\"\"Load every extraction document in `output_dir`.\n79: \n80:     Each body is the value under the document's own top-level key:\n81:     data_models.json holds {\"data_models\": [...]} and yields the array.\n82:     \"\"\"\n83:     directory = Path(output_dir)\n84:     if not directory.is_dir():\n85:         report.error(\"missing_directory\", f\"Output directory not found: {output_dir}\")\n86:         return Documents({}, tuple(DOCUMENT_NAMES))\n87: \n88:     bodies = {}\n89:     missing = []\n90: \n91:     for name in DOCUMENT_NAMES:\n92:         path = directory / f\"{name}.json\"\n93:         if not path.is_file():\n94:             if name in OPTIONAL_DOCUMENTS:\n95:                 missing.append(name)\n96:             else:\n97:                 report.error(\"missing_document\", f\"MISSING: {path.name}\")\n98:             continue\n99: \n100:         body = _read_document(path, name, report)\n101:         if body is not None:\n102:             bodies[name] = body\n103: \n104:     return Documents(bodies, tuple(missing))\n105: \n106: \n107: def _read_document(path, name, report):\n108:     try:\n109:         raw = path.read_text(encoding=\"utf-8\")\n110:     except OSError as error:\n111:         report.error(\"malformed_document\", f\"UNREADABLE: {path.name}: {error}\")\n112:         return None\n113: \n114:     try:\n115:         payload = json.loads(raw)\n116:     except json.JSONDecodeError as error:\n117:         report.error(\n118:             \"malformed_document\",\n119:             f\"MALFORMED: {path.name}: {error.msg} (line {error.lineno}, column {error.colno})\",\n120:         )\n121:         return None\n122: \n123:     if not isinstance(payload, dict):\n124:         report.error(\n125:             \"unexpected_shape\",\n126:             f\"UNEXPECTED SHAPE: {path.name} should hold a JSON object, \"\n127:             f\"found {type(payload).__name__}\",\n128:         )\n129:         return None\n130: \n131:     if name not in payload:\n132:         keys = \", \".join(sorted(payload)) or \"none\"\n133:         report.error(\n134:             \"unexpected_shape\",\n135:             f\"UNEXPECTED SHAPE: {path.name} has no '{name}' key (found: {keys})\",\n136:         )\n137:         return None\n138: \n139:     extra_keys = sorted(set(payload) - {name})\n140:     if extra_keys:\n141:         report.warning(\n142:             \"unexpected_shape\",\n143:             f\"UNEXPECTED SHAPE: {path.name} carries unexpected key(s): {', '.join(extra_keys)}\",\n144:         )\n145: \n146:     body = payload[name]\n147:     expected_type = list if name in LIST_DOCUMENTS else dict\n148:     if not isinstance(body, expected_type):\n149:         kind = \"array\" if expected_type is list else \"object\"\n150:         report.error(\n151:             \"unexpected_shape\",\n152:             f\"UNEXPECTED SHAPE: {path.name}['{name}'] should be a JSON {kind}, \"\n153:             f\"found {type(body).__name__}\",\n154:         )\n155:         return None\n156: \n157:     return body"
              }

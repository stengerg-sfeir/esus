        {
          "type": "text",
          "text": "Inventory lines carry no program word, so program detection eats `product` and resolution fails. Fixing with two-phase resolution (drop-path, then full-tokens).",
          "state": {
            "itemId": "rs_01a12fa90db9755e990df04cd1e12771",
            "phase": "commentary"
          }
        },
        {
          "type": "tool",
          "id": "call_01a12fa90f07711896a08ce5824f0e5c",

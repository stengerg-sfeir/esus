enerator.main([out]) == 0, \"fixture must generate cleanly\"\n335:         cls.out = out\n336:         cls.generated = str(Path(out) / \"generated\")\n337: \n338:     @classmethod\n339:     def tearDownClass(cls):\n340:         cls._tmp.cleanup()\n341: \n342:     def mods(self):\n343:         \"\"\"All generated modules, imported by real name off the generated dir.\n344: \n345:         The emitted files import each other as siblings (`import models`), so\n346:         they are loaded the way the CLI loads them: the directory on\n347:         `sys.path`, names evicted first so reruns never see a stale package.\n348:         \"\"\"\n349:         sys.path.insert(0, self.generated)\n350:         try:\n351:             for name in (\"store\", \"models\", \"errors\", \"repositories\",\n352:                          \"services\", \"cli\"):\n353:                 sys.modules.pop(name, None)\n354:             import store\n355:             import models\n356:             import errors\n357:             import repositories\n358:             import services\n359:             import cli\n360:             return store, models, errors, repositories, services, cli\n361:         finally:\n362:             sys.path.remove(self.generated)\n363: \n364:     def test_all_files_are_written(self):\n365:         for filename in (\"__init__.py\", \"models.py\", \"errors.py\", \"store.py\",\n366:                          \"repositories.py\", \"services.py\", \"cli.py\"):\n367:             self.assertTrue((Path(self.generated) / filename).is_file(), filename)\n368: \n369:     def test_crud_round_trip_with_registered_errors(self):\n370:         store, models, errors, repositories, _, _ = self.mods()\n371:         backend = store.Store()\n372:         categories = repositories.CategoryRepository(backend)\n373:         products = repositories.ProductRepository(backend)\n374:         category = categories.create_category(models.Category(name=\"food\"))\n375:         self.assertEqual(category.id, 1
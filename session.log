                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/review_aliases.py, lines 1-518\n1: #!/usr/bin/env python3\n2: \"\"\"Ask the user about adapter fields no rule can map.\n3: \n4: Some fields name a value no spelling rule reaches: `file_path` where the\n5: leaf offers `--output`, `copies` where the model declares\n6: `available_copies`. Only the requirements author knows they name one thing.\n7: This asks about exactly those pairs — required-but-unsuppliable fields and\n8: entity-targeted fields spelling no model field — and records each answer as\n9: `{action, field, flag}` in `field_aliases.json`, stamped with the prompt sha\n10: like pattern decisions.\n11: \n12: Usage:\n13:     python review_aliases.py out/expenses          # ask open questions\n14:     python review_aliases.py out/expenses --list   # show open questions only\n15: \n16: Each question shows the action, the field, its target, the bound leaf with\n17: its flags, and numbered suggestions (leaf flags the field resembles); answer\n18: with a number, a flag name of your own, or skip. Answers apply to the on-disk\n19: adapters immediately (the field takes the flag's spelling, its target\n20: unchanged) and to every future run while the prompt stands. `skip` leaves a\n21: pair open — the probe keeps reporting it.\n22: \"\"\"\n23: \n24: import json\n25: import os\n26: import sys\n27: from difflib import SequenceMatcher\n28: \n29: sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n30: \n31: from kernel import codegen  # noqa: E402\n32: from kernel.consistency.checks_surface import COMMAND_VERB_STEMS  # noqa: E402\n33: from kernel.consistency.loader import load_documents, load_requirements  # noqa: E402\n34: from kernel.consistency.report import Report  # noqa: E402\n35: from kernel.extraction.aliases import (  # noqa: E402\n36:     apply_aliases,\n37:     load_aliases,\n38:     save_aliases,\n39: )\n40: from kernel.extraction.decisions import requirements_sha  # noqa: E402\n41: \n42: SUGGESTION_LIMIT = 5\n43: \n44: # CLI option types mapped to model field types, for inferring a creatable\n45: # field. `list` maps to nothing: a new multi-valued model field is never\n46: # inferred — its shape is a design decision, not a derivation.\n47: OPTION_TO_MODEL_TYPES = {\"int\": \"int\", \"str\": \"string\", \"float\": \"float\",\n48:                          \"bool\": \"boolean\"}\n49: \n50: \n51: def collect_questions(output_dir):\n52:     \"\"\"Open `(action, field)` pairs needing a mapping, with answering context.\n53: \n54:     Returns `(questions, context)` where each question carries its target,\n55:     entity, bound leaves and leaf flags. Assembly markers, optional fields\n56:     and already-recorded pairs are excluded — what remains cannot be reached\n57:     by any rule.\n58:     \"\"\"\n59:     report = Report(\"review\")\n60:     documents = load_documents(output_dir, report)\n61:     adapters = documents.get(\"interaction_adapters\") or []\n62:     services = documents.get(\"service_contracts\") or []\n63:     ports = documents.get(\"persistence_ports\")\n64:     repositories = []\n65:     if isinstance(ports, dict) and isinstance(ports.get(\"repositories\"), list):\n66:         repositories = ports[\"repositories\"]\n67:     models = documents.get(\"data_models\") or []\n68:     entity_names = [m.get(\"name\") for m in models\n69:                     if isinstance(m, dict) and m.get(\"name\")]\n70:     invocation = ((documents.get(\"components\") or {}).get(\"facade\") or {}).get(\"invocation\")\n71:     targets = codegen.action_targets(adapters, services, repositories, entity_names)\n72:     bindings, _ = codegen.bind_commands(adapters, invocation, COMMAND_VERB_STEMS)\n73:     leaf_of = {}\n74:     for (command, sub), bound in bindings.items():\n75:         if bound is not None:\n76:             leaf_of.setdefault(bound[0], []).append((command, sub))\n77:     argv = codegen.action_argv(adapters, bindings, invocation)\n78:     model_fields = {}\n79:     pk_of = {}\n80:     for model in models or []:\n81:         if isinstance(model, dict) and model.get(\"name\"):\n82:             fields = [f for f in model.get(\"fields\") or [] if isinstance(f, dict)]\n83:             model_fields[model[\"name\"]] = [\n84:                 f.get(\"name\") for f in fields if f.get(\"name\")]\n85:             for f in fields:\n86:                 if f.get(\"primary_key\") and f.get(\"name\") and model[\"name\"] not in pk_of:\n87:                     pk_of[model[\"name\"]] = f[\"name\"]\n88:     decided = set()\n89:     for r in load_aliases(output_dir):\n90:         if isinstance(r, dict):\n91:             # Both ends: the recorded field (already answered) and the flag\n92:             # it became (already renamed) — else every review re-asks the\n93:             # renamed pair it just created. Deliberately final: a recorded\n94:             # pair that still fires (mapped, yet unsupplied) needs surface\n95:             # or model work, not another mapping answer — and the probe keeps\n96:             # reporting it, so nothing goes silent.\n97:             decided.add((r.get(\"action\"), r.get(\"field\")))\n98:             decided.add((r.get(\"action\"), r.get(\"flag\")))\n99: \n100:     questions = []\n101:     seen = set()\n102:     for action, field, entity in codegen.unknown_model_fields(\n103:             adapters, services, repositories, models):\n104:         if (action, field) not in decided and (action, field) not in seen:\n105:             seen.add((action, field))\n106:             questions.append(_question(adapters, leaf_of, argv, invocation,\n107:                                        action, field, entity, \"model\",\n108:                                        model_fields, pk_of))\n109:     for action, field in codegen.uncovered_required_fields(adapters, invocation, targets):\n110:         if (action, field) not in decided and (action, field) not in seen:\n111:             seen.add((action, field))\n112:             questions.append(_question(adapters, leaf_of, argv, invocation,\n113:                                        action, field, None, \"flag\",\n114:                                        model_fields, pk_of))\n115:     questions.sort(key=lambda q: (q[\"action\"], q[\"field\"]))\n116:     context = {\"adapters\": adapters, \"prompt_sha\": requirements_sha(load_requirements(output_dir))}\n117:     return questions, context\n118: \n119: \n120: def _question(adapters, leaf_of, argv, invocation, action, field,\n121:               entity, kind, model_fields=(), pk_of=None):\n122:     \"\"\"One askable pair, stated as a contract, not internals.\n123: \n124:     kind 'model' asks which model field the value fills (the adapter names\n125:     no declared one); kind 'flag' asks which flag supplies a required value\n126:     no leaf flag covers. Either way the answer renames the adapter field\n127:     only — service, method and parameter are shown qualified so the human\n128:     sees exactly what maps to where.\n129:     \"\"\"\n130:     adapter = next((a for a in adapters\n131:                     if isinstance(a, dict) and a.get(\"action_name\") == action), {})\n132:     entry = next((f for f in adapter.get(\"input_fields\") or []\n133:                   if isinstance(f, dict) and f.get(\"field_name\") == field), {})\n134:     service = adapter.get(\"target_service\")\n135:     method = adapter.get(\"target_method\")\n136:     target = entry.get(\"target_param\")\n137:     leaves = leaf_of.get(action, [])\n138:     leafpaths = [\" \".join(part for part in leaf if part) for leaf in leaves]\n139:     leaf_flags = []\n140:     for command, sub in leaves:\n141:         for option in codegen.leaf_options(invocation, command, sub):\n142:             if isinstance(option, dict) and option.get(\"name\"):\n143:                 if option[\"name\"] not in leaf_flags:\n144:                     leaf_flags.append(option[\"name\"])\n145:     supplied = []\n146:     dest = (argv.get(action) or {}).get(field)\n147:     if dest:\n148:         for (command, sub), leafpath in zip(leaves, leafpaths):\n149:             for option in codegen.leaf_options(invocation, command, sub):\n150:                 if (isinstance(option, dict)\n151:                         and codegen.option_dest(option) == dest\n152:                         and option.get(\"name\")):\n153:                     triple = (leafpath, option[\"name\"], option.get(\"type\"))\n154:                     if triple not in supplied:\n155:                         supplied.append(triple)\n156:     problems = []\n157:     if kind == \"model\" and entity:\n158:         problems.append(\n159:             f\"{entity} declares no '{field}' field, so building it fails.\")\n160:     if kind == \"flag\":\n161:         where = leafpaths[0] if len(leafpaths) == 1 else \"its command\"\n162:         problems.append(\n163:             f\"no flag on '{where}' supplies this required value — \"\n164:             f\"the action parses but can never run.\")\n165:     if kind == \"model\" and entity:\n166:         question_line = f\"Which {entity} field does this value fill?\"\n167:         suggestions = suggest_model_fields(model_fields, entity, field)\n168:     else:\n169:         question_line = \"Which flag supplies this value?\"\n170:         suggestions = suggest_flags(\n171:             sorted({d for d in (argv.get(action) or {}).values() if d}), field)\n172:     spellings = {}\n173:     for command, sub in leaves:\n174:         for option in codegen.leaf_options(invocation, command, sub):\n175:             if isinstance(option, dict) and option.get(\"name\"):\n176:                 known = codegen.option_dest(option)\n177:                 if known and known not in spellings:\n178:                     spellings[known] = option[\"name\"]\n179:     declared = sorted(model_fields.get(entity, [])) if isinstance(model_fields, dict) else []\n180:     create = None\n181:     if kind == \"model\" and entity:\n182:         create = infer_new_field(entry, supplied, pk_of, model_fields, entity, field)\n183:     return {\n184:         \"action\": action,\n185:         \"field\": field,\n186:         \"service\": service,\n187:         \"method\": method,\n188:         \"target\": target,\n189:         \"transform\": entry.get(\"transform\"),\n190:         \"entity\": entity,\n191:         \"kind\": kind,\n192:         \"leaves\": leafpaths,\n193:         \"flags\": sorted({d for d in (argv.get(action) or {}).values() if d}),\n194:         \"leaf_flags\": leaf_flags,\n195:         \"supplied\": supplied,\n196:         \"model_fields\": declared,\n197:         \"create\": create,\n198:         \"problem\": problems,\n199:         \"question\": question_line,\n200:         \"suggestions\": suggestions,\n201:         \"spellings\": spellings,\n202:     }\n203: \n204: def suggest_flags(dests, field, limit=SUGGESTION_LIMIT):\n205:     \"\"\"Leaf flags resembling the field, most similar first (deterministic).\"\"\"\n206:     from kernel.consistency.naming import normalize\n207: \n208:     wanted = normalize(field or \"\")\n209:     if not wanted:\n210:         return []\n211:     scored = []\n212:     for dest in dests:\n213:         flat = normalize(dest)\n214:         if not flat or flat == wanted:\n215:             continue\n216:         if flat in wanted or wanted in flat:\n217:             scored.append((0, dest))\n218:         else:\n219:             ratio = SequenceMatcher(None, wanted, flat).ratio()\n220:             if ratio >= 0.5:\n221:                 scored.append((1 - ratio, dest))\n222:     scored.sort(key=lambda item: (item[0], item[1] or \"\"))\n223:     return [dest for _, dest in scored[:limit]]\n224: \n225: \n226: def infer_new_field(entry, supplied, pk_of, model_fields, entity, field):\n227:     \"\"\"A creatable field spec, or None when any piece is underivable.\n228: \n229:     Type comes from the supplying flag's declared CLI type, else int for\n230:     LOOKUP_ID (an identifier by definition) — anything else untyped stays\n231:     uninferable rather than guessed. The foreign key resolves only through\n232:     the adapter's lookup_entity naming a declared entity with a known\n233:     primary key. Nullable follows the adapter contract (a value always\n234:     supplied holds); unique is never inferred; provenance is `deduced`.\n235:     \"\"\"\n236:     from kernel.consistency.naming import normalize\n237: \n238:     if not isinstance(model_fields, dict):\n239:         return None\n240:     declared = {normalize(n) for n in model_fields.get(entity, []) or []}\n241:     if normalize(field or \"\") in declared:\n242:         return None\n243:     ftype = None\n244:     provenance = None\n245:     for _, spelling, otype in supplied:\n246:         mapped = OPTION_TO_MODEL_TYPES.get((otype or \"\").strip().lower())\n247:         if mapped:\n248:             ftype, provenance = mapped, f\"flag '{spelling}' : {otype}\"\n249:             break\n250:     if ftype is None and (entry.get(\"transform\") or \"\") == \"LOOKUP_ID\":\n251:         ftype, provenance = \"int\", \"LOOKUP_ID transform\"\n252:     if ftype is None:\n253:         return None\n254:     foreign_key = None\n255:     lookup = entry.get(\"lookup_entity\")\n256:     if isinstance(lookup, str) and isinstance(pk_of, dict):\n257:         target = next((m for m in model_fields if normalize(m) == normalize(lookup)), None)\n258:         if target is not None and pk_of.get(target):\n259:             foreign_key = {\"target_entity\": target, \"target_field\": pk_of[target],\n260:                            \"relationship\": \"many_to_one\"}\n261:     spec = {\"entity\": entity, \"name\": field, \"type\": ftype,\n262:             \"nullable\": not bool(entry.get(\"required\", True)),\n263:             \"unique\": False, \"foreign_key\": foreign_key, \"status\": \"deduced\"}\n264:     if provenance:\n265:         spec[\"provenance\"] = provenance\n266:     return spec\n267: \n268: \n269: def suggest_model_fields(model_fields, entity, field):\n270:     \"\"\"Target-entity model fields containing the name, sorted, deterministic.\n271: \n272:     Offered only when no leaf flag resembles the field: answering one of\n273:     these renames the value into a real model field, which is what\n274:     unblocks construction. Forward containment only, like the rename\n275:     repair — suggesting `id` for `author_id` would repoint an author\n276:     reference at the record itself, so reverse matches are never offered.\n277:     \"\"\"\n278:     from kernel.consistency.naming import normalize\n279: \n280:     wanted = normalize(field or \"\")\n281:     names = model_fields.get(entity or \"\", []) if isinstance(model_fields, dict) else []\n282:     return sorted({name for name in names if name and wanted\n283:                    and wanted in normalize(name)})\n284: \n285: \n286: def describe_question(index, total, question):\n287:     \"\"\"One pair stated as a contract: what maps to where, what answering does.\n288: \n289:     Every line is qualified — adapter and method names, the transform, the\n290:     exact problem, where the value arrives from today, and what an answer\n291:     changes (the adapter field only; the method parameter is untouched).\n292:     Missing keys degrade to the older terse lines, so hand-built questions\n293:     in tests still render.\n294:     \"\"\"\n295:     get = question.get\n296:     lines = [\n297:         f\"--- question {index}/{total} ---\",\n298:         f\"ADAPTER '{get('action')}' feeds CLI input into \"\n299:         f\"{get('service')}.{get('method')}.\",\n300:         f\"  field '{get('field')}' ---({get('transform')})---> \"\n301:         f\"parameter '{get('target')}'\"\n302:         + (f\", which must be a {get('entity')}\" if get(\"entity\") else \"\"),\n303:     ]\n304:     for problem in get(\"problem\") or []:\n305:         lines.append(f\"  Problem: {problem}\")\n306:     supplied = get(\"supplied\") or []\n307:     if supplied:\n308:         lines.append(\"  The value arrives via \" + \", \".join(\n309:             f\"flag '{item[1]}' on '{item[0]}'\" for item in supplied) + \".\")\n310:     elif get(\"leaves\"):\n311:         lines.append(\"  No bound flag supplies it; flags on \"\n312:                      + \", \".join(f\"'{leaf}'\" for leaf in get(\"leaves\") or [])\n313:                      + \": \" + (\", \".join(f\"'{flag}'\" for flag in get(\"leaf_flags\") or [])\n314:                                 or \"none declared\") + \".\")\n315:     else:\n316:         lines.append(\"  No command reaches this action.\")\n317:     lines.append(f\"  {get('question') or 'What does this value map to?'}\")\n318:     spellings = get(\"spellings\") or {}\n319:     if get(\"entity\"):\n320:         lines.append(f\"  {get('entity')} declares: \"\n321:                      + (\", \".join(get(\"model_fields\") or []) or \"nothing\") + \".\")\n322:     create = get(\"create\")\n323:     for number, suggestion in enumerate(get(\"suggestions\") or [], start=1):\n324:         shown = spellings.get(suggestion, suggestion)\n325:         lines.append(f\"  {number}) {suggestion}\" + (f\" (as flag '{shown}')\" if shown != suggestion else \"\"))\n326:     if create:\n327:         lines.append(f\"  {len(get('suggestions') or []) + 1}) create {create['entity']}.{create['name']} \"\n328:                      f\": {create['type']}\"\n329:                      + (f\", FK → {create['foreign_key']['target_entity']}.\"\n330:                         f\"{create['foreign_key']['target_field']}\" if create.get(\"foreign_key\") else \"\")\n331:                      + (f\" (from {create['provenance']})\" if create.get(\"provenance\") else \"\"))\n332:     if not (get(\"suggestions\") or []) and not create and get(\"entity\"):\n333:         lines.append(f\"  (type the {get('entity')} field it fills, or skip)\")\n334:     elif not (get(\"suggestions\") or []) and not create:\n335:         lines.append(\"  (type a flag name, or skip — without a declared flag it stays blocked)\")\n336:     lines.append(f\"  Answering renames the adapter field, or creates the model field; \"\n337:                  f\"parameter '{get('target')}' is untouched either way.\")\n338:     return lines\n339: \n340: \n341: def ask(question, input_fn=input):\n342:     \"\"\"Pose one pair; return `(\"rename\", name)`, `(\"create\", spec)`, or `(None, None)`.\n343: \n344:     Numbers address suggestions first, then the create offer when one is\n345:     shown. Free text only ever renames: typing the offered create name still\n346:     renames rather than creates, because creation changes the schema and\n347:     must stay an explicit, numbered choice — never something a stray\n348:     keystroke implies.\n349:     \"\"\"\n350:     suggestions = question.get(\"suggestions\") or []\n351:     create = question.get(\"create\")\n352:     options = [(\"rename\", name) for name in suggestions]\n353:     if create:\n354:         options.append((\"create\", create))\n355:     try:\n356:         answer = input_fn(\"choose a number, type a name, or skip: \").strip()\n357:     except (EOFError, KeyboardInterrupt):\n358:         return None, None\n359:     if answer.lower() in (\"skip\", \"s\", \"\"):\n360:         return None, None\n361:     if answer.isdigit():\n362:         index = int(answer) - 1\n363:         if 0 <= index < len(options):\n364:             return options[index]\n365:         return None, None\n366:     cleaned = answer.lstrip(\"-\")\n367:     return (\"rename\", cleaned) if cleaned else (None, None)\n368: \n369: \n370: def run_review(output_dir, input_fn=input, out_fn=print):\n371:     \"\"\"Ask every open pair; return (asked, answered).\"\"\"\n372:     questions, context = collect_questions(output_dir)\n373:     if not questions:\n374:         out_fn(\"no open field mappings — nothing to decide\")\n375:         return 0, 0\n376:     aliases = load_aliases(output_dir)\n377:     answered = 0\n378:     for number, question in enumerate(questions, start=1):\n379:         for line in describe_question(number, len(questions), question):\n380:             out_fn(line)\n381:         kind, value = ask(question, input_fn)\n382:         if kind is None:\n383:             out_fn(\"skipped — left open\")\n384:             continue\n385:         if kind == \"rename\" and value == question[\"field\"]:\n386:             # Answering the name it already has renames nothing: record\n387:             # nothing, ask nothing again later — the pair stays open.\n388:             out_fn(\"that changes nothing — skipped, left open\")\n389:             continue\n390:         if kind == \"create\":\n391:             if _model_has_field(output_dir, value[\"entity\"], value[\"name\"]):\n392:                 # A rerun declared it meanwhile: the create is moot, but the\n393:                 # mapping still stands — record it as a plain rename.\n394:                 out_fn(f\"{value['entity']}.{value['name']} is declared now — \"\n395:                         f\"recording a rename instead\")\n396:                 record = {\n397:                     \"action\": question[\"action\"],\n398:                     \"field\": question[\"field\"],\n399:                     \"flag\": value[\"name\"],\n400:                     \"decided_by\": \"user\",\n401:                 }\n402:             elif not _apply_create(output_dir, value, out_fn):\n403:                 continue\n404:             else:\n405:                 record = {\n406:                     \"action\": question[\"action\"],\n407:                     \"field\": question[\"field\"],\n408:                     \"flag\": value[\"name\"],\n409:                     \"create\": value,\n410:                     \"decided_by\": \"user\",\n411:                 }\n412:         else:\n413:             record = {\n414:                 \"action\": question[\"action\"],\n415:                 \"field\": question[\"field\"],\n416:                 \"flag\": value,\n417:                 \"decided_by\": \"user\",\n418:             }\n419:         if context[\"prompt_sha\"] is not None:\n420:             record[\"requirements_sha\"] = context[\"prompt_sha\"]\n421:         aliases.append(record)\n422:         answered += 1\n423:     save_aliases(output_dir, aliases)\n424:     matches_path = os.path.join(output_dir, \"interaction_adapters.json\")\n425:     try:\n426:         with open(matches_path, encoding=\"utf-8\") as handle:\n427:             payload = json.load(handle)\n428:     except (OSError, ValueError) as error:\n429:         out_fn(f\"error: cannot read {matches_path}: {error}\")\n430:         return len(questions), answered\n431:     payload[\"interaction_adapters\"] = apply_aliases(\n432:         payload.get(\"interaction_adapters\"), aliases)\n433:     with open(matches_path, \"w\", encoding=\"utf-8\") as handle:\n434:         json.dump(payload, handle, indent=2, ensure_ascii=False)\n435:         handle.write(\"\\n\")\n436:     out_fn(f\"answered {answered} of {len(questions)}; mappings in field_aliases.json\")\n437:     return len(questions), answered\n438: \n439: \n440: def _model_has_field(output_dir, entity, name):\n441:     \"\"\"True when the archived model already declares the field.\"\"\"\n442:     try:\n443:         with open(os.path.join(output_dir, \"data_models.json\"), encoding=\"utf-8\") as handle:\n444:             models = json.load(handle).get(\"data_models\")\n445:     except (OSError, ValueError, AttributeError):\n446:         return False\n447:     if not isinstance(models, list):\n448:         return False\n449:     return any(isinstance(m, dict) and m.get(\"name\") == entity\n450:                and any(isinstance(f, dict) and f.get(\"name\") == name\n451:                        for f in m.get(\"fields\") or [])\n452:                for m in models)\n453: \n454: \n455: def _apply_create(output_dir, spec, out_fn):\n456:     \"\"\"Append a reviewed field to its model's data_models.json; True on change.\n457: \n458:     The entity must still exist and lack the field — a rerun may have healed\n459:     or moved it meanwhile, in which case there is nothing to create and the\n460:     answer falls back to a plain rename at the call site.\n461:     \"\"\"\n462:     path = os.path.join(output_dir, \"data_models.json\")\n463:     try:\n464:         with open(path, encoding=\"utf-8\") as handle:\n465:             payload = json.load(handle)\n466:     except (OSError, ValueError) as error:\n467:         out_fn(f\"error: cannot read {path}: {error}\")\n468:         return False\n469:     models = payload.get(\"data_models\")\n470:     if not isinstance(models, list):\n471:         return False\n472:     for model in models:\n473:         if isinstance(model, dict) and model.get(\"name\") == spec[\"entity\"]:\n474:             fields = model.get(\"fields\")\n475:             if not isinstance(fields, list):\n476:                 return False\n477:             if any(isinstance(f, dict) and f.get(\"name\") == spec[\"name\"] for f in fields):\n478:                 return False\n479:             fields.append({\n480:                 \"name\": spec[\"name\"],\n481:                 \"type\": spec[\"type\"],\n482:                 \"primary_key\": False,\n483:                 \"nullable\": spec[\"nullable\"],\n484:                 \"unique\": False,\n485:                 \"foreign_key\": spec[\"foreign_key\"],\n486:                 \"status\": \"deduced\",\n487:             })\n488:             with open(path, \"w\", encoding=\"utf-8\") as handle:\n489:                 json.dump(payload, handle, indent=2, ensure_ascii=False)\n490:                 handle.write(\"\\n\")\n491:             out_fn(f\"created {spec['entity']}.{spec['name']} in data_models.json\")\n492:             return True\n493:     return False\n494: \n495: \n496: def main(argv=None):\n497:     args = list(sys.argv[1:] if argv is None else argv)\n498:     list_only = \"--list\" in args\n499:     args = [a for a in args if a != \"--list\"]\n500:     if len(args) != 1:\n501:         print(__doc__.splitlines()[0], file=sys.stderr)\n502:         print(\"usage: python review_aliases.py OUT_DIR [--list]\", file=sys.stderr)\n503:         return 2\n504:     if list_only:\n505:         questions, _ = collect_questions(args[0])\n506:         if not questions:\n507:             print(\"no open field mappings — nothing to decide\")\n508:             return 0\n509:         for number, question in enumerate(questions, start=1):\n510:             for line in describe_question(number, len(questions), question):\n511:                 print(line)\n512:         return 0\n513:     asked, _ = run_review(args[0])\n514:     return 0\n515: \n516: \n517: if __name__ == \"__main__\":\n518:     sys.exit(main())"

                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_aliases.py, lines 197-276\n197:     def test_skip_leaves_everything_open(self):\n198:         with tempfile.TemporaryDirectory() as directory:\n199:             writes(directory, adapters())\n200:             asked, answered = run_review(\n201:                 directory, input_fn=lambda _: \"skip\", out_fn=lambda _: None)\n202:             self.assertEqual((asked, answered), (1, 0))\n203:             self.assertEqual(aliases.load_aliases(directory), [])\n204: \n205:     def test_a_second_run_finds_nothing_open(self):\n206:         with tempfile.TemporaryDirectory() as directory:\n207:             writes(directory, adapters())\n208:             run_review(directory, input_fn=lambda _: \"output\", out_fn=lambda _: None)\n209:             asked, answered = run_review(\n210:                 directory, input_fn=lambda _: \"output\", out_fn=lambda _: None)\n211:             self.assertEqual((asked, answered), (0, 0))\n212: \n213: \n214: class ModelFallbackTests(unittest.TestCase):\n215:     \"\"\"No resembling flag: the entity's own fields are offered instead.\"\"\"\n216: \n217:     def test_model_fields_containing_the_name_are_suggested(self):\n218:         from review_aliases import suggest_model_fields\n219:         models = {\"Book\": [\"title\", \"available_copies\", \"isbn\"]}\n220:         self.assertEqual(\n221:             suggest_model_fields(models, \"Book\", \"copies\"), [\"available_copies\"])\n222:         self.assertEqual(suggest_model_fields(models, \"Book\", \"zzz\"), [])\n223:         self.assertEqual(suggest_model_fields(models, \"Nope\", \"copies\"), [])\n224:         self.assertEqual(suggest_model_fields({}, \"Book\", \"copies\"), [])\n225: \n226:     def test_empty_suggestions_come_with_guidance(self):\n227:         from review_aliases import describe_question\n228:         lines = describe_question(1, 1, {\n229:             \"action\": \"add_book\", \"field\": \"copies\", \"target\": \"book\",\n230:             \"transform\": \"DIRECT\", \"entity\": \"Book\", \"kind\": \"model\",\n231:             \"leaves\": [\"book add\"], \"flags\": [\"copies\"], \"suggestions\": [],\n232:             \"problem\": [\"Book declares no 'copies' field, so building it fails.\"],\n233:             \"supplied\": [(\"book add\", \"--copies\")], \"leaf_flags\": [\"--copies\"],\n234:             \"question\": \"Which Book field does this value fill?\",\n235:             \"service\": \"BookRepo\", \"method\": \"create_book\", \"spellings\": {}})\n236:         text = \"\\n\".join(lines)\n237:         self.assertIn(\"ADAPTER 'add_book' feeds CLI input into BookRepo.create_book.\", text)\n238:         self.assertIn(\"Problem: Book declares no 'copies' field\", text)\n239:         self.assertIn(\"arrives via flag '--copies' on 'book add'\", text)\n240:         self.assertIn(\"Which Book field does this value fill?\", text)\n241:         self.assertIn(\"renames the adapter field, or creates the model field\", text)\n242: \n243:     def test_answering_the_unchanged_name_records_nothing(self):\n244:         with tempfile.TemporaryDirectory() as directory:\n245:             path = Path(directory)\n246:             (path / \"interaction_adapters.json\").write_text(json.dumps(\n247:                 {\"interaction_adapters\": [{\n248:                     \"action_name\": \"add_book\", \"target_service\": \"BookRepo\",\n249:                     \"target_method\": \"create_book\",\n250:                     \"input_fields\": [\n251:                         {\"field_name\": \"copies\", \"target_param\": \"book\",\n252:                          \"transform\": \"DIRECT\", \"required\": True}]}]}),\n253:                 encoding=\"utf-8\")\n254:             (path / \"service_contracts.json\").write_text(json.dumps(\n255:                 {\"service_contracts\": [{\n256:                     \"service_name\": \"BookRepo\", \"methods\": [\n257:                         {\"name\": \"create_book\",\n258:                          \"params\": [{\"name\": \"book\", \"type\": \"Book\"}]}]}]}),\n259:                 encoding=\"utf-8\")\n260:             (path / \"data_models.json\").write_text(json.dumps(\n261:                 {\"data_models\": [{\n262:                     \"name\": \"Book\", \"fields\": [\n263:                         {\"name\": \"available_copies\", \"type\": \"int\"}]}]}),\n264:                 encoding=\"utf-8\")\n265:             (path / \"components.json\").write_text(json.dumps(\n266:                 {\"components\": {\n267:                     \"facade\": {\"type\": \"cli\", \"technology\": \"argparse\",\n268:                                \"invocation\": {\"commands\": [\n269:                                    {\"name\": \"book\", \"options\": [],\n270:                                     \"subcommands\": [\n271:                                         {\"name\": \"add\", \"options\": [\n272:                                             {\"name\": \"--copies\", \"type\": \"int\"}]}]}]}}}}),\n273:                 encoding=\"utf-8\")\n274:             (path / \"requirements.txt\").write_text(\"req\", encoding=\"utf-8\")\n275:             for name in (\"errors\", \"pattern_matches\", \"intentions\", \"invariants\"):\n276:                 (path / f\"{name}.json\").write_text(json.dumps({name: []}),\n[Output truncated. Continue reading with offset: 277]"

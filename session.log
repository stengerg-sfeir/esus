\"Raised when a member with the given ID is not found in the database.\"\"\"\n442: \n443: \n444: class LoanNotFoundError(LookupError):\n445:     \"\"\"Raised when a loan with the given ID is not found in the database.\"\"\"\n446: \n447: \n448: class BookAlreadyExistsError(ValueError):\n449:     \"\"\"Raised when attempting to add a book with an existing ISBN.\"\"\"\n450: \n451: \n452: class MemberAlreadyExistsError(ValueError):\n453:     \"\"\"Raised when attempting to add a member with an existing email.\"\"\"\n454: \n455: \n456: class InsufficientCopiesError(RuntimeError):\n457:     \"\"\"Raised when attempting to borrow a book with zero available copies.\"\"\"\n458: \n459: \n460: class InvalidReturnDateError(RuntimeError):\n461:     \"\"\"Raised when a book is returned before its due date.\"\"\"\n462: \n463: ===== models.py =====\n464: \n465: \"\"\"Data models. Every field defaults to None: the store assigns integer\n466: primary keys on insert, and updates merge only non-None values.\"\"\"\n467: \n468: from dataclasses import dataclass\n469: from decimal import Decimal\n470: import datetime\n471: from typing import Any, Dict, List, Optional\n472: \n473: \n474: \n475: @dataclass\n476: class Book:\n477:     id: int = None\n478:     title: str = None\n479:     isbn: str = None\n480:     published_year: Optional[int] = None\n481:     available_copies: int = None\n482:     author_id: int = None\n483: \n484: \n485: @dataclass\n486: class Author:\n487:     id: int = None\n488:     name: str = None\n489:     birth_year: Optional[int] = None\n490:     biography: Optional[str] = None\n491: \n492: \n493: @dataclass\n494: class Member:\n495:     id: int = None\n496:     name: str = None\n497:     email: str = None\n498:     membership_date: datetime.date = None\n499:     is_active: bool = None\n500: \n501: \n502: @dataclass\n503: class Loan:\n504:     id: int = None\n505:     book_id: int = None\n506:     member_id: int = None\n507:     loan_date: datetime.datetime = None\n508:     due_date: datetime.datetime = None\n509:     return_date: Optional[datetime.datetime] = None\n510:     status: str = None\n511: \n512: ===== repositories.py =====\n513: \n514: \"\"\"Repositories over an in-memory Store, one class per persistence port.\n515: \n516: CRUD, reads and filters run for real. Anything else raises\n517: NotImplementedError with its work order — an aggregate or guard body\n518: is specified by its pattern, not invented here.\n519: \"\"\"\n520: \n521: from typing import Any, Dict, List, Optional, Union\n522: \n523: import datetime\n524: \n525: import models\n526: import errors\n527: from store import Store, match_criterion\n528: \n529: \n530: def _record_values(data, field_names):\n531:     \"\"\"A dataclass or dict entity argument as a `{field: value}` dict.\"\"\"\n532:     if data is None:\n533:         return {}\n534:     if isinstance(data, dict):\n535:         return {name: data.get(name) for name in field_names}\n536:     return {name: getattr(data, name, None) for name in field_names}\n537: \n538: \n539: \n540: class BookRepository:\n541:     ENTITY = \"Book\"\n542:     PK = \"id\"\n543: \n544:     def __init__(self, store):\n545:         self._store = store\n546: \n547: \n548:     def create_book(self, book: models.Book = None, isbn: str = None) -> models.Book:\n549:         \"\"\"Creates a new book entry with the provided details. [crud:create: STANDARD_CRUD]\"\"\"\n550:         values = {}\n551:         values.update(_record_values(book, ['id', 'title', 'isbn', 'published_year', 'available_copies', 'author_id']))\n552:         if isbn is not None:\n553:             values['isbn'] = isbn\n554:         unknown = [k for k in values if k not in ['id', 'title', 'isbn', 'published_year', 'available_copies', 'author_id']]\n555:         if unknown:\n556:             raise ValueError(f\"cannot create Book from {unknown}\")\n557:         record = self._store.add(self.ENTITY, self.PK, values, check_fk=[(\"author_id\", \"Author\", \"id\", errors.AuthorNotFoundError)])\n558:         return models.Book(**record)\n559: \n560:     def read_one_book(self, book_id_or_isbn: Union[str, int] = None) -> models.Book | None:\n561:         \"\"\"Reads a single book by its ID or ISBN. [crud:read_one: STANDARD_CRUD]\"\"\"\n562:         found = []\n563:         if book_id_or_isbn is not None:\n564:             for field, operator in [('id', 'eq'), ('isbn', 'eq')]:\n565:                 found.extend(self._store.select(self.ENTITY, [(field, operator, book_id_or_isbn)]))\n566:         if len(found) != 1:\n567:             raise errors.BookNotFoundError(f\"Book lookup matched {len(found)} records\")\n568:         record = found[0]\n569:         return models.Book(**record)\n570: \n571:     def read_all_books(self) -> List[models.Book]:\n572:         \"\"\"Reads all books from the database. [crud:read_all: READ_ALL]\"\"\"\n573:         criteria = []\n574:         found = self._store.select(self.ENTITY, criteria)\n575:         return [models.Book(**r) for r in found]\n576: \n577:     def update_book(self, book_id_or_isbn: Union[str, int] = None, book: models.Book = None) -> models.Book:\n578:         \"\"\"Updates a book's details by its ID or ISBN. [crud:update: STANDARD_CRUD]\"\"\"\n579:         found = []\n580:         if book_id_or_isbn is not None:\n581:             for field, operator in [('id', 'eq'), ('isbn', 'eq')]:\n582:                 found.extend(self._store.select(self.ENTITY, [(field, operator, book_id_or_isbn)]))\n583:         if len(found) != 1:\n584:             raise errors.BookNotFoundError(f\"Book update matched {len(found)} records\")\n585:         patch = {}\n586:         for key, value in _record_values(book, ['id', 'title', 'isbn', 'published_year', 'available_copies', 'author_id']).items():\n587:             if value is not None:\n588:                 patch[key] = value\n589:         if book_id_or_isbn is not None and 'book_id_or_isbn' in ['id', 'title', 'isbn', 'published_year', 'available_copies', 'author_id']:\n590:             patch['book_id_or_isbn'] = book_id_or_isbn\n591:         record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error=errors.BookNotFoundError)\n592:         return models.Book(**record)\n593: \n594:     def delete_book(self, book_id_or_isbn: Union[str, int] = None) -> bool:\n595:         \"\"\"Deletes a book by its ID or ISBN. [crud:delete: STANDARD_CRUD]\"\"\"\n596:         found = []\n597:         if book_id_or_isbn is not None:\n598:             for field, operator in [('id', 'eq'), ('isbn', 'eq')]:\n599:                 found.extend(self._store.select(self.ENTITY, [(field, operator, book_id_or_isbn)]))\n600:         if not found:\n601:             raise errors.BookNotFoundError(f\"Book delete matched no records\")\n602:         for record in found:\n603:             self._store.delete(self.ENTITY, self.PK, record[self.PK])\n604:         return None\n605: \n606:     def filter_books_by_available_copies(self, min_available_copies: int = None) -> List[models.Book]:\n607:         \"\"\"Filters books by available copies count. [crud:filter: FILTER_BY_FIELD]\"\"\"\n608:         criteria = []\n609:         if min_available_copies is not None:\n610:             criteria.append(('available_copies', 'ge', min_available_copies))\n611:         found = self._store.select(self.ENTITY, criteria)\n612:         return [models.Book(**r) for r in found]\n613: \n614:     def search_books_by_title_author_isbn(self, query: str = None) -> List[models.Book]:\n615:         \"\"\"Searches books by title, author, or ISBN. [llm-written by Qwen3-4B-Instruct-2507-Q4_K_M.gguf — review]\"\"\"\n616:         found = self._store.all(self.ENTITY)\n617:         results = []\n618:         for record in found:\n619:             title = record.get(\"title\")\n620:             isbn = record.get(\"isbn\")\n621:             author_id = record.get(\"author_id\")\n622:             if query is None:\n623:                 continue\n624:             if title and query.lower() in title.lower():\n625:                 results.append(models.Book(**record))\n626:             elif isbn and query.lower() in isbn.lower():\n627:                 results.append(models.Book(**record))\n628:             elif author_id is not None:\n629:                 # We need to check if the author's name matches, but we don't have it directly\n630:                 # So we must fetch the author name from Author table\n631:                 author_record = self._store.get(\"Author\", \"id\", author_id)\n632:                 if author_record and query.lower() in author_record.get(\"name\", \"\").lower():\n633:                     results.append(models.Book(**record))\n634:         return results\n635: \n636: \n637: class AuthorRepository:\n638:     ENTITY = \"Author\"\n639:     PK = \"id\"\n640: \n641:     def __init__(self, store):\n642:         self._store = store\n643: \n644: \n645:     def create_author(self, author: models.Author = None) -> models.Author:\n646:         \"\"\"Creates a new author entry with the provided details. [crud:create: STANDARD_CRUD]\"\"\"\n647:         values = _record_values(author, ['id', 'name', 'birth_year', 'biography'])\n648:         record = self._store.add(self.ENTITY, self.PK, values, check_fk=[])\n649:         return models.Author(**record)\n650: \n651:     def read_one_author(self, author_id: int = None) -> models.Author | None:\n652:         \"\"\"Reads a single author by its ID. [crud:read_one: STANDARD_CRUD]\"\"\"\n653:         record = self._store.get(self.ENTITY, self.PK, author_id, error=errors.AuthorNotFoundError)\n654:         return models.Author(**record)\n655: \n656:     def read_all_authors(self) -> List[models.Author]:\n657:         \"\"\"Reads all authors from the database. [crud:read_all: READ_ALL]\"\"\"\n658:         criteria = []\n659:         found = self._store.select(self.ENTITY, criteria)\n660:         return [models.Author(**r) for r in found]\n661: \n662:     def update_author(self, author_id: int = None, author: models.Author = None) -> models.Author:\n663:         \"\"\"Updates an author's details by its ID. [crud:update: STANDARD_CRUD]\"\"\"\n664:         criteria = []\n665:         if author_id is not None:\n666:             criteria.append(('id', 'eq', author_id))\n667:         found = self._store.select(self.ENTITY, criteria)\n668:         if len(found) != 1:\n669:             raise errors.AuthorNotFoundError(f\"Author update matched {len(found)} records\")\n670:         patch = {}\n671:         for key, value in _record_values(author, ['id', 'name', 'birth_year', 'biography']).items():\n672:             if value is not None:\n673:                 patch[key] = value\n674:         if author_id is not None and 'author_id' in ['id', 'name', 'birth_year', 'biography']:\n675:             patch['author_id'] = author_id\n676:         record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error=errors.AuthorNotFoundError)\n677:         return models.Author(**record)\n678: \n679:     def delete_author(self, author_id: int = None) -> bool:\n680:         \"\"\"Deletes an author by its ID. [crud:delete: STANDARD_CRUD]\"\"\"\n681:         criteria = []\n682:         if author_id is not None:\n683:             criteria.append(('id', 'eq', author_id))\n684:         found = self._store.select(self.ENTITY, criteria)\n685:         if not found:\n686:             raise errors.AuthorNotFoundError(f\"Author delete matched no records\")\n687:         for record in found:\n688:             self._store.delete(self.ENTITY, self.PK, record[self.PK])\n689:         return None\n690: \n691:     def find_books_by_author(self, author_id: int = None) -> List[models.Book]:\n692:         \"\"\"Finds all books by a specific author. [crud:filter: FILTER_BY_FIELD]\"\"\"\n693:         criteria = []\n694:         if author_id is not None:\n695:             criteria.append(('author_id', 'eq', author_id))\n696:         found = self._store.select('Book', criteria)\n697:         return [models.Book(**r) for r in found]\n698: \n699: \n700: class MemberRepository:\n701:     ENTITY = \"Member\"\n702:     PK = \"id\"\n703: \n704:     def __init__(self, store):\n705:         self._store = store\n706: \n707: \n708:     def create_member(self, member: models.Member = None, email: str = None) -> models.Member:\n709:         \"\"\"Creates a new member entry with the provided details. [crud:create: STANDARD_CRUD]\"\"\"\n710:         values = {}\n711:         values.update(_record_values(member, ['id', 'name', 'email', 'membership_date', 'is_active']))\n712:         if email is not None:\n713:             values['email'] = email\n714:         unknown = [k for k in values if k not in ['id', 'name', 'email', 'membership_date', 'is_active']]\n715:         if unknown:\n716:             raise ValueError(f\"cannot create Member from {unknown}\")\n717:         record = self._store.add(self.ENTITY, self.PK, values, check_fk=[])\n718:         return models.Member(**record)\n719: \n720:     def read_one_member(self, member_id: int = None) -> models.Member | None:\n721:         \"\"\"Reads a single member by its ID. [crud:read_one: STANDARD_CRUD]\"\"\"\n722:         record = self._store.get(self.ENTITY, self.PK, member_id, error=errors.MemberNotFoundError)\n723:         return models.Member(**record)\n724: \n725:     def read_all_members(self) -> List[models.Member]:\n726:         \"\"\"Reads all members from the database. [crud:read_all: READ_ALL]\"\"\"\n727:         criteria = []\n728:         found = self._store.select(self.ENTITY, criteria)\n729:         return [models.Member(**r) for r in found]\n730: \n731:     def update_member(self, member_id: int = None, member: models.Member = None) -> models.Member:\n732:         \"\"\"Updates a member's details by its ID. [crud:update: STANDARD_CRUD]\"\"\"\n733:         criteria = []\n734:         if member_id is not None:\n735:             criteria.append(('id', 'eq', member_id))\n736:         found = self._store.select(self.ENTITY, criteria)\n737:         if len(found) != 1:\n738:             raise errors.MemberNotFoundError(f\"Member update matched {len(found)} records\")\n739:         patch = {}\n740:         for key, value in _record_values(member, ['id', 'name', 'email', 'membership_date', 'is_active']).items():\n741:             if value is not None:\n742:                 patch[key] = value\n743:         if member_id is not None and 'member_id' in ['id', 'name', 'email', 'membership_date', 'is_active']:\n744:             patch['member_id'] = member_id\n745:         record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error=errors.MemberNotFoundError)\n746:         return models.Member(**record)\n747: \n748:     def delete_member(self, member_id: int = None) -> bool:\n749:         \"\"\"Deletes a member by its ID. [crud:delete: STANDARD_CRUD]\"\"\"\n750:         criteria = []\n751:         if member_id is not None:\n752:             criteria.append(('id', 'eq', member_id))\n753:         found = self._store.select(self.ENTITY, criteria)\n754:         if not found:\n755:             raise errors.MemberNotFoundError(f\"Member delete matched no records\")\n756:         for record in found:\n757:             self._store.delete(self.ENTITY, self.PK, record[self.PK])\n758:         return None\n759: \n760:     def find_active_members(self) -> List[models.Member]:\n761:         \"\"\"Finds all active members. [FILTER_CRITERION via answered slots: criterion_field=is_active, criterion_value=True]\"\"\"\n762:         criteria = [('is_active', 'eq', True)]\n763:         found = self._store.select(self.ENTITY, criteria)\n764:         return [models.Member(**record) for record in found]\n765: \n766:     def find_inactive_members(self) -> List[models.Member]:\n767:         \"\"\"Finds all inactive members. [FILTER_CRITERION via answered slots: criterion_field=is_active, criterion_value=False]\"\"\"\n768:         criteria = [('is_active', 'eq', False)]\n769:         found = self._store.select(self.ENTITY, criteria)\n770:         return [models.Member(**record) for record in found]\n771: \n772: \n773: class LoanRepository:\n774:     ENTITY = \"Loan\"\n775:     PK = \"id\"\n776: \n777:     def __init__(self, store):\n778:         self._store = store\n779: \n780: \n781:     def create_loan(self, loan: models.Loan = None) -> models.Loan:\n782:         \"\"\"Creates a new loan entry with the provided details. [crud:create: STANDARD_CRUD]\"\"\"\n783:         values = _record_values(loan, ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status'])\n784:         record = self._store.add(self.ENTITY, self.PK, values, check_fk=[(\"book_id\", \"Book\", \"id\", errors.BookNotFoundError), (\"member_id\", \"Member\", \"id\", errors.MemberNotFoundError)])\n785:         return models.Loan(**record)\n786: \n787:     def read_one_loan(self, loan_id: int = None) -> models.Loan | None:\n788:         \"\"\"Reads a single loan by its ID. [crud:read_one: STANDARD_CRUD]\"\"\"\n789:         record = self._store.get(self.ENTITY, self.PK, loan_id, error=errors.LoanNotFoundError)\n790:         return models.Loan(**record)\n791: \n792:     def read_all_loans(self) -> List[models.Loan]:\n793:         \"\"\"Reads all loans from the database. [crud:read_all: READ_ALL]\"\"\"\n794:         criteria = []\n795:         found = self._store.select(self.ENTITY, criteria)\n796:         return [models.Loan(**r) for r in found]\n797: \n798:     def update_loan(self, loan_id: int = None, loan: models.Loan = None) -> models.Loan:\n799:         \"\"\"Updates a loan's details by its ID. [crud:update: STANDARD_CRUD]\"\"\"\n800:         criteria = []\n801:         if loan_id is not None:\n802:             criteria.append(('id', 'eq', loan_id))\n803:         found = self._store.select(self.ENTITY, criteria)\n804:         if len(found) != 1:\n805:             raise errors.LoanNotFoundError(f\"Loan update matched {len(found)} records\")\n806:         patch = {}\n807:         for key, value in _record_values(loan, ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status']).items():\n808:             if value is not None:\n809:                 patch[key] = value\n810:         if loan_id is not None and 'loan_id' in ['id', 'book_id', 'member_id', 'loan_date', 'due_date', 'return_date', 'status']:\n811:             patch['loan_id'] = loan_id\n812:         record = self._store.update(self.ENTITY, self.PK, found[0][self.PK], patch, error=errors.LoanNotFoundError)\n813:         return models.Loan(**record)\n814: \n815:     def delete_loan(self, loan_id: int = None) -> bool:\n816:         \"\"\"Deletes a loan by its ID. [crud:delete: STANDARD_CRUD]\"\"\"\n817:         criteria = []\n818:         if loan_id is not None:\n819:             criteria.append(('id', 'eq', loan_id))\n820:         found = self._store.select(self.ENTITY, criteria)\n821:         if not found:\n822:             raise errors.LoanNotFoundError(f\"Loan delete matched no records\")\n823:         for record in found:\n824:             self._store.delete(self.ENTITY, self.PK, record[self.PK])\n825:         return None\n826: \n827:     def get_active_loans(self) -> List[models.Loan]:\n828:         \"\"\"Finds all active loans. [FILTER_CRITERION via answered slots: criterion_field=status, criterion_value=active]\"\"\"\n829:         criteria = [('status', 'eq', 'active')]\n830:         found = self._store.select(self.ENTITY, criteria)\n831:         return [models.Loan(**record) for record in found]\n832: \n833:     def get_overdue_loans(self) -> List[models.Loan]:\n834:         \"\"\"Finds all overdue loans. [THRESHOLD_SCAN via answered slots: comparison_field=due_date, operator=<, threshold=today]\"\"\"\n835:         bound = datetime.date.today().isoformat()\n836:         out = []\n837:         for record in self._store.select(self.ENTITY, []):\n838:             key = str(record.get('due_date') or '')[:10]\n839:             hit = key < str(bound)[:10]\n840:             if hit:\n841:                 out.append(models.Loan(**record))\n842:         return out\n843: \n844:     def get_member_loan_history(self, member_id: int = None) -> List[models.Loan]:\n845:         \"\"\"Finds all loans for a specific member. [crud:filter: FILTER_BY_FIELD: by parameter shape]\"\"\"\n846:         criteria = []\n847:         if member_id is not None:\n848:             criteria.append(('member_id', 'eq', member_id))\n849:         found = self._store.select(self.ENTITY, criteria)\n850:         return [models.Loan(**r) for r in found]\n851: \n852:     def get_book_loan_history(self, book_id: int = None) -> List[models.Loan]:\n853:         \"\"\"Finds all loans for a specific book. [crud:filter: FILTER_BY_FIELD: by parameter shape]\"\"\"\n854:         criteria = []\n855:         if book_id is not None:\n856:             criteria.append(('book_id', 'eq', book_id))\n857:         found = self._store.select(self.ENTITY, criteria)\n858:         return [models.Loan(**r) for r in found]\n859: \n860: ===== services.py =====\n861: \n862: \"\"\"Services. A method with the same name as a repository method delegates\n863: to it; anything else raises NotImplementedError with its work order.\n864: \"\"\"\n865: \n866: from typing import Any, Dict, List, Optional, Union\n867: \n868: import calendar\n869: \n870: import models\n871: import errors\n872: from store import match_criterion\n873: import datetime\n874: \n875: \n876: def _holds(actual, operator, expected):\n877:     \"\"\"Twin of `store._holds`: the operators filter composition reuses.\"\"\"\n878:     if operator == \"eq\":\n879:         return actual == expected\n880:     if operator == \"ge\":\n881:         return actual is not None and actual >= expected\n882:     if operator == \"le\":\n883:         return actual is not None and actual <= expected\n884:     raise ValueError(f\"unknown operator {operator!r}\")\n885: \n886: \n887: \n888: class LibraryService:\n889: \n890:     def __init__(self, repos):\n891:         self._repos = repos\n892: \n893: \n894:     def borrow_book(self, member_id: int = None, book_id: int = None) -> models.Loan:\n895:         \"\"\"Borrow a book by member and book IDs, checks availability, creates loan, and decrements copies. [llm-written by Qwen3-4B-Instruct-2507-Q4_K_M.gguf — review]\"\"\"\n896:         member = self._repos['MemberRepository'].read_one_member(member_id)\n897:         if not member:\n898:             raise errors.MemberNotFoundError(f\"Member with id {member_id} not found\")\n899: \n900:         book = self._repos['BookRepository'].read_one_book(book_id=book_id)\n901:         if not book:\n902:             raise errors.BookNotFoundError(f\"Book with id {book_id} not found\")\n903: \n904:         if book.available_copies <= 0:\n905:             raise errors.InsufficientCopiesError(f\"Book with id {book_id} has no available copies\")\n906: \n907:         # Create a new loan with current date and due date (e.g., 14 days from loan date)\n908:         loan_date = datetime.datetime.now()\n909:         due_date = loan_date + datetime.timedelta(days=14)\n910: \n911:         loan = models.Loan(\n912:             book_id=book_id,\n913:             member_id=member_id,\n914:             loan_date=loan_date,\n915:             due_date=due_date,\n916:             status='active'\n917:         )\n918: \n919:         created_loan = self._repos['LoanRepository'].create_loan(loan)\n920: \n921:         # Decrement available copies and update book\n922:         book.available_copies -= 1\n923:         updated_book = self._repos['BookRepository'].update_book(book_id, book)\n924: \n925:         return created_loan\n926: \n927:     def return_book(self, loan_id: int = None) -> models.Loan:\n928:         \"\"\"Returns a book by loan ID, sets return_date, updates status, and increments copies. [llm-written by Qwen3-4B-Instruct-2507-Q4_K_M.gguf — review]\"\"\"\n929:         loan = self._repos[
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_persistence.py, lines 1-227\n1: \"\"\"Consistency checks for the persistence ports.\n2: \n3: Covers the repositories (their entity names, interface names and methods) and\n4: the entity mappings (table names and primary keys), which are the documents\n5: that must agree with both data_models and components.\n6: \"\"\"\n7: \n8: from kernel.consistency.methods import check_method_list, is_missing\n9: from kernel.consistency.naming import CLASS_SUFFIXES, MATCH_NONE, MATCH_VARIANT, normalize\n10: from kernel.consistency.report import with_suggestions\n11: \n12: \n13: def check_persistence_presence(documents, report):\n14:     \"\"\"An absent persistence_ports.json only matters if persistence was requested.\"\"\"\n15:     if \"persistence_ports\" not in documents.missing:\n16:         return\n17:     if _persistence_required(documents.get(\"components\")):\n18:         report.error(\n19:             \"missing_document\",\n20:             \"MISSING: persistence_ports.json (components declare persistence.required=true)\",\n21:         )\n22: \n23: \n24: def check_persistence_ports(ports, facts, report):\n25:     \"\"\"Validate the repositories, the entity mappings, and their agreement.\"\"\"\n26:     if not isinstance(ports, dict):\n27:         return\n28: \n29:     repositories = ports.get(\"repositories\")\n30:     mappings = ports.get(\"entity_mappings\")\n31: \n32:     if not isinstance(repositories, list) or not repositories:\n33:         report.error(\"empty_section\", \"persistence_ports.repositories is empty\")\n34:     if not isinstance(mappings, list) or not mappings:\n35:         report.error(\"empty_section\", \"persistence_ports.entity_mappings is empty\")\n36: \n37:     declared = _check_repositories(repositories, facts, report)\n38:     _check_mappings(mappings, facts, report, declared)\n39:     _check_crud_coverage(facts.crud_entities, declared, report)\n40: \n41: \n42: def _persistence_required(components):\n43:     if not isinstance(components, dict):\n44:         return False\n45:     persistence = components.get(\"persistence\")\n46:     return isinstance(persistence, dict) and persistence.get(\"required\") is True\n47: \n48: \n49: def _check_repositories(repositories, facts, report):\n50:     \"\"\"Check the repository list; return {normalized entity: declared entity}.\"\"\"\n51:     declared = {}\n52:     if not isinstance(repositories, list):\n53:         return declared\n54: \n55:     seen_entities = {}\n56:     seen_interfaces = {}\n57: \n58:     for repository in repositories:\n59:         if not isinstance(repository, dict):\n60:             report.error(\"invalid_value\", \"persistence_ports: a repository entry is not an object\")\n61:             continue\n62: \n63:         entity = repository.get(\"entity\")\n64:         interface = repository.get(\"interface_name\")\n65:         if is_missing(entity):\n66:             report.error(\"invalid_identifier\", \"persistence_ports: a repository has no entity\")\n67:             continue\n68: \n69:         label = interface if not is_missing(interface) else entity\n70:         if is_missing(interface):\n71:             report.error(\"invalid_identifier\", f\"persistence_ports: repository for '{entity}' has no interface_name\")\n72:         else:\n73:             interface_key = interface.strip().lower()\n74:             if interface_key in seen_interfaces:\n75:                 report.warning(\n76:                     \"duplicate_entry\",\n77:                     f\"persistence_ports: interface '{interface}' is declared more than once\",\n78:                 )\n79:             seen_interfaces[interface_key] = interface\n80: \n81:         entity_key = normalize(entity)\n82:         if entity_key in seen_entities:\n83:             report.error(\"duplicate_entry\", f\"persistence_ports: entity '{entity}' has more than one repository\")\n84:         seen_entities[entity_key] = entity\n85:         declared[entity_key] = entity\n86: \n87:         _check_repository_entity(entity, facts, report)\n88:         check_method_list(repository.get(\"methods\"), f\"persistence_ports: {label}\", report)\n89: \n90:     return declared\n91: \n92: \n93: def _check_repository_entity(entity, facts, report):\n94:     if entity.endswith(CLASS_SUFFIXES):\n95:         report.error(\n96:             \"class_name_entity\",\n97:             f\"persistence_ports: repository entity '{entity}' is a class name, not a domain entity\",\n98:         )\n99:         return\n100:     if not facts.entities.names:\n101:         return\n102: \n103:     tier, resolved = facts.entities.resolve(entity)\n104:     if tier is MATCH_NONE:\n105:         report.warning(\n106:             \"unknown_reference\",\n107:             with_suggestions(\n108:                 f\"persistence_ports: repository entity '{entity}' not found in data_models\",\n109:                 facts.entities.suggest(entity),\n110:             ),\n111:         )\n112:     elif tier is MATCH_VARIANT:\n113:         report.warning(\n114:             \"name_variant\",\n115:             f\"persistence_ports: repository entity '{entity}' is spelled '{resolved}' in data_models\",\n116:         )\n117: \n118: \n119: def _check_mappings(mappings, facts, report, declared):\n120:     if not isinstance(mappings, list):\n121:         return\n122: \n123:     mapped = {}\n124:     seen_tables = {}\n125:     seen_entities = set()\n126: \n127:     for mapping in mappings:\n128:         if not isinstance(mapping, dict):\n129:             report.error(\"invalid_value\", \"persistence_ports: an entity_mapping is not an object\")\n130:             continue\n131: \n132:         entity = mapping.get(\"entity\")\n133:         if is_missing(entity):\n134:             report.error(\"invalid_identifier\", \"persistence_ports: an entity_mapping has no entity\")\n135:             continue\n136: \n137:         entity_key = normalize(entity)\n138:         if entity_key in seen_entities:\n139:             report.error(\"duplicate_entry\", f\"persistence_ports: entity_mappings lists '{entity}' more than once\")\n140:         seen_entities.add(entity_key)\n141:         mapped[entity_key] = entity\n142: \n143:         table = mapping.get(\"table\")\n144:         if is_missing(table):\n145:             report.error(\"invalid_identifier\", f\"persistence_ports: mapping for '{entity}' has no table\")\n146:         else:\n147:             table_key = table.strip().lower()\n148:             if table_key in seen_tables:\n149:                 report.warning(\"duplicate_entry\", f\"persistence_ports: table '{table}' is mapped more than once\")\n150:             seen_tables[table_key] = table\n151: \n152:         _check_mapping_primary_key(mapping, entity, facts, report)\n153: \n154:     _check_mapping_coverage(declared, mapped, report)\n155: \n156: \n157: def _check_mapping_coverage(declared, mapped, report):\n158:     for entity_key, entity in declared.items():\n159:         if entity_key not in mapped:\n160:             report.error(\"no_mapping\", f\"persistence_ports: repository entity '{entity}' has no entity_mapping\")\n161:         elif mapped[entity_key] != entity:\n162:             report.warning(\n163:                 \"name_variant\",\n164:                 f\"persistence_ports: repository entity '{entity}' is spelled \"\n165:                 f\"'{mapped[entity_key]}' in entity_mappings\",\n166:             )\n167: \n168: \n169: def _check_mapping_primary_key(mapping, entity, facts, report):\n170:     primary_key = mapping.get(\"primary_key\")\n171:     if is_missing(primary_key):\n172:         report.error(\"invalid_identifier\", f\"persistence_ports: mapping for '{entity}' has no primary_key\")\n173:         return\n174: \n175:     _, resolved = facts.entities.resolve(entity)\n176:     declared_fields = facts.entities.fields_of(resolved or entity)\n177:     if not declared_fields:\n178:         return\n179: \n180:     declared_keys = facts.entities.primary_keys(resolved or entity)\n181:     if primary_key in declared_fields:\n182:         if declared_keys and primary_key not in declared_keys:\n183:             report.warning(\n184:                 \"primary_key_mismatch\",\n185:                 f\"persistence_ports: mapping for '{entity}' keys on '{primary_key}' but the model marks \"\n186:                 f\"'{', '.join(declared_keys)}' as primary\",\n187:             )\n188:         return\n189: \n190:     if declared_keys and _is_composite_spelling(primary_key, declared_keys):\n191:         return\n192: \n193:     if declared_keys:\n194:         report.error(\n195:             \"primary_key_mismatch\",\n196:             f\"persistence_ports: mapping for '{entity}' uses primary_key '{primary_key}', which is not a \"\n197:             f\"field of the entity (fields: {', '.join(declared_fields)}; \"\n198:             f\"declared primary key: {', '.join(declared_keys)})\",\n199:         )\n200:     else:\n201:         report.warning(\n202:             \"missing_primary_key\",\n203:             f\"persistence_ports: mapping for '{entity}' uses primary_key '{primary_key}' but the model \"\n204:             f\"declares no primary key\",\n205:         )\n206: \n207: \n208: def _is_composite_spelling(primary_key, primary_keys):\n209:     \"\"\"True when a key name is the declared keys joined, like 'a_b_composite'.\"\"\"\n210:     target = normalize(primary_key)\n211:     for joined in {normalize(\"_\".join(primary_keys)), normalize(\"_\".join(sorted(primary_keys)))}:\n212:         if joined and target.startswith(joined):\n213:             return True\n214:     return False\n215: \n216: \n217: def _check_crud_coverage(crud_entities, declared, report):\n218:     if not crud_entities or not declared:\n219:         return\n220: \n221:     covered = set(declared)\n222:     for entity in crud_entities:\n223:         if normalize(entity) not in covered:\n224:             report.warning(\n225:                 \"no_repository\",\n226:                 f\"consistency: crud_services entity '{entity}' has no matching repository in persistence_ports\",\n227:             )"
              }

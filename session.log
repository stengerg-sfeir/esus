                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_domain.py, lines 1-53\n1: \"\"\"Consistency checks for the domain layer.\n2: \n3: Runs the per-document checks over intentions, invariants, data models,\n4: components and service contracts, and returns the facts the architecture\n5: checks need in order to resolve names.\n6: \"\"\"\n7: \n8: from dataclasses import dataclass, field\n9: \n10: from kernel.consistency.checks_components import check_components\n11: from kernel.consistency.checks_contracts import check_service_contracts\n12: from kernel.consistency.checks_errors import (\n13:     check_duplicate_error_subject,\n14:     check_errors,\n15:     check_raises,\n16:     check_unreachable_not_found,\n17: )\n18: from kernel.consistency.checks_invariants import check_invariant_claims\n19: from kernel.consistency.checks_models import check_data_models\n20: from kernel.consistency.checks_phrases import check_phrase_list\n21: from kernel.consistency.naming import EntityIndex\n22: \n23: \n24: @dataclass\n25: class DomainFacts:\n26:     \"\"\"What the domain checks learned, for the architecture checks to reuse.\"\"\"\n27: \n28:     entities: EntityIndex = field(default_factory=EntityIndex)\n29:     crud_entities: tuple = ()\n30: \n31: \n32: def check_domain_layer(documents, report):\n33:     \"\"\"Run every domain check and return a DomainFacts.\"\"\"\n34:     entities = check_data_models(documents.get(\"data_models\"), report)\n35:     check_phrase_list(documents.get(\"intentions\"), \"intentions\", report)\n36:     check_phrase_list(documents.get(\"invariants\"), \"invariants\", report)\n37:     # An invariant can name a field and claim an attribute of it; the data model\n38:     # declares that attribute, so the two can be compared.\n39:     check_invariant_claims(documents.get(\"invariants\"), entities, report)\n40:     crud_entities = check_components(documents.get(\"components\"), entities, report)\n41:     # The registry first: a contract method's `raises` is resolved against it, so\n42:     # the names have to be known before the references can be judged.\n43:     error_names = check_errors(documents.get(\"errors\"), report)\n44:     check_service_contracts(documents.get(\"service_contracts\"), report)\n45:     check_raises(documents.get(\"service_contracts\"), error_names, report)\n46:     # Two sharper error checks, both stated in names rather than guessed: an\n47:     # error for a missing record that the method reading it never raises, and two\n48:     # names for the same missing record.\n49:     check_unreachable_not_found(\n50:         documents.get(\"errors\"), documents.get(\"service_contracts\"), error_names, report\n51:     )\n52:     check_duplicate_error_subject(documents.get(\"errors\"), error_names, report)\n53:     return DomainFacts(entities=entities, crud_entities=crud_entities)"
              }
            ],

            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/runner.py, lines 1-221\n1: \"\"\"Model loading and one-step generation.\n2: \n3: This is the only module in the package that imports llama_cpp.\n4: \n5: Two things it does that the previous extractor did not: it computes the token\n6: budget from the space actually left in the context instead of hardcoding 4096,\n7: and it reads `finish_reason` so a truncated step is reported rather than saved\n8: as if it were complete.\n9: \"\"\"\n10: \n11: import sys\n12: import time\n13: \n14: from llama_cpp import Llama, LlamaGrammar\n15: \n16: try:  # llama-cpp-python < 0.2.x has no GPU offload probe\n17:     from llama_cpp import llama_supports_gpu_offload\n18: except ImportError:\n19:     llama_supports_gpu_offload = None\n20: \n21: GPU_LAYERS_ALL = -1\n22: GPU_LAYERS_NONE = 0\n23: \n24: # Thread counts are a CPU-backend tuning knob: llama.cpp picks the physical core\n25: # count itself when they are omitted, which beats a fixed number on both a small\n26: # laptop and a large workstation. They are therefore set only off macOS, where\n27: # the CPU backend does the work and an explicit count keeps it predictable —\n28: # on macOS Metal does the work and the setting is mostly moot.\n29: CPU_THREADS = 8\n30: \n31: # Novel-token ceiling for the *first* attempt at a step. The context is 8192 and\n32: # the prompts are a few hundred tokens, so this is rarely the binding\n33: # constraint; the room left in the context is. It exists to stop an\n34: # unconstrained generation from filling the whole context, and it is deliberately\n35: # not the last word: a step that hits it is retried with the full room left in\n36: # the context instead, because a ceiling that truncated an attempt cannot also be\n37: # the ceiling the retry runs under — see `generation_budget` and the retry in\n38: # `pipeline._generate`.\n39: MAX_NEW_TOKENS = 3584\n40: # The floor a budget is never allowed to fall below, so even a long prompt\n41: # leaves room for the shortest possible document.\n42: MIN_BUDGET = 16\n43: CONTEXT_RESERVE = 64\n44: \n45: # Flash attention, measured rather than assumed. This stack (Metal, Ministral-3\n46: # 3B Q4_K_M) renders decode 22.1 -> 25.3 tok/s and a whole document 24.8 -> 28.0\n47: # tok/s (+13-15%) with it on, and the effect on the output was measured too,\n48: # because the setting is commonly believed to cost quality:\n49: #\n50: #   - 118 real classification items across five prompts: **118/118 identical\n51: #     verdicts**, confidence drifting by a median of 0.0004 (max 0.0034);\n52: #   - one whole document generated at temperature 0: **byte-identical**, 7694\n53: #     characters either way;\n54: #   - the runner-up ordering differed on 2 of 118 items, which can move a\n55: #     `narrow_margin` note but never a verdict.\n56: #\n57: # `n_batch`/`n_ubatch` were measured in the same pass and are deliberately left\n58: # at their defaults: they changed nothing (prompts are ~1 100 tokens, so the\n59: # default 512 already chunks them and prefill is fixed-cost dominated, 4.2 s\n60: # flat across 512-4096). Raise `n_batch` only if a prompt ever exceeds 512\n61: # tokens by enough for the chunking to matter.\n62: FLASH_ATTENTION = True\n63: \n64: TRUNCATED = \"length\"\n65: \n66: \n67: def resolve_gpu_layers():\n68:     \"\"\"Offload every layer on Metal, otherwise stay on CPU.\"\"\"\n69:     if sys.platform != \"darwin\":\n70:         return GPU_LAYERS_NONE\n71:     if llama_supports_gpu_offload is None or not llama_supports_gpu_offload():\n72:         return GPU_LAYERS_NONE\n73:     return GPU_LAYERS_ALL\n74: \n75: \n76: def threading_parameters():\n77:     \"\"\"Explicit thread counts, or no keys at all to let llama.cpp choose.\n78: \n79:     Returning an empty dict — rather than keys set to None — matters, because\n80:     llama-cpp-python forwards these straight through to llama.cpp, which is\n81:     not expecting a None thread count.\n82:     \"\"\"\n83:     if sys.platform == \"darwin\":\n84:         return {}\n85:     return {\"n_threads\": CPU_THREADS, \"n_threads_batch\": CPU_THREADS}\n86: \n87: \n88: def load_model(model_path, context_size=8192, logits_all=False, quiet=False):\n89:     \"\"\"Load the GGUF model with the settings every step shares.\"\"\"\n90:     device = \"CPU\" if resolve_gpu_layers() == GPU_LAYERS_NONE else \"Metal\"\n91:     threading = threading_parameters()\n92:     threads = threading.get(\"n_threads\", \"auto\")\n93:     if not quiet:\n94:         print(\n95:             f\"[model] {model_path} on {device}, n_ctx={context_size}, \"\n96:             f\"n_threads={threads}, logits_all={logits_all}, \"\n97:             f\"flash_attn={FLASH_ATTENTION}\",\n98:             file=sys.stderr,\n99:         )\n100:     started = time.time()\n101:     llm = Llama(\n102:         model_path=model_path,\n103:         n_ctx=context_size,\n104:         **threading,\n105:         n_gpu_layers=resolve_gpu_layers(),\n106:         flash_attn=FLASH_ATTENTION,\n107:         logits_all=logits_all,\n108:         verbose=False,\n109:     )\n110:     if not quiet:\n111:         print(f\"[model] loaded in {time.time() - started:.1f}s\", file=sys.stderr)\n112:     return llm\n113: \n114: \n115: class StepResult:\n116:     \"\"\"The outcome of one constrained generation.\"\"\"\n117: \n118:     def __init__(self, label, text, tokens, seconds, finish_reason, budget=None):\n119:         self.label = label\n120:         self.text = text\n121:         self.tokens = tokens\n122:         self.seconds = seconds\n123:         self.finish_reason = finish_reason\n124:         self.budget = budget\n125: \n126:     @property\n127:     def truncated(self):\n128:         \"\"\"True when the model ran out of budget rather than finishing.\"\"\"\n129:         return self.finish_reason == TRUNCATED\n130: \n131:     def describe(self):\n132:         speed = self.tokens / self.seconds if self.seconds else 0.0\n133:         # The ceiling is named on a truncation, because the ceiling is the\n134:         # diagnosis: it is what the retry has to raise.\n135:         note = f\" TRUNCATED at the {self.budget}-token ceiling\" if self.truncated else \"\"\n136:         return (\n137:             f\"[{self.label}] {self.tokens} tokens in {self.seconds:.1f}s \"\n138:             f\"({speed:.1f} tok/s){note}\"\n139:         )\n140: \n141: \n142: def token_count(llm, text):\n143:     \"\"\"Tokens consumed by `text` as a prompt.\"\"\"\n144:     return len(llm.tokenize(text.encode(\"utf-8\")))\n145: \n146: \n147: def available_tokens(llm, prompt):\n148:     \"\"\"How many tokens the context can still hold as a response to `prompt`.\n149: \n150:     This is the real ceiling: the room the prompt left behind. `MAX_NEW_TOKENS`\n151:     is only a guard against filling the whole context on the first attempt.\n152:     \"\"\"\n153:     if llm is None or not prompt or llm.n_ctx() <= 0:\n154:         return MAX_NEW_TOKENS\n155:     return max(MIN_BUDGET, llm.n_ctx() - token_count(llm, prompt) - CONTEXT_RESERVE)\n156: \n157: \n158: def generation_budget(llm, prompt, max_new_tokens=None):\n159:     \"\"\"The response ceiling: the one asked for, clamped to the room available.\n160: \n161:     The retry after a truncation passes `max_new_tokens=available_tokens(...)`,\n162:     which is how a step that hit `MAX_NEW_TOKENS` gets the rest of the context\n163:     on the second attempt instead of the same ceiling that cut it off.\n164:     \"\"\"\n165:     ceiling = MAX_NEW_TOKENS if max_new_tokens is None else max_new_tokens\n166:     return max(MIN_BUDGET, min(ceiling, available_tokens(llm, prompt)))\n167: \n168: \n169: def generate(llm, prompt, grammar_text, label, temperature=0.0, max_new_tokens=None, seed=None):\n170:     \"\"\"Generate one document under `grammar_text`, honouring the context budget.\n171: \n172:     The call is **not** streamed. Streaming yields one chunk per token and\n173:     rebuilds a response dict for each, which is pure Python overhead on top of\n174:     the sampler that already runs per token — it buys nothing here, because the\n175:     document is only ever parsed once the whole step has finished. A single\n176:     non-streaming call returns the same text in one dict, and its `usage` gives\n177:     the exact completion-token count instead of the one-per-chunk estimate the\n178:     stream forced.\n179: \n180:     The caller is responsible for having validated `grammar_text` first: this\n181:     function assumes it is well formed and would otherwise fail on the first\n182:     token rather than up front.\n183: \n184:     `max_new_tokens` overrides the first-attempt ceiling of `MAX_NEW_TOKENS`,\n185:     still clamped to the room the prompt left in the context. The retry after a\n186:     truncation uses it to ask for that whole room.\n187: \n188:     The grammar is required, not optional. An experiment with no GBNF mask at\n189:     all (§9.31) settled it: the raw model fences its JSON, appends prose and\n190:     code, renames the document's own keys and loses whole steps, so the mask is\n191:     what makes the output machine-readable at all — not a vocabulary guard on\n192:     top of otherwise-good JSON. There is deliberately no switch to turn it off.\n193:     \"\"\"\n194:     grammar = LlamaGrammar.from_string(grammar_text)\n195:     llm.reset()\n196: \n197:     budget = generation_budget(llm, prompt, max_new_tokens)\n198: \n199:     started = time.time()\n200:     response = llm(\n201:         prompt=prompt,\n202:         max_tokens=budget,\n203:         temperature=temperature,\n204:         grammar=grammar,\n205:         **({\"seed\": seed} if seed is not None else {}),\n206:     )\n207: \n208:     choice = (response.get(\"choices\") or [{}])[0]\n209:     text = choice.get(\"text\") or \"\"\n210:     finish_reason = choice.get(\"finish_reason\")\n211:     usage = response.get(\"usage\") or {}\n212:     tokens = usage.get(\"completion_tokens\")\n213:     if not isinstance(tokens, int):\n214:         # A backend without a usage block: measure the text directly rather than\n215:         # reporting zero, so the speed line and the truncation diagnosis stay\n216:         # meaningful.\n217:         tokens = token_count(llm, text)\n218: \n219:     return StepResult(\n220:         label, text, tokens, time.time() - started, finish_reason, budget\n221:     )"
              }

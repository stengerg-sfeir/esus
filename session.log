            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_components.py, lines 1-442\n1: \"\"\"Consistency checks for the extracted technology components.\n2: \n3: Covers the facade and persistence choices, the external access list, and the\n4: crud_services list whose entities must be bare domain model names.\n5: \"\"\"\n6: \n7: from kernel.consistency.methods import is_missing, is_placeholder\n8: from kernel.consistency.naming import CLASS_SUFFIXES, MATCH_NONE, MATCH_VARIANT, normalize\n9: from kernel.consistency.report import with_suggestions\n10: \n11: CRUD_OPERATIONS = (\"create\", \"read_one\", \"read_all\", \"update\", \"delete\")\n12: FACADE_TYPES = (\"cli\", \"api\", \"gui\")\n13: NO_TECHNOLOGY = {\"\", \"none\"}\n14: \n15: # Technologies that mean a command-line parser is being used, so the program is\n16: # expected to have arguments for it to parse. A document that names one of these\n17: # while recording no arguments at all is contradicting itself — which is how the\n18: # hello-world prompt came back with `argparse` and nothing to parse, and no rule\n19: # could see it because the document never said what the parser was for.\n20: PARSER_TECHNOLOGIES = {\"argparse\", \"click\", \"docopt\", \"typer\"}\n21: \n22: # The three parts of a CLI surface, all of which are lists that may be empty.\n23: INVOCATION_PARTS = (\"positional\", \"options\", \"commands\")\n24: \n25: # What an option or positional may carry, matching the grammar's `option-type`.\n26: # The field used to be free text, and inventory filled it with `dict`, `none` and\n27: # `positional` — recording its verbs as options of type `dict` and then looping on\n28: # `-add` until the token ceiling. The grammar closes the set now, so a value\n29: # outside it means the document did not come from the current grammar (a\n30: # fallback, or an edit). `list` is the one container, for `--fields name price`.\n31: OPTION_TYPES = (\"str\", \"int\", \"float\", \"bool\", \"list\")\n32: \n33: \n34: def check_components(components, index, report):\n35:     \"\"\"Validate components; return the crud_services entity names.\"\"\"\n36:     if not isinstance(components, dict):\n37:         return ()\n38: \n39:     _check_facade(components.get(\"facade\"), report)\n40:     _check_persistence(components.get(\"persistence\"), report)\n41:     _check_external_access(components.get(\"external_access\"), report)\n42:     entities = _check_crud_services(components.get(\"crud_services\"), index, report)\n43:     _check_persistence_has_something_to_store(components.get(\"persistence\"), entities, report)\n44:     return entities\n45: \n46: \n47: def _check_facade(facade, report):\n48:     if not isinstance(facade, dict):\n49:         report.error(\"invalid_value\", \"components.facade should be an object\")\n50:         return\n51:     facade_type = facade.get(\"type\")\n52:     if facade_type not in FACADE_TYPES:\n53:         report.error(\n54:             \"unsupported_value\",\n55:             f\"components.facade: type '{facade_type}' is not one of {', '.join(FACADE_TYPES)}\",\n56:         )\n57:     # `none` is a *value* for a facade's technology, not a placeholder: a program\n58:     # with no arguments needs no parser, and the prompt now says so. The placeholder\n59:     # test therefore excludes it while still catching the junk a model leaves\n60:     # behind (\"undefined\", \"todo\", \"n/a\"). A facade that declares arguments while\n61:     # its technology is `none` is the contradiction, and `inconsistent_facade`\n62:     # reports that instead — so relaxing this loses nothing.\n63:     technology = facade.get(\"technology\")\n64:     if is_missing(technology) or (\n65:         is_placeholder(technology) and _normalized_technology(technology) not in NO_TECHNOLOGY\n66:     ):\n67:         report.warning(\"invalid_value\", f\"components.facade: type '{facade_type}' has no technology\")\n68: \n69:     if \"invocation\" not in facade:\n70:         # A document written before the CLI surface was recorded. Its silence is\n71:         # not the same statement as an explicit null, so nothing is inferred from\n72:         # it — reporting here would flag every earlier run for a field it could\n73:         # not have written.\n74:         return\n75:     _check_invocation_agrees_with_technology(facade, report)\n76: \n77: \n78: def _check_invocation_agrees_with_technology(facade, report):\n79:     \"\"\"The parser and the surface must say the same thing.\n80: \n81:     Either half alone is unfalsifiable: `technology: argparse` with no surface\n82:     cannot be wrong, and a surface with no technology cannot be checked. Together\n83:     they contradict each other in two ways, and both were real:\n84: \n85:     - the hello-world requirements ask for \"a CLI entry point that prints\n86:       Hello, World!\" — no arguments — and the prompt's own instruction (\"if the\n87:       requirements name none, use cli with technology argparse\") produced\n88:       `argparse` anyway;\n89:     - a surface listing options while the technology is `none` would generate a\n90:       program that declares flags nothing parses.\n91:     \"\"\"\n92:     _check_invocation(facade.get(\"invocation\"), report)\n93:     technology = _normalized_technology(facade.get(\"technology\"))\n94:     invocation = facade.get(\"invocation\")\n95:     if invocation is None and technology in PARSER_TECHNOLOGIES:\n96:         report.warning(\n97:             \"inconsistent_facade\",\n98:             f\"components.facade: technology '{facade.get('technology')}' is a command-line \"\n99:             f\"parser but invocation is null — the program is declared to take no arguments\",\n100:         )\n101:         return\n102:     if _invocation_has_content(invocation) and technology in NO_TECHNOLOGY:\n103:         report.warning(\n104:             \"inconsistent_facade\",\n105:             f\"components.facade: invocation declares arguments but technology is \"\n106:             f\"{facade.get('technology')!r} — nothing would parse them\",\n107:         )\n108: \n109: \n110: def _invocation_has_content(invocation):\n111:     \"\"\"True when the surface names at least one argument, option or command.\"\"\"\n112:     if not isinstance(invocation, dict):\n113:         return False\n114:     for part in INVOCATION_PARTS:\n115:         value = invocation.get(part)\n116:         if isinstance(value, list) and value:\n117:             return True\n118:     return False\n119: \n120: \n121: def _check_invocation(invocation, report):\n122:     \"\"\"Validate the surface's own shape: names, types, and repeated commands.\n123: \n124:     Two defects found by reading the first run's output, each checkable without\n125:     the requirements:\n126: \n127:     - **a verb recorded as an option.** inventory's requirements say\n128:       `category update --id`; the document says command `category` with an option\n129:       `-update` of type `dict`. The noun/verb split was inverted, so the option\n130:       carries the name of the subcommand it was meant to be. An option whose type\n131:       is a mapping cannot be a command-line value at all.\n132:     - **a repeated command name.** library lists `member` twice — once with\n133:       `[add, list]` and once with `[history]`. The two would collide in any CLI\n134:       framework, and nothing compared them because the duplicate rules covered\n135:       documents' named lists, not the nested surface.\n136:     \"\"\"\n137:     if invocation is None:\n138:         # `null` is the recorded answer for a program with no arguments, so it is\n139:         # valid here and says nothing to check. Treating it as a missing object was\n140:         # a defect in the first version of this function, and the tests that pin the\n141:         # silent cases caught it.\n142:         return\n143:     if not isinstance(invocation, dict):\n144:         report.error(\"invalid_value\", \"components.facade.invocation should be an object or null\")\n145:         return\n146:     _check_cli_args(invocation.get(\"positional\"), \"invocation.positional\", report)\n147:     _check_cli_options(invocation.get(\"options\"), \"invocation.options\", report)\n148:     _check_cli_commands(invocation.get(\"commands\"), report)\n149: \n150: \n151: def _check_cli_options(options, where, report):\n152:     \"\"\"Check one options list, wherever it sits in the surface.\n153: \n154:     The mapping-typed options are reported as **one** finding per list, not one per\n155:     option: inventory declared ten of them across two commands, and ten identical\n156:     warnings for one modelling mistake is noise that hides the rest of the report.\n157:     \"\"\"\n158:     if options is None:\n159:         return\n160:     if not isinstance(options, list):\n161:         report.error(\"invalid_value\", f\"components.facade.{where} should be a list\")\n162:         return\n163:     seen = set()\n164:     bad_types = []\n165:     for option in options:\n166:         if not isinstance(option, dict):\n167:             report.error(\"invalid_value\", f\"components.facade.{where} has an entry that is not an object\")\n168:             continue\n169:         name = option.get(\"name\")\n170:         if is_missing(name):\n171:             report.error(\"invalid_identifier\", f\"components.facade.{where} has an option with no name\")\n172:             continue\n173:         key = name.strip().lower()\n174:         if key in seen:\n175:             report.warning(\"duplicate_entry\", f\"components.facade.{where}: option '{name}' is listed twice\")\n176:         seen.add(key)\n177:         type_name = option.get(\"type\")\n178:         if not isinstance(type_name, str) or not type_name.strip():\n179:             report.warning(\"invalid_value\", f\"components.facade.{where}: option '{name}' declares no type\")\n180:         elif not _is_option_type(type_name):\n181:             bad_types.append(f\"{name} ({type_name})\")\n182: \n183:     if bad_types:\n184:         report.warning(\n185:             \"unsupported_value\",\n186:             f\"components.facade.{where}: {len(bad_types)} option type(s) are outside \"\n187:             f\"{', '.join(OPTION_TYPES)}: {', '.join(bad_types)}\",\n188:         )\n189: \n190: \n191: def _is_option_type(type_name):\n192:     return type_name.strip().lower() in OPTION_TYPES\n193: \n194: \n195: def _check_cli_args(args, where, report):\n196:     \"\"\"Check the positional arguments' types the same way as an option's.\"\"\"\n197:     if args is None:\n198:         return\n199:     if not isinstance(args, list):\n200:         report.error(\"invalid_value\", f\"components.facade.{where} should be a list\")\n201:         return\n202:     seen = set()\n203:     invalid = []\n204:     for argument in args:\n205:         if not isinstance(argument, dict):\n206:             report.error(\"invalid_value\", f\"components.facade.{where} has an entry that is not an object\")\n207:             continue\n208:         name = argument.get(\"name\")\n209:         if is_missing(name):\n210:             report.error(\"invalid_identifier\", f\"components.facade.{where} has an argument with no name\")\n211:             continue\n212:         key = name.strip().lower()\n213:         if key in seen:\n214:             report.warning(\"duplicate_entry\", f\"components.facade.{where}: argument '{name}' is listed twice\")\n215:         seen.add(key)\n216:         type_name = argument.get(\"type\")\n217:         if not isinstance(type_name, str) or not type_name.strip():\n218:             report.warning(\"invalid_value\", f\"components.facade.{where}: argument '{name}' declares no type\")\n219:         elif not _is_option_type(type_name):\n220:             invalid.append(f\"{name} ({type_name})\")\n221: \n222:     if invalid:\n223:         report.warning(\n224:             \"unsupported_value\",\n225:             f\"components.facade.{where}: {len(invalid)} argument type(s) are outside \"\n226:             f\"{', '.join(OPTION_TYPES)}: {', '.join(invalid)}\",\n227:         )\n228: \n229: \n230: def _check_cli_commands(commands, report):\n231:     if commands is None:\n232:         return\n233:     if not isinstance(commands, list):\n234:         report.error(\"invalid_value\", \"components.facade.invocation.commands should be a list\")\n235:         return\n236:     seen = set()\n237:     for command in commands:\n238:         if not isinstance(command, dict):\n239:             report.error(\"invalid_value\", \"components.facade.invocation.commands has an entry that is not an object\")\n240:             continue\n241:         name = command.get(\"name\")\n242:         if is_missing(name):\n243:             report.error(\"invalid_identifier\", \"components.facade.invocation.commands has a command with no name\")\n244:             continue\n245:         key = normalize(name)\n246:         if key in seen:\n247:             report.warning(\"duplicate_entry\", f\"components.facade.invocation.commands: '{name}' is listed twice\")\n248:         seen.add(key)\n249:         _check_cli_options(command.get(\"options\"), f\"invocation.commands.{name}.options\", report)\n250:         _check_subcommands(name, command.get(\"subcommands\"), report)\n251:         _check_options_are_not_subcommands(name, command, report)\n252: \n253: \n254: def _check_options_are_not_subcommands(parent, command, report):\n255:     \"\"\"A word cannot be both an option of a command and one of its subcommands.\n256: \n257:     Caught on inventory after the noun/verb correction: `product` gained the right\n258:     subcommands — `[add, list, update, delete, restock, report]` — and kept the same\n259:     verbs as its options, so `add` was both the subcommand that adds a product and\n260:     the flag `-add` of the command containing it. `tool product add --sku` and\n261:     `tool product -add` cannot both be how a product is added, and nothing c
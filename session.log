            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_invariants.py, lines 1-79\n1: \"\"\"Agreement between a stated invariant and the field it names.\n2: \n3: An invariant is free prose, so it cannot be checked in general — but a few of\n4: them make a claim about a single field attribute that the data model also\n5: declares, and those can be compared. Measured on the corpus, the pair that\n6: occurs is `<field> must be unique` against that field's `unique` flag, and\n7: `<field> must be nullable|optional` against its `nullable` flag. Most of those\n8: agree; where they do not, one of the two documents is wrong.\n9: \n10: The rule is deliberately narrow. A field name that appears in more than one\n11: model is skipped, because the invariant does not say which model it means and\n12: guessing would manufacture findings. An invariant naming a field that no model\n13: declares is skipped too, because a program with no data model legitimately\n14: states rules about records it does not model — cli_tool's \"isbn must be unique\n15: across all records\" is the whole of its invariants, and its data model is\n16: correctly empty.\n17: \"\"\"\n18: \n19: import re\n20: \n21: from kernel.consistency.checks_phrases import phrase_text\n22: \n23: # \"sku must be unique\", \"category.name must be unique\": the name is the token\n24: # before the claim, with an optional model prefix that is stripped.\n25: _UNIQUE = re.compile(r\"\\b([a-z_][a-z0-9_]*)\\b[^.]*?\\bmust be unique\\b\", re.I)\n26: _NULLABLE = re.compile(r\"\\b([a-z_][a-z0-9_]*)\\b[^.]*?\\bmust be (?:nullable|optional)\\b\", re.I)\n27: \n28: CLAIMS = (\n29:     (_UNIQUE, \"unique\", \"unique\"),\n30:     (_NULLABLE, \"nullable\", \"nullable\"),\n31: )\n32: \n33: \n34: def check_invariant_claims(invariants, index, report):\n35:     \"\"\"Report each invariant that contradicts the attribute it names.\n36: \n37:     Every invariant is read, `rule` or `schema`: a `rule` never contains a\n38:     \"must be unique\" or \"must be nullable\" claim, so scanning both loses nothing\n39:     and keeps the rule's coverage independent of how step C tags a statement.\n40:     `phrase_text` reads the sentence from either document shape.\n41:     \"\"\"\n42:     if not isinstance(invariants, list) or not index.models:\n43:         return\n44: \n45:     declared = _fields_by_name(index)\n46:     for invariant in invariants:\n47:         text = phrase_text(invariant)\n48:         if text is None:\n49:             continue\n50:         for regex, attribute, wording in CLAIMS:\n51:             match = regex.search(text)\n52:             if match is None:\n53:                 continue\n54:             field_name = match.group(1)\n55:             candidates = declared.get(field_name, [])\n56:             if len(candidates) != 1:\n57:                 # Unknown here, or named by several models: the invariant does\n58:                 # not identify which field it means, so there is nothing to\n59:                 # compare rather than something to report.\n60:                 continue\n61:             model_name, field = candidates[0]\n62:             if field.get(attribute) is True:\n63:                 continue\n64:             report.warning(\n65:                 \"inconsistent_invariant\",\n66:                 f\"invariants: '{field_name} must be {wording}' but \"\n67:                 f\"{model_name}.{field_name} declares {attribute}={field.get(attribute)}\",\n68:             )\n69: \n70: \n71: def _fields_by_name(index):\n72:     \"\"\"Every declared field, keyed by name, with the models that declare it.\"\"\"\n73:     declared = {}\n74:     for model in index.models:\n75:         model_name = model.get(\"name\")\n76:         for field in model.get(\"fields\", []):\n77:             if isinstance(field, dict) and field.get(\"name\"):\n78:                 declared.setdefault(field[\"name\"], []).append((model_name, field))\n79:     return declared"
              }

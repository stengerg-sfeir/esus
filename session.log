                "type": "text",
                "text": "Read file /tmp/opencode/qwen_chat_probe.py, lines 1-160\n1: \"\"\"Raw completion vs the GGUF's own chat template, on one library stub.\n2: \n3: Run from the esus repo root on the Mac:\n4: \n5:     caffeinate python3.12 /tmp/opencode/qwen_chat_probe.py \\\n6:         ../models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf \\\n7:         LibraryService.borrow_book\n8: \n9: It builds the real first-attempt stub prompt from /tmp/library_repair,\n10: prints the GGUF identity and chat template, then answers four ways at\n11: temp 0, seed 20261012:\n12: \n13:   1. raw, the fill pass's 3584-token ceiling;\n14:   2. raw, the whole room left in the context;\n15:   3. chat, user message only;\n16:   4. chat, system line + user message.\n17: \n18: A direct body should be a few hundred tokens; visible reasoning fills the\n19: budget and ends with finish_reason='length'.  Compare the four.\n20: \"\"\"\n21: import json\n22: import os\n23: import sys\n24: \n25: ROOT = os.environ.get(\"ESUS_STUB_TREE\", \"/tmp/library_repair\")\n26: DEFAULT_MODEL = \"../models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf\"\n27: DEFAULT_LABEL = \"LibraryService.borrow_book\"\n28: \n29: sys.path.insert(0, os.getcwd())\n30: import generator  # noqa: E402\n31: import kernel.extraction.runner as runner  # noqa: E402\n32: \n33: \n34: def read_tree():\n35:     files = {}\n36:     for name in (\"models.py\", \"errors.py\", \"repositories.py\",\n37:                  \"services.py\", \"store.py\"):\n38:         path = os.path.join(ROOT, \"generated\", name)\n39:         with open(path, encoding=\"utf-8\") as handle:\n40:             files[name] = handle.read()\n41:     return files\n42: \n43: \n44: def context_for(label, files):\n45:     for name in (\"repositories.py\", \"services.py\"):\n46:         for _start, _end, info in generator.find_stub_spans(files[name]):\n47:             if f\"{info['cls']}.{generator._stub_method(info)}\" == label:\n48:                 info = dict(info, file=name)\n49:                 references = (generator._method_signatures(\n50:                     files[\"repositories.py\"]) if name == \"services.py\" else ())\n51:                 api = generator._api_reference(files, name)\n52:                 return name, info, references, api\n53:     raise SystemExit(f\"stub {label!r} not found in {ROOT}/generated\")\n54: \n55: \n56: def show(title, text, finish, usage):\n57:     text = text or \"\"\n58:     lines = text.splitlines()\n59:     print(f\"\\n=== {title} ===\")\n60:     print(f\"finish={finish!r} chars={len(text)} lines={len(lines)} \"\n61:           f\"usage={usage}\")\n62:     for line in lines[:50]:\n63:         print(\"|\", line)\n64:     if len(lines) > 50:\n65:         print(f\"... ({len(lines) - 50} more lines)\")\n66:     print(\"tail:\", repr(\"\\n\".join(lines[-4:]))[:500])\n67: \n68: \n69: def chat(llm, messages, max_tokens):\n70:     kwargs = dict(messages=messages, temperature=0.0, seed=20261012,\n71:                   max_tokens=max_tokens)\n72:     try:\n73:         return llm.create_chat_completion(**kwargs)\n74:     except TypeError:  # older bindings without a seed on the chat path\n75:         kwargs.pop(\"seed\", None)\n76:         return llm.create_chat_completion(**kwargs)\n77: \n78: \n79: def main():\n80:     model = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_MODEL\n81:     label = sys.argv[2] if len(sys.argv) > 2 else DEFAULT_LABEL\n82:     files = read_tree()\n83:     name, info, references, api = context_for(label, files)\n84:     requirements = generator.load_requirements(ROOT)\n85:     prompt = generator.stub_prompt(requirements, files[name], info,\n86:                                    references, api)\n87:     llm = runner.load_model(model, logits_all=False, quiet=True)\n88: \n89:     try:\n90:         metadata = llm.metadata or {}\n91:     except Exception as error:  # a binding without the property\n92:         metadata = {}\n93:         print(\"metadata unavailable:\", error)\n94:     if not isinstance(metadata, dict):\n95:         metadata = {}\n96:     print(\"model:\", model)\n97:     for key in (\"general.name\", \"general.basename\", \"general.size_label\"):\n98:         print(f\"{key}: {metadata.get(key)!r}\")\n99:     template = metadata.get(\"tokenizer.chat_template\") or \"\"\n100:     print(f\"chat_template: {len(template)} chars; \"\n101:           f\"enable_thinking={'enable_thinking' in template}; \"\n102:           f\"mentions thinking={'thinking' in template.lower()}\")\n103:     print(\"template head:\", template[:400].replace(\"\\n\", \"\\\\n\"))\n104: \n105:     prompt_tokens = runner.token_count(llm, prompt)\n106:     room = runner.available_tokens(llm, prompt)\n107:     print(f\"\\nlabel: {label}\")\n108:     print(f\"prompt: {len(prompt)} chars, {prompt_tokens} tokens; \"\n109:           f\"room={room} tokens (n_ctx={llm.n_ctx()})\")\n110: \n111:     # What the live repair ask cost: it embedded the whole raw first answer.\n112:     try:\n113:         with open(os.path.join(ROOT, \"llm_stub_answers.json\"),\n114:                   encoding=\"utf-8\") as handle:\n115:             dump = json.load(handle)\n116:         row = next(entry for entry in dump if entry[\"label\"] == label)\n117:     except Exception:\n118:         row = {}\n119:     first = row.get(\"first_answer\") or \"\"\n120:     if first:\n121:         repair = generator.stub_prompt(\n122:             requirements, files[name], info, references, api,\n123:             previous=first, complaints=[\"the body does not compile\"])\n124:         repair_tokens = runner.token_count(llm, repair)\n125:         print(f\"repair prompt with the dumped first answer: {len(repair)} \"\n126:               f\"chars, {repair_tokens} tokens; room=\"\n127:               f\"{runner.available_tokens(llm, repair)}\")\n128: \n129:     result = runner.generate_free(llm, prompt, f\"probe:{label}:raw-ceiling\",\n130:                                   temperature=0.0, seed=20261012)\n131:     show(\"raw, fill ceiling\", result.text, result.finish_reason,\n132:          {\"tokens\": result.tokens, \"budget\": result.budget})\n133: \n134:     result = runner.generate_free(llm, prompt, f\"probe:{label}:raw-room\",\n135:                                   temperature=0.0, seed=20261012,\n136:                                   max_new_tokens=room)\n137:     show(\"raw, full room\", result.text, result.finish_reason,\n138:          {\"tokens\": result.tokens, \"budget\": result.budget})\n139: \n140:     budget = max(64, min(4096, room - 512))\n141:     response = chat(llm, [{\"role\": \"user\", \"content\": prompt}], budget)\n142:     choice = (response.get(\"choices\") or [{}])[0]\n143:     show(\"chat, user only\",\n144:          (choice.get(\"message\") or {}).get(\"content\") or \"\",\n145:          choice.get(\"finish_reason\"), response.get(\"usage\"))\n146: \n147:     response = chat(llm, [\n148:         {\"role\": \"system\",\n149:          \"content\": \"You are a Python code generator. Reply with only the \"\n150:                     \"requested method body, no explanation.\"},\n151:         {\"role\": \"user\", \"content\": prompt},\n152:     ], budget)\n153:     choice = (response.get(\"choices\") or [{}])[0]\n154:     show(\"chat, system + user\",\n155:          (choice.get(\"message\") or {}).get(\"content\") or \"\",\n156:          choice.get(\"finish_reason\"), response.get(\"usage\"))\n157: \n158: \n159: if __name__ == \"__main__\":\n160:     main()"

                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/pipeline.py, lines 423-462\n423:     def _repair_errors(self):\n424:         \"\"\"Remove the two error contradictions the grammar cannot express (§9.28).\n425: \n426:         Run after step E because both documents have to exist first: the registry\n427:         is what `raises` resolves against, and the keep/drop decision for a\n428:         duplicate subject follows which name a method actually raises. The\n429:         constraints are global — two names meaning one thing, a create raising\n430:         its own not-found — so no GBNF expresses them, and the check for each is\n431:         shared with the checker to keep one definition.\n432:         \"\"\"\n433:         services = self.documents.get(SERVICE_CONTRACTS)\n434:         errors, services = repairs.repair_errors(\n435:             self.documents.get(ERRORS), services, self.log\n436:         )\n437:         # A declared error that no method raises is dead code. The registry keeps\n438:         # one when a method raises it, when the requirements name it, or when a\n439:         # distinctive word of its name is grounded in the requirements; otherwise\n440:         # it is dropped (§9.34).\n441:         errors = repairs.repair_unraised_errors(\n442:             errors, services, getattr(self, \"requirements\", \"\"), self.log\n443:         )\n444:         self.documents[ERRORS] = errors\n445:         if isinstance(services, list):\n446:             self.documents[SERVICE_CONTRACTS] = services\n447: \n448:     def _step_patterns(self):\n449:         \"\"\"Step F: classify invariants and contract methods into kernel patterns.\n450: \n451:         The classifier model is loaded here, on the first run that actually has\n452:         something to classify, rather than at startup. Its context is built with\n453:         `logits_all=True` — the pattern classifier reads per-token `logprobs`,\n454:         which nothing else needs — so it is a second full model load, and a\n455:         program with no domain (hello, cli_tool) must not pay for one it will\n456:         never call. Building it here means a no-domain run loads one model.\n457:         \"\"\"\n458:         items = classification.classification_items(self.documents)\n459:         if not items:\n460:             self.log.write(\"[ok] step patterns: nothing to classify\")\n461:             self.documents[PATTERN_MATCHES] = []\n462:             return\n[Output truncated. Continue reading with offset: 463]"

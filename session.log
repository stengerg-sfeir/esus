\"```\",\n    # 3. ExpenseService.export_to_csv\n    \"        expenses = self.list_expenses(start_date=start_date, end_date=end_date)\\n\"\n    \"        with open(file_path, 'w', newline='') as csvfile:\\n\"\n    \"            writer = csv.writer(csvfile)\\n\"\n    \"            writer.writerow(['ID', 'Amount (cents)', 'Description', 'Expense Date', 'Category ID', 'Payment Method', 'Is Recurring'])\\n\"\n    \"\\n\"\n    \"            for expense in expenses:\\n\"\n    \"                writer.writerow([\\n\"\n    \"                    expense.id,\\n\"\n    \"                    expense.amount_cents,\\n\"\n    \"                    expense.description,\\n\"\n    \"                    expense.expense_date,\\n\"\n    \"                    expense.category_id,\\n\"\n    \"                    expense.payment_method,\\n\"\n    \"                    expense.is_recurring\\n\"\n    \"                ])\\n\"\n    \"```\",\n    # 4. ExpenseService.get_yearly_summary\n    \"def get_yearly_summary(self, year: str = None) -> Dict[str, Any]:\\n\"\n    \"    expenses = self._repos['ExpenseRepository'].read_all_expenses()\\n\"\n    \"    monthly_totals = {}\\n\"\n    \"    for expense in expenses:\\n\"\n    \"        month = expense.expense_date[:7]\\n\"\n    \"        if month not in monthly_totals:\\n\"\n    \"            monthly_totals[month] = 0\\n\"\n    \"        monthly_totals[month] += expense.amount_cents\\n\"\n    \"\\n\"\n    \"    top_categories = {}\\n\"\n    \"    for expense in expenses:\\n\"\n    \"        category_id = expense.category_id\\n\"\n    \"        if category_id not in top_categories:\\n\"\n    \"            top_categories[category_id] = 0\\n\"\n    \"        top_categories[category_id] += expense.amount_cents\\n\"\n    \"\\n\"\n    \"    # Sort top categories by total spending\\n\"\n    \"    sorted_categories = sorted(top_categories.items(), key=lambda x: x[1], reverse=True)\\n\"\n    \"\\n\"\n    \"    # Calculate average monthly spend\\n\"\n    \" 
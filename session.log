str)) \\\n128:                 and not isinstance(effect.get(\"by\"), bool):\n129:             item[\"by\"] = effect[\"by\"]\n130:         if isinstance(effect.get(\"value\"), (str, int, float, bool)):\n131:             item[\"value\"] = effect[\"value\"]\n132:         if isinstance(effect.get(\"write\"), str) and effect[\"write\"]:\n133:             item[\"write\"] = effect[\"write\"]\n134:         effects.append(item)\n135:     if effects:\n136:         record[\"effects\"] = effects\n137: \n138:     creates = []\n139:     for create in raw.get(\"creates\") or []:\n140:         if not isinstance(create, dict):\n141:             continue\n142:         item = {}\n143:         for key in (\"class\", \"call\"):\n144:             if isinstance(create.get(key), str) and create[key]:\n145:                 item[key] = create[key]\n146:         if item:\n147:             creates.append(item)\n148:     if creates:\n149:         record[\"creates\"] = creates\n150: \n151:     preconditions = []\n152:     for precondition in raw.get(\"preconditions\") or []:\n153:         if not isinstance(precondition, dict):\n154:             continue\n155:         check = precondition.get(\"check\")\n156:         if not (isinstance(check, str) and check):\n157:             continue\n158:         item = {\"check\": check}\n159:         if isinstance(precondition.get(\"error\"), str) \\\n160:                 and precondition[\"error\"]:\n161:             item[\"error\"] = precondition[\"error\"]\n162:         preconditions.append(item)\n163:     if preconditions:\n164:         record[\"preconditions\"] = preconditions\n165: \n166:     order = [step for step in (raw.get(\"order\") or [])\n167:              if isinstance(step, str) and step]\n168:     if order:\n169:         record[\"order\"] = order\n170: \n171:     forbid = []\n172:     for rule in raw.get(\"forbid\") or []:\n173:         if not (isinstance(rule, dict)\n174:                 and isinstance(rule.get(\"target\"), str)\n175:      
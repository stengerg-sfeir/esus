                "type": "text",
                "text": "REPO: ['AGGREGATE_BY_FK_AND_DATE', 'AGGREGATE_BY_FK', 'COUNT_ACTIVE_BY_FK', 'FILTER_BY_FIELD', 'FILTER_WITH_PAGINATION', 'EXISTS_BY_UNIQUE_COMPOSITE', 'THRESHOLD_SCAN', 'READ_ALL']\nSERVICE: ['BUDGET_OVERFLOW_GUARD', 'QUOTA_CAPACITY_GUARD', 'STOCK_SUFFICIENCY_GUARD', 'PRICE_MARGIN_GUARD', 'STATE_TRANSITION_GUARD']\n===== AGGREGATE_BY_FK_AND_DATE\n{\n \"pattern_id\": \"AGGREGATE_BY_FK_AND_DATE\",\n \"layer\": \"repository\",\n \"returns\": [\n  \"scalar\",\n  \"mapping\"\n ],\n \"description\": \"Calculates an aggregate (SUM, AVG, COUNT, MIN, MAX) of a numeric field filtered by a foreign key ID and a date or month range. Commonly used for monthly totals, budget calculations, and periodic expense summaries.\",\n \"match_keywords\": [\n  \"sum\",\n  \"total\",\n  \"aggregate\",\n  \"month\",\n  \"monthly\",\n  \"period\",\n  \"date range\",\n  \"category\",\n  \"budget check\"\n ],\n \"required_params\": [\n  \"fk_field\",\n  \"date_field\",\n  \"target_field\",\n  \"aggregate_func\"\n ],\n \"sql_template\": \"SELECT COALESCE({aggregate_func}({target_field}), 0) FROM {table_name} WHERE {fk_field} = ? AND {date_field} >= ? AND {date_field} <= ?\",\n \"python_signature\": \"def {method_name}(self, {fk_field}: int, start_date: date, end_date: date) -> {return_type}:\"\n}\n===== AGGREGATE_BY_FK\n{\n \"pattern_id\": \"AGGREGATE_BY_FK\",\n \"layer\": \"repository\",\n \"returns\": [\n  \"scalar\",\n  \"mapping\"\n ],\n \"description\": \"Calculates an aggregate of a field grouped or filtered by a foreign key ID without date constraints (e.g. total stock value for a category, total spent per vendor).\",\n \"match_keywords\": [\n  \"total value\",\n  \"sum by category\",\n  \"total stock\",\n  \"group by category\"\n ],\n \"required_params\": [\n  \"fk_field\",\n  \"target_field\",\n  \"aggregate_func\"\n ],\n \"sql_template\": \"SELECT COALESCE({aggregate_func}({target_field}), 0) FROM {table_name} WHERE {fk_field} = ?\",\n \"python_signature\": \"def {method_name}(self, {fk_field}: int) -> {return_type}:\"\n}\n===== THRESHOLD_SCAN\n{\n \"pattern_id\": \"THRESHOLD_SCAN\",\n \"layer\": \"repository\",\n \"returns\": [\n  \"collection\"\n ],\n \"description\": \"Scans records where a quantity or date crosses a threshold (e.g. stock below reorder threshold, overdue loans where due_date < current_date).\",\n \"match_keywords\": [\n  \"low stock\",\n  \"reorder threshold\",\n  \"overdue\",\n  \"threshold alert\",\n  \"below limit\"\n ],\n \"required_params\": [\n  \"comparison_field\",\n  \"threshold_field_or_param\",\n  \"operator\"\n ],\n \"sql_template\": \"SELECT * FROM {table_name} WHERE {comparison_field} {operator} {threshold_field_or_param}\",\n \"python_signature\": \"def {method_name}(self, threshold_val: Optional[Any] = None) -> list[{entity_name}]:\"\n}\n===== BUDGET_OVERFLOW_GUARD\n{\n \"pattern_id\": \"BUDGET_OVERFLOW_GUARD\",\n \"layer\": \"service\",\n \"returns\": [\n  \"boolean\",\n  \"none\"\n ],\n \"description\": \"Verifies that adding or modifying an amount does not cause the sum of existing amounts for a period/category to exceed a defined budget or quota limit. Raises BudgetExceededException on violation.\",\n \"match_keywords\": [\n  \"budget\",\n  \"limit\",\n  \"budget limits\",\n  \"exceed\",\n  \"exceeding\",\n  \"overflow\",\n  \"monthly limit\",\n  \"budget exceeded\",\n  \"budget checks\"\n ],\n \"required_invariants\": [\n  \"Amount addition must not exceed monthly budget limit\"\n ],\n \"dependencies\": {\n  \"repository_calls\": [\n   \"AGGREGATE_BY_FK_AND_DATE\",\n   \"EXISTS_BY_UNIQUE_COMPOSITE\"\n  ]\n },\n \"template_logic\": \"current_total = repo.get_total_by_category_and_period(category_id, start_date, end_date)\\nif current_total + new_amount > budget.amount_limit:\\n    raise BudgetExceededException(f'Exceeds budget limit of {budget.amount_limit}')\"\n}\n"
              }

"text\": entry.get(\"text\"), \"candidates\": candidates})\n144-    pattern_id = entry.get(\"pattern_id\")\n145-    if decision == \"undefined\" or pattern_id in (\"NO_MATCH\", \"NO_PATTERN_IN_DOMAIN\"):\n146-        return (\"llm-gap\", {\n147-            \"text\": entry.get(\"text\"),\n148-            \"source\": entry.get(\"source\"),\n"

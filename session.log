nts, self.documents.get(DATA_MODELS), self.log\n329:                 )\n330:                 retry_misses = (_missing_commands(retry, requirements)\n331:                                 + _missing_flags(retry, requirements))\n332:             else:\n333:                 retry_misses = list(missing)\n334:             body, _ = _settle_retry(\n335:                 COMPONENTS, first, missing, retry, retry_misses,\n336:                 self.log, unit=\"surface item(s)\",\n337:             )\n338:             # _generate stores every attempt: point the document back at the\n339:             # kept one, or a degrading retry silently replaces good content.\n340:             self.documents[COMPONENTS] = body\n341:         return body\n342: \n343:     def _step_contracts(self, requirements):\n344:         \"\"\"Step E: service names are new, so the grammar stays open.\n345: \n346:         Gated on there being entities, as step H is gated on persistence: a\n347:         service contract exists to act on a domain, so no domain means no\n348:         services. Ungated, this step invented a `HelloWorldService` for a\n349:         program whose data model was, correctly, empty — and step G then\n350:         faithfully built an adapter onto it.\n351:         \"\"\"\n352:         entities = self._entities()\n[Output truncated. Continue reading with offset: 353]"

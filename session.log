                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/tests/test_repairs.py, lines 1-184\n1: \"\"\"The two contradictions removed by `kernel.extraction.repairs`.\n2: \n3: Each test pins one decision and, where the repair must stay silent, pins that\n4: silence too — a repair that removes a value the document does not contradict is\n5: worse than no repair. The predicates are shared with the checker, so these also\n6: assert that the repair agrees with the rule that used to report the defect.\n7: \"\"\"\n8: \n9: import sys\n10: import unittest\n11: from pathlib import Path\n12: \n13: sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n14: \n15: from kernel.extraction import repairs  # noqa: E402\n16: \n17: \n18: class Log:\n19:     def __init__(self):\n20:         self.lines = []\n21: \n22:     def write(self, text):\n23:         self.lines.append(text)\n24: \n25: \n26: def contract(name, raises):\n27:     return {\"service_name\": \"S\", \"methods\": [{\"name\": name, \"raises\": list(raises)}]}\n28: \n29: \n30: class DuplicateErrorSubjectTests(unittest.TestCase):\n31:     def test_two_names_for_one_missing_record_leave_one(self):\n32:         errors = [{\"name\": \"ProductNotFoundError\"}, {\"name\": \"MissingProductError\"}]\n33:         log = Log()\n34:         kept, _ = repairs.repair_errors(errors, [], log)\n35:         self.assertEqual([item[\"name\"] for item in kept], [\"ProductNotFoundError\"])\n36: \n37:     def test_the_kept_name_is_the_one_a_method_raises(self):\n38:         errors = [{\"name\": \"MissingProductError\"}, {\"name\": \"ProductNotFoundError\"}]\n39:         services = [contract(\"get_product_by_id\", [\"ProductNotFoundError\"])]\n40:         kept, _ = repairs.repair_errors(errors, services, Log())\n41:         self.assertEqual([item[\"name\"] for item in kept], [\"ProductNotFoundError\"])\n42: \n43:     def test_a_reference_to_the_dropped_name_is_redirected(self):\n44:         \"\"\"Both names raised by different methods: the later one is redirected.\"\"\"\n45:         errors = [{\"name\": \"ProductNotFoundError\"}, {\"name\": \"MissingProductError\"}]\n46:         services = [\n47:             contract(\"get_product_by_id\", [\"ProductNotFoundError\"]),\n48:             contract(\"read_product_by_code\", [\"MissingProductError\"]),\n49:         ]\n50:         _, repaired = repairs.repair_errors(errors, services, Log())\n51:         self.assertEqual(\n52:             repaired[1][\"methods\"][0][\"raises\"], [\"ProductNotFoundError\"]\n53:         )\n54: \n55:     def test_one_name_per_subject_is_left_alone(self):\n56:         errors = [{\"name\": \"ProductNotFoundError\"}, {\"name\": \"CategoryNotFoundError\"}]\n57:         log = Log()\n58:         kept, _ = repairs.repair_errors(errors, [], log)\n59:         self.assertEqual(len(kept), 2)\n60:         self.assertEqual(log.lines, [])\n61: \n62: \n63: class ContradictoryRaiseTests(unittest.TestCase):\n64:     def test_a_create_loses_the_not_found_of_what_it_creates(self):\n65:         services = [contract(\"create_product\", [\"ProductNotFoundError\"])]\n66:         _, repaired = repairs.repair_errors([], services, Log())\n67:         self.assertEqual(repaired[0][\"methods\"][0][\"raises\"], [])\n68: \n69:     def test_add_stock_keeps_the_product_not_found_it_must_find(self):\n70:         \"\"\"`add` is ambiguous: adding stock finds the product, so the raise stays.\"\"\"\n71:         services = [contract(\"add_stock\", [\"ProductNotFoundError\"])]\n72:         _, repaired = repairs.repair_errors([], services, Log())\n73:         self.assertEqual(repaired[0][\"methods\"][0][\"raises\"], [\"ProductNotFoundError\"])\n74: \n75:     def test_a_reader_keeps_its_not_found(self):\n76:         services = [contract(\"read_product_by_id\", [\"ProductNotFoundError\"])]\n77:         _, repaired = repairs.repair_errors([], services, Log())\n78:         self.assertEqual(repaired[0][\"methods\"][0][\"raises\"], [\"ProductNotFoundError\"])\n79: \n80: \n81: class MismatchedTransformTests(unittest.TestCase):\n82:     def adapter(self, field_name, transform):\n83:         return {\n84:             \"action_name\": \"add_book\",\n85:             \"input_fields\": [{\"field_name\": field_name, \"transform\": transform}],\n86:         }\n87: \n88:     def test_a_count_converted_to_cents_becomes_direct(self):\n89:         adapters = [self.adapter(\"copies\", \"DECIMAL_TO_CENTS\")]\n90:         repairs.repair_adapter_transforms(adapters, Log())\n91:         self.assertEqual(adapters[0][\"input_fields\"][0][\"transform\"], \"DIRECT\")\n92: \n93:     def test_a_money_amount_keeps_its_transform(self):\n94:         adapters = [self.adapter(\"price_cents\", \"DECIMAL_TO_CENTS\")]\n95:         repairs.repair_adapter_transforms(adapters, Log())\n96:         self.assertEqual(adapters[0][\"input_fields\"][0][\"transform\"], \"DECIMAL_TO_CENTS\")\n97: \n98:     def test_a_single_name_read_as_a_list_becomes_direct(self):\n99:         adapters = [self.adapter(\"title\", \"CSV_LIST\")]\n100:         repairs.repair_adapter_transforms(adapters, Log())\n101:         self.assertEqual(adapters[0][\"input_fields\"][0][\"transform\"], \"DIRECT\")\n102: \n103:     def test_a_date_field_keeps_its_transform(self):\n104:         adapters = [self.adapter(\"expense_date\", \"ISO_DATE\")]\n105:         repairs.repair_adapter_transforms(adapters, Log())\n106:         self.assertEqual(adapters[0][\"input_fields\"][0][\"transform\"], \"ISO_DATE\")\n107: \n108:     def test_direct_is_never_touched(self):\n109:         adapters = [self.adapter(\"anything\", \"DIRECT\")]\n110:         repairs.repair_adapter_transforms(adapters, Log())\n111:         self.assertEqual(adapters[0][\"input_fields\"][0][\"transform\"], \"DIRECT\")\n112: \n113: \n114: class UnraisedErrorTests(unittest.TestCase):\n115:     \"\"\"An error no method raises is dropped only when the requirements disown it.\"\"\"\n116: \n117:     REQUIREMENTS = (\n118:         \"Book lending CLI. Handles overdue loans and reports an overdue list.\"\n119:     )\n120: \n121:     def test_a_raised_error_is_kept(self):\n122:         errors = [{\"name\": \"BookNotFoundError\"}]\n123:         services = [contract(\"find_book\", [\"BookNotFoundError\"])]\n124:         kept = repairs.repair_unraised_errors(errors, services, self.REQUIREMENTS, Log())\n125:         self.assertEqual([item[\"name\"] for item in kept], [\"BookNotFoundError\"])\n126: \n127:     def test_a_grounded_unraised_error_is_kept(self):\n128:         \"\"\"`OverdueLoanFoundError` is unraised but the requirements say 'overdue'.\"\"\"\n129:         errors = [{\"name\": \"OverdueLoanFoundError\"}]\n130:         log = Log()\n131:         kept = repairs.repair_unraised_errors(errors, [], self.REQUIREMENTS, log)\n132:         self.assertEqual([item[\"name\"] for item in kept], [\"OverdueLoanFoundError\"])\n133:         self.assertEqual(log.lines, [])\n134: \n135:     def test_a_named_unraised_error_is_kept(self):\n136:         errors = [{\"name\": \"BookNotFoundError\"}]\n137:         kept = repairs.repair_unraised_errors(\n138:             errors, [], \"raise BookNotFoundError when absent\", Log()\n139:         )\n140:         self.assertEqual([item[\"name\"] for item in kept], [\"BookNotFoundError\"])\n141: \n142:     def test_an_ungrounded_validation_error_is_dropped(self):\n143:         errors = [{\"name\": \"InvalidInputError\"}]\n144:         log = Log()\n145:         kept = repairs.repair_unraised_errors(errors, [], self.REQUIREMENTS, log)\n146:         self.assertEqual(kept, [])\n147:         self.assertEqual(len(log.lines), 1)\n148: \n149:     def test_a_partly_grounded_validation_error_is_still_dropped(self):\n150:         \"\"\"'budget' grounds the name, but a validation shape is dropped anyway.\"\"\"\n151:         errors = [{\"name\": \"InvalidBudgetAmountError\"}]\n152:         kept = repairs.repair_unraised_errors(errors, [], \"the budget is stored\", Log())\n153:         self.assertEqual(kept, [])\n154: \n155:     def test_an_ungrounded_unraised_error_is_dropped(self):\n156:         errors = [{\"name\": \"MalformedCSVError\"}]\n157:         kept = repairs.repair_unraised_errors(errors, [], \"a book lending tool\", Log())\n158:         self.assertEqual(kept, [])\n159: \n160:     def test_a_grounded_validation_error_is_kept(self):\n161:         \"\"\"cli_tool's requirements say 'malformed CSV', so the class is warranted.\"\"\"\n162:         errors = [{\"name\": \"MalformedCSVError\"}]\n163:         kept = repairs.repair_unraised_errors(\n164:             errors, [], \"Handle missing files and malformed CSV input.\", Log()\n165:         )\n166:         self.assertEqual([item[\"name\"] for item in kept], [\"MalformedCSVError\"])\n167: \n168:     def test_no_requirements_leaves_the_registry_untouched(self):\n169:         errors = [{\"name\": \"InvalidInputError\"}]\n170:         kept = repairs.repair_unraised_errors(errors, [], \"\", Log())\n171:         self.assertEqual([item[\"name\"] for item in kept], [\"InvalidInputError\"])\n172: \n173:     def test_the_library_case_drops_two_and_keeps_one(self):\n174:         errors = [\n175:             {\"name\": \"MalformedCSVError\"},\n176:             {\"name\": \"InvalidInputError\"},\n177:             {\"name\": \"OverdueLoanFoundError\"},\n178:         ]\n179:         kept = repairs.repair_unraised_errors(errors, [], self.REQUIREMENTS, Log())\n180:         self.assertEqual([item[\"name\"] for item in kept], [\"OverdueLoanFoundError\"])\n181: \n182: \n183: if __name__ == \"__main__\":\n184:     unittest.main()"
              }

            "content": [
              {
                "type": "text",
                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/consistency/checks_errors.py, lines 1-308\n1: \"\"\"Consistency checks for the application error registry (step E').\n2: \n3: This is the one document whose entries another document references by name: a\n4: contract method's `raises` list names an error from the registry. That makes two\n5: opposite defects checkable — a name that is raised but never declared (a dangling\n6: reference) and a name that is declared but never raised (a declaration nothing\n7: uses) — and neither could be seen before the registry existed, because there was\n8: no name to resolve against and no field to carry it.\n9: \"\"\"\n10: \n11: from kernel.consistency.methods import is_missing\n12: from kernel.consistency.naming import normalize\n13: \n14: # The verbs that mean a method brings a record into existence. A method that\n15: # creates cannot then report that it failed to find what it is creating, so a\n16: # create-like name raising the not-found error *of that same thing* is\n17: # self-contradictory. The rule was written because the corpus produced it twice\n18: # independently: inventory's `ProductRepository.create_product` and expenses'\n19: # `ExpenseRepository.create_expense` both declared a `*NotFoundError` for the\n20: # record they were making.\n21: CREATE_VERBS = (\"create\", \"add\", \"save\", \"insert\", \"register\", \"make\", \"new\")\n22: \n23: # The noun is compared, not just the verb, because `add` is ambiguous:\n24: # `add_stock(product_id, ...)` must find the product it adds stock to, so its\n25: # `ProductNotFoundError` is correct, while `add_product` creating one cannot.\n26: # Matching `add_stock`'s subject (\"stock\") against the error's (\"product\") leaves\n27: # the first alone and still catches the second.\n28: NOT_FOUND_MARKER = \"notfound\"\n29: # `Missing<Entity>Error` is the other way the corpus spells the same idea, and\n30: # inventory and expenses each declared *both* spellings for one entity.\n31: MISSING_MARKER = \"missing\"\n32: ERROR_NAME_SUFFIXES = (\"error\", \"exception\")\n33: \n34: # The verbs that mean a method looks a record up by its key. Such a method is\n35: # where that record's not-found error belongs, which is what makes the rules\n36: # below checkable rather than a judgement call.\n37: READ_VERBS = (\"read\", \"get\", \"find\", \"fetch\", \"load\", \"lookup\")\n38: KEY_MARKERS = (\"byid\", \"byemail\", \"byname\", \"bysku\", \"byisbn\", \"bycode\", \"bykey\", \"bynumber\")\n39: \n40: # The built-ins an application error may derive from. Closed by the grammar, so a\n41: # value outside this set means the document was hand-edited or produced by an\n42: # older build rather than by the model.\n43: BASE_ERRORS = (\n44:     \"LookupError\",\n45:     \"ValueError\",\n46:     \"KeyError\",\n47:     \"RuntimeError\",\n48:     \"PermissionError\",\n49:     \"OSError\",\n50:     \"TypeError\",\n51:     \"Exception\",\n52: )\n53: \n54: \n55: def check_errors(errors, report):\n56:     \"\"\"Validate the registry; return the declared names.\n57: \n58:     An absent document returns nothing and says nothing: `loader` has already\n59:     reported it as `missing_document`, and reporting the type here as well tells\n60:     the reader the registry holds the wrong kind of value when in fact there is no\n61:     registry at all — the same finding twice, the second time misleading.\n62:     \"\"\"\n63:     if errors is None:\n64:         return ()\n65:     if not isinstance(errors, list):\n66:         report.error(\"invalid_value\", \"errors should be a list\")\n67:         return ()\n68: \n69:     names = []\n70:     seen = set()\n71:     for item in errors:\n72:         if not isinstance(item, dict):\n73:             report.error(\"invalid_value\", \"errors contains an entry that is not an object\")\n74:             continue\n75:         name = item.get(\"name\")\n76:         if is_missing(name):\n77:             report.error(\"invalid_identifier\", \"errors has an entry with no name\")\n78:             continue\n79: \n80:         key = name.strip().lower()\n81:         if key in seen:\n82:             report.warning(\"duplicate_entry\", f\"errors: '{name}' is declared more than once\")\n83:         seen.add(key)\n84:         names.append(name)\n85: \n86:         _check_base(name, item.get(\"base\"), report)\n87:         _check_description(name, item.get(\"description\"), report)\n88: \n89:     return tuple(names)\n90: \n91: \n92: def _check_base(name, base, report):\n93:     if is_missing(base):\n94:         report.warning(\"invalid_value\", f\"errors: '{name}' declares no base class\")\n95:         return\n96:     if base not in BASE_ERRORS:\n97:         report.warning(\n98:             \"unsupported_value\",\n99:             f\"errors: '{name}' derives from '{base}', which is not one of {', '.join(BASE_ERRORS)}\",\n100:         )\n101: \n102: \n103: def _check_description(name, description, report):\n104:     if is_missing(description):\n105:         report.warning(\n106:             \"empty_section\",\n107:             f\"errors: '{name}' has no description — nothing says when it is raised\",\n108:         )\n109: \n110: \n111: def check_raises(services, error_names, report):\n112:     \"\"\"Resolve every method's `raises` against the registry.\n113: \n114:     An unregistered name is reported whichever way the document is wrong: either\n115:     the method invents an error, or the registry is missing one it should hold.\n116:     A registered error that no method raises is a **note**, not a defect — a class\n117:     the generated program may still need for a failure raised outside the service\n118:     layer — and it is only reported when services exist at all, because a program\n119:     with no services (a CSV converter, whose errors belong to its CLI layer)\n120:     would otherwise have every one of its errors called unused, which is true and\n121:     useless.\n122:     \"\"\"\n123:     declared = {name.strip().lower() for name in error_names}\n124:     raised = set()\n125:     has_services = False\n126: \n127:     if isinstance(services, list):\n128:         for service in services:\n129:             if not isinstance(service, dict):\n130:                 continue\n131:             owner = service.get(\"service_name\")\n132:             for method in service.get(\"methods\") or []:\n133:                 if not isinstance(method, dict):\n134:                     continue\n135:                 has_services = True\n136:                 for target in method.get(\"raises\") or []:\n137:                     label = f\"{owner}.{method.get('name')}\"\n138:                     if not isinstance(target, str) or not target.strip():\n139:                         report.warning(\n140:                             \"invalid_value\",\n141:                             f\"service_contracts: {label} has an empty entry in raises\",\n142:                         )\n143:                         continue\n144:                     raised.add(target.strip().lower())\n145:                     if target.strip().lower() not in declared:\n146:                         report.warning(\n147:                             \"unknown_reference\",\n148:                             f\"service_contracts: {label} raises '{target}', \"\n149:                             f\"which no registered error declares\",\n150:                         )\n151:                     elif is_contradictory_raise(method.get(\"name\"), target):\n152:                         report.warning(\n153:                             \"contradictory_raise\",\n154:                             f\"service_contracts: {label} raises '{target}', but a method \"\n155:                             f\"that creates a record cannot fail to find it\",\n156:                         )\n157: \n158:     if not has_services:\n159:         return\n160:     for name in error_names:\n161:         if name.strip().lower() not in raised:\n162:             report.note(\n163:                 \"unused_error\",\n164:                 f\"errors: '{name}' is declared but no method raises it\",\n165:             )\n166: \n167: \n168: def is_contradictory_raise(method_name, error_name):\n169:     \"\"\"True when a create-like method claims to raise the not-found error of the\n170:     very thing it creates.\n171: \n172:     The test is on names because that is where the evidence is: the method's own\n173:     name states what it brings into existence, and the error's name states what\n174:     was not found. They have to agree for the pair to contradict itself.\n175:     \"\"\"\n176:     created = _created_subject(method_name)\n177:     if not created:\n178:         return False\n179:     absent = _absent_subject(error_name)\n180:     return bool(absent) and created == absent\n181: \n182: \n183: def _created_subject(method_name):\n184:     \"\"\"The noun a create-like method name claims to bring into existence.\"\"\"\n185:     if not isinstance(method_name, str):\n186:         return None\n187:     method = normalize(method_name)\n188:     for verb in CREATE_VERBS:\n189:         if method.startswith(verb) and len(method) > len(verb):\n190:             return method[len(verb):]\n191:     return None\n192: \n193: \n194: def _absent_subject(error_name):\n195:     \"\"\"The noun a not-found error name says was missing, or None.\"\"\"\n196:     if not isinstance(error_name, str):\n197:         return None\n198:     name = normalize(error_name)\n199:     if NOT_FOUND_MARKER not in name:\n200:         return None\n201:     for suffix in ERROR_NAME_SUFFIXES:\n202:         if name.endswith(suffix):\n203:             name = name[: -len(suffix)]\n204:     return name.replace(NOT_FOUND_MARKER, \"\")\n205: \n206: \n207: def _missing_subject(error_name):\n208:     \"\"\"The noun a `Missing<Entity>Error` name says was absent, or None.\n209: \n210:     The corpus spells the same failure two ways, so both have to be read: a rule\n211:     that knew only `NotFound` would treat `MissingCategoryError` and\n212:     `CategoryNotFoundError` as unrelated names for one missing category.\n213:     \"\"\"\n214:     absent = _absent_subject(error_name)\n215:     if absent:\n216:         return absent\n217:     if not isinstance(error_name, str):\n218:         return None\n219:     name = normalize(error_name)\n220:     for suffix in ERROR_NAME_SUFFIXES:\n221:         if name.endswith(suffix):\n222:             name = name[: -len(suffix)]\n223:     if name.startswith(MISSING_MARKER) and len(name) > len(MISSING_MARKER):\n224:         return name[len(MISSING_MARKER):]\n225:     return None\n226: \n227: \n228: def check_unreachable_not_found(errors, services, error_names, report):\n229:     \"\"\"A not-found error nothing raises while its own reader is declared.\n230: \n231:     `unused_error` notes every declared error no method raises, and it is a note\n232:     because the checker cannot tell a failure raised outside the service layer\n233:     from one the service forgot to raise. This is the case it *can* tell: the\n234:     document declares a method that looks that very thing up by its key, so the\n235:     method is exactly where the error belongs, and nothing raising it means the\n236:     lookup cannot report what the registry says it can. Measured on the corpus it\n237:     finds inventory's `MissingProductError` (`get_product_by_id` raises nothing)\n238:     and expenses' `MissingCategoryError` (`read_category_by_id` likewise), and\n239:     stays silent on every error whose subject no method reads.\n240:     \"\"\"\n241:     if not isinstance(services, list) or not services:\n242:         return\n243: \n244:     raised = set()\n245:     readers = []\n246:     for service in services:\n247:         if not isinstance(service, dict):\n248:             continue\n249:         for method in service.get(\"methods\") or []:\n250:             if not isinstance(method, dict):\n251:                 continue\n252:             name = method.get(\"name\")\n253:             if not isinstance(name, str):\n254:                 continue\n255:             raised.update(\n256:                 target.strip().lower()\n257:                 for target in method.get(\"raises\") or []\n258:                 if isinstance(target, str)\n259:             )\n260:             if _is_key_reader(name):\n261:                 readers.append(name)\n262: \n263:     for name in error_names:\n264:         subject = _missing_subject(name)\n265:         if not subject or name.strip().lower() in raised:\n266:             continue\n267:         reader = next(\n268:             (candidate for candidate in readers if subject in normalize(candidate)),\n269:             None,\n270:         )\n271:         if reader is None:\n272:             continue\n273:         report.warning(\n274:             \"unreachable_error\",\n275:             f\"errors: '{name}' is declared but no method raises it, while '{reader}' looks \"\n276:             f\"that record up by its key — the error for a missing record belongs to the method \"\n277:             f\"that reads it\",\n278:         )\n279: \n280: \n281: def check_duplicate_error_subject(errors, error_names, report):\n282:     \"\"\"Two declared errors naming one missing thing.\n283: \n284:     `CategoryNotFoundError` and `MissingCategoryError` are the same failure under\n285:     two names, and a registry holding both makes the generator emit two exception\n286:     classes for one condition. The check is exact because it compares what each\n287:     name *says is absent*, not how it is spelled.\n288:     \"\"\"\n289:     subjects = {}\n290:     for name in error_names:\n291:         subject = _missing_subject(name)\n292:         if subject:\n293:             subjects.setdefault(subject, []).append(name)\n294:     for subject, names in sorted(subjects.items()):\n295:         if len(names) > 1:\n296:             report.warning(\n297:                 \"duplicate_error_subject\",\n298:                 f\"errors: {', '.join(names)} all name the same missing record ({subject}) — \"\n299:                 f\"one failure should have one error type\",\n300:             )\n301: \n302: \n303: def _is_key_reader(method_name):\n304:     \"\"\"True when a method name reads one record by a key.\"\"\"\n305:     normalized = normalize(method_name)\n306:     if not normalized.startswith(READ_VERBS):\n307:         return False\n308:     return any(marker in normalized for marker in KEY_MARKERS)"
              }

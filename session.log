 'int'), ('member', 'Member')] -> Member | Updates a member's details by its ID.\n R MemberRepository.delete_member [('member_id', 'int')] -> bool | Deletes a member by its ID.\n R MemberRepository.find_active_members [] -> List[Member] | Finds all active members.\n R MemberRepository.find_inactive_members [] -> List[Member] | Finds all inactive members.\n R LoanRepository.create_loan [('loan', 'Loan')] -> Loan | Creates a new loan entry with the provided details.\n R LoanRepository.read_one_loan [('loan_id', 'int')] -> Loan | None | Reads a single loan by its ID.\n R LoanRepository.read_all_loans [] -> List[Loan] | Reads all loans from the database.\n R LoanRepository.update_loan [('loan_id', 'int'), ('loan', 'Loan')] -> Loan | Updates a loan's details by its ID.\n R LoanRepository.delete_loan [('loan_id', 'int')] -> bool | Deletes a loan by its ID.\n R LoanRepository.get_active_loans [] -> List[Loan] | Finds all active loans.\n R LoanRepository.get_overdue_loans [] -> List[Loan] | Finds all overdue loans.\n R LoanRepository.get_member_loan_history [('member_id', 'int')] -> List[Loan] | Finds all loans for a specific member.\n R LoanRepository.get_book_loan_history [('book_id', 'int')] -> List[Loan] | Finds all loans for a specific book.\n S LibraryService.borrow_book [('member_id', 'int'), ('book_id', 'int')] -> Loan | Borrow a book by member and book IDs, checks availability, creates loan, and dec\n S LibraryService.return_book [('loan_id', 'int')] -> Loan | Returns a book by loan ID, sets return_date, updates status, and increments copi\n S LibraryService.get_overdue_loans [] -> List[Loan] | Returns all overdue loans.\n S LibraryService.renew_membership [('member_id', 'int')] -> Member | Renews membership by toggling is_active status.\n S LibraryService.search_books [('query', 'str')] -> List[Book] | Searches books by title, author, or ISBN.\n===  out/expenses\n R CategoryRepository.create_category [('category', 'Category')] -> None | Creates a new category record in the database.\n R CategoryRepository.read_category_by_id [('id', 'int')] -> Category | Reads a category by its ID from the database.\n R CategoryRepository.read_all_categories [] -> List[Category] | Reads all categories from the database.\n R CategoryRepository.update_category [('id', 'int'), ('category', 'Category')] -> None | Updates an existing category record.\n R CategoryRepository.delete_category [('id', 'int')] -> None | Deletes a category record from the database.\n R CategoryRepository.find_expenses_by_category [('category_id', 'int')] -> List[Expense] | Finds all expenses associated with a category.\n R ExpenseRepository.create_expense [('expense', 'Expense')] -> None | Creates a new expense record in the database.\n R ExpenseRepository.read_expense_by_id [('id', 'int')] -> Expense | Reads an expense by its ID from the database.\n R ExpenseRepository.read_expenses_by_category [('category_id', 'int')] -> List[Expense] | Reads all expenses associated with a category.\n R ExpenseRepository.read_all_expenses [] -> List[Expense] | Reads all expenses from the database.\n R ExpenseRepository.read_expenses_by_date_range [('start_date', 'str'), ('end_date', 'str')] -> List[Expense] | Reads expenses within a specified date range.\n R ExpenseRepository.read_expenses_by_payment_method [('payment_method', 'str')] -> List[Expense] | Reads expenses by payment method.\n R ExpenseRepository.read_expenses_by_category_and_payment_method [('category_id', 'int'), ('payment_method', 'str')] -> List[Expense] | Reads expenses by category and payment method.\n R ExpenseRepository.update_expense [('id', 'int'), ('expense', 'Expense')] -> None | Updates an existing expense record.\n R ExpenseRepository.delete_expense [('id', 'int')] -> None | Deletes an expense record from the database.\n R ExpenseRepository.get_monthly_expense_total [('month', 'str')] -> int | Calculates total expenses for a given month.\n R ExpenseRepository.get_yearly_expense_total [('year', 'str')] -> int 
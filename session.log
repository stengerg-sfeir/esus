              "content": "\"\"\"Smoke the Qwen3 chat-written library bodies on the generated tree.\n\nRuns the real CLI against SQLite, then calls the service/repo directly where\nthe CLI has no command (renew, repo-level search). Every check prints what\nthe body actually did, so a mechanical pass cannot hide a runtime failure.\n\"\"\"\nimport os\nimport shutil\nimport sqlite3\nimport subprocess\nimport sys\n\nSRC = \"/tmp/opencode/library_qwen_chat\"\nSCRATCH = \"/tmp/opencode/library_qwen_chat_smoke\"\nGEN = SCRATCH\n\nshutil.rmtree(SCRATCH, ignore_errors=True)\nshutil.copytree(SRC, SCRATCH)\nfor name in os.listdir(GEN):\n    if name.endswith(\".db\"):\n        os.remove(os.path.join(GEN, name))\nshutil.rmtree(os.path.join(GEN, \"__pycache__\"), ignore_errors=True)\n\n\ndef run(cmd, label):\n    proc = subprocess.run(cmd, cwd=GEN, capture_output=True, text=True)\n    output = (proc.stdout + proc.stderr).strip()\n    print(f\"\\n$ {label}\")\n    print(output if output else \"(no output)\")\n    print(\"exit:\", proc.returncode)\n    return proc\n\n\ndef counts():\n    db = sqlite3.connect(os.path.join(GEN, \"lab.db\"))\n    try:\n        return {entity: db.execute(\n            \"SELECT COUNT(*) FROM records WHERE entity = ?\", (entity,)\n        ).fetchone()[0] for entity in (\"Author\", \"Book\", \"Member\", \"Loan\")}\n    finally:\n        db.close()\n\n\nSEED = '''\nimport sys\nsys.path.insert(0, \".\")\nimport store as store_mod\ns = store_mod.Store(\"lab.db\")\ns.add(\"Author\", \"id\", {\"name\": \"Ursula Le Guin\", \"birth_year\": 1929})\ns.add(\"Book\", \"id\", {\"title\": \"A Wizard of Earthsea\", \"isbn\": \"978-0\",\n                     \"author_id\": 1, \"published_year\": 1968,\n                     \"available_copies\": 1})\ns.add(\"Book\", \"id\", {\"title\": \"The Dispossessed\", \"isbn\": \"978-1\",\n                     \"author_id\": 1, \"published_year\": 1974,\n                     \"available_copies\": 1})\ns.add(\"Member\", \"id\", {\"name\": \"Ada\", \"email\": \"ada@example.com\",\n                       \"membership_date\": \"2026-01-15\", \"is_active\": True})\ns.close()\nprint(\"seeded\")\n'''\n\nREPO_SEARCH = '''\nimport sys\nsys.path.insert(0, \".\")\nimport store as store_mod\nfrom repositories import BookRepository, AuthorRepository\ns = store_mod.Store(\"lab.db\")\nrepo = BookRepository(s)\nfor query in (\"earthsea\", \"le guin\", \"978-1\", \"978-0\"):\n    try:\n        hits = [b.title for b in repo.search_books_by_title_author_isbn(query)]\n        print(f\"repo search {query!r} -> {hits}\")\n    except Exception as error:\n        print(f\"repo search {query!r} -> {type(error).__name__}: {error}\")\ns.close()\n'''\n\nSERVICE = '''\nimport sys\nsys.path.insert(0, \".\")\nimport store as store_mod\nfrom repositories import BookRepository, MemberRepository, LoanRepository\nfrom services import LibraryService\ns = store_mod.Store(\"lab.db\")\nsvc = LibraryService({\n    \"BookRepository\": BookRepository(s),\n    \"MemberRepository\": MemberRepository(s),\n    \"LoanRepository\": LoanRepository(s),\n})\nfor query in (\"earthsea\", \"le guin\", \"978-1\"):\n    try:\n        hits = [b.title for b in svc.search_books(query)]\n        print(f\"service search {query!r} -> {hits}\")\n    except Exception as error:\n        print(f\"service search {query!r} -> {type(error).__name__}: {error}\")\nfor round_ in (1, 2):\n    try:\n        print(f\"renew {round_} ->\", svc.renew_membership(1).is_active)\n    except Exception as error:\n        print(f\"renew {round_} -> {type(error).__name__}: {error}\")\ntry:\n    svc.renew_membership(99)\nexcept Exception as error:\n    print(\"renew 99 ->\", type(error).__name__, error)\ns.close()\n'''\n\nC = [sys.executable, \"cli.py\", \"--db\", \"lab.db\"]\n\nrun([sys.executable, \"-c\", SEED], \"seed\")\nprint(\"counts:\", counts())\n\nrun(C + [\"book\", \"list\"], \"book list\")\nrun(C + [\"book\", \"search\", \"--query\", \"earthsea\"], \"search by title\"
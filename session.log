ds[1]) in entities:\n            words = words[1:]\n        elif words[0] not in entities and len(words) > 1:\n            words = words[1:]\n        command = words[0]\n        sub = None\n        if len(words) > 1 and not words[1].startswith(\"-\"):\n            candidate = words[1].strip(\"[](),.;:\")\n            if candidate.lower() in COMMAND_VERB_STEMS:\n                sub = candidate\n        attributed.append((command, sub, flags))\n    return attributed\n\n\ndef _split_span(span):\n    \"\"\"`(word tokens, [(flag, required)])` for one command-line span.\"\"\"\n    from kernel.consistency import checks_surface as surface_checks\n\n    words = []\n    flags = []\n    for token in span.split():\n        match = surface_checks.FLAG_TOKEN.match(token)\n        if match is not None:\n            flags.append((match.group(1), not token.startswith(\"[\")))\n            continue\n        stripped = token.strip(\"[](),.;:\")\n        if stripped and not stripped.startswith(\"-\"):\n            words.append(stripped)\n    return words, flags\nPYEOF\npython3 -c \"\nimport sys; sys.path.insert(0,'.')\nfrom kernel.extraction import command_lines as C\nreq = open('prompts/prompt_library_system.txt').read()\nspans = C.extract_command_lines(req)\nfor c, s, f in C.attribute_lines(spans, ['Book','Author','Member','Loan']):\n    print(repr(c), '|', repr(s), '|', f)\n\""

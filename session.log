NotFoundError(\"Member not found\")\n\n        member.is_active = not member.is_active\n        updated_member = self._repos['MemberRepository'].update_member(member_id, member)\n\n        return updated_member\n```\"\"\",\n\"\"\"    def return_book(self, loan_id: int = None) -> models.Loan:\n        loan = self._repos['LoanRepository'].read_one_loan(loan_id)\n        if loan is None:\n            raise errors.LoanNotFoundError(\"Loan not found\")\n\n        book = self._repos['BookRepository'].read_one_book(loan.book_id)\n        if book is None:\n            raise errors.BookNotFoundError(\"Book not found\")\n\n        if loan.return_date is not None:\n            raise errors.LoanAlreadyReturnedError(\"Loan already returned\")\n\n        loan.return_date = models.date_today()\n        loan.status = \"returned\"\n        updated_loan = self._repos['LoanRepository'].update_loan(loan_id, loan)\n\n        book.available_copies += 1\n        updated_book = self._repos['BookRepository'].update_book(book_id, book)\n\n        return updated_loan\n```\"\"\",\n\"\"\"    def borrow_book(self, member_id: int = None, book_id: int = None) -> models.Loan:\n        member = self._repos['MemberRepository'].read_one_member(member_id)\n        if not member:\n            raise errors.MemberNotFoundError(\"Member not found\")\n\n        book = self._repos['BookRepository'].read_one_book(book_id)\n        if not book:\n            raise errors.BookNotFoundError(\"Book not found\")\n\n        if book.available_copies <= 0:\n            raise errors.BookUnavailableError(\"Book is not available for borrowing\")\n\n        loan = models.Loan(\n            book_id=book_id,\n            member_id=member_id,\n            loan_date=calendar.timegm(calendar.localtime()),\n            due_date=calendar.timegm(calendar.localtime()) + 14 * 24 * 60 * 60\n        )\n\n        self._repos['LoanRepository'].create_loan(loan)\n        self._repos['BookRepository'].update_book(book_id, book=book - 1)\n        return loan\n```\"\"\",\n]\n\nreplies = [mock.Mock(text=a, tokens=120, seconds=3.0) for a in answers]\nwith mock.patch.object(generator.runner, \"load_model\", return_value=object()), \\\n     mock.patch.object(generator.runner, \"generate_free\", side_effect=replies):\n    rows = generator.fill_stubs(files, \"Ministral-3-3B-Instruct-2512-Q4_K_M.gguf\",\n                                \"req\", out=lambda l: None)\nfor row in rows:\n    print(row)\nfor name in (\"repositories.py\", \"services.py\"):\n    open(f\"/tmp/esus_llm_check/{name}\", \"w\").write(files[name])\nprint(\"written to /tmp/esus_llm_check\")\nPYEOF"

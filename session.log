                "text": "Read file /Users/gillesstenger/Documents/esus/kernel/extraction/vocabulary.py, lines 1-229\n1: \"\"\"Authoritative name sets carried from one extraction step to the next.\n2: \n3: A document produced by step n is turned into signatures here, and those\n4: signatures drive both the prompt block of step n+1 and the GBNF rules that\n5: close its naming fields. Keeping one representation for both is what stops the\n6: prompt and the grammar from drifting apart.\n7: \"\"\"\n8: \n9: from dataclasses import dataclass\n10: \n11: PLACEHOLDER_NAMES = frozenset(\n12:     {\"\", \"none\", \"null\", \"nil\", \"n/a\", \"na\", \"unknown\", \"todo\", \"tbd\", \"undefined\"}\n13: )\n14: \n15: PRIMARY_KEY_FALLBACK = \"id\"\n16: \n17: \n18: def clean(value):\n19:     \"\"\"Return a stripped name, or None when it is missing or a placeholder.\"\"\"\n20:     if not isinstance(value, str):\n21:         return None\n22:     cleaned = value.strip()\n23:     if not cleaned or cleaned.lower() in PLACEHOLDER_NAMES:\n24:         return None\n25:     return cleaned\n26: \n27: \n28: @dataclass(frozen=True)\n29: class MethodSignature:\n30:     \"\"\"One method of a service contract.\"\"\"\n31: \n32:     name: str\n33:     params: tuple\n34: \n35: \n36: @dataclass(frozen=True)\n37: class EntitySignature:\n38:     \"\"\"One domain entity with its fields and its declared primary key.\"\"\"\n39: \n40:     name: str\n41:     fields: tuple\n42:     primary_key: str\n43: \n44:     def summary(self):\n45:         marked = [\n46:             f\"{field} pk\" if field == self.primary_key else field for field in self.fields\n47:         ]\n48:         return f\"{self.name}({', '.join(marked)})\"\n49: \n50: \n51: @dataclass(frozen=True)\n52: class ServiceSignature:\n53:     \"\"\"One service contract with the methods it declares.\"\"\"\n54: \n55:     name: str\n56:     methods: tuple\n57: \n58:     def summary_lines(self):\n59:         lines = []\n60:         for method in self.methods
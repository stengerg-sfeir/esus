    state[\"failed\"] = True\n164:                 raise RuntimeError(\"llama_decode returned -3\")\n165:             calls[\"reruns\"].append(start)\n166: \n167:         calls = {\"reruns\": []}\n168:         with tempfile.TemporaryDirectory() as directory:\n169:             with unittest.mock.patch(\"probe_readiness.check_prompt\") as checked:\n170:                 one = [Finding(\"warning\", \"uncovered_field\", \"x\")]\n171:                 checked.side_effect = [(one, [], None), (one, [], None),\n172:                                        ([], [], None), ([], [], None),\n173:                                        ([], [], None)]\n174:                 remaining = extract_arch.chat_loop(\n175:                     directory, fake_rerun, out_fn=lambda _: None,\n176:                     max_rounds=3)\n177:             self.assertEqual(remaining, 0)\n178:             self.assertEqual(calls[\"reruns\"], [\"interaction_adapters\"])\n179: \n180:     def test_a_repeated_crash_rolls_back(self):\n181:         from kernel.consistency.report import Finding\n182: \n183:         def always_crash(start):\n184:             raise RuntimeError(\"llama_decode returned -3\")\n185: \n186:         with tempfile.TemporaryDirectory() as tmp:\n187:             target = Path(tmp) / \"out\"\n188:             target.mkdir()\n189:             (target / \"marker.txt\").write_text(\"before\", encoding=\"utf-8\")\n190:             with unittest.mock.patch(\"probe_readiness.check_prompt\") as checked:\n191:                 one = [Finding(\"warning\", \"uncovered_field\", \"x\")]\n192:                 checked.side_effect = [(one, [], None), (one, [], None)]\n193:                 lines = []\n194:                 remaining = extract_arch.chat_loop(\n195:                     str(target), always_crash, out_fn=lines.append,\n196:                     max_rounds=3)\n197:             self.assertEqual(remaining, 1)\n198:             self.assertEqual((target / \"marker.txt\").read_text(encoding=\"utf-8\"),\n199:                              \"before\")\n200:             self.assertTrue(any(\"crashed twice\" in line for line in lines))\n201: \n202:     def test_attempt_resume_runs_once_when_healthy(self):\n203:         calls = []\n204:         extract_arch.attempt_resume(calls.append, \"components\", out_fn=lambda _: None)\n205:         self.assertEqual(calls, [\"components\"])\n206: \n207: \n208: class ResumeSubprocessTests(unittest.TestCase):\n209:     \"\"\"Resume rounds are isolated child processes, not in-process reruns.\n210: \n211:     The failure that motivated this: a crashed classifier decode left Metal\n212:     state unusable, and the in-process retry's fresh model load failed with\n213:     pressure errors. A child inherits stdio (logs stream live) and takes any\n214:     corruption down with it; the snapshot decides what survives.\n215:     \"\"\"\n216: \n217:     def args(self):\n218:         return type(\"Args\", (), {\"model\": \"m.gguf\", \"context\": 8192})()\n219: \n220:     def test_success_returns_quietly_with_the_right_command(self):\n221:         import subprocess\n222: \n223:         seen = {}\n224: \n225:         def fake_run(cmd, **kwargs):\n226:             seen[\"cmd\"] = cmd\n227:             seen[\"cwd\"] = kwargs.get(\"cwd\")\n228:             return subprocess.CompletedProcess(cmd, 0)\n229: \n230:         with unittest.mock.patch(\"subprocess.run\", side_effect=fake_run):\n231:             self.assertIsNone(extract_arch.resume_in_subprocess(\n232:                 self.args(), \"out/shop\", \"components\"))\n233:         self.assertEqual(seen[\"cmd\"][:2], [sys.executable, unittest.mock.ANY])\n234:         self.assertTrue(str(seen[\"cmd\"][1]).endswith(\"extract_arch.py\"))\n235:         for flag, value in [(\"--model\", \"m.gguf\"), (\"--output\", \"out/shop\"),\n236:                             (\"--context\", \"8192\"),\n237:                             (\"--from-step\", \"components\")]:\n238:             self.assertIn(flag, seen[\"cmd\"])\n239:             self.assertIn(value, seen[\"cmd\"])\n240: \n241:     def test_failure_raises_with_the_exit_code(self):\n242:         import subprocess\n243: \n244:         def fake_run(cmd, **kwargs):\n245:             return subprocess.CompletedProcess(cmd, 1)\n246: \n247:         with unittest.mock.patch(\"subprocess.run\", side_effect=fake_run):\n248:             with self.assertRaises(RuntimeError) as ctx:\n249:                 extract_arch.resume_in_subprocess(\n250:                     self.args(), \"out/shop\", \"components\")\n251:         self.assertIn(\"1\", str(ctx.exception))\n252: \n253:     def test_a_killed_child_raises_like_any_failure(self):\n254:         import subprocess\n255: \n256:         def fake_run(cmd, **kwargs):\n257:             return subprocess.CompletedProcess(cmd, -9)\n258: \n259:         with unittest.mock.patch(\"subprocess.run\", side_effect=fake_run):\n260:             with self.assertRaises(RuntimeError):\n261:                 extract_arch.resume_in_subprocess(\n262:                     self.args(), \"out/shop\", \"components\")\n263: \n264: \n265: if __name__ == \"__main__\":\n266:     unittest.main()"

gits_all=logits_all,\n107:         verbose=False,\n108:     )\n109:     print(f\"[model] loaded in {time.time() - started:.1f}s\", file=sys.stderr)\n110:     return llm\n111: \n112: \n113: class StepResult:\n114:     \"\"\"The outcome of one constrained generation.\"\"\"\n115: \n116:     def __init__(self, label, text, tokens, seconds, finish_reason, budget=None):\n117:         self.label = label\n118:         self.text = text\n119:         self.tokens = tokens\n[Output truncated. Continue reading with offset: 120]"
